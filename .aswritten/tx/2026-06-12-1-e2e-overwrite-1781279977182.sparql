# ── UPDATE: Body observation — exact quote changes from "First version" to "Second version" ──
DELETE {
  GRAPH ?g {
    narr:Obs_FirstVersionBody skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Obs_FirstVersionBody
      skos:note "The entire document body now consists of the single phrase 'Second version', marking this as an incremented stub superseding the prior 'First version' body." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_FirstVersionBody skos:note ?oldNote .
  }
} ;

