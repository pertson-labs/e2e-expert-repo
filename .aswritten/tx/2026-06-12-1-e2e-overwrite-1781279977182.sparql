# ── UPDATE: Narrative theme — "First version" → "Second version" ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_FirstVersionStub
      narr:theme "Second version document stub with reviewer assignment" ;
      skos:note "The document represents a second-version placeholder: a YAML frontmatter block assigns a reviewer (test+expert-gh@aswritten.ai, local-part redacted per PII policy), and the body contains only the phrase 'Second version', indicating an incremented stub or template-initialised artifact superseding the prior 'First version'." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim — body text superseded from "First version" to "Second version" ──
