PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250715T000000Z a prov:Activity ;
    dct:title "Extraction: stub document — Second version" ;
    prov:generatedAtTime "2025-07-15T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id provided in input)" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion_Stub,
      narr:StyleMetrics_SecondVersion_Stub,
      narr:StyleObs_SecondVersion_NounPhrase,
      narr:StyleObs_SecondVersion_MinimalRegister,
      narr:StyleObs_SecondVersion_YAMLFrontmatter .
} ;

# ── Update Narrative to reflect second version ───────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T000000Z {
    narr:Narrative_FirstVersionStub
      dct:source narr:Sample_SecondVersion_Stub ;
      skos:note "The document asserts only that this is a 'Second version' with a designated reviewer. No strategic, product, or architectural claims are present. Represents a second minimal commit of a memory document stub." ;
      narr:theme "Document stub — second version placeholder" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

# ── New entities (named graph) ────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T000000Z {

    # Sample
    narr:Sample_SecondVersion_Stub
      a narr:Sample ;
      dct:title "Second version (stub document)" ;
      dct:description "Minimal YAML-frontmatter document containing a reviewer field and the body text 'Second version'. No substantive narrative content. Reviewer email redacted per PII policy." ;
      narr:inputLength 65 .

    # Style Metrics
    narr:StyleMetrics_SecondVersion_Stub
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion_Stub ;
      skos:broader narr:StyleMetrics ;
      skos:note "Stub document. Body is a single 2-word noun phrase. No sentences, no jargon, no passive constructions. Metrics reflect placeholder content only." ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

    # Style Observation 1 — bare noun phrase body
    narr:StyleObs_SecondVersion_NounPhrase
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion_Stub ;
      skos:note "Body consists of a bare two-word noun phrase with no verb, no sentence structure, and no punctuation — minimal placeholder cadence." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_Stub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 56 ;
          oa:end 70
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — minimal register / no formality markers
    narr:StyleObs_SecondVersion_MinimalRegister
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion_Stub ;
      skos:note "Document uses no formal register markers, no salutation, no closing. Register is effectively absent — consistent with an internal version label rather than authored prose." ;
      rdf:value "false"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_Stub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 70
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---\n\nSecond version" ;
          oa:prefix "" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 3 — YAML frontmatter structural convention
    narr:StyleObs_SecondVersion_YAMLFrontmatter
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion_Stub ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes to declare metadata (reviewer). This is a structural editorial convention consistent with the first version." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_Stub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 53
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

  }
}