PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250715T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_SecondVersionState,
      narr:StyleObs_SecondVersion_Conciseness,
      narr:StyleObs_SecondVersion_RegisterFormality,
      narr:StyleObs_SecondVersion_VersionDeclaration,
      narr:StyleMetrics_SecondVersion .
} ;

# New Sample node for second version document
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer and a two-word body: 'Second version'. Supersedes the first version document." ;
      narr:inputLength 68 .
  }
} ;

# Update Narrative: theme transitions from initial state to second version state
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Second version document state" ;
      skos:note "The document has been updated to a second version, retaining the same minimal structure (YAML frontmatter with reviewer, two-word body) but advancing the version label. The reviewer designation persists." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# New Claim for second version state (temporal supersession of Claim_FirstVersionInitialState)
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Claim_SecondVersionState a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The phrase 'Second version' asserts this document has been revised at least once. Conviction is Notion — a single two-word phrase with no corroborating detail beyond the version increment." ;
      narr:aboutNode narr:Narrative_FirstVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_FirstVersionDocument .
  }
} ;

# Style Observation 1: Extreme conciseness — two-word body
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:StyleObs_SecondVersion_Conciseness a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body reduced to two words. Extreme conciseness pattern consistent with first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 36 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# Style Observation 2: Register formality — YAML frontmatter reviewer declaration
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:StyleObs_SecondVersion_RegisterFormality a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter used for structured metadata (reviewer field). Institutional/technical register implied by structured key-value syntax." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 34
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .
  }
} ;

# Style Observation 3: Version declaration pattern — ordinal versioning in plain language
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:StyleObs_SecondVersion_VersionDeclaration a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Ordinal version label ('Second version') used as the entire document body. Plain-language versioning rather than semantic versioning (e.g., v2.0). Consistent with prior 'First version' pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 36 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# Style Metrics for second version
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Single two-word body phrase. No sentences in the traditional sense; average sentence length approximated as 2 words. No jargon. No passive constructions. Identical profile to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
}