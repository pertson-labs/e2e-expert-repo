PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250715T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleObs_SecondVersion_PlainLanguage,
      narr:StyleObs_SecondVersion_YAMLFrontMatter,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleMetrics_SecondVersion .
} ;

# ── New Sample entity (INSERT DATA) ─────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML front-matter reviewer metadata and a two-word body. Successor to First version." ;
      narr:inputLength 67 .
  }
} ;

# ── Update Narrative: first version → second version ────────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_FirstVersionDocument
      narr:theme "Document version progression with reviewer assignment" ;
      skos:note "Document has progressed from first to second version, retaining a named reviewer assigned via YAML front-matter metadata. Version label is the sole body content." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── Update Claim: first version state → second version state ────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionState
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Claim_FirstVersionState
      skos:note "The document now self-identifies as 'Second version', superseding the prior first-version state. Indicates at least one revision cycle has occurred." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionState
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── Style observations (INSERT DATA) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {

    # Style Observation 1: Plain language / stub register
    narr:StyleObs_SecondVersion_PlainLanguage
      a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a two-word stub ('Second version'). Minimal register; no elaboration, no jargon, no rhetorical devices." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2: YAML front-matter metadata convention
    narr:StyleObs_SecondVersion_YAMLFrontMatter
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document uses YAML front-matter delimited by triple-dashes to carry reviewer metadata, consistent with editorial/CMS conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 51
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # Style Observation 3: Version label as sole body content (naming convention)
    narr:StyleObs_SecondVersion_VersionLabel
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version label ('Second version') used as the complete document body, functioning as a placeholder or stub title rather than substantive prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Body is two words ('Second version'). No full sentences; no jargon; no passive constructions. Metrics reflect stub/placeholder register, identical in character to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
}