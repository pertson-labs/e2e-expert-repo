          oa:exact "missing-id failure pattern from prod (## level heading, no id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    narr:StyleObs_ShortPunchyCadence_Phase2
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SampleMemoryWithDistinctiveHeading ;
      skos:note "Two-sentence body with parallel 'must' clauses separated by semicolon creates a terse, directive cadence typical of test-specification prose." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryWithDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 115 ;
          oa:end 241
        ] ;
        oa:hasSelector [
