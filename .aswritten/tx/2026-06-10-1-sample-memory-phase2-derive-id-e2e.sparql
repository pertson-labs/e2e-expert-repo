# ── New Sample entity (named graph) ─────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    narr:Sample_SampleMemoryPhase2DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Validates that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 280 .

    # ── Style Metrics ──────────────────────────────────────────────────────
    narr:StyleMetrics_Phase2DeriveIdE2E
      a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:AverageSentenceLength 18 ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Very short body (2 sentences). Imperative/active voice dominant ('Must not crash', 'must produce'). High engineering jargon density: id field, slug, prod, E2E, ## level heading, LLM. Neutral-technical register with test-specification tone." .

    # ── Style Observation 1: Imperative mood / active voice ────────────────
    narr:StyleObs_Phase2_ImperativeMood
      a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Imperative mood used for test acceptance criteria: 'Must not crash; must produce a valid slug.' Signals specification-style authorship." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 228
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: Technical jargon density ──────────────────────
    narr:StyleObs_Phase2_TechnicalJargon
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Dense engineering vocabulary in a short passage: 'missing-id failure pattern', 'prod', '## level heading', 'no id field'. Assumes reader familiarity with pipeline internals." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 97 ;
          oa:end 183
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod (## level heading,\nno id field)." ;
          oa:prefix "Derive Id E2E\n\n" ;
          oa:suffix " Must not crash"
        ]
      ] .

    # ── Style Observation 3: Parenthetical clarification ──────────────────
    narr:StyleObs_Phase2_ParentheticalClarification
      a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Parenthetical inline clarification '(## level heading, no id field)' used to specify the exact structural condition being tested, a common pattern in technical test specs." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 138 ;
          oa:end 183
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "(## level heading,\nno id field)" ;
          oa:prefix "missing-id failure pattern from prod " ;
          oa:suffix ". Must not crash"
        ]
      ] .

  }
} ;

# ── UPDATE: narr:Narrative_PipelineSlugGeneration — add Phase 2 context ─────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake path. Phase 2 E2E testing specifically reproduces the missing-id failure pattern from prod (## level heading, no id field) and asserts the pipeline must not crash and must produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}