# ── New entities: Claims, Observation, StyleObservations, StyleMetrics ───────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Claim: Meridian as the chosen database
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian selected as the analytics database, replacing Zypherion. Stated as a firm revised decision by the CTO." ;
      narr:aboutNode narr:Narrative_ZypherionAnalyticsAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAnalyticsAdoption .

    # New Claim: Zypherion streaming ingestion gap
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion. This is the primary disqualifying reason for the database switch. Stated by CTO after further evaluation." ;
      narr:aboutNode narr:Claim_ZypherionDatabaseChoice ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # New Claim: Meridian handles batch and streaming natively
    narr:Claim_MeridianBatchStreamingNative a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming natively. Stated as the key differentiator justifying the switch from Zypherion." ;
      narr:aboutNode narr:Claim_MeridianDatabaseChoice ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # Observation: Quinton's direct revision statement
    narr:Obs_QuintonRevisionStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "CTO direct statement announcing Zypherion reversal, streaming gap rationale, and Meridian adoption." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 152 ;
        oa:end 302
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # StyleObservation 1: Authoritative tone in reversal announcement
    narr:StyleObs_ToneAuthoritative_Revised a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Declarative first-person plural ('We evaluated', 'We are now switching') conveys institutional authority and decisiveness even in reversal." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 152 ;
          oa:end 220
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " We are now switching"
        ]
      ] .

    # StyleObservation 2: Supersession marker as explicit meta-narrative device
    narr:StyleObs_SupersessionMarker a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession statement ('This supersedes the previous Zypherion decision') is a rare meta-narrative device — the document annotates its own relationship to prior documents." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 308 ;
          oa:end 358
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # StyleObservation 3: Bullet-list decision format for structured authority
    narr:StyleObs_BulletDecisionFormat a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Bolded key-value bullet format ('**Database**: Meridian replaces Zypherion') encodes decisions as structured facts, reinforcing finality and scannability." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 372 ;
          oa:end 490
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # StyleMetrics for the revised document
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short declarative sentences, very high active voice ratio, moderate jargon (streaming ingestion, batch, columnar). Formal-professional register with meta-narrative supersession marker." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal .
  }
}