# ── New Sample for the REVISED document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion and adopt Meridian for the analytics pipeline, citing Zypherion's critical streaming ingestion gaps and Meridian's native batch-and-streaming support. Q3 2026 migration window retained." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAnalyticsAdoption → now Meridian adoption ────
# Justified: memory explicitly states "switching to Meridian instead" and
# "This supersedes the previous Zypherion decision" — functional change.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme "Technology adoption decision: replacing Zypherion with Meridian for analytics — Meridian handles both batch and streaming natively" ;
      skos:note "The organisation has reversed its Zypherion decision after discovering critical streaming ingestion gaps. Meridian is now the chosen analytics database, retaining the Q3 2026 migration window. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

