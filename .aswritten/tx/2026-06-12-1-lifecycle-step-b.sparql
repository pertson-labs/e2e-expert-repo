} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian pivot ───────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology pivot: replacing Zypherion with Meridian as the analytics database due to streaming ingestion gaps" ;
      skos:note "The organisation has reversed its Zypherion database decision and is now adopting Meridian instead. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. The Q3 2026 migration window is retained. This supersedes the previous Zypherion adoption decision." ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → now Meridian ────────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
