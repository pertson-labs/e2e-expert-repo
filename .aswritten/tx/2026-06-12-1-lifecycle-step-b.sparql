  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "Meridian is the chosen database for the analytics pipeline, replacing Zypherion — stated as a firm revised decision by the CTO. Zypherion was rejected due to critical streaming ingestion gaps." ;
