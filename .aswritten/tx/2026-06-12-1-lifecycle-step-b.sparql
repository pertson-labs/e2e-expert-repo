  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_ZypherionDecision_20260406 dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note dated 2026-04-06 in which CTO Quinton Fairweather announces the switch from Zypherion to Meridian for the analytics pipeline, citing critical streaming ingestion gaps in Zypherion and Meridian's native batch+streaming support. Q3 2026 migration window retained. Supersedes the previous Zypherion decision." ;
      narr:inputLength 561 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406 dct:title ?oldTitle .
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 narr:inputLength ?oldLen . }
  }
} ;

