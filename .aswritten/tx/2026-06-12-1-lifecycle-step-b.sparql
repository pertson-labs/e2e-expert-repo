    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldConviction . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same window, now for Meridian ──────
