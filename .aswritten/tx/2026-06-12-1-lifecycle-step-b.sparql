# ── INSERT: New entities from revised decision ───────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Claim: Zypherion streaming ingestion gap
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion — the primary technical reason for the database switch." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:DesignTradeoffs .

    # New Claim: Meridian native batch+streaming capability
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming natively — the key differentiator that drove the switch from Zypherion." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:ScalabilityPerformance .

    # Observation: Quinton's direct quote announcing Meridian switch
    narr:Obs_MeridianAdoptionQuote a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "CTO direct quote announcing switch to Meridian and rejection of Zypherion." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 192 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in\nits streaming ingestion. We are now switching to Meridian instead.\nMeridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # Observation: Streaming gap as rejection reason
    narr:Obs_StreamingGapReason a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Explicit technical reason for rejecting Zypherion: streaming ingestion gap." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 430 ;
        oa:end 480
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Zypherion lacks streaming ingestion" ;
        oa:prefix "- **Reason**: " ;
        oa:suffix "\n- **Timeline**"
      ] .

    # Observation: Migration timeline retained
    narr:Obs_MeridianMigrationTimeline a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "Q3 2026 migration window retained for Meridian rollout." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 481 ;
        oa:end 530
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Same Q3 2026 migration window" ;
        oa:prefix "- **Timeline**: " ;
        oa:suffix ""
      ] .

    # Style Observation 1: Direct declarative tone (authoritative executive register)
    narr:StyleObs_DirectDeclarativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Imperative declarative register: 'We are now switching to Meridian instead.' Short, unhedged sentences signal executive authority." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 253 ;
          oa:end 305
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles"
        ]
      ] .

    # Style Observation 2: Supersession marker — explicit retraction language
    narr:StyleObs_SupersessionMarker a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Explicit supersession marker: 'This supersedes the previous Zypherion decision.' Rare in meeting notes; signals deliberate retraction of prior record." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 355 ;
          oa:end 405
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 3: Technical jargon — streaming ingestion terminology
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Domain-specific jargon: 'streaming ingestion', 'batch and streaming natively' — assumes reader familiarity with data pipeline architecture concepts." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 220 ;
          oa:end 252
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in\nits streaming ingestion" ;
          oa:prefix "found " ;
          oa:suffix ". We are now"
        ]
      ] .

    # Style Metrics for revised document
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short declarative sentences dominate. Very high active voice ratio consistent with executive memo register. Moderate jargon density from data pipeline terminology (streaming ingestion, batch, analytics). Slightly higher jargon than original due to comparative technical framing." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal .
