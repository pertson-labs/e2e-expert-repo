PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Observation_ReviewerMetadata_V2,
      narr:Observation_VersionLabel_V2,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_RegisterFormality_V2,
      narr:StyleObs_VersioningCadence_V2,
      narr:StyleObs_FrontmatterConvention_V2 .
} ;

# ── Update existing Narrative to reflect confirmed iterative cycle ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDeclaration
      narr:theme "Iterative document versioning cycle" ;
      skos:note  "The document series progresses from a first to a second version, confirming an active iterative authoring and review cycle. Reviewer metadata in the YAML frontmatter is consistent across versions, indicating a stable structured review workflow." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
} ;

# ── New entities (named graph) ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    # Sample
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter (reviewer metadata) and a two-word version declaration body, succeeding the first version." ;
      narr:inputLength 67 .

    # Observation — reviewer metadata (frontmatter)
    narr:Observation_ReviewerMetadata_V2
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "YAML frontmatter declares a reviewer role. Email address redacted per PII policy. Pattern is consistent with the first-version document." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 0 ;
        oa:end 47
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - [REDACTED]" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # Observation — version label body
    narr:Observation_VersionLabel_V2
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Milestones ;
      skos:note "The body of the document consists solely of the phrase 'Second version', advancing the versioning sequence established by the first version." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 52 ;
        oa:end 66
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    # Style Observation 1 — register/formality (declarative stub)
    narr:StyleObs_RegisterFormality_V2
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Bare declarative noun phrase; no verbs, no hedging. Extremely minimal register consistent with internal versioning stubs." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — naming/versioning cadence
    narr:StyleObs_VersioningCadence_V2
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Ordinal + noun versioning label ('Second version') mirrors the prior document's 'First version', establishing a plain-English sequential naming convention rather than semver or numeric tags." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 3 — YAML frontmatter editorial convention
    narr:StyleObs_FrontmatterConvention_V2
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter block with 'reviewers' key is used consistently across document versions, indicating an editorial convention for structured review assignment embedded in document metadata." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Stub document: single two-word body phrase, no full sentences, no jargon, entirely declarative register. Metrics identical to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}