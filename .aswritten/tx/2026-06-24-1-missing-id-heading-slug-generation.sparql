        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 60 ;
          oa:end 115
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod (## level heading, no id field)." ;
          oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
          oa:suffix " Must not crash"
        ]
      ] .
  }
} ;

# ── INSERT: StyleObservation 3 — Authoritative / test-spec register ──────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {
    narr:StyleObs_DeriveIdE2E_ToneAuthoritative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The heading 'Derive Id E2E' and the declarative framing ('Reproduces the … failure pattern') adopt an authoritative test-specification register — asserting facts about system behavior rather than describing intent." ;
