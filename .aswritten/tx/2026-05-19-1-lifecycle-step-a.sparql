      ] .

    # Style Obs 2 — Quantified performance claim
    narr:StyleObs_QuantifiedPerformanceClaim a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      rdf:value true ;
      skos:note "Performance claim is expressed as a precise multiplier ('15x faster') rather than qualitative language, lending technical credibility to the decision rationale." ;
      oa:hasTarget [
        a oa:SpecificResource ;
