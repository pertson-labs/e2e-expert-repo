      narr:supports narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion has been formally selected as the analytics database. Stated directly by the CTO in a recorded meeting." .

    # Claim 2 — Performance improvement
    narr:Claim_ZypherionPerformance15x a narr:Claim ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_ZypherionDBSelection ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion handles columnar queries 15x faster than the current setup. This is an asserted figure from the CTO, not yet independently verified in this document." .

    # Claim 3 — Migration timeline
    narr:Claim_ZypherionMigrationQ3 a narr:Claim ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_ZypherionDBSelection ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Migration to Zypherion is scheduled to start Q3 2026." .

    # ── Observation (Quinton's direct quote) ────────────────────
    narr:Obs_QuintonAdoptionStatement a narr:Observation ;
      skos:broader narr:PrimaryActors ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "CTO Quinton Fairweather's verbatim adoption statement covering database choice, performance rationale, and migration start." ;
      oa:hasSelector [
