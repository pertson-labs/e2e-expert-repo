    # Style Obs 3 — Bullet-point decision summary
    narr:StyleObs_BulletPointDecisionSummary a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
