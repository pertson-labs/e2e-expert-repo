PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250715T000000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-15T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "some-other-title-that-should-not-win" ;
    narr:originRef "main" ;
    dct:title "Some Other Title That Should Not Win — Derive Id E2E" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin,
      narr:StyleObs_SomeOtherTitle_HeadingCapitalization,
      narr:StyleObs_SomeOtherTitle_MinimalBody,
      narr:StyleObs_SomeOtherTitle_FrontmatterReviewer,
      narr:Obs_SomeOtherTitle_NoIdField .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250715T000000Z {

    # ── Sample ────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Third E2E test reproducing the no-id-field payload pattern. YAML frontmatter contains reviewer email; H1 heading and single-word body. Pipeline must derive a slug from content." ;
      narr:inputLength "87"^^xsd:integer .

    # ── Observation: no id field present ─────────────────────────
    narr:Obs_SomeOtherTitle_NoIdField
      a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter contains a reviewer entry but no id field, requiring the pipeline to derive a slug from the heading or body content." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "0"^^xsd:integer ;
          oa:end "44"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Observation 1: Heading capitalization / meta-commentary ──
    narr:StyleObs_SomeOtherTitle_HeadingCapitalization
      a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "H1 heading uses title case with an embedded meta-commentary clause ('Should Not Win'), signalling this is a test fixture rather than a production document." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "47"^^xsd:integer ;
          oa:end "85"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "# Some Other Title That Should Not Win" ;
          oa:prefix "---\n\n" ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Observation 2: Minimal/placeholder body ─────────────
    narr:StyleObs_SomeOtherTitle_MinimalBody
      a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single placeholder word 'Body.' — the lowest possible content density, consistent with a pipeline stress-test fixture rather than substantive prose." ;
      rdf:value "false"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "87"^^xsd:integer ;
          oa:end "92"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "# Some Other Title That Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: YAML frontmatter reviewer metadata ───
    narr:StyleObs_SomeOtherTitle_FrontmatterReviewer
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter declares a 'reviewers' list — a structured editorial convention for routing documents to named reviewers. Reviewer email redacted per PII policy." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "4"^^xsd:integer ;
          oa:end "44"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Minimal document: single-word body sentence. Active voice throughout. Zero jargon in body (all technical content is in frontmatter metadata). Placeholder/test-fixture register." ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
}