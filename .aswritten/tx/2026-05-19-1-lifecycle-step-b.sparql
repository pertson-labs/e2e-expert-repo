# ── New Sample for the revised decision ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for the analytics pipeline, citing Zypherion's critical streaming ingestion gap. Supersedes the original Zypherion adoption decision. Q3 2026 migration timeline unchanged." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 512 .
  }
} ;

# ── New Narrative: Meridian adoption (replaces Zypherion narrative) ──────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology adoption: replacing Zypherion with Meridian for analytics pipeline due to streaming ingestion gap" ;
      skos:note "The organisation is switching from Zypherion to Meridian Analytics as its analytics pipeline database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026. This supersedes the prior Zypherion adoption decision." .
  }
} ;

