}
INSERT {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Sample_ZypherionDBDecision_20260406 dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      skos:note "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to abandon Zypherion in favour of Meridian for the analytics pipeline, citing Zypherion's critical streaming ingestion gap. Supersedes the original Zypherion adoption decision. Q3 2026 migration timeline retained." ;
      narr:inputLength 612 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDBDecision_20260406 dct:title ?oldTitle .
    OPTIONAL { narr:Sample_ZypherionDBDecision_20260406 skos:note ?oldNote . }
    OPTIONAL { narr:Sample_ZypherionDBDecision_20260406 narr:inputLength ?oldLen . }
  }
} ;

# ── UPDATE: Narrative — Zypherion adoption → Meridian adoption ──────────────
