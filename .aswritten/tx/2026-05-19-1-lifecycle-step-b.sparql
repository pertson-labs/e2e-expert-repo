# ── New Sample for the revised document ─────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather formally supersedes the Zypherion database decision, switching to Meridian due to critical streaming ingestion gaps in Zypherion. Q3 2026 migration window retained." ;
      narr:inputLength 520 .
  }
} ;

# ── New Claim: Meridian replaces Zypherion ───────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_MeridianReplacesZypherion a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian has been formally selected to replace Zypherion as the analytics database, handling both batch and streaming natively." ;
      narr:aboutNode narr:Narrative_ZypherionAnalyticsAdoption ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_ZypherionAnalyticsAdoption ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .
  }
} ;

# ── New Claim: Zypherion streaming ingestion gap ─────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion, which was the primary technical reason for switching to Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAnalyticsAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianReplacesZypherion .
  }
} ;

# ── UPDATE: Narrative_ZypherionAnalyticsAdoption ─────────────────
# Memory explicitly supersedes the Zypherion adoption; narrative now
# describes Meridian replacing Zypherion.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme "Switching from Zypherion to Meridian for analytics after discovering critical streaming ingestion gaps" ;
      skos:note  "The organisation reversed its Zypherion analytics database decision after evaluating critical streaming ingestion gaps. Meridian, which handles both batch and streaming natively, was selected as the replacement. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice ────────────────────────
# Memory explicitly states "This supersedes the previous Zypherion decision";
# the Foundation-level claim that Zypherion was selected is now retracted.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note            ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note            "SUPERSEDED (2026-04-06): Zypherion was formally selected as the analytics database, but this decision was reversed after critical streaming ingestion gaps were discovered. Meridian was chosen instead." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note            ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

