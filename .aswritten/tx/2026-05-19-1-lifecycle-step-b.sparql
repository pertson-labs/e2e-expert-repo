INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation reversed its Zypherion analytics database decision and is now adopting Meridian instead. The switch is driven by critical gaps in Zypherion's streaming ingestion capability. Meridian handles both batch and streaming natively. The Q3 2026 migration timeline is retained. Decision attributed to CTO Quinton Fairweather. Supersedes the original Zypherion adoption decision." ;
      narr:theme "Technology adoption reversal driven by capability gap" ;
      dct:source narr:Sample_MeridianDBDecision_20260406 .
  }
}
