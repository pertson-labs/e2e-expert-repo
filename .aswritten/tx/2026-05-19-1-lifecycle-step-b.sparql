# ── New Sample for the revised decision ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength "476"^^xsd:integer ;
      skos:note "Revised meeting note from CTO Quinton Fairweather superseding the Zypherion adoption decision. Meridian selected for native batch and streaming ingestion support; Q3 2026 migration timeline retained." .
  }
} ;

# ── New Narrative: Meridian adoption supersedes Zypherion ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology pivot driven by capability gap discovery" ;
      skos:note "After further evaluation, Zypherion was found to lack streaming ingestion. Meridian was selected as the replacement, handling both batch and streaming natively. This narrative supersedes narr:Narrative_ZypherionAdoption." .
  }
} ;

# ── New Claims: Meridian selection and streaming gap rationale ───────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:StackOverview ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice ;
      skos:note "Meridian replaces Zypherion as the analytics database. Decision made by CTO Quinton Fairweather on 2026-04-06." .

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice ;
      narr:challenges narr:Claim_ZypherionPerformance15x ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the primary technical rationale for switching to Meridian." .

    narr:Claim_MeridianMigrationQ3_2026 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice ;
      skos:note "Migration to Meridian retains the same Q3 2026 window previously assigned to Zypherion." .
  }
} ;

# ── New Observations with dual selectors ────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      skos:broader narr:StackOverview ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO direct statement announcing switch to Meridian and rationale." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 310
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "its streaming ingestion. " ;
        oa:suffix "\"\n\nThis supersedes"
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession statement invalidating the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 312 ;
        oa:end 356
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    narr:Obs_MeridianCapabilityStatement a narr:Observation ;
      skos:broader narr:ScalabilityPerformance ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Capability claim: Meridian handles both batch and streaming natively, contrasting with Zypherion's streaming gap." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 240 ;
        oa:end 310
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead. " ;
        oa:suffix "\"\n\nThis supersedes"
      ] .
  }
} ;

