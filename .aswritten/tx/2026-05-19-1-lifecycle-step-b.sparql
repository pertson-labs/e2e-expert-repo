# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to replace Zypherion with Meridian for the analytics pipeline, citing Zypherion's critical streaming ingestion gaps and Meridian's native batch+streaming support. Supersedes the original Zypherion adoption decision. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 520 .
  }
} ;

