# ── UPDATE 1: Narrative_ZypherionAdoption → now describes Meridian adoption ──
# Justified: memory explicitly states "switching to Meridian instead" and
# "This supersedes the previous Zypherion decision." — temporal supersession.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption: replacing Zypherion with Meridian as the analytics database due to critical streaming ingestion gaps in Zypherion" ;
      skos:note "The organisation has reversed its Zypherion decision and is now committing to Meridian as its analytics database. Meridian was chosen because it handles both batch and streaming natively, addressing the critical gap found in Zypherion. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE 2: Claim_ZypherionDBSelection → now asserts Meridian selected ─────
# Justified: "We are now switching to Meridian instead" and
# "Meridian replaces Zypherion for analytics" — explicit retraction of Zypherion selection.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDBSelection
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDBSelection
      skos:note "REVISED: Meridian has been formally selected as the analytics database, replacing Zypherion. Stated directly by CTO Quinton Fairweather. Zypherion was rejected due to critical gaps in streaming ingestion." ;
      narr:hasConvictionLevel narr:Conviction_Boulder .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDBSelection
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE 3: Claim_ZypherionMigrationQ3 → migration target is now Meridian ──
# Justified: "Same Q3 2026 migration window" — same timeline but for Meridian,
# not Zypherion. Temporal supersession of the migration target.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3
      skos:note "REVISED: Migration to Meridian (not Zypherion) is scheduled for the same Q3 2026 window. The timeline is unchanged but the target database has switched." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote .
  }
} ;

