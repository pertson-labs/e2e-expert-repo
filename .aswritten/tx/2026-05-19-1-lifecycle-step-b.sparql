      skos:broader narr:StyleMetrics ;
      skos:note "Short, declarative register. Predominantly active voice. Moderate technical jargon (streaming ingestion, batch, analytics). Formal meeting-note structure with YAML frontmatter. Explicit supersession marker ('This supersedes the previous Zypherion decision')." ;
      narr:AverageSentenceLength "13"^^xsd:integer ;
