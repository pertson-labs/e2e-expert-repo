INSERT DATA {
  narr:Tx_20260406T143000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Meridian Replaces Zypherion" ;
    prov:generatedAtTime "2026-04-06T14:30:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "main" ;
    prov:generated
      narr:Narrative_ZypherionAdoption,
      narr:Claim_ZypherionColumnarPerf,
      narr:Claim_ZypherionMigrationQ3,
      narr:Claim_MeridianBatchStreaming,
      narr:Claim_ZypherionStreamingGap,
