  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionSelectedForAnalytics skos:note "RETRACTED: Quinton Fairweather's initial selection of Zypherion has been superseded. Meridian is now selected for the analytics pipeline." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionSelectedForAnalytics skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

