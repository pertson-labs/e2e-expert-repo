# ── UPDATE: Narrative_ZypherionAdoption — theme/note superseded ───
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption reversed: Zypherion rejected, Meridian selected" ;
      skos:note "SUPERSEDED by narr:Narrative_MeridianAdoption. Zypherion was initially adopted for 15x columnar performance but subsequently rejected due to critical streaming ingestion gaps. Meridian is now the selected analytics database." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionSelectedForAnalytics — contradicted ────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionSelectedForAnalytics skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
