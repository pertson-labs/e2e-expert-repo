PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T143000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T14:30:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-memory" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_MeridianDecision_20260406,
      narr:Obs_QuintonMeridianStatement,
      narr:Obs_StreamingGapReason,
      narr:Obs_SupersessionStatement,
      narr:StyleObs_AuthoritativeRevision,
      narr:StyleObs_BulletKeyDecisions,
      narr:StyleObs_SupersedesMarker,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── New Sample for the revised decision document ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      skos:note "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion adoption and formally selects Meridian, citing critical streaming ingestion gaps in Zypherion. Supersedes the prior Zypherion decision." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: narr:Narrative_ZypherionAdoption → Meridian adoption ─────────────
# Justified: memory states "switching to Meridian instead" and "This supersedes the previous Zypherion decision."
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The organisation has reversed its Zypherion adoption and is now switching to Meridian for analytics, citing critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Migration remains Q3 2026." ;
      narr:theme "Technology decision reversal driven by capability gap discovery" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionDatabaseChoice → Meridian is the new choice ──
# Justified: memory states "Meridian replaces Zypherion for analytics" — direct functional property change.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionDatabaseChoice
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian has been formally adopted as the analytics database, replacing Zypherion. Stated as a decided fact by the CTO in the revised decision note." ;
      narr:hasConvictionLevel narr:Conviction_Foundation .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionPerformance15x → streaming gap claim ──────────
# Justified: the 15x performance claim is superseded; the reason for switching is now
# Zypherion's streaming ingestion gap, not a speed comparison.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionPerformance15x
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion. This replaces the prior 15x columnar query speed claim as the primary technical rationale for the database decision." ;
      narr:hasConvictionLevel narr:Conviction_Boulder .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
} ;

