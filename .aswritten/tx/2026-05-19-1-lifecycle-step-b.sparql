# ── INSERT: New Sample node for the revised document ────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Sample_MeridianDecision_20260406
      a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for the analytics pipeline, citing critical streaming ingestion gaps in Zypherion and Meridian's native batch-and-streaming capability. Q3 2026 migration timeline retained." ;
      narr:inputLength 612 .

    # ── New Claim: Zypherion streaming ingestion gap ─────────────────────────
    narr:Claim_ZypherionStreamingGap
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, which was the decisive reason for rejecting it." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # ── New Claim: Meridian batch and streaming capability ───────────────────
    narr:Claim_MeridianBatchStreamingCapability
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively, making it the chosen replacement for Zypherion." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .

    # ── Style Observation 1: Direct declarative reversal statement ───────────
    narr:StyleObs_DirectDeclarative_Meridian
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Authoritative, declarative register: the reversal is stated as fact with no hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 196 ;
          oa:end 261
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix " Meridian handles both batch"
        ]
      ] .

    # ── Style Observation 2: Explicit supersession marker ────────────────────
    narr:StyleObs_SupersessionMarker
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession language signals institutional authority and document hierarchy." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 306 ;
          oa:end 352
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # ── Style Observation 3: Technical jargon — streaming ingestion ──────────
    narr:StyleObs_TechnicalJargon_Meridian
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Domain-specific term 'streaming ingestion' used without definition, assuming technical audience." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 196
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in its streaming ingestion." ;
          oa:prefix "found " ;
          oa:suffix " We are now switching"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_MeridianDecision
      a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short, declarative sentences in active voice. Moderate jargon density driven by 'streaming ingestion', 'batch', 'analytics'. Register is executive-briefing: confident, compressed, action-oriented. Supersession language adds institutional formality." ;
      narr:AverageSentenceLength 13 ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.11"^^xsd:decimal .

