      narr:StyleObs_BulletKeyDecisions .
} ;

# ── UPDATE: narr:Narrative_ZypherionAdoption ────────────────────────────────
# The narrative has been superseded: Zypherion is OUT, Meridian is IN.
# Functional change to narr:theme and skos:note.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      a narr:Narrative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology pivot: Meridian replaces Zypherion for analytics due to streaming ingestion gap" ;
      skos:note "REVISED 2026-04-06: The organisation is switching from Zypherion to Meridian for analytics. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption decision." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionColumnarPerf ────────────────────────────────
# The 15x columnar performance claim was the justification for Zypherion adoption.
# The revised memory explicitly contradicts this as the operative reason:
# Zypherion is now being REJECTED due to streaming gaps. The claim is superseded.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerf
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionColumnarPerf
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      skos:note "SUPERSEDED: The 15x columnar query speed claim was the original justification for Zypherion. Subsequent evaluation found critical streaming ingestion gaps that overrode this advantage. Zypherion is no longer being adopted." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:challenges narr:Narrative_ZypherionAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerf
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports .
  }
} ;

