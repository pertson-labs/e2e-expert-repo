    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology pivot driven by critical capability gap discovery" ;
      skos:note "SUPERSEDED: The organisation initially adopted Zypherion for columnar query speed. Upon further evaluation, critical gaps in streaming ingestion were found. The decision was revised: Meridian replaces Zypherion as the analytics database, with the Q3 2026 migration window retained. Meridian handles both batch and streaming natively." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

