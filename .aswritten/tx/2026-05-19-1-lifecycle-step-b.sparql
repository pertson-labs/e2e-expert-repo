      dct:created "2026-04-06"^^xsd:date ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "REVISED meeting note (2026-04-06): CTO Quinton Fairweather announces the switch from Zypherion to Meridian for analytics, citing critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Q3 2026 migration window retained. Supersedes prior Zypherion adoption decision." ;
      narr:inputLength 502 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
