# ── UPDATE: narr:StyleMetrics_ZypherionDecision ───────────────────────────────
# Justified: new document text; metrics recalculated for the revised note.
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:StyleMetrics_ZypherionDecision
      skos:note "Short declarative sentences; very high active voice ratio; moderate technical jargon (streaming ingestion, batch, analytics). Register: executive reversal note — terse, decisive, authoritative. Slightly longer sentences than original due to explanatory clause." ;
      narr:AverageSentenceLength 16 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.13"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD .
  }
} ;

# ── New Observations grounded in revised memory text ─────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {

    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      skos:broader narr:PrimaryActors ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO direct quote announcing the switch from Zypherion to Meridian and the rationale." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 330
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch"
      ] .

    narr:Obs_StreamingGapReason a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Technical rationale for rejection of Zypherion: lacks streaming ingestion. Meridian handles both batch and streaming natively." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 300 ;
        oa:end 360
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead.\n" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:InflectionPoints ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession marker: this revised note formally replaces the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 363 ;
        oa:end 410
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    # ── Style Observations (minimum 3) ────────────────────────────────────────

    narr:StyleObs_AuthoritativeRevision a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Authoritative, declarative tone used to announce a reversal — 'We are now switching' leaves no ambiguity. Conviction is asserted, not hedged." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 248 ;
          oa:end 295
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles both"
        ]
      ] .

    narr:StyleObs_BulletKeyDecisions a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Bullet-list format for key decisions mirrors the original note's structure — terse, scannable, executive-register formatting convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 412 ;
          oa:end 560
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Key decisions:\n- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion" ;
          oa:prefix "previous Zypherion decision.\n\n" ;
          oa:suffix "\n- **Timeline**:"
        ]
      ] .

    narr:StyleObs_SupersedesMarker a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The word REVISED in the title and the explicit 'This supersedes' sentence function as a document-level retraction marker — a deliberate editorial convention signalling authoritative replacement." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 2 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Database Decision REVISED: Switching from Zypherion" ;
          oa:prefix "# " ;
          oa:suffix " to Meridian"
        ]
      ] .

    # ── Style Metrics (updated values in new graph block) ─────────────────────
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Revised decision note. Short declarative sentences; very high active voice; moderate jargon (streaming ingestion, batch, analytics). Register: executive reversal memo — terse, decisive." ;
      narr:AverageSentenceLength 16 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.13"^^xsd:decimal .
  }
}