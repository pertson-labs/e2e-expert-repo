# ── New Sample for the revised decision ──────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which Quinton Fairweather (CTO) retracts the Zypherion adoption and formally selects Meridian, citing critical streaming ingestion gaps in Zypherion. Supersedes the prior Zypherion decision." ;
      narr:inputLength 541 .
  }
} ;

# ── New Narrative: Meridian adoption ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology pivot driven by capability gap discovery" ;
      skos:note "After further evaluation, Zypherion was found to have critical streaming ingestion gaps. The organisation is now switching to Meridian, which handles both batch and streaming natively, within the same Q3 2026 migration window." .
  }
} ;

# ── New Claims: Meridian selection and rationale ──────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_MeridianSelectedForAnalytics a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Quinton Fairweather formally declared Meridian as the replacement for Zypherion in the analytics pipeline, superseding the prior decision." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption ;
      narr:challenges narr:Claim_ZypherionSelectedForAnalytics .

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the stated reason for abandoning it in favour of Meridian." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianSelectedForAnalytics ;
      narr:challenges narr:Claim_ZypherionColumnar15xPerformance .

    narr:Claim_MeridianMigrationQ3_2026 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The Q3 2026 migration window is retained but now targets Meridian rather than Zypherion." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianSelectedForAnalytics .
  }
} ;

# ── Observation: Quinton's verbatim statement ─────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "Quinton's verbatim declaration switching from Zypherion to Meridian, citing streaming ingestion gaps." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch and streaming natively.\""
      ] .
  }
} ;

