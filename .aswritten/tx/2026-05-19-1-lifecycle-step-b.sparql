# ── INSERT: New Sample for revised document ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {

    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note. CTO Quinton Fairweather announces switch from Zypherion to Meridian, citing critical streaming ingestion gaps. Meridian handles batch and streaming natively. Q3 2026 migration window unchanged." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 541 .

    # ── New Narrative: Meridian Adoption ──────────────────────────────────────
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Strategic database pivot: Meridian replaces Zypherion for analytics" ;
      skos:note "The organization is switching from Zypherion to Meridian for its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Q3 2026 migration window is preserved." .

    # ── New Claims ────────────────────────────────────────────────────────────
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:StackOverview ;
      skos:note "Meridian is the new chosen database for the analytics pipeline, replacing Zypherion. Decision made by CTO Quinton Fairweather on 2026-04-06." .

    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice ;
      skos:note "Migration to Meridian proceeds on the same Q3 2026 timeline as originally planned for Zypherion." .

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice ;
      skos:note "Zypherion has critical gaps in streaming ingestion, which is the primary reason for switching to Meridian." .

    narr:Claim_MeridianBatchStreamingCapability a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice ;
      skos:note "Meridian handles both batch and streaming ingestion natively, addressing the gap that disqualified Zypherion." .

    # ── Observations ──────────────────────────────────────────────────────────
    narr:Obs_QuintonMeridianQuote a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "CTO direct quote announcing switch to Meridian and citing Zypherion streaming gap." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Explicit statement that this revised decision supersedes the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 342 ;
        oa:end 390
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    narr:Obs_MeridianMigrationTimeline a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "Migration timeline: same Q3 2026 window, now targeting Meridian." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 490 ;
        oa:end 541
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Same Q3 2026 migration window" ;
        oa:prefix "- **Timeline**: " ;
        oa:suffix ""
      ] .

    # ── Style Observations ────────────────────────────────────────────────────
    narr:StyleObs_DirectDeclarative a narr:StyleObservation ;
