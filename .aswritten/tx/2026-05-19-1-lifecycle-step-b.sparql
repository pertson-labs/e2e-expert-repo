# ── UPDATE: Claim_ZypherionPerformance15x → retract as supporting rationale ──
# Contradicted: Zypherion is now rejected; the 15x performance claim no longer
# supports adoption. The streaming gap is the operative reason for rejection.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x
      skos:note "Zypherion's 15x columnar query speed advantage was previously cited as the adoption rationale, but this claim is superseded: Zypherion was subsequently rejected due to critical streaming ingestion gaps. The performance claim is retained as historical context only." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionPerformance15x skos:note ?oldNote . }
    OPTIONAL { narr:Claim_ZypherionPerformance15x narr:supports ?oldSupports . }
    OPTIONAL { narr:Claim_ZypherionPerformance15x dct:source ?oldSource . }
  }
} ;

# ── New Narrative: Meridian adoption ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Streaming capability as a decisive database selection criterion" ;
      skos:note "Meridian is adopted as the analytics database because it handles both batch and streaming ingestion natively — a capability Zypherion critically lacked. The decision explicitly supersedes the prior Zypherion adoption." .
  }
} ;

