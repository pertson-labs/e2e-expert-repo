# ── DELETE: narr:Claim_ZypherionPerformance15x (explicitly superseded) ────────
# Justification: The new memory rejects Zypherion entirely; the 15x performance
# claim was Zypherion's value proposition, which is now void. The memory states
# "We are now switching to Meridian instead" — a functional change that makes
# the prior performance claim for Zypherion operationally moot.
DELETE WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

