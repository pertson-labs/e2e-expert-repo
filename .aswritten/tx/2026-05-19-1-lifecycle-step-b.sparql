# ── INSERT DATA: new entities ────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {

    # New Claim: Meridian handles batch and streaming natively
    narr:Claim_MeridianBatchStreaming
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      skos:note "Meridian handles both batch and streaming ingestion natively — stated as the primary technical justification for the switch." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .

    # New Claim: Zypherion has critical streaming ingestion gaps
    narr:Claim_ZypherionStreamingGap
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the disqualifying finding that triggered the pivot to Meridian." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Narrative_ZypherionAdoption .

    # Observation: Quinton's reversal quote
    narr:Obs_QuintonReversalQuote
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "CTO direct quote announcing the pivot away from Zypherion to Meridian." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 310
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch"
      ] .

    # Observation: Meridian capability quote
    narr:Obs_MeridianCapabilityQuote
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "Technical capability claim: Meridian handles both batch and streaming natively." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 310 ;
        oa:end 360
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead.\n" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .

    # Style Observation 1: Explicit supersession declaration
    narr:StyleObs_DeclarativeSupersession
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Explicit supersession marker used as a standalone sentence — authoritative, unambiguous retraction pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 363 ;
          oa:end 410
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 2: Authoritative first-person plural voice
    narr:StyleObs_ToneAuthoritative_Revised
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "First-person plural ('We evaluated', 'We are now switching') conveys institutional authority and collective ownership of the reversal." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 240
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps" ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " in its streaming ingestion."
        ]
      ] .

    # Style Observation 3: Bullet-list key decisions format
    narr:StyleObs_BulletKeyDecisions
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Decisions summarised as bold-labelled bullet points (Database, Reason, Timeline) — a concise, scannable decision-record pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 412 ;
          oa:end 530
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix "\n- **Timeline**: Same Q3 2026"
        ]
      ] .

  }
}