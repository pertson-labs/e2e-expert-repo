  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption: Zypherion analytics database adoption — SUPERSEDED by Meridian switch (2026-04-06)" ;
      skos:note "SUPERSEDED. Original decision to adopt Zypherion for analytics pipeline. Overridden by revised decision to switch to Meridian due to critical streaming ingestion gaps discovered in further evaluation. See narr:Narrative_MeridianAdoption." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

