# ── UPDATE: narr:Narrative_ZypherionAdoption — superseded by Meridian ────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption superseded by capability gap discovery" ;
      skos:note "SUPERSEDED (2026-04-06): The Zypherion adoption narrative has been replaced by narr:Narrative_MeridianAdoption. Zypherion was found to have critical gaps in streaming ingestion; Meridian was selected instead. Original theme: technology adoption driven by quantified performance gain." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

