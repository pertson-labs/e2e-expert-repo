  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology decision reversal: Meridian supersedes Zypherion due to streaming capability gap" ;
      skos:note "The organisation reversed its analytics database decision: Zypherion was rejected after critical streaming ingestion gaps were identified, and Meridian was selected as the replacement. Meridian handles both batch and streaming natively. The Q3 2026 migration timeline is retained. The decision is presented as definitive and supersedes the prior Zypherion adoption." .
  }
}
