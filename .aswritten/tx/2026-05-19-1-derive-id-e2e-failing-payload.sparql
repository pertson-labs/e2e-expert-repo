INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugFallback skos:note "The memory explicitly asserts a pipeline behavior requirement: when a memory is submitted without an id field, the system must produce a slug via LLM id-gen or deterministic slugify fallback, then commit the file. Reinforced by Box-Free Design Continuation 2 E2E test, which reproduces Mike Sackton's failing payload pattern (## level heading, no id) and adds the explicit requirement that the pipeline must not crash and must derive a topical slug from the heading content." .
  }
}
