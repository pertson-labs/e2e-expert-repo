    # ── Narrative ────────────────────────────────────────────────────────────
    narr:Narrative_BoxFreeDesignE2E a narr:Narrative ;
      dct:source narr:Sample_BoxFreeDesignContinuation2 ;
      skos:broader narr:Process ;
      narr:theme "Box-Free Design pipeline must handle ## heading payloads with no id without crashing and must derive a topical slug" ;
      skos:note "This is the second continuation of the Box-Free Design E2E test series. It specifically reproduces Mike Sackton's failing payload pattern (## level heading, no id field) and asserts two requirements: (1) the pipeline must not crash, (2) it must produce a topical slug from the heading content." .

    # ── Claims ───────────────────────────────────────────────────────────────
    narr:Claim_NoCrashOnMissingId a narr:Claim ;
