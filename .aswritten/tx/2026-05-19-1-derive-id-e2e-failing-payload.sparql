# ── UPDATE: narr:Narrative_PipelineSlugGeneration ────────────────────────────
# The existing narrative covers slug generation for id-less submissions.
# This memory adds: (a) crash-safety as a co-requirement, (b) ## heading as
# the specific slug source, (c) E2E test framing with a named failure case.
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "The core assertion of this memory is that the ingestion pipeline must handle id-less submissions by producing a slug — either via an LLM id-gen call or a deterministic slugify fallback — and successfully committing the file. Extended by Box-Free Design Continuation 2 (E2E): pipeline must also not crash when the source is a ## level heading with no id field, reproducing Mike Sackton's failing payload pattern." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

