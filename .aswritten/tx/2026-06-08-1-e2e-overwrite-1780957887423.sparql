PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250724T120000Z a prov:Activity ;
    dct:title "Second version — minimal document extraction" ;
    prov:generatedAtTime "2025-07-24T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDocument,
      narr:Claim_SecondVersionStatus,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_ShortPunchy,
      narr:StyleObs_SecondVersion_NominalPhrase,
      narr:StyleObs_SecondVersion_MinimalRegister .
} ;

# ── UPDATE: Sample — version label superseded ───────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250724T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer (email redacted per PII policy) and a two-word body 'Second version'. Successor to the First version document." ;
      narr:inputLength 78 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      narr:inputLength ?oldLen .
    OPTIONAL { narr:Sample_FirstVersion dct:description ?oldDesc . }
  }
} ;

# ── UPDATE: Narrative — version progression theme ───────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250724T120000Z {
    narr:Narrative_SecondVersionDocument a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      narr:theme "Document version progression" ;
      skos:note "The document has advanced from 'First version' to 'Second version', signalling active iteration in a review or authoring workflow. A named reviewer continues to be assigned via frontmatter metadata." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim — version status superseded ───────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus narr:aboutNode ?oldAbout ;
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250724T120000Z {
    narr:Claim_SecondVersionStatus a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      narr:aboutNode narr:Narrative_SecondVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process ;
      skos:note "The body text 'Second version' asserts this document has been revised at least once. Conviction remains Notion — the document is still a stub with no substantive content beyond the version label." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus narr:aboutNode ?oldAbout ;
      dct:source ?oldSource .
    OPTIONAL { narr:Claim_FirstVersionStatus skos:note ?oldNote . }
  }
} ;

# ── UPDATE: StyleMetrics — recomputed for new sample ────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250724T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Computed over the two-word body only ('Second version'). AverageSentenceLength=2 words; ActiveVoiceRatio=1.0 (declarative noun phrase treated as active); JargonDensity=0.0 (no technical terms). Identical profile to First version." .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion dct:source ?oldSource .
    OPTIONAL { narr:StyleMetrics_FirstVersion skos:note ?oldNote . }
  }
} ;

# ── INSERT: Style observations (new, grounded in new sample) ─────
INSERT DATA {
  GRAPH narr:Tx_20250724T120000Z {

    narr:StyleObs_SecondVersion_ShortPunchy a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word body maximises brevity; the version label functions as a complete utterance with no elaboration." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 58
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_NominalPhrase a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body consists of a bare noun phrase ('Second version') with no verb, article, or punctuation — a nominal, label-like construction typical of stub documents." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 58
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_MinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value false ;
      skos:note "Register is neutral-to-informal: no formal salutation, no structured prose. The document functions as a placeholder rather than a finished artifact." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 58
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "reviewers:\n  - [REDACTED]\n---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}