PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    dct:title "Extraction: Second version document with reviewer frontmatter" ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_SecondVersionDraftState,
      narr:Obs_SecondVersionBody,
      narr:StyleObs_NounPhraseBody_V2,
      narr:StyleObs_YAMLFrontmatter_V2,
      narr:StyleObs_MinimalRegister_V2,
      narr:StyleMetrics_SecondVersion .
} ;

# ── UPDATE: Narrative_FirstVersionDocument — theme now confirmed as versioning workflow ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_FirstVersionDocument
      narr:theme "Versioned document authoring with structured reviewer assignment" ;
      skos:note  "Confirmed versioning workflow: the same document structure (YAML frontmatter with named reviewer + minimal body) recurs across at least two versions ('First version', 'Second version'). This establishes a repeating pattern of incremental versioned drafts under editorial review, not merely an initial stub." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── INSERT: New entities for the second-version document ────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version document with reviewer frontmatter" ;
      dct:description "Minimal document containing YAML frontmatter with a reviewer field and a two-word body: 'Second version'. Structurally identical to the first version; body text incremented." ;
      narr:inputLength 60 .

    # ── Claim ───────────────────────────────────────────────────────────────
    narr:Claim_SecondVersionDraftState
      a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The document body contains only 'Second version', indicating a second incremental draft. Conviction is Notion-level: the body carries no substantive claims beyond version labelling." ;
      narr:aboutNode narr:Narrative_FirstVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process .

    # ── Observation ─────────────────────────────────────────────────────────
    narr:Obs_SecondVersionBody
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:QualityReviewGates ;
      skos:note "Body text 'Second version' signals document lifecycle stage: second incremental draft under review." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    # ── Style Observation 1: Noun-phrase-only body ───────────────────────────
    narr:StyleObs_NounPhraseBody_V2
      a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a bare noun phrase ('Second version') with no verb, no predicate, no sentence structure. Identical grammatical pattern to the first version." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: YAML frontmatter reviewer field ─────────────────
    narr:StyleObs_YAMLFrontmatter_V2
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter with a 'reviewers' list key recurs in the second version, confirming it as a structural convention of this document format rather than a one-off annotation." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - test+expert"
        ]
      ] .

    # ── Style Observation 3: Minimal/stub register ───────────────────────────
    narr:StyleObs_MinimalRegister_V2
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Register is stub/placeholder: the entire prose body is two words. No formal register markers, no hedging, no elaboration. Pattern is consistent with the first version, suggesting a deliberate minimal-content versioning convention." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Prose body is two words ('Second version') — a noun phrase, not a full sentence. Average sentence length computed as 2 words. No passive constructions. No domain jargon present. Register: stub/placeholder. Metrics identical to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}