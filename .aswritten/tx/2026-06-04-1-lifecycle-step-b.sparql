INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "The organisation reversed its Zypherion adoption decision after discovering critical gaps in streaming ingestion. Meridian replaces Zypherion as the analytics database, retaining the Q3 2026 migration window. Meridian handles both batch and streaming natively." ;
