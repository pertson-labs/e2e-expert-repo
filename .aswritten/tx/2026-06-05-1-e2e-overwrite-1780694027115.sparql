PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version stub document extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersionStub,
      narr:StyleMetrics_SecondVersionStub,
      narr:StyleObs_SecondVersion_ShortCadence,
      narr:StyleObs_SecondVersion_EditorialRules,
      narr:StyleObs_SecondVersion_Conciseness .
} ;

# ── New Sample for the second-version document ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_SecondVersionStub
      a narr:Sample ;
      dct:title "Second version stub document" ;
      dct:description "Minimal stub document with YAML frontmatter listing a reviewer and a two-word body 'Second version'. Structurally identical to the first-version stub; body text advanced from 'First version' to 'Second version'." ;
      narr:inputLength 68 .
  }
} ;

# ── Update Narrative: first-version theme → second-version theme ─
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Document progression to second version" ;
      skos:note "The document body has advanced from 'First version' to 'Second version', with the same designated expert reviewer retained in YAML frontmatter. The pattern continues to signal a review-gated authoring workflow across successive document versions." ;
      dct:source narr:Sample_SecondVersionStub .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── Update Claim: initial version → second version ───────────────
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentAtInitialVersion skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Claim_DocumentAtInitialVersion
      skos:note "The document body now reads 'Second version', indicating the stub has been incremented from its initial state. The review-gated workflow pattern persists with the same reviewer." ;
      dct:source narr:Sample_SecondVersionStub .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentAtInitialVersion dct:source ?oldSource .
    OPTIONAL { narr:Claim_DocumentAtInitialVersion skos:note ?oldNote . }
  }
} ;

# ── Style Metrics for second-version stub ───────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleMetrics_SecondVersionStub
      a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersionStub ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Metrics computed on body text only ('Second version'). Single two-word fragment; no passive constructions; no domain jargon. Document remains a stub with no developed prose register." .
  }
} ;

# ── Style Observations ───────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    narr:StyleObs_SecondVersion_ShortCadence
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Body text is a two-word declarative fragment, exemplifying maximal brevity and short punchy cadence." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_EditorialRules
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "YAML frontmatter reviewer declaration follows a structured editorial convention: named reviewer role enforced at document level before content is developed." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    narr:StyleObs_SecondVersion_Conciseness
      a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The entire prose body is two words. This extreme conciseness marks the document as a versioned placeholder stub, not a developed artifact." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
