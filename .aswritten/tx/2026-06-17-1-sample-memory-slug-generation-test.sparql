    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id field is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via LLM id-gen or a deterministic slugify fallback — and commit the file successfully. This memory exists to exercise and validate that path." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_SlugFromContent_NoIdField a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
