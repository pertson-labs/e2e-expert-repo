      ] .

    narr:StyleObs_ImperativeDeclarative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Authoritative imperative register: 'must produce', 'must' signals a hard requirement, not a suggestion. Tone is declarative and prescriptive." ;
      rdf:value true ;
