      skos:note "Describes the two-step slug generation mechanism: LLM id-gen call or deterministic slugify fallback." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 136 ;
        oa:end 300
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_EmDashPunctuation a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash (—) used as a list separator between two alternative mechanisms, without surrounding spaces on the left." ;
      rdf:value true ;
