PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version document with reviewer metadata" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_ShortCadence,
      narr:StyleObs_SecondVersion_RegisterFormality,
      narr:StyleObs_SecondVersion_ReviewerFrontmatter .
} ;

# ── New Sample for the second-version document ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version (YAML-frontmatter document)" ;
      dct:description "Minimal document with YAML frontmatter declaring a reviewer and a two-word body 'Second version'. Structurally identical to the first version; body text incremented." ;
      narr:inputLength 66 .
  }
} ;

# ── Update Narrative: theme now reflects second version ──────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Document at second version with assigned reviewer" ;
      skos:note "The document asserts it is at its second version and names the same reviewer, confirming a review-gated authoring process pattern that persists across revisions." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── Update Claim: body text now references 'Second version' ──────
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentAtInitialVersion skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Claim_DocumentAtInitialVersion skos:note "The body text 'Second version' asserts this document has been revised at least once. Conviction remains Notion — a single two-word phrase with no corroborating detail." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentAtInitialVersion skos:note ?oldNote .
    OPTIONAL { narr:Claim_DocumentAtInitialVersion dct:source ?oldSource . }
  }
} ;

# ── Style Metrics for second version ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is two words with no complete sentence. AverageSentenceLength estimated at 2 words. ActiveVoiceRatio 1.0 (no passive constructions). JargonDensity 0.0 (no technical terms in body). Metrics unchanged from first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── Style Observation 1: Short punchy cadence ────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_ShortCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word body continues the ultra-minimal cadence pattern established in the first version." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── Style Observation 2: Register formality (minimal/informal) ───
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_RegisterFormality a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body register is bare noun-phrase, no verb, no punctuation — extremely low formality, consistent with a draft label or placeholder text." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── Style Observation 3: Reviewer declared in YAML frontmatter ───
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_ReviewerFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Reviewer assignment persists in YAML frontmatter across versions, indicating a structured editorial convention rather than ad-hoc annotation." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 15 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "  - test+expert-gh@aswritten.ai" ;
          oa:prefix "reviewers:\n" ;
          oa:suffix "\n---"
        ]
      ] .
  }
}