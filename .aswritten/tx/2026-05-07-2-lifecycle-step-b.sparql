INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "The organisation is replacing Zypherion with Meridian for analytics, after discovering critical gaps in Zypherion's streaming ingestion. Meridian handles both batch and streaming natively. Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption decision." ;
      narr:theme "Technology pivot driven by capability gap discovery" ;
      narr:supersedes narr:Narrative_ZypherionAdoption .
  }
}
