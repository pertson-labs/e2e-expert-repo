# ── UPDATE: Sample — revised document supersedes original ───────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406 dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for analytics, citing critical gaps in Zypherion's streaming ingestion. Supersedes the original Zypherion adoption decision. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 512 ;
      narr:supersedes narr:Sample_ZypherionDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406 dct:title ?oldTitle .
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 narr:inputLength ?oldLen . }
  }
} ;

