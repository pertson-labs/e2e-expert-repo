PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T150000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T15:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath ".aswritten/memories/2026-04-06-database-decision-revised.md" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_MeridianDecision_20260406,
      narr:Claim_StreamingIngestionGap,
      narr:StyleObs_DirectDeclarative_Meridian,
      narr:StyleObs_ToneAuthoritative_Meridian,
      narr:StyleObs_SupersessionMarker,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── New Sample for the REVISED document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note in which Quinton Fairweather (CTO) supersedes the prior Zypherion decision, selecting Meridian for analytics due to Zypherion's lack of streaming ingestion. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength "487"^^xsd:integer .
  }
} ;

# ── New Claim: Zypherion streaming ingestion gap (net-new knowledge) ─────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_StreamingIngestionGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion lacks streaming ingestion capability — the critical gap that drove the switch to Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .
  }
} ;

# ── Style Observations ───────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {

    narr:StyleObs_DirectDeclarative_Meridian a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Short declarative sentence announces the switch without hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 200 ;
          oa:end 253
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles both batch"
        ]
      ] .

    narr:StyleObs_ToneAuthoritative_Meridian a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO asserts capability comparison as settled fact, no hedging language." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 253 ;
          oa:end 306
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Meridian handles both batch and streaming natively." ;
          oa:prefix "switching to Meridian instead.\n" ;
          oa:suffix "\n\nThis supersedes"
        ]
      ] .

    narr:StyleObs_SupersessionMarker a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession sentence functions as a formal retraction marker — rare in informal meeting notes, signals deliberate record-keeping intent." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 308 ;
          oa:end 352
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "and streaming natively.\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Terse, active-voice decision log. Slightly higher jargon density than prior version due to 'streaming ingestion' and 'batch and streaming natively'. Formal retraction sentence elevates register." ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ─────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:theme "Technology adoption reversed by capability gap: streaming ingestion" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering a critical streaming ingestion gap. Meridian, which handles both batch and streaming natively, replaces Zypherion. Q3 2026 migration window is retained. Supersedes the prior Zypherion adoption narrative." ;
      skos:broader narr:StackOverview .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the choice ────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note              ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice
      dct:source              narr:Sample_MeridianDecision_20260406 ;
      skos:note               "Meridian has replaced Zypherion as the selected analytics database. Zypherion was rejected due to lack of streaming ingestion. Decision stated by CTO Quinton Fairweather." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:aboutNode          narr:Narrative_ZypherionAdoption ;
      narr:supports           narr:Narrative_ZypherionAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same timeline, Meridian now the target
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionMigrationQ3
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note  "Migration to Meridian (replacing Zypherion) retains the same Q3 2026 window. Timeline unchanged despite database switch." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
  }
}