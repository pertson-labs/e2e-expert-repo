# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 340 ;
      dct:description "Test memory submitted without an explicit id field to validate pipeline slug-generation behaviour (LLM id-gen or deterministic slugify fallback)." .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exists to exercise that code path." ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading .

    # ── Claim ────────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading .

    # ── Observation ──────────────────────────────────────────────
    narr:Obs_SlugFromContent a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline requirement: slug must be produced from content when id is absent." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 119 ;
        oa:end 295
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ───────────────────────────────────────

    # 1. Imperative / directive register
    narr:StyleObs_ImperativeRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Imperative modal 'must' signals a directive, authoritative register appropriate to pipeline specification writing." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 119 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a slug" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " from the memory content"
        ]
      ] .

    # 2. Technical jargon density
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Concentrated technical vocabulary: 'slug', 'LLM id-gen call', 'deterministic slugify fallback', 'pipeline' — high jargon density for a short document." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 260
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the deterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file"
        ]
      ] .

    # 3. Passive / nominalized construction for fallback description
    narr:StyleObs_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "'Submitted without an explicit id field' opens with a passive/nominalized construction, omitting the agent (the submitter), which is typical of technical specification prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 73 ;
          oa:end 118
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Submitted without an explicit id field." ;
          oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
          oa:suffix " The pipeline must"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 28 ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Short document (2 sentences in body). Mixed active/passive register. High jargon density relative to word count due to technical pipeline terminology." .

