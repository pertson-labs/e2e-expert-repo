      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The heading uses imperative negation ('Should Not Win') to encode a test expectation as a title — a rhetorical device that embeds a behavioural constraint directly in the document heading." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 90
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Minimalist body — single placeholder word
    narr:StyleObservation_MinimalistBody
      a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The document body consists of a single word 'Body.' — a placeholder indicating the body content is intentionally minimal or irrelevant to the test scenario being exercised." ;
      rdf:value true ;
