  GRAPH narr:Tx_20250721T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleThatShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter (reviewer annotation) and a single-word body. The H1 heading is explicitly named to signal it should not be used as the slug or id." ;
      narr:inputLength 97 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_HeadingDoesNotWinOverId
      a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:broader narr:Process ;
      skos:note "The H1 heading of a memory document should not be used as the slug or id when another mechanism (explicit id field, LLM id-gen, or slugify) is available. The heading is content, not an identifier. This memory's title 'Some Other Title That Should Not Win' encodes this constraint directly." ;
      narr:theme "Heading text must not override the pipeline's slug/id derivation logic" .

    # ── Claim ────────────────────────────────────────────────────
    narr:Claim_HeadingNotUsedAsId
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The pipeline must not derive the file slug or id from the H1 heading text. The heading 'Some Other Title That Should Not Win' is a deliberate test signal that the heading should lose to the correct id-derivation path." ;
      narr:aboutNode narr:Narrative_HeadingDoesNotWinOverId ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_HeadingDoesNotWinOverId .

    # ── Observation ──────────────────────────────────────────────
    narr:Observation_TitleShouldNotWin
      a narr:Observation ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:broader narr:CoreWorkflows ;
      skos:note "The H1 heading is explicitly named 'Some Other Title That Should Not Win', encoding the test expectation that the heading must not become the slug." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 52 ;
        oa:end 90
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Some Other Title That Should Not Win" ;
        oa:prefix "# " ;
        oa:suffix "\n\nBody."
      ] .

    # ── Style Observations ───────────────────────────────────────

    # 1. Imperative negation in heading
    narr:StyleObservation_ImperativeNegationHeading
      a narr:StyleObservation ;
