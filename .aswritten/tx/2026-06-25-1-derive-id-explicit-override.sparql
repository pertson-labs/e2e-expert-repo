PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

INSERT DATA {
  narr:Tx_20250728T120000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — no-id E2E test (Phase 3)" ;
    prov:generatedAtTime "2025-07-28T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id provided)" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin,
      narr:StyleObs_TitleAssertion_ShouldNotWin,
      narr:StyleObs_MinimalBody,
      narr:StyleObs_YAMLFrontmatterReviewer .
} ;

INSERT DATA {
  GRAPH narr:Tx_20250728T120000Z {

    # ── Sample ──────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Third no-id E2E test memory. YAML frontmatter lists reviewer test+expert-gh@aswritten.ai. Heading explicitly signals it should not be used as the slug source. Body is a single word." ;
      narr:inputLength "88"^^xsd:integer .

    # ── Style Observations ───────────────────────────────────────────

    # SO-1: Heading as deliberate counter-signal (NamingConventions / BrandNameStylization)
    narr:StyleObs_TitleAssertion_ShouldNotWin
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading is phrased as an explicit negative assertion about its own role ('Should Not Win'), signalling that the pipeline must not derive the slug from the document title when an id is absent. This is a deliberate test of slug-source priority logic." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 88
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # SO-2: Minimal body — extreme conciseness (ShortPunchyCadence)
    narr:StyleObs_MinimalBody
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The document body is a single word ('Body.'), the most minimal possible prose content. This is a deliberate test fixture pattern, not a style choice for production content." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 90 ;
          oa:end 95
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-3: YAML frontmatter reviewer field (EditorialRules / CitationConventions)
    narr:StyleObs_YAMLFrontmatterReviewer
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list field with a test email address. This is a structural convention for attributing review responsibility, consistent with the pattern seen in prior E2E test memories." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document: one heading (7 words) and one body sentence (1 word). Active voice ratio is not meaningfully applicable. Jargon density is low — the only domain term is the reviewer email convention. Average sentence length is 1 word for the body." ;
      narr:AverageSentenceLength "4"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.10"^^xsd:decimal .

  }
}