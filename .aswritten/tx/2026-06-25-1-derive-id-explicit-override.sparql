    # 3. YAML frontmatter reviewer annotation
    narr:StyleObservation_YAMLFrontmatterReviewer
      a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "YAML frontmatter is used to annotate the document with a reviewer email address, following the aswritten.ai convention for GitHub integration metadata. This is a structural/formatting style feature, not prose style." ;
