# ── UPDATE: extend existing Narrative note to include Phase 2 / E2E context ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFromContent skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_PipelineSlugGenFromContent skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake pipeline's id-resolution path. Phase 2 (E2E) specifically reproduces the missing-id failure pattern using an H2-level heading as the slug source, asserting the pipeline must not crash and must produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFromContent skos:note ?oldNote .
  }
}