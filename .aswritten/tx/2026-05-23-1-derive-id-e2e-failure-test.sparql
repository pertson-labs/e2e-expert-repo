# ── New Sample node for this specific memory ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {

    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E pipeline test reproducing the missing-id failure pattern. Memory uses an H2-level heading and no id field; pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 244 .

    # ── New Claim: H2 heading as slug source ──────────────────────────────
    narr:Claim_H2HeadingSlugSource a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "This Phase 2 test specifically uses an H2-level (## ) heading and no id field to reproduce the missing-id failure pattern, asserting that the pipeline must derive a valid slug from the heading text." ;
      narr:aboutNode narr:Narrative_PipelineSlugGenFromContent ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFromContent .

    # ── Style Observations ────────────────────────────────────────────────
    narr:StyleObs_ImperativeConstruction_Phase2 a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Imperative mood used for test requirements: 'Must not crash; must produce a valid slug.'" ;
      oa:hasTarget [
