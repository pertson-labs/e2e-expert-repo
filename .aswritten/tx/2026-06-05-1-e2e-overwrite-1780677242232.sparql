PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    dct:title "Second Version document extraction" ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_ReviewerAssigned_V2,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_MinimalRegister_V2,
      narr:StyleObs_YAMLReviewerPattern_V2,
      narr:StyleObs_VersionLabelConvention_V2 .
} ;

# ── UPDATE: Narrative_FirstVersionDocument → now covers both versions ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_FirstVersionDocument
      narr:theme "Reviewer-assigned document progressing through version stages" ;
      skos:note "The document pattern recurs across versions: YAML frontmatter assigns a reviewer, body text declares version stage. Now observed at 'Second version', confirming an iterative review workflow." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── NEW ENTITIES (named graph) ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # Sample — second version document
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter assigning the same reviewer and a single-line body declaring second version status." ;
      narr:inputLength 67 .

    # Claim — reviewer still assigned in second version
    narr:Claim_ReviewerAssigned_V2
      a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The same reviewer (test+expert-gh@aswritten.ai, redacted) is assigned in the YAML frontmatter of the second version, confirming the review workflow persists across versions." ;
      narr:aboutNode narr:Narrative_FirstVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_FirstVersionDocument .

    # Style Metrics — second version
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2-word body). Active voice ratio 1.0 (no passive constructions). Jargon density 0.0 — no technical terminology in body text. Identical profile to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

    # Style Observation 1 — minimal register
    narr:StyleObs_MinimalRegister_V2
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text is a bare two-word declarative phrase with no punctuation, sustaining an ultra-minimal register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — YAML reviewer assignment pattern
    narr:StyleObs_YAMLReviewerPattern_V2
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Reviewer assignment via YAML frontmatter list is a recurring structural convention, not prose — signals a machine-readable workflow integration." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - test+expert-gh@aswritten.ai"
        ]
      ] .

    # Style Observation 3 — version label convention
    narr:StyleObs_VersionLabelConvention_V2
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version is expressed as a title-case ordinal phrase ('Second version') rather than a numeric tag (v2, 2.0), indicating a human-facing prose convention over semantic versioning." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}