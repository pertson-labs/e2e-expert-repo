PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250715T120000Z a prov:Activity ;
    dct:title "Second Version Stub Extraction" ;
    prov:generatedAtTime "2025-07-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_FirstVersion,
      narr:Narrative_FirstVersionStub,
      narr:Obs_SecondVersionDeclaration,
      narr:StyleObs_SecondVersion_Terse,
      narr:StyleObs_SecondVersion_YAMLFrontmatter,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleMetrics_SecondVersion .
} ;

# ── UPDATE: Sample title, description, inputLength ──────────────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    narr:Sample_FirstVersion dct:description ?oldDesc .
    narr:Sample_FirstVersion narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_FirstVersion dct:title "Second version" .
    narr:Sample_FirstVersion dct:description "Minimal stub document with YAML frontmatter declaring a reviewer and a single body phrase 'Second version'. Successor to the first version stub." .
    narr:Sample_FirstVersion narr:inputLength 66 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    OPTIONAL { narr:Sample_FirstVersion dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_FirstVersion narr:inputLength ?oldLen . }
  }
} ;

# ── UPDATE: Narrative theme and note ────────────────────────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub narr:theme ?oldTheme .
    narr:Narrative_FirstVersionStub skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_FirstVersionStub narr:theme "Initial document stub — second version declaration" .
    narr:Narrative_FirstVersionStub skos:note "The document now asserts itself as a second version with no substantive content beyond a reviewer assignment. This signals document lifecycle progression from first to second version, still pre-content." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionStub skos:note ?oldNote . }
  }
} ;

# ── INSERT: New observation for second version declaration ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Obs_SecondVersionDeclaration a narr:Observation ;
      skos:broader narr:Milestones ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "The sole body content declares this as a second version, indicating document lifecycle progression with no elaborated content." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 52 ;
        oa:end 66
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
} ;

# ── INSERT: Style observations (minimum 3) ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {

    narr:StyleObs_SecondVersion_Terse a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Two-word body phrase continues the terse, label-only register established in the first version. No elaboration, no sentence structure." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "YAML frontmatter block used consistently for reviewer metadata, following the same editorial convention as the first version. Signals a structured document lifecycle pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 51
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Version label ('Second version') used as the entire document body, indicating a pre-content lifecycle stage. Informal register: no capitalisation of 'version', no version number (e.g. v2.0)." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "0.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Metrics computed on a two-word stub body ('Second version'). No full sentences present; active voice ratio and jargon density remain zero. Document remains pre-content at second version stage." .
  }
}