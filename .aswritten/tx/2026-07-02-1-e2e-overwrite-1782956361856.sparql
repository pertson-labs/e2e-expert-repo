# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20260702T014413Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion_E2E a narr:Sample ;
      dct:title "Second version — e2e-expert-repo" ;
      dct:created "2025-07-15"^^xsd:date ;
      narr:inputLength 73 ;
      skos:note "Minimal second-version document with YAML front-matter declaring the same reviewer and a single-sentence body reading 'Second version'." .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersionDocument a narr:Narrative ;
      dct:source narr:Sample_SecondVersion_E2E ;
      narr:theme "Document versioning with structured reviewer assignment" ;
      skos:broader narr:Process ;
      skos:note "The document declares itself a second version and assigns the same reviewer via YAML front-matter. Structurally identical to the first version; only the body label advances from 'First version' to 'Second version'. No substantive content beyond version declaration." .

    # ── Style Observations ───────────────────────────────────────

    # 1. YAML front-matter convention (same structural pattern, new sample)
    narr:StyleObs_YAMLFrontmatter_V2 a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SecondVersion_E2E ;
      skos:note "Document uses YAML front-matter block to declare metadata (reviewers list), a structured-data convention embedded in prose documents. Pattern identical to first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_E2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # 2. Reviewer naming convention (same key, new sample)
    narr:StyleObs_ReviewerAnnotation_V2 a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion_E2E ;
      skos:note "The key 'reviewers' (plural, lowercase) is used as a YAML list field for assigning review responsibility, confirming a persistent structured editorial workflow convention across document versions." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_E2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ; oa:end 14
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - [REDACTED]"
        ]
      ] .

    # 3. Minimal body text — version label incremented
    narr:StyleObs_MinimalBodyText_V2 a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion_E2E ;
      skos:note "Body text is a single two-word phrase ('Second version'), maintaining the extremely minimal, label-style register established in the first version. Version ordinal incremented; no elaboration added." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_E2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ; oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion_E2E ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Single two-word body sentence. No passive constructions. No domain jargon in prose body. YAML metadata excluded from prose metrics. Pattern identical to first version metrics." .

  }
}