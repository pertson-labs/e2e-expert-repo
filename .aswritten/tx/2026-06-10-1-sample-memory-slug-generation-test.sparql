      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Two slug-generation strategies are described: LLM id-gen call (primary) and deterministic slugify fallback (secondary). The pipeline must succeed via either path." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 135 ;
          oa:end 268
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    narr:Observation_CommitOnSuccess a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must commit the file successfully after slug generation — this is the terminal success condition for the intake test." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 270 ;
          oa:end 300
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "commit the file successfully" ;
          oa:prefix "deterministic slugify fallback — and " ;
          oa:suffix "."
        ]
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObservation_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "technical-neutral; pipeline/engineering register throughout" ;
      rdf:value true ;
      oa:hasTarget [
