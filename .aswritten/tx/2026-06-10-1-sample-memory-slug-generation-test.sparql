      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id is provided, using either the LLM id-gen call or the deterministic slugify fallback, and must commit the file successfully." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_SlugGenFallbackBehavior a narr:Observation ;
