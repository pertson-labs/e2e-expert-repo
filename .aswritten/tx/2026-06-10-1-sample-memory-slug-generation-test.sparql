    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake path." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
