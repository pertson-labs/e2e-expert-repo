# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 282 ;
      dct:description "Pipeline test memory submitted without an explicit id field, exercising slug-generation and commit behaviour." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exists to validate that behaviour." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_LLMIdGenCall a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline may produce a slug via the LLM id-gen call path." .

    narr:Claim_DeterministicSlugifyFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline may produce a slug via the deterministic slugify fallback path when the LLM id-gen call is unavailable or fails." .

    narr:Claim_CommitOnSuccess a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "After slug generation, the pipeline must commit the file successfully." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh (reviewer)" ;
      skos:note "Reviewer listed in YAML frontmatter as test+expert-gh@aswritten.ai. PII redacted per verbatim policy." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenAssertion a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline behaviour assertion: slug must be produced and file committed when no explicit id is supplied." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 90 ;
        oa:end 282
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a slug from the memory content" ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix " — either via the LLM id-gen call or the"
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Technical register / jargon density
    narr:StyleObservation_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
