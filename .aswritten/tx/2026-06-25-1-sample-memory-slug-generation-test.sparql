    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 339 ;
      dct:description "Test memory submitted without an explicit id field, exercising the pipeline slug-generation path (LLM id-gen call or deterministic slugify fallback)." .

