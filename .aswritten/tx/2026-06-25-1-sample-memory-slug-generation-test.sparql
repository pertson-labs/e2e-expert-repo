      narr:theme "Pipeline slug generation from memory content when no explicit id field is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative validates that both code paths produce a stable, committable identifier." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_SlugFromContentRequired a narr:Claim ;
