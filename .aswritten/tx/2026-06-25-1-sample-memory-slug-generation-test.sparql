          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # 3. Em-dash as cadence / parenthetical delimiter
    narr:StyleObservation_EmDashCadence a narr:StyleObservation ;
      skos:broader narr:CadenceRhythm ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dashes (—) are used twice in the body sentence to bracket an inline elaboration, creating a parenthetical cadence common in technical prose." ;
