      skos:note "Two code paths are acceptable for slug generation: (1) an LLM id-gen call, or (2) a deterministic slugify fallback. Either must result in a successful file commit." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_PipelineMustProduceSlug a narr:Observation ;
