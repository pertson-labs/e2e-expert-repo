PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250720T120000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — Pipeline Title Selection Test" ;
    prov:generatedAtTime "2025-07-20T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:Claim_TitleShouldNotWinSlugSelection,
      narr:StyleObs_TitleModalNegation,
      narr:StyleObs_MinimalBody,
      narr:StyleObs_FrontmatterReviewerPattern,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal pipeline test artifact: YAML frontmatter with reviewer, H1 heading asserting it should not win slug/title selection, one-word body. No id field present." ;
      narr:inputLength 89 .

    # ── Claim ───────────────────────────────────────────────────
    # The H1 title explicitly states it 'Should Not Win' — this is a
    # test assertion about pipeline title-selection logic: the H1 heading
    # must not be used as the canonical slug/title when a better source exists.
    narr:Claim_TitleShouldNotWinSlugSelection
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' encodes a pipeline test assertion: the heading title must not be selected as the canonical slug or document title when competing title sources are present. Supports the slug-generation process invariant." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Style Observations ──────────────────────────────────────

    # 1. Modal negation in H1 heading — rhetorical/structural signal
    narr:StyleObs_TitleModalNegation
      a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      skos:note "H1 heading uses modal negation ('Should Not Win') as a meta-assertion about pipeline behaviour, embedding test intent directly into document structure." ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 84
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Minimal body — extreme brevity / single-word body pattern
    narr:StyleObs_MinimalBody
      a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      skos:note "Body content is a single word ('Body.') — a placeholder pattern indicating the document's narrative content is intentionally minimal, consistent with pipeline test artifact conventions." ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 86 ;
          oa:end 91
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. YAML frontmatter reviewer pattern — structural/editorial convention
    narr:StyleObs_FrontmatterReviewerPattern
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      skos:note "YAML frontmatter declares a 'reviewers' list with a single email address, establishing a pipeline-level editorial review convention for test artifacts." ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 40
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document. Body is a single word; the H1 heading (9 words) dominates the prose. No active/passive distinction possible for a one-word body. Zero jargon in body; heading contains no technical jargon." ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
}