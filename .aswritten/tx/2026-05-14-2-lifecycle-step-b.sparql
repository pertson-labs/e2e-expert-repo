INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDBDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather supersedes the earlier Zypherion decision, announcing Meridian as the analytics database due to Zypherion's critical streaming ingestion gaps. Q3 2026 migration timeline unchanged." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: Narrative theme — Zypherion → Meridian ──────────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAnalyticsAdoption narr:theme "Switching from Zypherion to Meridian as the analytics database due to streaming ingestion gaps" ;
      skos:note "The organisation has reversed its Zypherion decision. Meridian replaces Zypherion for analytics because Zypherion lacks streaming ingestion; Meridian handles both batch and streaming natively. Q3 2026 migration window is unchanged. This supersedes the previous Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDBDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAnalyticsAdoption skos:note ?oldNote . }
  }
} ;

