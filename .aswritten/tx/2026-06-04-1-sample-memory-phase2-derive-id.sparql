# ── New Claim: pipeline must not crash ───────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Claim_PipelineMustNotCrash a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The pipeline must not crash when processing a memory that has no explicit id field and uses a ## level heading. Crash-resistance is a distinct acceptance criterion from slug production." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .
  }
} ;

# ── UPDATE: Narrative_PipelineSlugGeneration — add Phase 2 / prod context ───
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake path. Phase 2 (E2E) reproduces the failure pattern from prod using a ## level heading with no id field; the pipeline must not crash and must produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: Obs_ExplicitIdFieldAbsent — add ## level heading detail ──────────
