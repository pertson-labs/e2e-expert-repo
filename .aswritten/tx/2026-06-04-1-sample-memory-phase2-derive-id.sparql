  GRAPH narr:Tx_20250730T120000Z {
    narr:Obs_ExplicitIdFieldAbsent skos:note "Memory explicitly states it was submitted without an explicit id field and uses a ## level heading (not a YAML id key), triggering the slug-gen path. Phase 2 confirms this pattern reproduces the prod failure." .
  }
}
WHERE {
