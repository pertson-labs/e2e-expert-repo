  narr:Tx_20250725T000000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — pipeline heading-vs-slug test" ;
    prov:generatedAtTime "2025-07-25T00:00:00Z"^^xsd:dateTime ;
