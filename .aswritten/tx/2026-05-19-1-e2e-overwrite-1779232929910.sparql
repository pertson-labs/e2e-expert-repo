PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250130T130000Z a prov:Activity ;
    dct:title "Second version — minimal revision with same reviewer frontmatter" ;
    prov:generatedAtTime "2025-01-30T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDraft,
      narr:Claim_SecondVersionMarker,
      narr:Obs_ReviewerFrontmatter_V2,
      narr:Obs_VersionBodyText_V2,
      narr:StyleObs_NounPhraseBody_V2,
      narr:StyleObs_FrontmatterReviewGate_V2,
      narr:StyleObs_MinimalRegister_V2,
      narr:StyleMetrics_SecondVersion .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250130T130000Z {

    # ── Sample ────────────────────────────────────────────────────
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing the same reviewer as the first version and a two-word body 'Second version'. Structurally identical to the first version; only the version label has changed." ;
      narr:inputLength 65 .

    # ── Narrative ─────────────────────────────────────────────────
    narr:Narrative_SecondVersionDraft a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      narr:theme "Revision / version increment marker" ;
      skos:note "The document signals a second iteration of the same work product. The body text 'Second version' functions as a version-state declaration, continuing the pattern established in the first version. The same reviewer is retained, indicating no change in review ownership across the revision." .

    # ── Claim ─────────────────────────────────────────────────────
    narr:Claim_SecondVersionMarker a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      narr:aboutNode narr:Narrative_SecondVersionDraft ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      skos:note "The phrase 'Second version' asserts this document is at the second draft stage. Conviction is Stake: the claim is explicit but the document provides no further corroborating content beyond the version label." .

    # ── Observation: reviewer frontmatter ─────────────────────────
    narr:Obs_ReviewerFrontmatter_V2 a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:QualityReviewGates ;
      skos:note "YAML frontmatter retains the same reviewer across the version increment, indicating review-gate ownership is stable between versions. Email redacted per PII policy." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 4 ;
        oa:end 44
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # ── Observation: version body text ────────────────────────────
    narr:Obs_VersionBodyText_V2 a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "The body text 'Second version' is the sole substantive content of the document, functioning as a version-state declaration rather than narrative content." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 51 ;
        oa:end 65
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    # ── Style Observations ────────────────────────────────────────

    # 1. Noun-phrase-only body (same pattern as first version)
    narr:StyleObs_NounPhraseBody_V2 a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body consists of a bare noun phrase with no verb, clause, or sentence structure. Identical syntactic pattern to the first version." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 51 ;
          oa:end 65
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. YAML frontmatter as editorial/review convention
    narr:StyleObs_FrontmatterReviewGate_V2 a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter with a 'reviewers' key is used as a structural editorial convention, persisting unchanged across version increments. Signals an institutionalised review-gate pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 49
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # 3. Minimal register / placeholder stub
    narr:StyleObs_MinimalRegister_V2 a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document register is minimal/placeholder: no prose, no sentences, no rhetorical structure. The version label serves as the entire body. Consistent with a stub document awaiting substantive content." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 51 ;
          oa:end 65
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Extremely short document. Body is a two-word noun phrase with no active-voice sentences and zero domain jargon. Metrics are identical to the first version, confirming stub/placeholder state persists across the version increment." .

  }
}