INSERT {
  GRAPH narr:Tx_20260703T212327Z {
    narr:Narrative_PipelineSlugDerivation skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) adds: the pipeline must not crash when the heading is ## level with no id field, and must produce a valid slug. This narrative is exercised by both Phase 1 (Sample_SampleMemoryWithDistinctiveHeading) and Phase 2 (Sample_SampleMemoryPhase2DeriveIdE2E) test artifacts." .
  }
}
