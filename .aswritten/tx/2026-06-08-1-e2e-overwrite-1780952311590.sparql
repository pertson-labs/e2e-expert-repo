PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "" ;
    dct:title "Second version document extraction" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_DocumentSecondState,
      narr:Obs_SecondVersionBody,
      narr:StyleObs_SecondVersion_NominalRegister,
      narr:StyleObs_SecondVersion_VersionIncrement,
      narr:StyleObs_SecondVersion_YAMLFrontmatter,
      narr:StyleMetrics_SecondVersion .
} ;

# ── New Sample entity ────────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter (reviewer metadata) and a two-word body asserting second iteration of document state. Same reviewer as first version." ;
      narr:inputLength 67 .

    narr:Claim_DocumentSecondState
      a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' asserts this document has advanced to a second iteration. Conviction is Notion — minimal content, no elaboration beyond version increment." ;
      narr:aboutNode narr:Narrative_FirstVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process .

    narr:Obs_SecondVersionBody
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:IntakePrioritization ;
      skos:note "The sole body content asserts document version state as second iteration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 53 ;
        oa:end 67
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    narr:StyleObs_SecondVersion_NominalRegister
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "stub-placeholder register: bare two-word nominal phrase, no verb, no predicate structure" ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_VersionIncrement
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Ordinal 'Second' signals iterative document lifecycle via ordinal-noun naming convention; mirrors 'First version' pattern from prior document" ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 59
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second" ;
          oa:prefix "---\n\n" ;
          oa:suffix " version"
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLFrontmatter
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter reviewer-assignment pattern repeated from first version; structured metadata convention for intake and review gate" ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 52
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Single two-word nominal phrase. No verbs, no jargon, no passive constructions. Stub/placeholder register identical to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
} ;

# ── UPDATE: Narrative_FirstVersionDocument — broaden scope to cover both versions ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_FirstVersionDocument
      skos:note "The document series declares version state (first, second) and assigns a named reviewer via YAML frontmatter, establishing the intake and review gate pattern across iterations." ;
      narr:theme "Document versioning and reviewer assignment" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}