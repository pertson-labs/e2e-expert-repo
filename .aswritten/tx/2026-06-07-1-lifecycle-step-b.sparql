# ── UPDATE: Sample — title/description revised to reflect Meridian decision ──
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDBDecision_20260406 dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_ZypherionDBDecision_20260406
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to replace Zypherion with Meridian for the analytics pipeline, citing critical gaps in Zypherion's streaming ingestion. Q3 2026 migration window retained." ;
      narr:inputLength 594 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDBDecision_20260406 dct:title ?oldTitle .
    OPTIONAL { narr:Sample_ZypherionDBDecision_20260406 dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_ZypherionDBDecision_20260406 narr:inputLength ?oldLen . }
  }
} ;

