PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250101T000001Z a prov:Activity ;
    dct:title "Second version stub document extraction" ;
    prov:generatedAtTime "2025-01-01T00:00:01Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_PlainLanguage,
      narr:StyleObs_SecondVersion_ReviewerFrontMatter .
} ;

# ── New entities (named graph) ───────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250101T000001Z {

    # New Sample for the second version document
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version stub document" ;
      dct:description "Minimal YAML-frontmatter document with reviewer assignment and 'Second version' body text. Successor to the first version stub." ;
      narr:inputLength 62 .

    # Style metrics for the second version
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Extremely short document (2-word body). Active voice ratio is 1.0 by default for a declarative stub. Jargon density is 0.0 — no domain-specific terminology present. Structurally identical to first version." .

    # Style observation 1: version label as plain declarative phrase
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text is a bare two-word declarative label with no punctuation or elaboration — extreme plain language." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style observation 2: YAML front matter as editorial/structural convention
    narr:StyleObs_SecondVersion_ReviewerFrontMatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML front matter used to declare reviewer assignment — a structured editorial convention separating metadata from content." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # Style observation 3: register formality — minimal, stub-like register
    narr:StyleObs_SecondVersion_PlainLanguage a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document register is minimal/stub: no prose, no sentences, no rhetorical devices. Formality is structural rather than linguistic." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---\n\nSecond version" ;
          oa:prefix "" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── UPDATE: Narrative — evolve from first-version to versioned-document theme ─
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250101T000001Z {
    narr:Narrative_FirstVersionDocument narr:theme "Versioned document lifecycle declaration" ;
      skos:note "The document series progresses from 'First version' to 'Second version', with the same reviewer assigned throughout, establishing a versioned review workflow pattern." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Observation — body text changed from 'First version' to 'Second version' ─
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionLabel skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250101T000001Z {
    narr:Observation_FirstVersionLabel
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' signals this is the second iteration of the document, continuing the versioned review cycle established by the first version." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionLabel skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim — reviewer assignment now references second version sample ─
DELETE {
  GRAPH ?g {
    narr:Claim_ReviewerAssigned dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250101T000001Z {
    narr:Claim_ReviewerAssigned
      dct:source narr:Sample_SecondVersion ;
      skos:note "The same reviewer (email redacted) is explicitly assigned in the YAML front matter of the second version, confirming the reviewer persists across document versions." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ReviewerAssigned dct:source ?oldSource .
    OPTIONAL { narr:Claim_ReviewerAssigned skos:note ?oldNote . }
  }
}