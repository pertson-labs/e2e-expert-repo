# ── Update existing Narrative to reference Phase 2 sample ───────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T143000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 1 exercised this path via a distinctive H2 heading. Phase 2 (Derive Id E2E) reproduces the missing-id failure pattern from prod (## level heading, no id field) and asserts the pipeline must not crash and must produce a valid slug." ;
      dct:source narr:Sample_Phase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

