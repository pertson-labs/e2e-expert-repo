PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250720T120000Z a prov:Activity ;
    dct:title "Second version stub extraction" ;
    prov:generatedAtTime "2025-07-20T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleObs_SecondVersion_BodyCadence,
      narr:StyleObs_SecondVersion_YAMLGovernance,
      narr:StyleObs_SecondVersion_MinimalRegister,
      narr:StyleMetrics_SecondVersion .
} ;

# ── New Sample node (INSERT DATA — new entity, distinct from Sample_FirstVersion) ──
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal stub document with YAML front-matter declaring a reviewer and a two-word body asserting second version status. Structurally identical to first version but advances the document lifecycle stage." ;
      narr:inputLength 58 .

    narr:StyleObs_SecondVersion_BodyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word declarative body. Extremely short punchy cadence signals lifecycle milestone." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLGovernance a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML front-matter reviewer declaration repeats the lightweight governance pattern from the first version, indicating an editorial convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    narr:StyleObs_SecondVersion_MinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Register is minimal/technical stub — no prose elaboration, no rhetorical devices. Formality is structural rather than linguistic." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---\n\nSecond version" ;
          oa:prefix "" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Extremely short document (two-word body). No passive constructions. No jargon. Register is minimal/technical stub. Metrics identical to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── UPDATE: Narrative_FirstVersionInitialization → now covers second version lifecycle ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionInitialization
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_FirstVersionInitialization
      dct:source narr:Sample_SecondVersion ;
      narr:theme "Document progression to second version" ;
      skos:note "The document has advanced from first to second version under the same review-gated authoring workflow, signalling an iterative lifecycle pattern." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionInitialization
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Obs_BodyText — quote changes from 'First version' to 'Second version' ──
DELETE {
  GRAPH ?g {
    narr:Obs_BodyText
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasSelector ?oldSel .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Obs_BodyText
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text 'Second version' signals document lifecycle stage — the artifact has advanced to its second iteration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_BodyText
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasSelector ?oldSel .
  }
} ;

# ── UPDATE: Obs_YAMLFrontMatter — re-point source to new sample ──
DELETE {
  GRAPH ?g {
    narr:Obs_YAMLFrontMatter dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Obs_YAMLFrontMatter dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_YAMLFrontMatter dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_DocumentUnderReview — re-point source to new sample ──
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentUnderReview
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Claim_DocumentUnderReview
      dct:source narr:Sample_SecondVersion ;
      skos:note "The document continues to declare a named reviewer in YAML front-matter across versions, confirming a persistent review workflow pattern. Conviction remains Notion — no further content substantiates the claim." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentUnderReview
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}