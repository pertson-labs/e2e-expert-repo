PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250716T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDeclaration,
      narr:Observation_SecondVersionBody,
      narr:StyleObs_SecondVersion_ShortCadence,
      narr:StyleObs_SecondVersion_FrontmatterStructure,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleMetrics_SecondVersion .
} ;

# UPDATE: Sample — title and description superseded by second version
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer and a two-word body declaring second version status. Supersedes first version." ;
      narr:inputLength 56 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# UPDATE: Narrative — theme and note superseded; first-version-specific claims no longer hold
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_SecondVersionDeclaration a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "The document declares itself a second version, signalling iteration on an established baseline. The reviewer assignment in frontmatter is unchanged, indicating the same review-gated workflow persists across versions." ;
      narr:theme "Document versioning — second iteration declaration" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# UPDATE: Observation — body text changed from "First version" to "Second version"
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Observation_SecondVersionBody a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:CoreNarratives ;
      skos:note "Body text is exactly two words: 'Second version', functioning as a version label rather than prose. Mirrors the structure of the prior version body." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# UPDATE: StyleMetrics — source updated to second version sample
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2-word body). No passive constructions. No domain jargon in body text. YAML frontmatter uses structured key syntax (reviewers:) which is technical but not prose jargon. Metrics unchanged from first version." ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:AverageSentenceLength 2 ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion dct:source ?oldSource ;
      skos:note ?oldNote .
  }
} ;

# INSERT: Style observations for second version
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {

    narr:StyleObs_SecondVersion_ShortCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word body continues the ultra-compressed cadence pattern established in the first version. No elaboration, no punctuation." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_FrontmatterStructure a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter block with 'reviewers:' key and list value persists unchanged from first version, indicating a stable editorial convention for review-gated documents." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten" ;
          oa:prefix "" ;
          oa:suffix ".ai\n---"
        ]
      ] .

    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "'Second version' uses ordinal word form rather than numeric (v2, 2.0). Consistent with informal, human-readable versioning convention rather than semantic versioning." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}