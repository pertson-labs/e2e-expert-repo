PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250730T120000Z a prov:Activity ;
    dct:title "Second Version Document Extraction" ;
    prov:generatedAtTime "2025-07-30T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id provided)" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:StyleObs_SecondVersion_ShortCadence,
      narr:StyleObs_SecondVersion_PlaceholderRegister,
      narr:StyleObs_SecondVersion_YAMLFrontMatter,
      narr:StyleMetrics_SecondVersion .
} ;

# ── UPDATE: Sample title and inputLength ────────────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Sample_FirstVersion dct:title "Second Version" ;
      dct:description "Minimal YAML front-matter document declaring a second version with a single reviewer." ;
      narr:inputLength 67 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: Narrative theme and note ────────────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Narrative_FirstVersionDeclaration narr:theme "Second version declaration" ;
      skos:note "The document body now reads 'Second version', superseding the prior 'First version' body. The YAML front-matter retains the same reviewer, establishing continuity of the minimal review workflow across versions." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim note ───────────────────────────────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Claim_FirstVersionStatus skos:note "The document now asserts 'Second version' as its sole body content — a low-conviction placeholder claim indicating an incremental draft update from the prior first version." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote .
  }
} ;

# ── UPDATE: StyleMetrics note ────────────────────────────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:StyleMetrics_FirstVersion skos:note "Prose body is two words ('Second version'). Metrics unchanged from prior extraction: active voice ratio trivially 1.0, jargon density 0.0, average sentence length 2. Register: placeholder/stub, now at second iteration." .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion skos:note ?oldNote .
  }
} ;

# ── INSERT: New style observations and metrics ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250730T120000Z {

    # Style Observation 1: Short punchy cadence — two-word body
    narr:StyleObs_SecondVersion_ShortCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Body text is exactly two words, exemplifying maximal brevity. Cadence is declarative and versioning-oriented." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 69
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2: Placeholder/stub register
    narr:StyleObs_SecondVersion_PlaceholderRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Register is minimal placeholder/stub. The body communicates only version state, not substantive content. Formality is implicit through YAML structure rather than prose." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 69
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 3: YAML front-matter citation convention
    narr:StyleObs_SecondVersion_YAMLFrontMatter a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Reviewer attribution is encoded in YAML front-matter using a structured list under 'reviewers:', a machine-readable citation convention rather than inline prose attribution." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 52
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # Style Metrics (new node for this transaction)
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Second version body: two words, no conventional sentences. Active voice ratio 1.0 (declarative noun phrase). Jargon density 0.0. Register: versioning placeholder/stub." .

  }
}