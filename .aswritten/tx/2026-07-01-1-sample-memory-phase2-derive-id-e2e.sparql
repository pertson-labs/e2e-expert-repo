# ── Update existing Narrative_PipelineSlugDerivation — add Phase 2 context ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugDerivation skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T195121Z {
    narr:Narrative_PipelineSlugDerivation skos:note "When a memory is submitted without an explicit id field, the pipeline must produce a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exercises that code path. Phase 2 extends this by reproducing the failure pattern from production using an H2-level (##) heading, confirming the pipeline must not crash and must produce a valid slug regardless of heading level." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugDerivation skos:note ?oldNote .
  }
} ;

