# UPDATE: extend Claim_SlugFallbackRequired to include the non-crash safety dimension
DELETE {
  GRAPH ?g {
    narr:Claim_SlugFallbackRequired skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T203257Z {
    narr:Claim_SlugFallbackRequired skos:note "The pipeline must not crash and must produce a valid slug from memory content — either via the LLM id-gen call or the deterministic slugify fallback — when no id field is present. The specific prod failure pattern is a ## level heading with no id field. (Phase 2 E2E confirms both the no-crash and slug-production requirements.)" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_SlugFallbackRequired skos:note ?oldNote .
  }
}