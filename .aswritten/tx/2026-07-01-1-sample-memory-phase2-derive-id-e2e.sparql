  GRAPH ?g {
    narr:Narrative_PipelineSlugDerivation skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T220002Z {
    narr:Narrative_PipelineSlugDerivation skos:note "When a memory is submitted without an explicit id field, the pipeline must produce a slug — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. Phase 2 extends this: the pattern is reproduced from a prod failure using a ## level heading with no id field; the pipeline must not crash and must produce a valid slug." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugDerivation skos:note ?oldNote .
  }
} ;

