  GRAPH narr:Tx_20260701T223941Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) extends this: the pipeline must also handle the ## level heading trigger condition without crashing, reproducing a known production failure pattern. See narr:Narrative_MissingIdFailurePatternReproduction for the regression-test framing." ;
      skos:related narr:Narrative_MissingIdFailurePatternReproduction .
  }
