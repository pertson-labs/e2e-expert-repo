    narr:Narrative_SlugGenerationPipelineRequirement a narr:Narrative ;
      dct:source narr:Sample_SlugGenPipelineTest ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either through an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests a critical fallback path in the ingestion workflow." .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlugFromContent a narr:Claim ;
