        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a\nslug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # ── Style Observation 2: Jargon-Dense Technical Vocabulary ────
    narr:StyleObs_JargonDensePipeline a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "High jargon density for a short document: 'pipeline', 'slug', 'LLM id-gen call', 'deterministic slugify fallback' all appear in a single sentence." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 140 ;
          oa:end 270
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # ── Style Observation 3: Active-Voice Imperative Construction ─
    narr:StyleObs_ActiveVoiceImperative a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Active-voice imperative: 'The pipeline must produce … and commit the file successfully' — subject-verb-object with modal 'must' signals a test assertion rather than a description." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 97 ;
          oa:end 280
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a\nslug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call or the"
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 22 ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:JargonDensity "0.12"^^xsd:decimal ;
      skos:note "Short two-sentence body. Dominant register: technical/procedural. Active voice throughout. Jargon density elevated by pipeline-specific vocabulary (slug, LLM id-gen, slugify fallback)." .

