          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # 2. Technical jargon / domain-specific terminology
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Dense use of pipeline-specific jargon: 'LLM id-gen call', 'deterministic slugify fallback', 'commit the file' — assumes reader familiarity with CI/CD and NLP pipeline conventions." ;
      oa:hasTarget [
