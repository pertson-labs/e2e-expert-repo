    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_SlugGenerationFromContent a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests a critical fallback path in the ingestion workflow." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineSlugFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_SlugGenerationFromContent ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
