      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenDescription a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline behavior: slug derived from content when id is absent, with two fallback strategies." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 349
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # SO-1: Technical register / jargon
    narr:StyleObservation_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
