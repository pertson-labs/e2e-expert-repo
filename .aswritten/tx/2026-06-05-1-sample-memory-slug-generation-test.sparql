      ] .

    # SO-2: Imperative / prescriptive voice
    narr:StyleObservation_ImperativeVoice a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
