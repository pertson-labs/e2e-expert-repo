# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ────────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 340 ;
      dct:description "Test memory submitted without an explicit id field to exercise pipeline slug-generation fallback logic." .

    # ── Narrative ─────────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake process." .

    # ── Claim ─────────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlugFromContent a narr:Claim ;
      narr:aboutNode narr:Process ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Actor ─────────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh (reviewer)" ;
      skos:note "Reviewer listed in YAML frontmatter of the test memory. Email redacted per PII policy." .

    # ── Style Observation 1: Technical/Procedural Register ────────
    narr:StyleObs_TechnicalProcedural a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Procedural, system-oriented register: the document describes pipeline behaviour in declarative must-statements." ;
      rdf:value true ;
      oa:hasTarget [
