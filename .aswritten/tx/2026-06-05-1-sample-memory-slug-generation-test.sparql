        oa:start 175 ;
        oa:end 302
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "The pipeline must produce a\nslug from the memory content — " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────────────────

    # 1. Imperative / directive mood
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Imperative/directive mood: 'The pipeline must produce a slug' — obligation framed as a system requirement, not a suggestion." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
