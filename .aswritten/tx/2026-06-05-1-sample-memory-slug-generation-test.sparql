      skos:note "The deterministic slugify fallback is a secondary mechanism that must also result in a successful file commit, ensuring pipeline resilience when the LLM id-gen call is unavailable or fails." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_PipelineSlugBehavior a narr:Observation ;
