      skos:note "Two slug-generation strategies are specified: (1) LLM id-gen call (primary), (2) deterministic slugify fallback. The fallback ensures robustness when the LLM path is unavailable." .

    # ── Observations ────────────────────────────────────────────────────────
    narr:Observation_SlugGenRequirement a narr:Observation ;
