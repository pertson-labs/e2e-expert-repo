PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "unknown" ;
    dct:title "Extraction: Sample Memory With Distinctive Heading" ;
    prov:generated
      narr:Sample_SampleMemoryDistinctiveHeading,
      narr:Actor_Reviewer_ExpertGH,
      narr:Narrative_PipelineSlugGeneration,
      narr:Claim_SlugFromContent,
      narr:Claim_SlugifyFallback,
      narr:Observation_SlugGenBody,
      narr:StyleObservation_ImperativeMood,
      narr:StyleObservation_TechnicalJargon,
      narr:StyleObservation_PassiveOpening,
      narr:StyleMetrics_SampleMemoryDistinctiveHeading .
} ;

# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 297 ;
      dct:description "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "Expert GH Reviewer" ;
      skos:note "Reviewer listed in YAML frontmatter. Email redacted per PII policy (allow_pii=false)." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the ingestion pipeline's id-resolution path." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_SlugFromContent a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id field is present." .

    narr:Claim_SlugifyFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Slug generation uses either the LLM id-gen call or the deterministic slugify fallback as a secondary mechanism." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenBody a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline behavior described: slug derived from content via LLM or deterministic fallback, then file committed." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 94 ;
        oa:end 296
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file" ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix " successfully."
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Imperative / deontic mood: "must produce", "must … commit"
    narr:StyleObservation_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Deontic imperative register: 'must produce', 'must … commit' signal a requirements/specification voice." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 133 ;
          oa:end 200
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # 2. Technical jargon density: slug, LLM, id-gen, slugify, deterministic
    narr:StyleObservation_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "High technical jargon density for a short document: 'LLM id-gen call', 'deterministic slugify fallback', 'explicit id field'. Assumes a developer audience." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 162 ;
          oa:end 254
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # 3. Passive opening construction: "Submitted without an explicit id field"
    narr:StyleObservation_PassiveOpening a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Document opens with an agentless passive construction ('Submitted without an explicit id field'), suppressing the actor who submitted the memory." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 94 ;
          oa:end 132
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Submitted without an explicit id field." ;
          oa:prefix "\n\n" ;
          oa:suffix " The pipeline must produce a"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 18 ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Short document (~3 sentences). Mixed voice: passive opening, active imperative body. Jargon terms: slug, LLM, id-gen, slugify, deterministic, pipeline (6 of ~33 content words ≈ 18%)." .

  }
}