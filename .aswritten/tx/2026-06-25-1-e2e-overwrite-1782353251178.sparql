PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250716T120000Z a prov:Activity ;
    dct:title "Extraction: Second version document" ;
    prov:generatedAtTime "2025-07-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_DocumentIsSecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_PlainLanguage,
      narr:StyleObs_SecondVersion_ShortPunchyCadence,
      narr:StyleObs_SecondVersion_DeclarativeTone .
} ;

# ── New Sample node for the second-version document ─────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing one reviewer and a two-word body asserting document version (second iteration)." ;
      narr:inputLength 63 .
  }
} ;

# ── UPDATE: Narrative — evolve from 'initial' to 'versioning lifecycle' ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Document versioning lifecycle" ;
      skos:note "The document has progressed from a first to a second version, confirming an active versioning lifecycle. A single reviewer (email redacted) is consistently assigned via frontmatter metadata." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Existing claim contradicted — document is no longer initial version ──
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentIsInitialVersion skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Claim_DocumentIsInitialVersion skos:note "Superseded: the document body previously read 'First version'. The new memory asserts 'Second version', contradicting the initial-version claim. Conviction downgraded to Notion (retracted)." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentIsInitialVersion narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_DocumentIsInitialVersion skos:note ?oldNote . }
    OPTIONAL { narr:Claim_DocumentIsInitialVersion dct:source ?oldSource . }
  }
} ;

# ── New Claim: document is second version ───────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Claim_DocumentIsSecondVersion a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' asserts this is the second iteration of the document, superseding the first. Conviction is Stake — corroborated by the prior first-version document in the graph." ;
      narr:aboutNode narr:Narrative_FirstVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_FirstVersionDocument .
  }
} ;

# ── Style Metrics for second-version document ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document body (2 words). No jargon. Fully declarative, no passive constructions. Register: minimal/placeholder. Identical style profile to first version." ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── Style Observations (minimum 3) ──────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {

    narr:StyleObs_SecondVersion_PlainLanguage a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text uses the simplest possible declarative phrasing: a bare ordinal noun phrase with no verb, article variation, or elaboration." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 46 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The entire document body is two words. This is the most compressed possible cadence — a single noun phrase standing as the complete content." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 46 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_DeclarativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The document makes no hedging, no qualification, and no explanation — it simply declares its version status. This is an authoritative, declarative register consistent with placeholder or stub documents." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 46 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}