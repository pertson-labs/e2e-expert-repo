INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ────────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 319 ;
      dct:description "Test memory submitted without an explicit id field, used to validate pipeline slug-generation behaviour." .

    # ── Actor ─────────────────────────────────────────────────────
    narr:Actor_TestExpertGH a narr:Actor ;
      skos:prefLabel "test+expert-gh" ;
      skos:note "Reviewer listed in YAML frontmatter (test+expert-gh@aswritten.ai). Role: expert reviewer in the aswritten.ai pipeline." .

    # ── Narrative ─────────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake/prioritization process." .

    # ── Claim ─────────────────────────────────────────────────────
    narr:Claim_SlugFromContentOrFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from memory content via LLM id-gen call or deterministic slugify fallback, and commit the file successfully." .

    # ── Observation ───────────────────────────────────────────────
    narr:Observation_SlugGenBehavior a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core behavioural assertion: slug must be produced and file committed even when id is absent." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 122 ;
        oa:end 319
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ────────────────────────────────────────

    # 1. Deontic modal "must" — authoritative obligation register
    narr:StyleObs_DeonticModal a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Deontic modal 'must' used twice to assert pipeline obligations, signalling a specification/requirements register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 122 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # 2. Technical/procedural register — system-facing terminology
    narr:StyleObs_TechnicalProcedural a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Cluster of technical pipeline terms ('LLM id-gen call', 'deterministic slugify fallback', 'commit the file') establishes a developer/ops register throughout the body." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 196 ;
          oa:end 290
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # 3. Either/or disjunctive construction — explicit branching logic
    narr:StyleObs_EitherOrDisjunction a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "'either … or …' disjunction encodes a two-branch conditional directly in prose, mirroring code-style logic in natural language." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 188 ;
          oa:end 290
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the\ndeterministic slugify fallback —" ;
          oa:prefix "slug from the memory content " ;
