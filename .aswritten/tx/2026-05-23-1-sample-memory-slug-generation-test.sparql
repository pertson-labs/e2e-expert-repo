    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      dct:description "Pipeline test memory submitted without an explicit id field, exercising slug-generation from content." ;
      narr:inputLength 301 .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertGH a narr:Actor ;
      skos:prefLabel "test+expert-gh (reviewer)" ;
