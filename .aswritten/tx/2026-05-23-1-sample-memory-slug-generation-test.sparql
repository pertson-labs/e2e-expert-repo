      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline may produce a slug via an LLM id-gen call when no explicit id is provided." .

    narr:Claim_DeterministicSlugifyFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGenFromContent ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFromContent ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline falls back to a deterministic slugify algorithm when the LLM id-gen call is unavailable or not used." .

    narr:Claim_CommitSuccessCriterion a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGenFromContent ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFromContent ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The success criterion for this pipeline test is that the file is committed successfully after slug generation." .

    # ── Style Observations ───────────────────────────────────────

    # SO-1: Technical/procedural register
    narr:StyleObs_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
