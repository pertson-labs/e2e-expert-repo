      ] .

    # SO-3: Disjunctive construction (either/or fallback pattern)
    narr:StyleObs_DisjunctiveConstruction a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
