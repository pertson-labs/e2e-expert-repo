    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGenFromContent a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake pipeline's id-resolution path." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_LLMIdGenCall a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGenFromContent ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
