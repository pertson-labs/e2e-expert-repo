          oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # SO-2: Imperative mood / prescriptive assertion
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Prescriptive imperative mood: \"must produce\" and \"commit the file successfully\" assert required pipeline behaviour as obligations, not observations." ;
      rdf:value true ;
