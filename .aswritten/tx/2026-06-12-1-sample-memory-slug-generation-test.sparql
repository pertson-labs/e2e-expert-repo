    # ── Observation 1: Submitted without explicit id ─────────────
    narr:Obs_SubmittedWithoutExplicitId a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Memory explicitly states it was submitted without an explicit id field, triggering the slug-generation path." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 93 ;
        oa:end 132
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Submitted without an explicit id field." ;
        oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
        oa:suffix " The pipeline must produce a"
      ] .

    # ── Observation 2: Slug generation mechanism ─────────────────
    narr:Obs_SlugGenMechanism a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Two slug-generation mechanisms are specified: LLM id-gen call (primary) and deterministic slugify fallback (secondary). The file must be committed successfully after slug derivation." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 133 ;
        oa:end 263
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "slug from the memory content — " ;
        oa:suffix ""
      ] .

    # ── Style Observation 1: Imperative/authoritative voice ──────
    narr:StyleObs_ImperativeVoice a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Modal imperative 'must produce' and 'must' constructions assert pipeline requirements as non-negotiable obligations, establishing an authoritative, specification-like register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 133 ;
          oa:end 172
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # ── Style Observation 2: Technical jargon density ────────────
    narr:StyleObs_TechnicalJargonDensity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "High concentration of pipeline-specific technical terms: 'slug', 'LLM id-gen call', 'deterministic slugify fallback', 'commit'. These terms are used without definition, presupposing a technical audience familiar with CI/CD and NLP pipeline conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
