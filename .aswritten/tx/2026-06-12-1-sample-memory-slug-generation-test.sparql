# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 263 ;
      dct:description "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGenFallback a narr:Narrative ;
      narr:theme "Pipeline slug generation from content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake and file-commit workflow." ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineMustDeriveSlugWhenIdAbsent a narr:Claim ;
      narr:aboutNode narr:Process ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFallback ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from memory content and commit the file successfully when no explicit id is provided. Two mechanisms are specified: LLM id-gen call and deterministic slugify fallback." .

    # ── Actor (reviewer — email redacted per PII policy) ────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "test+expert-gh (reviewer)" ;
