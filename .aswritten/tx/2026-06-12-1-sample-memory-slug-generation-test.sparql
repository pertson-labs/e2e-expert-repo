        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "slug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "The pipeline must produce a\n" ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # ── Style Observation 3: Short punchy cadence / em-dash list ─
    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash parenthetical ('— either via … or the … fallback —') creates a compact inline enumeration within a single sentence, a cadence pattern that compresses alternatives without breaking flow." ;
      rdf:value true ;
