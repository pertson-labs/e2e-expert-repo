# ── UPDATE Narrative_ZypherionAdoption → Meridian adoption ──────────────────
# Memory explicitly supersedes the Zypherion decision; narrative theme changes
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T174851Z {
    narr:Narrative_ZypherionAdoption narr:theme "Switching from Zypherion to Meridian for analytics pipeline" ;
      skos:note "CTO Quinton Fairweather revised the database decision after finding critical streaming ingestion gaps in Zypherion. Meridian replaces Zypherion, handling both batch and streaming natively. Migration window remains Q3 2026. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDBDecision_20260406 .
  }
}
