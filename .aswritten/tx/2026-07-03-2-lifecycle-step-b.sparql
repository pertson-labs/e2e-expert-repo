    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T103306Z {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme "Meridian replaces Zypherion as the analytics database due to streaming ingestion gaps" ;
      skos:note "REVISED 2026-04-06: CTO Quinton Fairweather announced that Zypherion has critical gaps in streaming ingestion. Meridian, which handles both batch and streaming natively, replaces Zypherion. Migration window remains Q3 2026. Supersedes the original Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDatabaseDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAnalyticsAdoption
      narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAnalyticsAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAnalyticsAdoption dct:source ?oldSource . }
  }
} ;

