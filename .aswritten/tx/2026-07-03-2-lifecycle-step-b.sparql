# ── UPDATE Narrative_ZypherionAdoption → Meridian adoption ──────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T210110Z {
    narr:Narrative_ZypherionAdoption narr:theme "Adopting Meridian as the analytics database, superseding Zypherion due to streaming ingestion gaps, with migration in Q3 2026" ;
      skos:note "CTO-level decision (2026-04-06) to replace Zypherion with Meridian for analytics. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026. Supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── New Narrative entity for Meridian adoption (descriptive IRI) ─────────────
INSERT DATA {
  GRAPH narr:Tx_20260703T210110Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      skos:broader narr:StackOverview ;
      narr:theme "Meridian replaces Zypherion as the analytics database due to streaming ingestion capability" ;
      skos:note "Following evaluation, Zypherion was found to lack streaming ingestion. Meridian, which handles both batch and streaming natively, is selected as the replacement. Q3 2026 migration window is retained." ;
