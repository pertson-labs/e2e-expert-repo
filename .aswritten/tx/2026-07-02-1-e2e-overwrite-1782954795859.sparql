# ── New Narrative: second version document state ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260702T011828Z {
    narr:Narrative_SecondVersionDocument a narr:Narrative ;
      dct:source narr:Sample_SecondVersion_E2E ;
      narr:theme "Second version document state" ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "Document declares itself a second version with the same designated reviewer, establishing the next iteration state of the artifact in the repository. Supersedes the first-version baseline." ;
      dct:replaces narr:Narrative_FirstVersionDocument .
  }
} ;

# ── UPDATE Narrative_FirstVersionDocument: mark as superseded ────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260702T011828Z {
    narr:Narrative_FirstVersionDocument skos:note "Document declared itself a first version with a designated reviewer, establishing the baseline state of the artifact in the repository. Superseded by narr:Narrative_SecondVersionDocument." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote .
  }
} ;

# ── New Claim: second version state (supersedes Claim_FirstVersionInitialState) ─
INSERT DATA {
  GRAPH narr:Tx_20260702T011828Z {
    narr:Claim_SecondVersionState a narr:Claim ;
      narr:aboutNode narr:Narrative_SecondVersionDocument ;
