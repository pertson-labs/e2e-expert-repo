# ── UPDATE Claim_FirstVersionInitialState: contradicted by second version ────
# The claim that the document is "at the earliest stage with no prior iterations"
# is directly contradicted by the existence of a second version.
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionInitialState skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260702T011828Z {
    narr:Claim_FirstVersionInitialState skos:note "The document was explicitly labeled 'First version', indicating it was at the earliest stage of its lifecycle. Superseded: a second version now exists, confirming at least one iteration has occurred." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionInitialState skos:note ?oldNote .
  }
} ;

