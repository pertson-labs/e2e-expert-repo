PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250716T120000Z a prov:Activity ;
    dct:title "Extraction: Second version reviewer document" ;
    prov:generatedAtTime "2025-07-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated narr:Sample_FirstVersion, narr:Narrative_FirstVersionDocument, narr:Observation_BodyFirstVersion .
} ;

# UPDATE 1: Sample title and description — "First version" → "Second version"
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Sample_FirstVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer and a two-word body. Body updated from 'First version' to 'Second version'." ;
      narr:inputLength 61 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    OPTIONAL { narr:Sample_FirstVersion dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_FirstVersion narr:inputLength ?oldLen . }
  }
} ;

# UPDATE 2: Narrative theme and note — reflects second-version state
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_FirstVersionDocument a narr:Narrative ;
      dct:source narr:Sample_FirstVersion ;
      skos:broader narr:Process ;
      narr:theme "Document progression: second-version stub with reviewer assignment" ;
      skos:note "The document has advanced to its second version ('Second version'), with the same reviewer designated via YAML frontmatter. No substantive content has been authored yet beyond the version label." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# UPDATE 3: Observation body text — "First version" → "Second version"
DELETE {
  GRAPH ?g {
    narr:Observation_BodyFirstVersion skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Observation_BodyFirstVersion a narr:Observation ;
      dct:source narr:Sample_FirstVersion ;
      skos:broader narr:CoreNarratives ;
      skos:note "The document body now reads 'Second version', indicating the stub has been incremented from its initial state. Still a placeholder with no substantive content." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 46 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_BodyFirstVersion skos:note ?oldNote .
  }
}