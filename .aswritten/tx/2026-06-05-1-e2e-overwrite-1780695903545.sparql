PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "First version stub document extraction" ;
    prov:generated
      narr:Sample_FirstVersionStub,
      narr:Actor_Reviewer_ExpertGH,
      narr:Narrative_FirstVersionStub,
      narr:Observation_ReviewerAssignment,
      narr:StyleObservation_YAMLFrontMatter,
      narr:StyleObservation_MinimalBodyText,
      narr:StyleObservation_TerseRegister,
      narr:StyleMetrics_FirstVersionStub .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_FirstVersionStub a narr:Sample ;
      dct:title "First version stub" ;
      dct:description "Minimal document stub with YAML front-matter reviewer assignment and a single body line." ;
      narr:inputLength 62 .

    # ── Actor (PII redacted) ─────────────────────────────────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "[REDACTED reviewer: expert-gh domain]" ;
      skos:note "Reviewer listed in YAML front-matter. Email address redacted per PII policy (allow_pii not set). Domain suffix: aswritten.ai, handle: expert-gh." .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_FirstVersionStub a narr:Narrative ;
      dct:source narr:Sample_FirstVersionStub ;
      narr:theme "Document stub at first version with reviewer assignment" ;
      skos:broader narr:Process ;
      skos:note "This memory represents the initial creation of a document, labelled 'First version', with a single reviewer assigned via YAML front-matter. No substantive content is present beyond the version label." .

    # ── Observation: reviewer assignment ────────────────────────
    narr:Observation_ReviewerAssignment a narr:Observation ;
      skos:broader narr:QualityReviewGates ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "YAML front-matter assigns a reviewer to this document at first version. Reviewer email redacted." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 0 ;
        oa:end 52
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # ── Style Observation 1: YAML front-matter convention ───────
    narr:StyleObservation_YAMLFrontMatter a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "Document uses YAML front-matter delimited by triple-dashes to encode metadata (reviewer list). This is a structured metadata convention common in static-site and documentation toolchains." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 55
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nFirst version"
        ]
      ] .

    # ── Style Observation 2: Minimal / terse body text ──────────
    narr:StyleObservation_MinimalBodyText a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "Body content is a single two-word phrase 'First version' — maximally terse. No elaboration, no punctuation, no sentence structure. Signals a placeholder or stub state." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 57 ;
          oa:end 70
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Terse / informal register ──────────
    narr:StyleObservation_TerseRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "The document's register is informal and minimal. No title, no headings, no body prose. The only content beyond metadata is a two-word version label, indicating a draft or stub register rather than a finished document voice." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 57 ;
          oa:end 70
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_FirstVersionStub a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersionStub ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Metrics computed on body text only ('First version'). Single fragment of 2 words; no sentences, no passive voice, no jargon. Document is a stub." .

  }
}