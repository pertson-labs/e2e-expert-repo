# ── New Sample (Phase 2 is a distinct memory artifact) ──────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T000000Z {

    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Asserts that the pipeline must not crash and must produce a valid slug when the id is absent and the heading is at ## level." ;
      narr:inputLength 232 .

    # ── Style Metrics ──────────────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryPhase2DeriveIdE2E a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:AverageSentenceLength 18 ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:JargonDensity "0.28"^^xsd:decimal ;
      skos:note "Two-sentence body; obligation framing ('Must not crash; must produce'); high jargon density relative to length (slug, id, pipeline, E2E, prod, slugify). Active-voice imperatives dominate." .

    # ── Style Observation 1: Imperative / obligation voice ─────────────────
    narr:StyleObs_Phase2_ImperativeVoice a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Paired imperative obligations ('Must not crash; must produce a valid slug') signal authoritative test-spec register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 200
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: Technical jargon density ──────────────────────
    narr:StyleObs_Phase2_TechJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Dense accumulation of pipeline-domain jargon in a short body: 'missing-id failure pattern', 'prod', '## level heading', 'no id field', 'valid slug'. Assumes reader fluency." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 97 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # ── Style Observation 3: Failure-pattern framing ───────────────────────
    narr:StyleObs_Phase2_FailurePatternFraming a narr:StyleObservation ;
      skos:broader narr:ProblemContext ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The heading encodes both phase number and test purpose ('Derive Id E2E'), framing the document as a regression/E2E test spec rather than a narrative memory." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 95
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Sample Memory Phase 2 — Derive Id E2E" ;
          oa:prefix "## " ;
          oa:suffix "\n\nReproduces"
        ]
      ] .

    # ── Observation: missing-id failure pattern ────────────────────────────
    narr:Observation_Phase2_MissingIdPattern a narr:Observation ;
      skos:broader narr:FailureModesSafety ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The memory explicitly reproduces the missing-id failure pattern from production: ## level heading with no id field in frontmatter." ;
      oa:hasSelector [
