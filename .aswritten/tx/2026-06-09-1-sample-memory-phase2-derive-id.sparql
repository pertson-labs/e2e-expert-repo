# ── UPDATE: Narrative_PipelineSlugGeneration — add Phase 2 / crash-safety ───
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T000000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E testing reproduces the missing-id failure pattern (## level heading, no id field) and asserts the pipeline must not crash under this condition." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_PipelineMustProduceSlug — add crash-safety requirement ────
DELETE {
  GRAPH ?g {
    narr:Claim_PipelineMustProduceSlug skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T000000Z {
    narr:Claim_PipelineMustProduceSlug skos:note "The pipeline must produce a slug from memory content when no explicit id is provided, using either LLM id-gen or deterministic slugify fallback, and must commit the file successfully. Additionally (Phase 2): the pipeline must not crash when the memory uses a ## level heading with no id field." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_PipelineMustProduceSlug skos:note ?oldNote .
  }
}