# ── New Sample node (Phase 2 document) ──────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    narr:Sample_SampleMemoryPhase2DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 test memory submitted without an explicit id field. Exercises crash-safety and valid-slug-generation behaviour in the pipeline intake workflow." ;
      narr:inputLength 231 .

    # ── New Claim: pipeline must not crash ───────────────────────────────────
    narr:Claim_PipelineMustNotCrashOnMissingId
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Phase 2 constraint: the pipeline must not crash when processing a memory that has a ## level heading but no id field. Crash-safety is an explicit acceptance criterion." ;
