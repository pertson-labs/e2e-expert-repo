# ── UPDATE: narr:Narrative_PipelineSlugGeneration ────────────────────────────
# Memory adds: prod failure pattern, ## level heading condition, crash-guard
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This includes the prod failure pattern where a ## level heading is present but no id field: the pipeline must not crash and must produce a valid slug. Phase 2 E2E test exercises this path." ;
      narr:theme "Pipeline slug generation from memory content — including missing-id prod failure pattern" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
} ;

