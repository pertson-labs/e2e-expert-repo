# ── UPDATE: narr:Narrative_PipelineSlugGeneration — add Phase 2 context ─────
# The existing narrative covers Phase 1 slug-gen behaviour. Phase 2 adds
# crash-safety as an explicit constraint. We update skos:note to reflect both.
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (Derive Id E2E) adds the explicit constraint that the pipeline must not crash on this path; it must produce a valid slug regardless of whether the memory uses a ## level heading or omits the id field entirely. This tests a core resilience path in the intake workflow." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}