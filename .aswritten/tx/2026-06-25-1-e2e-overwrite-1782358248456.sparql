PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250714T000000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-14T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Claim_DocumentIsSecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_ShortPunchyBody,
      narr:StyleObs_YAMLFrontmatterStructure,
      narr:StyleObs_MinimalRegister .
} ;

# ── Update Narrative_FirstVersionDeclaration → now reflects second version ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T000000Z {
    narr:Narrative_FirstVersionDeclaration narr:theme "Second version declaration" ;
      skos:note "The document body now reads 'Second version', superseding the prior 'First version' body text. The same reviewer pattern (YAML frontmatter, single reviewer) is retained. This signals progression along a versioned artifact lifecycle." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDeclaration skos:note ?oldNote . }
  }
} ;

# ── Update Claim_DocumentIsFirstVersion → now asserts second version ─────────
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentIsFirstVersion skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T000000Z {
    narr:Claim_DocumentIsFirstVersion skos:note "The body text 'Second version' supersedes the prior 'First version' body, marking this as the second iteration of the document." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentIsFirstVersion skos:note ?oldNote .
    OPTIONAL { narr:Claim_DocumentIsFirstVersion dct:source ?oldSource . }
  }
} ;

# ── New entities (named graph) ───────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T000000Z {

    # Sample
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version (YAML-frontmatter document)" ;
      dct:description "Minimal document with YAML frontmatter listing one reviewer (email redacted) and body text 'Second version'." ;
      narr:inputLength 58 .

    # Claim: document is second version
    narr:Claim_DocumentIsSecondVersion a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' explicitly marks this as the second iteration of the document, temporally superseding the first version." ;
      narr:aboutNode narr:Narrative_FirstVersionDeclaration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_FirstVersionDeclaration .

    # Style Metrics
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2-word body). No passive constructions detected. No domain jargon in body text. YAML frontmatter uses structured key-value notation identical to prior version." ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

    # Style Observation 1: Short punchy body cadence
    narr:StyleObs_ShortPunchyBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word declarative body ('Second version') continues the ultra-minimal cadence pattern established in the first version." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 38 ;
          oa:end 52
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2: YAML frontmatter structured notation
    narr:StyleObs_YAMLFrontmatterStructure a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter block uses key-value list notation for reviewer assignment, consistent with editorial governance conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 36
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # Style Observation 3: Minimal register / plain language
    narr:StyleObs_MinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document register is maximally minimal: no prose elaboration, no hedging, no technical jargon. The body is a bare version label, signalling a draft or stub state." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 38 ;
          oa:end 52
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}