      dct:source narr:Sample_SomeOtherTitle ;
      skos:note "Heading encodes a negative test assertion ('Should Not Win') — an imperative/evaluative framing embedded in a document title, unusual in prose but common in test fixtures." ;
      rdf:value true ;
