PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250720T120000Z a prov:Activity ;
    dct:title "Extraction: Second version document" ;
    prov:generatedAtTime "2025-07-20T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDeclaration,
      narr:Observation_ReviewerFrontmatter_SecondVersion,
      narr:StyleObs_PlainLanguage_SecondVersion,
      narr:StyleObs_ShortPunchyCadence_SecondVersion,
      narr:StyleObs_FrontmatterConvention_SecondVersion,
      narr:StyleMetrics_SecondVersion .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter (reviewer metadata) and a single body line declaring 'Second version'. Structurally identical to the first version artifact but asserts a new iteration." ;
      narr:inputLength 62 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersionDeclaration
      a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "The document asserts itself as a second version, signalling progression in a versioned artifact lifecycle. Reviewer metadata in frontmatter indicates the same review-gated workflow as the first version." ;
      narr:theme "Second version declaration" .

    # ── Observation: reviewer frontmatter ────────────────────────
    narr:Observation_ReviewerFrontmatter_SecondVersion
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "YAML frontmatter declares a reviewer role via a redacted email address, indicating the same structured review process as the first version document." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 0 ;
        oa:end 46
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - [REDACTED]" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # ── Style Observation 1: Plain Language ──────────────────────
    narr:StyleObs_PlainLanguage_SecondVersion
      a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text is two words with no technical vocabulary, exemplifying plain language register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 62
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: Short Punchy Cadence ────────────────
    narr:StyleObs_ShortPunchyCadence_SecondVersion
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The entire body is a two-word declarative phrase, representing maximum cadence compression." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 62
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Structured Frontmatter Convention ───
    narr:StyleObs_FrontmatterConvention_SecondVersion
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter with a 'reviewers' key follows a structured editorial convention for review-gated document workflows, consistent with the first version artifact." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2-word body). Active voice ratio and jargon density computed on body text only; frontmatter excluded from prose metrics. Metrics identical to first version document." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}