# ── New entities (named graph) ───────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {

    # ── Sample node ──────────────────────────────────────────────────────────
    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field (## level heading only). Reproduces the missing-id failure pattern from production to validate that the pipeline does not crash and produces a valid slug." ;
      dct:created "2025-07-16"^^xsd:date ;
      narr:inputLength 215 .

    # ── Narrative: crash resistance (new angle not in snapshot) ───────────────
    narr:Narrative_PipelineCrashResistance a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:ReliabilityResilience ;
      narr:theme "Pipeline must not crash when processing a memory with no explicit id field" ;
      skos:note "Phase 2 E2E test asserts a resilience requirement distinct from slug generation: the pipeline must handle the missing-id case without crashing, in addition to producing a valid slug. This is a robustness/fault-tolerance claim about the id-derivation path." .

    # ── Claims ───────────────────────────────────────────────────────────────
    narr:Claim_PipelineMustNotCrash a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:aboutNode narr:Narrative_PipelineCrashResistance ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineCrashResistance ;
      skos:note "'Must not crash' is an explicit acceptance criterion for the missing-id path, separate from the slug-production requirement." .

    narr:Claim_Phase2ReproducesFailurePattern a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_PipelineMustProduceSlug ;
      skos:note "Phase 2 explicitly reproduces the missing-id failure pattern from production using a ## level heading with no id field, providing additional evidence for the slug-generation narrative." .

    # ── Observation ──────────────────────────────────────────────────────────
    narr:Observation_MissingIdFailurePattern a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:FrictionFailure ;
      skos:note "Memory explicitly names the production failure pattern it reproduces: ## level heading with no id field. This grounds the E2E test scenario." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 130
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "missing-id failure pattern from prod (## level heading,\nno id field)" ;
        oa:prefix "Reproduces the " ;
        oa:suffix ". Must not crash"
      ] .

    # ── Style Observations ───────────────────────────────────────────────────

    # SO-1: Obligatory modal 'must' — authoritative specification register
    narr:StyleObs_Phase2_ModalMust a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      rdf:value true ;
      skos:note "Repeated use of 'must' (twice in two sentences) signals a hard specification requirement, not a preference. Establishes an authoritative, non-negotiable register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 130 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "). " ;
          oa:suffix ""
        ]
      ] .

    # SO-2: Technical jargon density — domain-specific vocabulary
    narr:StyleObs_Phase2_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      rdf:value true ;
      skos:note "High jargon density for document length: 'id field', 'slug', 'E2E', '## level heading', 'prod', 'missing-id failure pattern'. Technical pipeline vocabulary dominates the body text." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 40 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod (## level heading,\nno id field)." ;
          oa:prefix "\n\n" ;
          oa:suffix " Must not crash"
        ]
      ] .

    # SO-3: Imperative sentence structure — test-specification cadence
    narr:StyleObs_Phase2_ImperativeRegister a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      rdf:value true ;
      skos:note "The body consists of two short declarative/imperative sentences. The second sentence ('Must not crash; must produce a valid slug.') uses a headless imperative structure — subject omitted — typical of acceptance-criteria or test-spec writing." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 130 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryPhase2DeriveIdE2E a narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 18 ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Very short document (~2 body sentences, ~35 body words). Technical-specification register. Headless imperative construction ('Must not crash') creates passive-adjacent feel despite active verbs. Highest jargon density of the test memory series: slug, E2E, id field, prod, ## level heading, missing-id failure pattern." .

  }
} ;

# ── UPDATE: narr:Narrative_PipelineSlugGeneration — extend skos:note with Phase 2 evidence ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E test (## level heading, no id field) additionally asserts the pipeline must not crash during this derivation path, confirming a robustness requirement alongside the slug-production requirement." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}