      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "Body consists of a single word ('Body.') — extreme register minimalism, characteristic of a test fixture rather than a substantive document." ;
      rdf:value false ;
      oa:hasTarget [
