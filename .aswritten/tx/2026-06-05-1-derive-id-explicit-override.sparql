PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250721T000000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — pipeline test (no id field)" ;
    prov:generatedAtTime "2025-07-21T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main@unknown" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:Claim_SomeOtherTitleSlugFallback,
      narr:StyleObs_NegationTitleFraming,
      narr:StyleObs_SingleWordBody,
      narr:StyleObs_EmailReviewerNaming,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250721T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal pipeline test memory with YAML frontmatter reviewer and a single-word body. Submitted without an explicit id field, exercising slug-generation fallback logic." ;
      narr:inputLength 99 .

    # ── Claim ───────────────────────────────────────────────────
    # Supports the existing Narrative_PipelineSlugGenFallback (uses existing IRI)
    narr:Claim_SomeOtherTitleSlugFallback
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "A third pipeline test memory submitted without an explicit id field. The title 'Some Other Title That Should Not Win' signals that the H1 heading must NOT be used as the canonical slug when a better derivation path exists — reinforcing that slug selection logic must be discriminating, not merely first-heading-wins." ;
      narr:aboutNode narr:Narrative_PipelineSlugGenFallback ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFallback .

    # ── Style Observations ───────────────────────────────────────

    # SO-1: Negation framing in title (Antithesis / rhetorical device)
    narr:StyleObs_NegationTitleFraming
      a narr:StyleObservation ;
      skos:broader narr:Antithesis ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Title uses explicit negation ('Should Not Win') as a rhetorical signal — framing the heading as a deliberate counter-example rather than a genuine label." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 91
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n"
        ]
      ] .

    # SO-2: Extreme brevity — single-word body sentence (ShortPunchyCadence)
    narr:StyleObs_SingleWordBody
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The entire document body is a single word ('Body.') — an extreme instance of short-punchy cadence, likely a placeholder stub rather than intentional prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 94 ;
          oa:end 99
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-3: Email address used as reviewer identifier (NamingConventions)
    narr:StyleObs_EmailReviewerNaming
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Reviewer identity expressed as a full email address in YAML frontmatter rather than a display name — a naming convention that prioritises machine-readable identity over human-readable labels." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 19 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "test+expert-gh@aswritten.ai" ;
          oa:prefix "  - " ;
          oa:suffix "\n"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (~8 words of prose across title and body). Body is a single declarative stub sentence. No jargon. Title uses modal negation ('Should Not Win')." ;
      narr:AverageSentenceLength 4 ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
}