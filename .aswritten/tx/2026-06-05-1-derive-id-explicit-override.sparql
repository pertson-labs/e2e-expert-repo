# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Pipeline E2E test memory with a YAML frontmatter reviewer field and a content H1 heading that must NOT be used as the slug. Validates that title content does not override the pipeline id/slug derivation logic." ;
      narr:inputLength 82 .

    # ── Claim: title must not override slug ─────────────────────
    narr:Claim_TitleMustNotOverrideSlug a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' must not be used as the pipeline slug. The slug must be derived from the id field or deterministic fallback, not from the document title." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Style Observation 1: Declarative heading as negative assertion ──
    narr:StyleObs_TitleOverrideHeading a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "H1 heading is phrased as a declarative negative assertion — 'Should Not Win' — embedding the test expectation directly into the document title. Authoritative, imperative register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 82
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Observation 2: Minimal body — single-word sentence ──
    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word sentence 'Body.' — extreme brevity, placeholder register. Cadence is maximally compressed; content is purely structural/test scaffolding." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 84 ;
          oa:end 89
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: YAML frontmatter jargon / technical register ──
    narr:StyleObs_YAMLFrontmatterJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses technical key 'reviewers' with a structured email value. Technical/engineering register dominates the metadata layer; PII redacted per policy." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten" ;
          oa:prefix "" ;
          oa:suffix ".ai\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Extremely short document. Body is a single one-word sentence. Active voice ratio not meaningfully computable; defaulted to 1.0 (no passive constructions present). Jargon density high relative to document length due to YAML frontmatter and pipeline-specific heading." ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
