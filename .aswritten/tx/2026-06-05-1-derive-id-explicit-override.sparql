      ] .

    # SO-3: Title as negative assertion — rhetorical device in heading
    narr:StyleObs_TitleAsNegativeAssertion a narr:StyleObservation ;
      skos:broader narr:RhetoricalDevices ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 title embeds a normative negative assertion ('Should Not Win') — an unusual rhetorical move that encodes a test expectation directly in the document heading. This is a meta-textual style feature: the title describes what the pipeline must NOT do." ;
