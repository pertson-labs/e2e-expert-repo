          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. YAML frontmatter reviewer declaration — structured metadata style
    narr:StyleObs_FrontmatterReviewerDeclaration
      a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list with an email address. This is a structured metadata convention — machine-readable attribution embedded in the document header." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # 3. Heading as test artifact — title phrasing encodes test intent
    narr:StyleObs_HeadingAsTestArtifact
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a self-referential test label. The phrase 'Should Not Win' encodes the expected pipeline behavior directly in the title text — an unusual naming convention that doubles as a test assertion." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 48 ;
          oa:end 82
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
