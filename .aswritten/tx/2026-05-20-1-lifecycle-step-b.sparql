# ── INSERT: New Sample for revised document ──────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      skos:note "Revised decision document from Quinton Fairweather (CTO), 2026-04-06. Supersedes prior Zypherion adoption. Meridian chosen for native batch and streaming ingestion support." ;
      narr:inputLength "487"^^xsd:integer .

    # ── New Narrative: Meridian Adoption ────────────────────────────────────
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology adoption decision revised: Meridian replaces Zypherion for analytics due to streaming ingestion gap" ;
      skos:note "The organisation has switched its analytics database selection from Zypherion to Meridian. The trigger was discovery of critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Q3 2026 migration window is retained." .

    # ── New Claims ───────────────────────────────────────────────────────────
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian has been selected as the analytics database, replacing Zypherion. Stated as a firm revised decision by the CTO." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption .

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion. This is the stated reason for rejecting Zypherion. Single-source assertion from CTO." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    narr:Claim_MeridianBatchStreamingCapability a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming natively. Stated by CTO as the key differentiator over Zypherion. Single-source assertion; no independent benchmark cited." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Migration to Meridian will proceed in the same Q3 2026 window originally planned for Zypherion. Timeline retained from prior decision." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # ── Observations ────────────────────────────────────────────────────────
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "CTO direct quote announcing switch to Meridian and rejection of Zypherion due to streaming gaps." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 330
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\nMeridian handles both batch"
        ]
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Explicit supersession statement: this revised decision replaces the prior Zypherion adoption decision." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 337 ;
          oa:end 384
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "Meridian handles both batch and streaming natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    narr:Obs_ZypherionStreamingGap a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:FailureModesSafety ;
      skos:note "Key decision rationale: Zypherion lacks streaming ingestion, which was the disqualifying factor." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 430 ;
          oa:end 475
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Zypherion lacks streaming ingestion" ;
          oa:prefix "- **Reason**: " ;
          oa:suffix "\n- **Timeline**:"
        ]
      ] .

    # ── Style Observations ───────────────────────────────────────────────────
    narr:StyleObs_DirectDeclarativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO speaks in first-person plural imperatives with no hedging: 'We are now switching to Meridian instead.' Authoritative, unambiguous register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 240 ;
          oa:end 290
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles both"
        ]
      ] .

    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Document uses database-domain jargon without definition: 'streaming ingestion', 'batch', 'analytics'. Assumes technical audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 291 ;
          oa:end 336
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Meridian handles both batch and streaming natively." ;
          oa:prefix "switching to Meridian instead.\n" ;
          oa:suffix "\"\n\nThis supersedes"
        ]
      ] .

    narr:StyleObs_SupersessionRhetoric a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Single declarative sentence used to formally supersede a prior decision. Minimal ceremony; maximum clarity. Characteristic of engineering decision culture." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 337 ;
          oa:end 384
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "and streaming natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
