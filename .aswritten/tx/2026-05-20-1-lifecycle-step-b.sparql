  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:StyleMetrics_ZypherionDecision
      skos:note "Revised document retains short declarative cadence. Active voice dominant. Jargon density slightly higher with addition of 'streaming ingestion', 'batch', 'natively'. Formal-professional register. Supersession language ('This supersedes') adds institutional authority marker." ;
      narr:AverageSentenceLength "13"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
