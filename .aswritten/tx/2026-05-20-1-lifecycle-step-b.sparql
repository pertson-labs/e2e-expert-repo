# ── INSERT: New entities (new claims + style observations) ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Claim: Zypherion streaming ingestion gap (reason for switch)
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the decisive technical reason for abandoning it in favour of Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # New Claim: Meridian batch + streaming capability
    narr:Claim_MeridianBatchStreamingCapability a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively — the stated technical advantage over Zypherion that drove the switch." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .

    # Style Observation 1: Direct declarative tone in supersession
    narr:StyleObs_DirectDeclarativeTone_Rev a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "CTO uses unhedged declarative statements to announce the reversal, projecting authority" ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 240
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix " Meridian handles both batch"
        ]
      ] .

    # Style Observation 2: Supersession rhetoric
    narr:StyleObs_SupersessionRhetoric_Rev a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Explicit supersession statement functions as institutional authority marker, formally retiring prior decision" ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 265 ;
          oa:end 310
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 3: Technical jargon — streaming ingestion
    narr:StyleObs_TechnicalJargon_Rev a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "'streaming ingestion' introduced as precise technical discriminator; 'batch and streaming natively' compounds jargon density" ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 140 ;
          oa:end 200
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in its streaming ingestion" ;
          oa:prefix "found " ;
          oa:suffix ". We are now switching"
        ]
      ] .

    # Style Metrics (new node for revised document — source same sample, distinct metrics node)
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Revised document: short declarative cadence retained. Slightly elevated jargon with streaming/batch terminology. Supersession language adds formal institutional register." ;
      narr:AverageSentenceLength "13"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.21"^^xsd:decimal .
