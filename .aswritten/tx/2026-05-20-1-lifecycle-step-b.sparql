# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T140000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian — 2026-04-06" ;
    prov:generatedAtTime "2026-04-06T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "database-decision-revised-zypherion-to-meridian-2026-04-06" ;
    narr:originRef "main" ;
    prov:generated
      narr:Claim_ZypherionStreamingGap,
      narr:Claim_MeridianBatchStreamingCapability,
      narr:StyleObs_DirectDeclarativeTone_Rev,
      narr:StyleObs_SupersessionRhetoric_Rev,
      narr:StyleObs_TechnicalJargon_Rev,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption: Meridian replaces Zypherion as analytics database" ;
      skos:note "REVISED 2026-04-06: The organisation is switching from Zypherion to Meridian for analytics. Zypherion was found to have critical gaps in streaming ingestion. Meridian handles both batch and streaming natively. Migration remains on the Q3 2026 timeline. This supersedes the original Zypherion adoption decision." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the choice ──────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "REVISED: Meridian replaces Zypherion as the chosen database for the analytics pipeline. Zypherion was evaluated further and found to have critical gaps in streaming ingestion." ;
      narr:hasConvictionLevel narr:Conviction_Boulder .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same Q3 2026 window, now for Meridian
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3 skos:note "Migration to Meridian (replacing Zypherion) remains on the same Q3 2026 timeline. The switch does not alter the migration window." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
  }
} ;

# ── DELETE: Claim_ZypherionPerformance15x — explicitly superseded ────────────
# The 15x performance claim was the rationale for Zypherion adoption.
# The memory explicitly states Zypherion has critical gaps and the decision is superseded.
# This is a temporal supersession + explicit retraction of the adoption rationale.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

