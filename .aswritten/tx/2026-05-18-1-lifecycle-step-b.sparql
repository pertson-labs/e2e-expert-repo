# ── New Sample for the revised decision document ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and announces Meridian as the analytics database, citing critical gaps in Zypherion's streaming ingestion. Q3 2026 migration window retained." ;
      narr:inputLength 580 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → reframed as Meridian switch ────────
# Justified by: memory explicitly states "We are now switching to Meridian instead"
# and "This supersedes the previous Zypherion decision."
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology decision reversal driven by capability gap discovery" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps. Meridian replaces Zypherion, selected for native batch and streaming support. Q3 2026 migration window is retained. Decision attributed to CTO Quinton Fairweather on 2026-04-06. Supersedes narr:Narrative_ZypherionAdoption." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

