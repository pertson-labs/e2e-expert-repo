# ── INSERT: New Sample node for the revised document ─────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {

    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 586 .

    # ── Narrative: Meridian adoption (new entity for the revised framing) ──
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DataIntegrationFlows ;
      narr:theme "Adopting Meridian as the analytics database after Zypherion streaming failure" ;
      skos:note "The team evaluated Zypherion further, found critical streaming ingestion gaps, and pivoted to Meridian, which handles both batch and streaming natively. The Q3 2026 migration window is preserved." .

    # ── Claim: Zypherion streaming gap ──────────────────────────────────────
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:DataIntegrationFlows ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      skos:note "Zypherion lacks streaming ingestion capability — a critical gap discovered during extended evaluation." ;
      narr:supports narr:Narrative_MeridianAdoption .

    # ── Claim: Meridian streaming capability ────────────────────────────────
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:DataIntegrationFlows ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "Meridian handles both batch and streaming natively, addressing the gap that disqualified Zypherion." ;
      narr:supports narr:Narrative_MeridianAdoption .

    # ── Claim: Timeline preserved ────────────────────────────────────────────
    narr:Claim_MeridianTimeline a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:NarrativeDrivenRoadmap ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Meridian migration proceeds on the same Q3 2026 window originally planned for Zypherion." .

    # ── StyleObservation 1: Direct declarative voice ─────────────────────────
    narr:StyleObs_DirectDeclaration a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "First-person plural declaratives used for all key decisions: 'We evaluated', 'We are now switching'." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 195 ;
          oa:end 280
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\nMeridian handles both"
        ]
      ] .

    # ── StyleObservation 2: Supersession marker ──────────────────────────────
    narr:StyleObs_SupersessionMarker a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession statement used as a standalone sentence to signal authority and finality of the revised decision." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 367 ;
          oa:end 417
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # ── StyleObservation 3: Structured bullet key decisions ──────────────────
    narr:StyleObs_BulletKeyDecisions a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Bold-label bullet format (Database / Reason / Timeline) delivers decisions as scannable, parallel micro-assertions — a hallmark of decision-memo style." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 419 ;
          oa:end 585
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # ── StyleMetrics (new sample) ────────────────────────────────────────────
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.82"^^xsd:decimal ;
      narr:JargonDensity "0.12"^^xsd:decimal ;
      skos:note "Short declarative sentences; active voice dominant; moderate jargon (streaming ingestion, batch, analytics pipeline)." .
  }
}