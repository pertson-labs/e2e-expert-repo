# ── New Sample (REVISED document is a distinct memory artifact) ──────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDBDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and selects Meridian as the analytics database, citing critical gaps in Zypherion's streaming ingestion. Supersedes the original Zypherion decision. Q3 2026 migration window retained." ;
      narr:inputLength 541 .
  }
} ;

# ── New Narrative: Meridian Adoption ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology re-selection driven by streaming ingestion capability gap" ;
      skos:note "The organisation reverses its Zypherion analytics database decision and adopts Meridian instead. The trigger is a critical gap in Zypherion's streaming ingestion; Meridian handles both batch and streaming natively. The Q3 2026 migration window is retained. Decision attributed to CTO Quinton Fairweather." .
  }
} ;

