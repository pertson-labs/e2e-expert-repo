  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "SUPERSEDED: Zypherion was selected as the analytics database by CTO Quinton Fairweather, but this decision has been explicitly reversed. Meridian is now the chosen database. See narr:Claim_MeridianDatabaseChoice." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_MeridianDecision_20260406 .
