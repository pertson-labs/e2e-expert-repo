PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    dct:title "Second version stub extraction" ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_Conciseness,
      narr:StyleObs_SecondVersion_VersionDeclaration,
      narr:StyleObs_SecondVersion_ReviewerFrontmatter .
} ;

# ── Update: Narrative_FirstVersionDraft → now reflects second version ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDraft narr:theme ?oldTheme .
    narr:Narrative_FirstVersionDraft skos:note ?oldNote .
    narr:Narrative_FirstVersionDraft dct:source ?oldSource .
    narr:Narrative_FirstVersionDraft skos:broader ?oldBroader .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_FirstVersionDraft narr:theme "Second version declaration" ;
      skos:note "The document declares itself a second version, signalling iteration on an earlier draft. The same named reviewer (expert-gh) is retained in the YAML frontmatter, indicating the review workflow persists across versions." ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDraft narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDraft skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_FirstVersionDraft dct:source ?oldSource . }
    OPTIONAL { narr:Narrative_FirstVersionDraft skos:broader ?oldBroader . }
  }
} ;

# ── New entities (named graph) ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # Sample
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal stub document with YAML frontmatter listing a reviewer and a two-word body declaring this the second version." ;
      narr:inputLength 68 .

    # Style Metrics
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Minimal document: single two-word sentence in body. No passive constructions. No technical jargon. Informal register. Structurally identical to first version except version ordinal." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

    # Style Observation 1 — Conciseness / minimal body
    narr:StyleObs_SecondVersion_Conciseness a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body consists of exactly two words. Extreme conciseness; no elaboration or context beyond the version label." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 49 ;
          oa:end 63
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — Version declaration as naming convention
    narr:StyleObs_SecondVersion_VersionDeclaration a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document body uses ordinal version labelling ('Second version') as the sole content, establishing a naming convention for iterative drafts." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 49 ;
          oa:end 63
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 3 — YAML frontmatter reviewer pattern
    narr:StyleObs_SecondVersion_ReviewerFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter uses a 'reviewers' list with email addresses to assign review responsibility. Pattern is consistent with the first version, indicating an established editorial convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 47
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "" ;
          oa:suffix "\n---"
        ]
      ] .

  }
}