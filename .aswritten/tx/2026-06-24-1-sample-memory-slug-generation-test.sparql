PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250714T000000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "Sample Memory With Distinctive Heading — slug generation test" ;
    prov:generated
      narr:Sample_SampleMemoryDistinctiveHeading,
      narr:Narrative_PipelineSlugGeneration,
      narr:Claim_SlugFromContent_LLMOrFallback,
      narr:Actor_Reviewer_ExpertGH,
      narr:Observation_SlugMechanisms,
      narr:StyleObservation_ImperativeMood,
      narr:StyleObservation_TechnicalJargon,
      narr:StyleObservation_DashPunctuation,
      narr:StyleMetrics_SampleMemoryDistinctiveHeading .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 247 ;
      dct:description "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_SlugFromContent_LLMOrFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Two slug-generation mechanisms are asserted: (1) LLM id-gen call, (2) deterministic slugify fallback. Both must result in a successful file commit." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "Expert Reviewer (test+expert-gh)" ;
      skos:note "Reviewer listed in YAML frontmatter. Email redacted per PII policy." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugMechanisms a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The memory explicitly names two slug-generation paths: LLM id-gen call and deterministic slugify fallback." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 119 ;
        oa:end 247
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "slug from the memory content — " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Imperative mood / authoritative tone
    narr:StyleObservation_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Imperative construction ('The pipeline must produce') signals a requirements-style authoritative register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 79 ;
          oa:end 119
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "\n\n" ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # 2. Technical jargon density
    narr:StyleObservation_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Dense use of pipeline-specific jargon: 'id field', 'LLM id-gen call', 'deterministic slugify fallback', 'commit the file'. Assumes reader familiarity with CI/CD and NLP pipeline concepts." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 140 ;
          oa:end 220
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "either via the " ;
          oa:suffix " — and commit"
        ]
      ] .

    # 3. Em-dash as rhetorical separator
    narr:StyleObservation_DashPunctuation a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Em-dash used twice in the body to introduce elaboration and conclusion ('— either via…', '— and commit…'). Signals informal-technical hybrid register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 119 ;
          oa:end 247
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "slug from the memory content — either via the LLM id-gen call or the" ;
          oa:prefix "produce a\n" ;
          oa:suffix "\ndeterministic slugify fallback"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength "28"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.35"^^xsd:decimal ;
      skos:note "Short document (2 sentences in body). Active voice dominates ('must produce', 'must commit'). High jargon density for document length due to pipeline-specific terminology." .

  }
}