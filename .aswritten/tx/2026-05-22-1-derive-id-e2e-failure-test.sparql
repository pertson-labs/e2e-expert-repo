# ── New Sample: Phase 2 test document ───────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    narr:Sample_Phase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern (## level heading, no id field). Validates that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 322 .

    # ── New Claim: crash-safety + valid-slug acceptance criterion ────────────
    narr:Claim_CrashSafetySlugRequired a narr:Claim ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      skos:note "Phase 2 acceptance criteria: the pipeline must not crash when the id field is absent and a ## level heading is present; it must produce a valid slug. This extends the Phase 1 slug-gen claim with explicit crash-safety and output-validity requirements." .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_Phase2DeriveIdE2E a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      narr:AverageSentenceLength "20"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.70"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Short document (~3 sentences). Technical register with obligatory modal constructions ('Must not crash; must produce'). Jargon terms: pipeline, slug, id field, E2E, ## level heading, failure pattern." .

    # ── Style Observation 1: Technical register / JargonPolicy ───────────────
    narr:StyleObs_Phase2_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Dense technical jargon: 'missing-id failure pattern', '## level heading', 'no id field', 'valid slug' — all domain-specific pipeline terms used without definition." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 107 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading,\nno id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    # ── Style Observation 2: Obligational modal constructions ────────────────
    narr:StyleObs_Phase2_ObligationalModal a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Paired deontic imperatives ('Must not crash; must produce') signal acceptance-criteria register — terse, test-spec voice with no hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 176 ;
          oa:end 222
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Heading-as-title convention ─────────────────────
    narr:StyleObs_Phase2_JargonDensity a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "The document uses a ## Markdown heading as its sole title, deliberately omitting an id field — this is itself the test fixture, making the document's form inseparable from its function." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 40 ;
          oa:end 88
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Sample Memory Phase 2 — Derive Id E2E" ;
          oa:prefix "## " ;
          oa:suffix "\n\nReproduces"
        ]
      ] .

  }
} ;

# ── UPDATE: narr:Narrative_PipelineSlugGeneration — extend skos:note ─────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) extends this: the pipeline must not crash when a ## level heading is present with no id field, and must produce a valid slug. This tests both the critical fallback path and crash-safety of the ingestion pipeline." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_SlugFromContentRequired — extend skos:note ────────────
DELETE {
  GRAPH ?g {
    narr:Claim_SlugFromContentRequired skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Claim_SlugFromContentRequired skos:note "The pipeline must produce a slug from the memory content and commit the file successfully when no explicit id is provided. Two mechanisms are acceptable: LLM id-gen call or deterministic slugify fallback. Phase 2 adds: must not crash on ## level heading with no id field; must produce a valid slug (crash-safety criterion)." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_SlugFromContentRequired skos:note ?oldNote .
  }
}