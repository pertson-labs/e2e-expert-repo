      skos:note "When no id field is present, the pipeline must produce a valid slug (via LLM id-gen or deterministic slugify fallback) and commit the file successfully." ;
      narr:aboutNode narr:Process ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration .
  }
} ;

