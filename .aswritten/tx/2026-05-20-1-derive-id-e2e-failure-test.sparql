      narr:inputLength 221 .
  }
} ;

# ── Update existing Narrative to reflect Phase 2 extension ──────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T130000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (Derive Id E2E) extends this by reproducing the missing-id failure pattern from prod (## level heading, no id field): the pipeline must not crash and must produce a valid slug." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

