INSERT DATA {
  GRAPH narr:Tx_20250714T130000Z {
    narr:Sample_SampleMemoryPhase2DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Exercises the pipeline slug-generation path and the crash-safety requirement." ;
