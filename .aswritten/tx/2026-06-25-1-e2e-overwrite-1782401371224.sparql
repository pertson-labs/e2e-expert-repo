PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250717T130000Z a prov:Activity ;
    dct:title "Extraction: Second version document" ;
    prov:generatedAtTime "2025-07-17T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion_20250717,
      narr:Narrative_SecondVersionProgression,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_MinimalBody,
      narr:StyleObs_SecondVersion_FrontmatterReviewer,
      narr:StyleObs_SecondVersion_VersioningCadence .
} ;

# ── New entities (named graph) ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250717T130000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion_20250717 a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter declaring the same reviewer and body text 'Second version'. Successor to the First version document." ;
      narr:inputLength 67 .

    # ── Narrative: second-version progression ───────────────────
    narr:Narrative_SecondVersionProgression a narr:Narrative ;
      dct:source narr:Sample_SecondVersion_20250717 ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      narr:theme "Versioned artifact lifecycle progression" ;
      skos:note "The document advances the artifact from 'First version' to 'Second version', confirming an active versioning lifecycle. The same reviewer (test+expert-gh@aswritten.ai, redacted) is retained, indicating continuity of the review process across versions." .

    # ── Style Observation 1: ultra-minimal body ──────────────────
    narr:StyleObs_SecondVersion_MinimalBody a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion_20250717 ;
      skos:note "Body consists of a single two-word noun phrase. Register is ultra-minimal / placeholder, identical in structure to the first version." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_20250717 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: YAML frontmatter reviewer pattern ───
    narr:StyleObs_SecondVersion_FrontmatterReviewer a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion_20250717 ;
      skos:note "Reviewer is declared in YAML frontmatter using a structured list key ('reviewers:'). This editorial convention persists from the first version, establishing a consistent review-gate pattern." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_20250717 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Observation 3: ordinal versioning cadence ─────────
    narr:StyleObs_SecondVersion_VersioningCadence a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion_20250717 ;
      skos:note "Version label uses plain ordinal English ('Second version') rather than semantic versioning (e.g., v2.0). This matches the 'First version' naming convention, indicating a human-readable, non-technical versioning style." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_20250717 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion_20250717 ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Single two-word noun-phrase body. No verbs, no sentences in the traditional sense. No jargon. Active voice ratio notional. Register: ultra-minimal / placeholder. Structurally identical to the first version document." .

  }
} ;

# ── UPDATE: extend existing FirstVersionDeclaration narrative ────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T130000Z {
    narr:Narrative_FirstVersionDeclaration skos:note "The document declared itself a 'First version', signalling the start of a versioned artifact lifecycle. A named reviewer was assigned in the frontmatter, indicating a structured review process from the outset. A subsequent 'Second version' document (narr:Sample_SecondVersion_20250717) confirms the lifecycle is actively progressing with the same reviewer retained." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration skos:note ?oldNote .
  }
}