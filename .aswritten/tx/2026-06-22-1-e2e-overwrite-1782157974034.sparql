PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250716T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "Second version stub with reviewer frontmatter" ;
    prov:generated
      narr:Sample_SecondVersionStub,
      narr:StyleMetrics_SecondVersionStub,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_RegisterFormality,
      narr:StyleObs_SecondVersion_NamingConvention .
} ;

# ── New Sample node ──────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Sample_SecondVersionStub a narr:Sample ;
      dct:title "Second version stub with reviewer frontmatter" ;
      dct:description "Minimal document stub containing YAML frontmatter with a reviewer email and a two-word body: 'Second version'." ;
      narr:inputLength 62 .
  }
} ;

# ── Update Narrative: theme/note reflect 'Second version' ────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocumentStub narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_FirstVersionDocumentStub
      dct:source narr:Sample_SecondVersionStub ;
      narr:theme "Document iteration: second-version stub awaiting content" ;
      skos:note "The document now declares itself a 'Second version', indicating a revision cycle has occurred. The YAML frontmatter retains the same reviewer, confirming a review-gated authoring workflow persists across versions." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocumentStub narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocumentStub skos:note ?oldNote . }
  }
} ;

# ── Update Observation: body text changed to 'Second version' ────
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBodyText skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Observation_FirstVersionBodyText
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The entire document body is the two-word phrase 'Second version', signalling a revision of the prior stub. The version label has incremented from 'First' to 'Second'." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBodyText skos:note ?oldNote .
  }
} ;

# ── New StyleMetrics node ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleMetrics_SecondVersionStub a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:broader narr:StyleMetrics ;
      skos:note "Metrics computed on body text only ('Second version'). AverageSentenceLength=2 words (single fragment, no full sentence). ActiveVoiceRatio=1.0 (no passive constructions). JargonDensity=0.0 (no domain jargon in body)." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── StyleObservation 1: Version label as naming convention ───────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Ordinal version label ('Second version') used as the sole body content, consistent with a sequential stub naming pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── StyleObservation 2: Register formality (minimal/placeholder) ─
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_RegisterFormality a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Body text is a bare noun phrase with no punctuation, verb, or sentence structure — consistent with an informal placeholder register." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── StyleObservation 3: Editorial rules — reviewer frontmatter ───
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_NamingConvention a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "YAML frontmatter reviewer field uses a structured email pattern (role+qualifier@domain), indicating a systematic editorial assignment convention carried forward from the first version." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .
  }
}