      narr:aboutNode narr:Narrative_HeadingNotUsedAsSlug ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' explicitly encodes the assertion that heading text must not win as the slug source. This is a negative constraint on the slug-generation pipeline." .

    # ── Observations ─────────────────────────────────────────────
    narr:Observation_ReviewerFrontmatter a narr:Observation ;
