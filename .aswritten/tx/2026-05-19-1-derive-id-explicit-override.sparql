      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading encodes a pipeline constraint as a test assertion: the heading text must not be used as the slug or id output." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
