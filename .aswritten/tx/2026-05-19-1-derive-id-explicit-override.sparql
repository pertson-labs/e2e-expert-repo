    narr:StyleObs_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes for structured metadata (reviewers list). This is a consistent editorial convention across test memories in this corpus." ;
