PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250720T130000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — Slug Override Test" ;
    prov:generatedAtTime "2025-07-20T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "some-other-title-that-should-not-win" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:Claim_HeadingMustNotDetermineSlug,
      narr:Obs_ReviewerFrontmatter,
      narr:StyleObs_MinimalBodyRegister,
      narr:StyleObs_HeadingAsNegativeAssertion,
      narr:StyleObs_FrontmatterYAMLConvention,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250720T130000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter reviewer field and a single-word body. Heading is deliberately named to assert it should NOT be used as the pipeline-generated slug. No explicit id field provided." ;
      narr:inputLength 88 .

    # ── Claim: heading must not determine slug ───────────────────────────────
    narr:Claim_HeadingMustNotDetermineSlug
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a test assertion: the pipeline must NOT derive the slug from this heading when a better identifier is available (e.g., via LLM id-gen or frontmatter). The heading name encodes the expected negative outcome." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Observation: reviewer in frontmatter ─────────────────────────────────
    narr:Obs_ReviewerFrontmatter
      a narr:Observation ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:CoreWorkflows ;
      skos:note "YAML frontmatter contains a 'reviewers' list with one entry: test+expert-gh@aswritten.ai (redacted per PII policy). This is the same reviewer already captured in narr:Actor_TestExpertReviewer. Frontmatter reviewer field is a pipeline metadata convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Observations (minimum 3) ───────────────────────────────────────

    narr:StyleObs_MinimalBodyRegister
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word 'Body.' — a placeholder register signalling this is a test artifact, not substantive prose. Extremely low information density." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 82 ;
          oa:end 87
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "# Some Other Title That Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_HeadingAsNegativeAssertion
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading encodes a negative test assertion in plain English: 'Should Not Win' is a QA/test idiom asserting the heading must not be selected as the output slug. Rhetorical device: negation embedded in document title." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 80
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    narr:StyleObs_FrontmatterYAMLConvention
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter delimited by triple-dashes (---) is used for structured metadata (reviewers list). This is a consistent editorial convention across test memories in this corpus." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 48
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\n# Some Other Title"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Minimal test artifact. Body is a single word; no sentences in conventional sense. Active voice not applicable. Jargon density near zero in body; heading contains no technical terms." ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
} ;

# Update narr:Narrative_PipelineSlugGeneration to reference the new sample as additional evidence
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T130000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This validates the fallback path of the ingestion pipeline. A third test case ('Some Other Title That Should Not Win') further asserts that the pipeline must not naively adopt the H1 heading as the slug when a better identifier is available." ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}