# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250716T100000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Third pipeline test memory submitted without an explicit id field. The H1 heading explicitly asserts it should not be used as the slug, exercising heading-suppression logic in slug derivation." ;
      narr:inputLength 99 .

    # ── Claim: heading must not become slug ─────────────────────
    narr:Claim_HeadingMustNotBecomeSlug
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a deliberate test assertion that the heading text must not be promoted to the slug/id when no explicit id field is present. The pipeline must derive the slug via LLM id-gen or deterministic slugify, not by lifting the heading verbatim." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Style Observation 1: Heading as test assertion ───────────
    narr:StyleObs_HeadingAssertion
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "H1 heading is phrased as a negative imperative test assertion ('Should Not Win'), embedding the expected outcome directly into the document title — an authoritative, declarative register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 91
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n"
        ]
      ] .

    # ── Style Observation 2: Minimal body ───────────────────────
    narr:StyleObs_MinimalBody
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word sentence ('Body.') — an intentionally minimal placeholder, signalling that content substance is irrelevant to the test; only structural metadata matters." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 94 ;
          oa:end 99
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Frontmatter reviewer field ─────────
    narr:StyleObs_FrontmatterReviewer
      a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list with a tagged email address (test+expert-gh@aswritten.ai), following a structured metadata convention for attributing review authority before document body." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document: 1 body sentence ('Body.'), 1 heading, YAML frontmatter. Single-word body sentence yields minimal active-voice signal. No jargon in body; 'reviewers' in frontmatter is structural metadata, not prose jargon." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
}