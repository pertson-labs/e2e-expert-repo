# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250715T000000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter reviewer field and a single-word body. Exercises pipeline slug-generation path; the heading title is the slug candidate that the pipeline must not use as the winning id when a better derivation is available." ;
      narr:inputLength 93 .

    # ── Claim ───────────────────────────────────────────────────────────────
    # Section 2: Heading asserts a title that 'should not win' — this is a
    # deliberate test assertion about pipeline slug-selection behaviour.
    narr:Claim_TitleShouldNotWin a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The heading 'Some Other Title That Should Not Win' is an explicit test assertion: the pipeline must not select this heading verbatim as the canonical slug/id when a better derivation path exists. Supports the pipeline slug-generation narrative." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely minimal document: one YAML frontmatter block, one H1 heading, one single-word body sentence. No jargon in body. Active voice ratio not applicable (no finite verbs in body). Average sentence length 1 word. Register: bare/skeletal — characteristic of a test fixture, not prose." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

    # ── Style Observations ───────────────────────────────────────────────────

    # SO-1: Minimal body — single-word sentence as entire document body
    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word 'Body.' — an archetypal placeholder/fixture pattern. Extreme brevity signals a test document rather than substantive prose." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 87 ;
          oa:end 92
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-2: Heading contains meta-assertion ('Should Not Win') — self-referential title
    narr:StyleObs_HeadingAssertion a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading embeds a normative assertion ('Should Not Win') directly in the title text — a self-referential, imperative-adjacent construction used as a test signal rather than a descriptive label." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 85
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # SO-3: YAML frontmatter reviewer field — institutional/process register
    narr:StyleObs_FrontmatterReviewer a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a structured 'reviewers' list with a test email address. This machine-readable metadata block signals a formal review-gate process embedded in the document format itself — a process-register convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

  }
}