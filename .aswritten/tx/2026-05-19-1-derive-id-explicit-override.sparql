      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter lists reviewer test+expert-gh@aswritten.ai (email redacted per PII policy). Same reviewer appears in prior Phase 2 E2E memory, confirming a recurring test actor pattern." ;
      oa:hasSelector [
