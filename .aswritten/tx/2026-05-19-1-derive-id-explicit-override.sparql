# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250731T000000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — extraction" ;
    prov:generatedAtTime "2025-07-31T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
