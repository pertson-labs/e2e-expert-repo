    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter (reviewer) and a single-word body. The H1 heading is deliberately named to assert it should not be used as the pipeline slug or id." ;
      narr:inputLength 89 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_HeadingNotUsedAsSlug a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
