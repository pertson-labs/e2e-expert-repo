# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250714T140000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    dct:title "Some Other Title That Should Not Win — H1 title slug suppression E2E" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:Narrative_H1TitleShouldNotDetermineSlug,
      narr:Claim_H1TitleShouldNotWin,
      narr:Obs_H1TitleHeading,
