PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250720T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-20T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "[id-not-provided]" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_FirstVersion,
      narr:Narrative_FirstVersionDocument,
      narr:Observation_FirstVersionBody,
      narr:StyleMetrics_FirstVersion,
      narr:StyleObservation_SecondVersion_NominalFragment,
      narr:StyleObservation_SecondVersion_FrontmatterConvention,
      narr:StyleObservation_SecondVersion_VersionProgression .
} ;

# ── UPDATE: Sample — title and description reflect second version ────────────
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    narr:Sample_FirstVersion dct:description ?oldDesc .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Sample_FirstVersion dct:title "Second version" .
    narr:Sample_FirstVersion dct:description "Minimal document with YAML frontmatter listing a reviewer and body text 'Second version'." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    OPTIONAL { narr:Sample_FirstVersion dct:description ?oldDesc . }
  }
} ;

# ── UPDATE: Narrative — theme and note reflect second version ────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    narr:Narrative_FirstVersionDocument skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Second document version with reviewer assignment" .
    narr:Narrative_FirstVersionDocument skos:note "Document declares itself a second version and assigns a reviewer via YAML frontmatter. No substantive content beyond the version marker is present." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Observation body — note reflects 'Second version' body text ──────
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Observation_FirstVersionBody skos:note "The sole body content is the phrase 'Second version', functioning as a version milestone marker." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote .
  }
} ;

# ── UPDATE: StyleMetrics — note updated for second version body ──────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:StyleMetrics_FirstVersion skos:note "Metrics computed on body text only ('Second version'). Single nominal fragment; no passive constructions; no domain jargon. Metrics unchanged from first version." .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion skos:note ?oldNote .
  }
} ;

# ── INSERT: Style observations for second version ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    narr:StyleObservation_SecondVersion_NominalFragment
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Body text is a two-word nominal fragment with no verb, mirroring the pattern of the prior version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObservation_SecondVersion_FrontmatterConvention
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "YAML frontmatter block uses a 'reviewers' list key, consistent with an editorial workflow convention for assigning review responsibility." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    narr:StyleObservation_SecondVersion_VersionProgression
      a narr:StyleObservation ;
      skos:broader narr:Milestones ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "The ordinal label 'Second version' signals iterative document versioning using plain English ordinals rather than semantic version numbers (e.g., v2.0)." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

  }
}