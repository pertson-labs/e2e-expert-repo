# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 299 ;
      dct:description "Test memory submitted without an explicit id field to validate pipeline slug generation via LLM id-gen or deterministic slugify fallback." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertGH a narr:Actor ;
      skos:prefLabel "test+expert-gh@aswritten.ai" ;
      skos:note "Reviewer listed in frontmatter of this test memory submission." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id field is present, and commit the file successfully." .

    narr:Claim_SlugFallbackMechanism a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_PipelineMustProduceSlug ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Slug generation uses either the LLM id-gen call (primary) or the deterministic slugify fallback (secondary), establishing a two-tier resolution strategy." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SubmittedWithoutId a narr:Observation ;
      skos:broader narr:FrictionFailure ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Memory explicitly states it was submitted without an explicit id field, triggering the slug-generation path." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 90 ;
        oa:end 129
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Submitted without an explicit id field." ;
        oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
        oa:suffix " The pipeline must produce a"
      ] .

    # ── Style Observations ───────────────────────────────────────
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Imperative/obligatory mood via 'must produce' and 'must' constructions signals a requirements-specification register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 130 ;
          oa:end 185
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a\nslug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Dense use of pipeline-specific technical terms: 'slug', 'LLM id-gen call', 'deterministic slugify fallback'. Assumes reader familiarity with the aswritten.ai pipeline vocabulary." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 196 ;
          oa:end 263
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    narr:StyleObs_AlternativeConstruction a narr:StyleObservation ;
      skos:broader narr:Antithesis ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash-delimited 'either…or' construction presents two resolution paths as a binary choice, a rhetorical pattern common in technical specification writing." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 270
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the\ndeterministic slugify fallback —" ;
          oa:prefix "slug from the memory content " ;
          oa:suffix " and commit the file successfully."
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 20 ;
      narr:ActiveVoiceRatio "0.67"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Short document (~3 sentences, ~60 body words). Technical-specification register with obligatory modal ('must'). Mix of active ('must produce', 'commit') and passive-adjacent constructions. High jargon density relative to document length: slug, LLM, id-gen, slugify, fallback, deterministic." .

  }
}