# ── UPDATE: Narrative_ZypherionAdoption → superseded by Meridian adoption ───
# Justification: memory explicitly states "This supersedes the previous Zypherion decision"
# and the org is now adopting Meridian. Temporal supersession of the same adoption narrative.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260706T223711Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption decision reversed: Meridian replaces Zypherion as analytics database" ;
      skos:note "Originally adopted Zypherion for analytics (15x columnar performance); decision revised 2026-04-06 after critical streaming ingestion gaps found. Meridian selected instead, handling both batch and streaming natively. Q3 2026 migration window unchanged." ;
      narr:challenges narr:Claim_ZypherionColumnarPerformance .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionColumnarPerformance → conviction downgraded ───────
# Justification: the decision to adopt Zypherion was reversed due to critical gaps;
# the 15x columnar claim no longer drives the adoption decision (explicit retraction of basis).
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260706T223711Z {
    narr:Claim_ZypherionColumnarPerformance skos:note "Columnar performance advantage acknowledged but insufficient: Zypherion was found to have critical streaming ingestion gaps, leading to reversal of adoption decision on 2026-04-06. Claim remains factually asserted but no longer supports adoption." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationTimeline → now applies to Meridian ───────
