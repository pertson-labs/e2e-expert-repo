    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter (reviewer: test+expert-gh@aswritten.ai), H1 heading asserting title-selection priority, and a one-word body. Exercises the pipeline's slug/title derivation logic — specifically that the H1 heading should not be selected as the winning slug when a better derivation is available." ;
