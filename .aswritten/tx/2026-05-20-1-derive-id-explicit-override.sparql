    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_H1TitleShouldNotWinSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The pipeline's slug/id derivation logic must not blindly select the H1 heading as the winning title or slug. The heading 'Some Other Title That Should Not Win' is a test fixture asserting that title-selection priority rules should prefer an alternative derivation (LLM id-gen or slugify fallback) over the raw H1 text when appropriate." .

    # ── Style Observations ──────────────────────────────────────

    # 1. Terse/minimal register — entire body is one word
    narr:StyleObs_TerseMinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Extremely terse body: single word 'Body.' The document is a test fixture with near-zero prose content, signalling a minimal/stub register." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
          oa:end 93
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. Test-fixture framing — heading encodes expected pipeline behaviour
    narr:StyleObs_TestFixtureFraming a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading is written as a behavioural assertion ('Should Not Win'), a rhetorical device common in test-fixture naming that encodes expected system behaviour directly into the document title." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 87
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 3. Technical jargon embedded in heading (pipeline/slug domain)
    narr:StyleObs_TechnicalJargonInHeading a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The phrase 'Should Not Win' imports pipeline-slug-selection jargon ('win' as in winning candidate) into the document heading, a domain-specific idiom from ranking/selection systems." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
