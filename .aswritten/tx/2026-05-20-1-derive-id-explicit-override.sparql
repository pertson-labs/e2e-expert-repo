PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250714T140000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "unknown" ;
    dct:title "Some Other Title That Should Not Win — pipeline slug-gen test (heading-must-not-win variant)" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:Claim_HeadingMustNotBeSlug,
      narr:Obs_TitleShouldNotWin,
      narr:StyleObs_DeclarativeTitle,
      narr:StyleObs_MinimalBody,
      narr:StyleObs_YAMLFrontmatterReviewer,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T140000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Test memory with YAML frontmatter reviewer and a heading explicitly named to assert it must not be used as the pipeline slug. Exercises the slug-gen path (LLM id-gen or deterministic slugify fallback)." ;
      narr:inputLength 83 .

    # ── Claim: heading must not become the slug ──────────────────
    narr:Claim_HeadingMustNotBeSlug a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a deliberate test signal asserting that the pipeline must not derive the slug from the document heading. The slug must come from LLM id-gen or deterministic slugify fallback, not from the title." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Observation: title as explicit test signal ───────────────
    narr:Obs_TitleShouldNotWin a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The heading 'Some Other Title That Should Not Win' is a deliberate test assertion embedded in the document title itself." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 30 ;
        oa:end 72
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Some Other Title That Should Not Win" ;
        oa:prefix "# " ;
        oa:suffix "\n\nBody."
      ] .

    # ── Style Observations ───────────────────────────────────────

    # 1. Declarative/imperative title as rhetorical device
    narr:StyleObs_DeclarativeTitle a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Title is a declarative assertion ('Should Not Win') embedded as a heading — an unusual rhetorical choice that encodes test intent directly in document structure." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 30 ;
          oa:end 72
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Minimal body — single-word body text
    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body text is a single word ('Body.') — a placeholder indicating the document's informational content is entirely in its structure and metadata, not its prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 74 ;
          oa:end 79
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. YAML frontmatter reviewer field — institutional convention
    narr:StyleObs_YAMLFrontmatterReviewer a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list field — consistent with the pipeline's editorial convention for designating review ownership. Email redacted per PII policy." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 28
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - [REDACTED]" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document. One-word body ('Body.') with a declarative heading. Active voice ratio is low due to near-absence of prose. Jargon confined to YAML key 'reviewers'." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "0.40"^^xsd:decimal ;
      narr:JargonDensity "0.10"^^xsd:decimal .

  }
}