# ── New Sample (REVISED document) ───────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260702T020303Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 615 ;
      dct:description "Revised decision note from Quinton Fairweather (CTO) superseding the Zypherion adoption. Meridian replaces Zypherion for analytics due to critical streaming ingestion gaps in Zypherion. Q3 2026 migration window retained." ;
      narr:supersedes narr:Sample_ZypherionDecision_20260406 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → Meridian adoption ─────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      skos:broader ?oldBroader .
  }
}
INSERT {
  GRAPH narr:Tx_20260702T020303Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation is switching from Zypherion to Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration remains on the Q3 2026 timeline. This supersedes the prior Zypherion adoption decision." ;
      narr:theme "Technology supersession: Meridian replaces Zypherion for analytics" ;
      skos:broader narr:StackOverview .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:broader ?oldBroader . }
  }
} ;

