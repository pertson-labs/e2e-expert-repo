  GRAPH narr:Tx_20250715T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test fixture memory with YAML frontmatter (reviewer: test+expert-gh@aswritten.ai), an H1 title asserting the title should not be used as the pipeline slug, and a single-word body. Tests that the pipeline does not derive the slug from the H1 heading." ;
      narr:inputLength 97 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_TitleShouldNotWin a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:Process ;
      skos:note "The H1 title of a memory document should not be used as the pipeline-generated slug or id. This test fixture asserts that the slug derivation mechanism must not fall back to the document heading as a slug source." ;
      skos:related narr:Narrative_PipelineSlugGeneration ;
      narr:theme "Pipeline must not use H1 title as slug when deriving id from memory content" .

    # ── Claim ────────────────────────────────────────────────────
    narr:Claim_TitleNotUsedAsSlug a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The heading 'Some Other Title That Should Not Win' explicitly asserts that the H1 title must not win the slug-derivation contest — the pipeline must use a different mechanism (LLM id-gen or deterministic slugify from content) rather than the heading text." ;
      narr:aboutNode narr:Narrative_TitleShouldNotWin ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Style Observations ───────────────────────────────────────

    # SO-1: Normative modal phrasing in H1
    narr:StyleObs_NormativeModal a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "H1 uses 'Should Not' — normative/prescriptive modal expressing a pipeline constraint as a heading. Unusual register for a document title; signals test-specification intent." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 90
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # SO-2: Minimal body — single-word content
    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word 'Body.' — an intentional placeholder indicating this is a test fixture, not a substantive document. Extreme conciseness signals synthetic/test-authored content." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 91 ;
          oa:end 96
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-3: YAML frontmatter structured metadata
    narr:StyleObs_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Document uses YAML frontmatter with a 'reviewers' list — structured metadata convention consistent with the aswritten.ai pipeline's memory format. Signals institutional authoring convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 48
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
