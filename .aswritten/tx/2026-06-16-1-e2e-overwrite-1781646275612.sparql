PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Extraction: Second version stub document" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersionStub,
      narr:StyleMetrics_SecondVersionStub,
      narr:StyleObs_SecondVersion_RegisterFormality,
      narr:StyleObs_SecondVersion_ToneMinimal,
      narr:StyleObs_SecondVersion_ReviewerFrontmatter .
} ;

# ── New Sample (named graph) ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_SecondVersionStub a narr:Sample ;
      dct:title "Second version stub document" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer (email redacted) and a two-word body: 'Second version'." ;
      narr:inputLength 66 .
  }
} ;

# ── UPDATE: Narrative_FirstVersionStub → second-version framing ─
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionStub
      narr:theme "Document iteration / second version placeholder" ;
      skos:note "The document now declares itself a 'Second version', superseding the initial stub. The YAML frontmatter reviewer structure is retained, confirming a review-gated workflow. The narrative shifts from inception to iteration: a second placeholder anchoring continued elaboration." ;
      dct:source narr:Sample_SecondVersionStub .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_DocumentIsInitialVersion → second version ──────
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentIsInitialVersion
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Claim_DocumentIsInitialVersion
      skos:note "The body text 'Second version' supersedes the prior 'First version' assertion. This is now the second iteration of the stub. Conviction remains Notion — the document is still a stub with no substantive body content." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:aboutNode narr:Narrative_FirstVersionStub ;
      dct:source narr:Sample_SecondVersionStub .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentIsInitialVersion
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── Style Observations (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    narr:StyleObs_SecondVersion_RegisterFormality a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Body text is a bare noun phrase with no verbs, articles, or qualifiers. Register is maximally compressed — stub-level formality." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_ToneMinimal a narr:StyleObservation ;
      skos:broader narr:ToneVoice ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The two-word body conveys no evaluative tone. Absence of verbs, adjectives, and punctuation signals a placeholder register rather than a communicative act." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_ReviewerFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "YAML frontmatter declares a 'reviewers' key with a single email value (redacted). This editorial convention signals a structured, review-gated authoring workflow embedded in the document format itself." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # ── Style Metrics ──────────────────────────────────────────────
    narr:StyleMetrics_SecondVersionStub a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersionStub ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Body text is a single two-word noun phrase. No verbs, no jargon, no passive constructions. Metrics are identical to the first-version stub — content remains negligible prose." .
  }
}