      skos:note "The document declares itself a second version with no further elaboration. Conviction is Notion — the label is present but carries no supporting evidence or context." .

    # ── Style Observations ──────────────────────────────────────────

    # 1. YAML front-matter convention
    narr:StyleObservation_SecondVersionFrontMatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Document uses YAML front-matter delimited by triple-dashes to carry metadata (reviewers list), consistent with Jekyll/Hugo/markdown-it conventions. Mirrors pattern in Sample_FirstVersionStub." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 44
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@[REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # 2. Minimal register
    narr:StyleObservation_SecondVersionMinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Entire body is a single two-word phrase; register is maximally sparse. Identical structural pattern to the first version stub." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 58 ; oa:end 72
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. Version label naming convention
    narr:StyleObservation_SecondVersionLabel a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersionStub ;
      rdf:value false ;
      skos:note "'Second version' used as a standalone body sentence — a naming/versioning convention rather than a narrative statement. No verb, no subject beyond the implicit document. Mirrors 'First version' pattern." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 58 ; oa:end 72
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────────
    narr:StyleMetrics_SecondVersionStub a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersionStub ;
      narr:AverageSentenceLength 2 ;
