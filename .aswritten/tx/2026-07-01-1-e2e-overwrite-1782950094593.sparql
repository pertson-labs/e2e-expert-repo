INSERT DATA {
  GRAPH narr:Tx_20260701T235610Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_FirstVersionStub a narr:Sample ;
      dct:title "First version (stub document)" ;
      narr:inputLength 72 ;
      dct:description "Minimal stub document with YAML front-matter reviewer annotation and a single 'First version' body line. No substantive narrative content." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_FirstVersionLabel a narr:Claim ;
      narr:aboutNode narr:Sample_FirstVersionStub ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
