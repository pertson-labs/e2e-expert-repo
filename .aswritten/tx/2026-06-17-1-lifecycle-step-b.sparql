} ;

# ── New Sample for the revised decision document ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Sample_MeridianDecision_20260406
      a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather supersedes the prior Zypherion decision, citing critical streaming ingestion gaps, and selects Meridian for the analytics pipeline. Q3 2026 migration window retained." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now Meridian adoption ──────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation has reversed its Zypherion decision and is now adopting Meridian for the analytics pipeline. The switch is driven by critical streaming ingestion gaps in Zypherion; Meridian handles both batch and streaming natively. The CTO directive retains the Q3 2026 migration window. This supersedes the prior Zypherion adoption narrative." ;
      narr:theme "Technology pivot driven by critical capability gap discovery" ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_ZypherionSelectedForAnalytics → Meridian selected ──────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionSelectedForAnalytics
      skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionSelectedForAnalytics
      skos:note "Meridian has been selected as the database for the analytics pipeline, replacing Zypherion. Decision attributed to CTO Quinton Fairweather in the revised directive dated 2026-04-06." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionSelectedForAnalytics
      skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_MigrationStartsQ32026 → now about Meridian migration ───────
DELETE {
  GRAPH ?g {
    narr:Claim_MigrationStartsQ32026
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_MigrationStartsQ32026
      skos:note "Migration to Meridian (replacing Zypherion) is scheduled to begin in Q3 2026. The timeline is unchanged from the original Zypherion decision, but the target database has changed." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_MigrationStartsQ32026
