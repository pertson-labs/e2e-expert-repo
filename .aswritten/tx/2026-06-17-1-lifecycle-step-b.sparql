DELETE {
  GRAPH ?g {
    narr:Actor_QuintonFairweather skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Actor_QuintonFairweather
      skos:note "CTO. Decision-maker for analytics database selection. Issued original Zypherion adoption directive, then superseded it with a revised directive selecting Meridian after discovering critical streaming ingestion gaps." .
