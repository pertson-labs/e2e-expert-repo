# ── New Claims: streaming gap and Meridian capability ────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionLacksStreaming
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, which disqualified it from the analytics pipeline role." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionSelectedForAnalytics .

    narr:Claim_MeridianHandlesBatchAndStreaming
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively, satisfying the capability requirement that Zypherion could not meet." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionSelectedForAnalytics .
  }
} ;

# ── Observation: Quinton's direct statement ──────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Obs_QuintonMeridianStatement
      a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "CTO direct statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps and Meridian's native batch+streaming capability." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 183 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .
  }
} ;

