PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id field provided in input)" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_FirstVersion,
      narr:Narrative_FirstVersionDocument,
      narr:Observation_FirstVersionBody,
      narr:StyleObs_SecondVersion_TerseRegister,
      narr:StyleObs_SecondVersion_OrdinalVersioning,
      narr:StyleObs_SecondVersion_YAMLFrontmatter,
      narr:StyleMetrics_SecondVersion .
} ;

# ── UPDATE: Sample title and description (temporal supersession) ─
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    narr:Sample_FirstVersion dct:description ?oldDesc .
    narr:Sample_FirstVersion narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_FirstVersion dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer and a single-sentence body declaring second version status." ;
      narr:inputLength 76 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle .
    OPTIONAL { narr:Sample_FirstVersion dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_FirstVersion narr:inputLength ?oldLen . }
  }
} ;

# ── UPDATE: Narrative note (version reference changed) ───────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote .
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDocument
      skos:note "The document now declares itself a second version with the same reviewer assigned, signalling an iterative review-gated authoring process advancing from first to second version." ;
      narr:theme "Document versioning and review progression" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument skos:note ?oldNote .
    OPTIONAL { narr:Narrative_FirstVersionDocument narr:theme ?oldTheme . }
  }
} ;

# ── UPDATE: Body observation (quote changed from First to Second) ─
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Observation_FirstVersionBody
      skos:note "Body text declares document status as second version, superseding the prior first version declaration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 52 ;
        oa:end 66
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote .
  }
} ;

# ── INSERT: New style observations and metrics ───────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    narr:StyleObs_SecondVersion_TerseRegister
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Body is a two-word nominal phrase with no verb — maximally terse declarative register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_OrdinalVersioning
      a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Version declared using ordinal word form ('Second') rather than numeric shorthand ('v2' or '2.0'), consistent with prior 'First version' pattern." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLFrontmatter
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "YAML frontmatter reviewer list persists unchanged across versions, establishing a stable metadata convention for review accountability." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Single two-word nominal sentence in body. No jargon. No verb. Fully declarative, implied active voice. Extremely terse register — identical profile to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}