PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T150000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T15:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---\n\n# Database Decision REVISED: Switching from Zypherion to Meridian" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_MeridianDecision_20260406,
      narr:Narrative_ZypherionAdoption,
      narr:Claim_ZypherionDatabaseChoice,
      narr:Claim_ZypherionMigrationQ3_2026,
      narr:Claim_ZypherionLacksStreaming,
      narr:Claim_MeridianBatchAndStreaming,
      narr:Obs_AdoptionStatement,
      narr:Obs_MigrationTimeline,
      narr:StyleMetrics_ZypherionDecision,
      narr:StyleObs_BoldKeyDecisions,
      narr:StyleObs_SupersessionStatement,
      narr:StyleObs_DirectQuoteCTO .
} ;

# ── INSERT new Sample for the REVISED document ──────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which Quinton Fairweather (CTO) retracts the Zypherion adoption decision and selects Meridian instead, citing critical gaps in Zypherion's streaming ingestion. Migration window remains Q3 2026." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE Narrative_ZypherionAdoption → now describes Meridian adoption ────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps, and is now adopting Meridian, which handles both batch and streaming natively. Migration remains Q3 2026." ;
      narr:theme "Technology decision reversal driven by capability gap discovery" ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption skos:note ?oldNote .
    OPTIONAL { narr:Narrative_ZypherionAdoption narr:theme ?oldTheme . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── UPDATE Claim_ZypherionDatabaseChoice → Meridian is now the choice ───────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "Meridian replaces Zypherion as the selected analytics database following discovery of Zypherion's streaming ingestion gaps." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldLevel . }
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice dct:source ?oldSource . }
  }
} ;

# ── UPDATE Claim_ZypherionMigrationQ3_2026 → same window, new DB ─────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionMigrationQ3_2026
      skos:note "Migration to Meridian (replacing Zypherion) proceeds in the same Q3 2026 window." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 dct:source ?oldSource . }
  }
} ;

# ── DELETE Claim_ZypherionPerformance15x — explicitly contradicted ───────────
# The memory rejects Zypherion entirely; the 15x performance claim is superseded
# by the streaming gap finding. No longer operative.
DELETE WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

# ── UPDATE Obs_AdoptionStatement → new quote from revised document ───────────
DELETE {
  GRAPH ?g {
    narr:Obs_AdoptionStatement skos:note ?oldNote ;
      dct:source ?oldSource ;
      oa:hasSelector ?oldSel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Obs_AdoptionStatement
      skos:note "Quinton's direct statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 148 ;
        oa:end 290
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch"
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_AdoptionStatement skos:note ?oldNote .
    OPTIONAL { narr:Obs_AdoptionStatement dct:source ?oldSource . }
    OPTIONAL { narr:Obs_AdoptionStatement oa:hasSelector ?oldSel . }
  }
} ;

# ── UPDATE Obs_MigrationTimeline → same Q3 window, now for Meridian ──────────
DELETE {
  GRAPH ?g {
    narr:Obs_MigrationTimeline skos:note ?oldNote ;
      dct:source ?oldSource ;
      oa:hasSelector ?oldSel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
