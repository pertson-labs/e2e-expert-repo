# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      skos:note "Revised meeting note documenting CTO Quinton Fairweather's decision to abandon Zypherion and adopt Meridian for analytics, citing critical streaming ingestion gaps in Zypherion. Explicitly supersedes the prior Zypherion decision. Q3 2026 migration window retained." ;
      narr:inputLength "470"^^xsd:integer .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → Meridian adoption ─────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology reversal driven by critical capability gap" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps. Meridian replaces Zypherion, selected for native batch and streaming support. The Q3 2026 migration window is retained. Decision attributed to CTO Quinton Fairweather and explicitly supersedes the prior adoption." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── New Narrative for Meridian adoption (distinct from updated Zypherion node) ─
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Meridian replaces Zypherion as analytics database" ;
      skos:note "Meridian is adopted as the analytics database after Zypherion is found to lack streaming ingestion. Meridian handles both batch and streaming natively. This is a reversal of a prior decision within the same Q3 2026 migration window." .
  }
} ;

