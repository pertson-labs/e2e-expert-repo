# ── New Sample for the revised decision document ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised CTO decision memo from Quinton Fairweather superseding the Zypherion adoption. Meridian selected as analytics database due to Zypherion's critical streaming ingestion gaps. Q3 2026 migration window retained." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ─────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology pivot driven by critical capability gap: streaming ingestion" ;
      skos:note "The organisation has reversed its Zypherion adoption decision. Meridian replaces Zypherion as the analytics database, justified by Zypherion's critical streaming ingestion gaps. Meridian handles both batch and streaming natively. Q3 2026 migration window is retained. This supersedes the previous Zypherion decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

