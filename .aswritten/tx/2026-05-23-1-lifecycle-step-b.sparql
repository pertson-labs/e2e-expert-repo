      skos:note "Migration window confirmed as Q3 2026, now targeting Meridian." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 430 ;
        oa:end 480
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Same Q3 2026 migration window" ;
        oa:prefix "- **Timeline**: " ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_MigrationTimeline skos:note ?oldNote .
    OPTIONAL { narr:Obs_MigrationTimeline dct:source ?oldSource . }
    OPTIONAL { narr:Obs_MigrationTimeline oa:hasSelector ?oldSel . }
  }
} ;

# ── UPDATE StyleMetrics ──────────────────────────────────────────────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:StyleMetrics_ZypherionDecision
      narr:AverageSentenceLength 13 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.13"^^xsd:decimal ;
      skos:note "Short declarative register maintained. Slightly higher jargon density due to addition of 'streaming ingestion' and 'batch'. Active voice dominant via first-person CTO quote and imperative bullet labels." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision narr:AverageSentenceLength ?oldASL .
    OPTIONAL { narr:StyleMetrics_ZypherionDecision narr:ActiveVoiceRatio ?oldAVR . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision narr:JargonDensity ?oldJD . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision skos:note ?oldNote . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision dct:source ?oldSource . }
  }
} ;

# ── INSERT new Claims and StyleObservations ──────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {

    # New Claim: Zypherion lacks streaming ingestion
    narr:Claim_ZypherionLacksStreaming a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, which disqualified it from selection." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # New Claim: Meridian handles batch and streaming natively
    narr:Claim_MeridianBatchAndStreaming a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming natively, satisfying the capability requirement that Zypherion failed." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .

    # StyleObservation 1: Bold key-decision labels
    narr:StyleObs_BoldKeyDecisions a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      skos:note "Bold markdown labels on each key decision bullet (e.g., **Database**, **Reason**, **Timeline**) signal structured decision record format." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 355 ;
          oa:end 430
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix "\n- **Reason**"
        ]
      ] .

    # StyleObservation 2: Supersession statement — explicit retraction register
    narr:StyleObs_SupersessionStatement a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      skos:note "The phrase 'This supersedes the previous Zypherion decision' uses a formal retraction register, signalling institutional authority and finality." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 295 ;
          oa:end 345
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # StyleObservation 3: Direct first-person CTO quote
    narr:StyleObs_DirectQuoteCTO a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      skos:note "First-person CTO quote ('We evaluated... We are now switching') grounds the decision in direct attribution, lending authority and accountability." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 148 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " We are now switching"
        ]
      ] .
  }
}