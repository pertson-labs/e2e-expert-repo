  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_PlainLanguage a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Body text uses plain, unambiguous language. 'Second version' is immediately comprehensible with zero domain knowledge required." ;
      rdf:value true ;
      oa:hasTarget [
