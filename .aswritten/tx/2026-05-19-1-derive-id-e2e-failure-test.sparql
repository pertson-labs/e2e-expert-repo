    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T000000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an id field, the pipeline falls back to slug generation — either via LLM id-gen call or deterministic slugify — and must commit the file successfully. Phase 2 E2E test reproduces the missing-id failure pattern observed in production; the pipeline must not crash and must produce a valid slug." ;
      narr:theme "Pipeline must derive a slug from memory content when no explicit id is provided, without crashing, even when reproducing production failure patterns" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

