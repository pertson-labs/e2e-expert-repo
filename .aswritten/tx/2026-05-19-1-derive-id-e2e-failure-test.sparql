# ── UPDATE: narr:Narrative_PipelineSlugGeneration — extend skos:note ─────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T140000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully without crashing. Phase 2 (Derive Id E2E) confirms this as a hard process invariant: the pipeline must not crash on a ## level heading with no id field, and must produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

