# ── UPDATE: narr:Narrative_PipelineSlugGeneration — add Phase 2 context ──────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative captures the expected resilience behaviour of the ingestion pipeline. Phase 2 E2E testing specifically reproduces the prod failure pattern where a ## level heading is present but no id field is provided; the pipeline must not crash and must produce a valid slug." ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}