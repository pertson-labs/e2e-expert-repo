# ── New Observation: missing-id failure pattern grounded in source ───────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Obs_MissingIdFailurePattern
      a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:FrictionFailure ;
      skos:note "Memory explicitly states it reproduces the missing-id failure pattern from prod, with a ## level heading and no id field — the canonical crash-trigger condition." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 155
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Reproduces the missing-id failure pattern from prod (## level heading," ;
        oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
        oa:suffix "\nno id field). Must not crash; must produce a valid slug."
      ] .
  }
} ;

