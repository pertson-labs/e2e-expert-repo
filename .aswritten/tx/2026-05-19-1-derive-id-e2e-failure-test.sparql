      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.60"^^xsd:decimal ;
      narr:JargonDensity "0.24"^^xsd:decimal ;
      skos:note "Very short document (~33 words, 3 sentences). Imperative mood dominates ('Must not crash; must produce'). High jargon density: slug, id field, E2E, prod, missing-id, ## level heading, crash, slugify." .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_SampleMemoryDistinctiveHeading
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD ;
      skos:note ?oldNote .
  }
} ;

# ── INSERT: new entities (named graph) ──────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250717T120000Z {

    # Narrative: Phase 2 E2E test framing (distinct from the general slug-gen narrative)
    narr:Narrative_Phase2DeriveIdE2E
      a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:broader narr:QualityReviewGates ;
      skos:note "Phase 2 of the Derive Id E2E test suite. Specifically reproduces the missing-id failure pattern observed in production: a memory submitted with a ## level heading and no id field. The pipeline must not crash and must produce a valid slug." ;
      narr:theme "E2E test phase 2: reproduce prod missing-id failure pattern; assert crash-safety and valid slug output" .

    # Claim: crash-safety constraint (new — not in snapshot)
    narr:Claim_MustNotCrash
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Explicit crash-safety requirement: the pipeline must not crash when processing a memory with a ## level heading and no id field." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # StyleObservation 1: Imperative mood / directive tone
    narr:StyleObs_ImperativeMood_Phase2
      a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Imperative mood used for requirements: 'Must not crash; must produce a valid slug.'" ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 148 ;
          oa:end 191
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # StyleObservation 2: Technical jargon density
    narr:StyleObs_TechnicalJargon_Phase2
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "High concentration of pipeline-specific jargon: 'missing-id failure pattern', 'id field', '## level heading', 'valid slug'. Assumes reader familiarity with the intake pipeline." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 57 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading,\nno id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    # StyleObservation 3: Terse directive register
    narr:StyleObs_TerseDirective_Phase2
      a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Extremely terse register: the entire body is two sentences. No hedging, no elaboration. Reads as a test specification or acceptance criterion." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 40 ;
          oa:end 191
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # StyleMetrics node for this extraction run
    narr:StyleMetrics_Phase2DeriveIdE2E
      a narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:broader narr:StyleMetrics ;
      skos:note "Phase 2 E2E document: ~33 words, 3 sentences. Imperative mood, terse specification register. High jargon density from pipeline-specific vocabulary." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.60"^^xsd:decimal ;
      narr:JargonDensity "0.24"^^xsd:decimal .

  }
}