      ] .

    # ── Style Observation 2: Imperative mood / requirement framing ─────────
    narr:StyleObs_Phase2_ImperativeMood
      a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Requirements stated as modal imperatives ('Must not crash; must produce a valid slug'), asserting non-negotiable system behaviour without hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
