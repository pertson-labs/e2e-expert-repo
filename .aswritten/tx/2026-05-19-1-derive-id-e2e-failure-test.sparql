# ── UPDATE: extend Narrative_PipelineSlugGeneration with crash-safety angle ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the resulting file successfully. Additionally, the pipeline must not crash on this condition; Phase 2 E2E testing reproduces the missing-id failure pattern from production to validate crash-safety alongside slug-generation correctness." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}