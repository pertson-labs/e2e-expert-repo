# ── UPDATE: narr:Narrative_PipelineSlugGeneration — add crash-safety requirement ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via LLM id-gen or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E test confirms the pipeline must also not crash when encountering a ## level heading with no id field." ;
      narr:theme "Pipeline slug generation from memory content when id field is absent; crash-safety required" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

# ── New entities (named graph) ───────────────────────────────────────────────
