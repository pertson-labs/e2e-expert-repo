    # ── New claim: crash-safety requirement ────────────────────────────────
    narr:Claim_MustNotCrash
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "The pipeline must not crash when processing a memory that has a ## level heading but no id field; it must produce a valid slug and complete ingestion successfully." ;
