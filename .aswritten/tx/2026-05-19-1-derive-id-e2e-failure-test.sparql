# ── UPDATE: Narrative_PipelineSlugGeneration — extend with Phase 2 / E2E context ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T143000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative captures the expected system behaviour under that condition. Phase 2 E2E testing (sample-memory-phase-2-derive-id-e2e) confirms the pattern must be reproduced from prod without crashing." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_PipelineMustSlugFromContent — add crash-safety requirement ──
DELETE {
  GRAPH ?g {
    narr:Claim_PipelineMustSlugFromContent skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T143000Z {
    narr:Claim_PipelineMustSlugFromContent skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. Additionally (Phase 2 E2E), the pipeline must not crash when encountering a ## level heading with no id field; it must produce a valid slug in all cases." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_PipelineMustSlugFromContent skos:note ?oldNote .
  }
}