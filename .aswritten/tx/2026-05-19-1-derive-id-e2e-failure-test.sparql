  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample node ────────────────────────────────────────────────────────
    narr:Sample_SampleMemoryPhase2_DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Exercises crash-safety and valid-slug requirements of the ingestion pipeline." ;
