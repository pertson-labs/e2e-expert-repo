# ── UPDATE: narr:Sample_SampleMemoryDistinctiveHeading ──────────────────────
# Memory introduces a Phase 2 / E2E framing; update title, description, inputLength
DELETE {
  GRAPH ?g {
    narr:Sample_SampleMemoryDistinctiveHeading
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T120000Z {
    narr:Sample_SampleMemoryDistinctiveHeading
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Must not crash; must produce a valid slug." ;
      narr:inputLength 229 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_SampleMemoryDistinctiveHeading
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: narr:Narrative_PipelineSlugGeneration ───────────────────────────
# Memory adds Phase 2 / prod-failure-pattern / E2E context to existing narrative
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "Phase 2 E2E: When a memory is submitted without an id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Must not crash; must produce a valid slug. Tests robustness of the intake pipeline's id-resolution path." ;
      narr:theme "Pipeline slug generation from memory content when no explicit id field is provided; Phase 2 E2E reproduces prod missing-id failure pattern" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

