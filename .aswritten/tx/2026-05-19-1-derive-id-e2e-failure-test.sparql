      skos:note "Document uses dense technical register: 'missing-id failure pattern', 'prod', '## level heading', 'id field', 'slug'. Minimal prose scaffolding around jargon." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
