# New Sample and style entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20260704T230706Z {

    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version stub document" ;
      narr:inputLength 64 ;
      skos:note "Minimal stub document with YAML front-matter listing a reviewer (redacted) and a two-word body: 'Second version'." .

    # Style Observation 1: YAML front-matter delimiter (same pattern as V1, now sourced to V2)
    narr:StyleObs_FrontMatterYAML_V2 a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value true ;
      skos:note "Document uses YAML front-matter delimited by '---' to carry metadata (reviewer field), a structured-document convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ; oa:end 3
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---" ;
          oa:prefix "" ;
          oa:suffix "\nreviewers:\n  - xena+staging@asw"
        ]
      ] .

    # Style Observation 2: Minimal/stub register — body is "Second version"
    narr:StyleObs_RegisterMinimal_V2 a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value false ;
      skos:note "Body text is a bare placeholder phrase ('Second version') with no elaboration, indicating a stub or draft-zero register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ; oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix " xena+staging@aswritten.ai\n---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 3: Reviewer key in front-matter (PII redacted)
    narr:StyleObs_BodyStub_V2 a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value true ;
      skos:note "Front-matter includes a 'reviewers' key with a single email value (redacted per PII policy). Signals a review-workflow editorial convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 44
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - [REDACTED]" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # Style Metrics for Second Version
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Computed over a two-word body ('Second version'). Metrics are nominal given the stub nature of the document."
  }
