}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology decision reversal driven by critical capability gap" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical gaps in streaming ingestion. Meridian was selected as the replacement, handling both batch and streaming natively. The Q3 2026 migration window is retained. Decision attributed to CTO Quinton Fairweather." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
