PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250716T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_Register,
      narr:StyleObs_SecondVersion_Brevity .
} ;

# ── New Sample node for the second-version document ─────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter assigning a reviewer and body text 'Second version'. Successor to the First version document." ;
      narr:inputLength 67 .
  }
} ;

# ── UPDATE Narrative: version label changed from First to Second ─
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Document at second version state with assigned reviewer" ;
      skos:note "The document now declares itself as 'Second version' and retains the same reviewer assignment via YAML frontmatter, indicating progression through a review workflow." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE Claim: version state note updated ─────────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionState skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Claim_FirstVersionState skos:note "The document body now asserts 'Second version', indicating progression from the initial draft. The reviewer assignment in the YAML frontmatter is unchanged." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionState skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── Style Metrics for Second Version ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Extremely minimal document: 2-word body, no verbs (ActiveVoiceRatio=0), no domain jargon. Register is placeholder/stub. Identical profile to First version." ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── Style Observation 1: Version label as nominal phrase ─────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version label expressed as bare nominal phrase ('Second version') with no verb, article variation, or punctuation. Consistent with stub/placeholder register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# ── Style Observation 2: YAML frontmatter reviewer assignment ────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_Register a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document uses structured YAML frontmatter for metadata (reviewer field), contrasting with the bare prose body. Signals a machine-readable workflow convention rather than prose authorship." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .
  }
} ;

# ── Style Observation 3: Extreme brevity / stub cadence ──────────
INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {
    narr:StyleObs_SecondVersion_Brevity a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body content is a single two-word phrase with no elaboration, punctuation, or sentence structure. Represents a stub/placeholder cadence pattern, not intentional rhetorical brevity." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}