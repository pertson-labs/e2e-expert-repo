PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph) — documents the retraction event
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "test+expert-gh@aswritten.ai" ;
    narr:originPath "retract:quantum-widget-decision" ;
    narr:originRef "main" ;
    dct:title "Retraction: Quantum Widget Decision and PostgreSQL-to-QuantumDB migration" ;
    prov:generated narr:Tx_20250115T120000Z .
} ;

# DELETE WHERE — remove any entity whose label/theme/note references the Quantum Widget Decision
DELETE {
  GRAPH ?g {
    ?entity ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    ?entity ?p ?o .
    FILTER (
      (isLiteral(?o) && (
        CONTAINS(LCASE(STR(?o)), "quantum widget") ||
        CONTAINS(LCASE(STR(?o)), "quantum widget decision")
      )) ||
      (isIRI(?entity) && (
        CONTAINS(LCASE(STR(?entity)), "quantumwidget") ||
        CONTAINS(LCASE(STR(?entity)), "quantum_widget")
      ))
    )
  }
} ;

# DELETE WHERE — remove any entity whose label/theme/note references the PostgreSQL-to-QuantumDB migration
DELETE {
  GRAPH ?g {
    ?entity ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    ?entity ?p ?o .
    FILTER (
      (isLiteral(?o) && (
        CONTAINS(LCASE(STR(?o)), "quantumdb") ||
        CONTAINS(LCASE(STR(?o)), "postgresql to quantumdb") ||
        CONTAINS(LCASE(STR(?o)), "postgres to quantumdb") ||
        CONTAINS(LCASE(STR(?o)), "quantumdb migration")
      )) ||
      (isIRI(?entity) && (
        CONTAINS(LCASE(STR(?entity)), "quantumdb") ||
        CONTAINS(LCASE(STR(?entity)), "postgresql_quantumdb") ||
        CONTAINS(LCASE(STR(?entity)), "postgres_quantumdb")
      ))
    )
  }
} ;

# DELETE WHERE — remove any outbound relationships FROM matched entities (cascade)
DELETE {
  GRAPH ?g {
    ?entity ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    ?entity a ?type .
    FILTER (
      CONTAINS(LCASE(STR(?entity)), "quantumwidget") ||
      CONTAINS(LCASE(STR(?entity)), "quantum_widget") ||
      CONTAINS(LCASE(STR(?entity)), "quantumdb") ||
      CONTAINS(LCASE(STR(?entity)), "postgresql_quantumdb")
    )
    ?entity ?p ?o .
  }
} ;

# DELETE WHERE — remove any inbound relationships TO matched entities (cascade)
DELETE {
  GRAPH ?g {
    ?s ?p ?entity .
  }
}
WHERE {
  GRAPH ?g {
    ?entity a ?type .
    FILTER (
      CONTAINS(LCASE(STR(?entity)), "quantumwidget") ||
      CONTAINS(LCASE(STR(?entity)), "quantum_widget") ||
      CONTAINS(LCASE(STR(?entity)), "quantumdb") ||
      CONTAINS(LCASE(STR(?entity)), "postgresql_quantumdb")
    )
    ?s ?p ?entity .
  }
}