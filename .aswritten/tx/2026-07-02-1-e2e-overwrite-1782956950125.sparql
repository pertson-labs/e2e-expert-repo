PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20260702T015506Z a prov:Activity ;
    prov:generatedAtTime "2026-07-02T01:55:06Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "2026-07-02-1-e2e-overwrite-1782956950125" ;
    narr:originRef "e2e-overwrite-1782956950125" ;
    dct:title "Second version document extraction" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersion,
      narr:StyleObs_FrontmatterYAML_V2,
      narr:StyleObs_BareDeclaration_V2,
      narr:StyleObs_RegisterMinimal_V2,
      narr:StyleMetrics_SecondVersion .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20260702T015506Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal second-version document with YAML frontmatter and a single declarative line." ;
      narr:inputLength 73 ;
      dct:created "2025-07-15"^^xsd:date .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersion a narr:Narrative ;
      narr:theme "Second version document creation" ;
      skos:broader narr:NarrativeAnchor ;
      skos:note "The document asserts its own second-version status with no further elaboration — a bare progression marker following the first version." ;
      dct:source narr:Sample_SecondVersion .

    # ── Style Observations ───────────────────────────────────────

    # 1. YAML frontmatter convention (same pattern as V1, new source)
    narr:StyleObs_FrontmatterYAML_V2 a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value true ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes for metadata (reviewer list), a structured-document convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # 2. Bare declarative noun phrase body
    narr:StyleObs_BareDeclaration_V2 a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value true ;
      skos:note "The body content is a bare declarative noun phrase with no verb, article, or elaboration — a terse, authoritative naming convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ; oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. Minimal register
    narr:StyleObs_RegisterMinimal_V2 a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      rdf:value true ;
      skos:note "Extremely minimal register: the entire body is a single two-word declarative phrase, identical in structure to the first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ; oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Single two-word body phrase. No passive constructions. No domain jargon present. Structurally identical to first version." .

  }
}