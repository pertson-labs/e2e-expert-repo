# ── Remove Transaction: Tx_20260406T140000Z (Meridian revision) ─────────────
DELETE WHERE {
  narr:Tx_20260406T140000Z ?p ?o .
} ;

# ── Remove any blank-node selector children of retracted observations ────────
# (oa:hasSelector blank nodes attached to retracted observations)
DELETE {
  ?sel ?sp ?so .
}
WHERE {
  VALUES ?obs {
    narr:Obs_PerformanceClaim
    narr:Obs_QuintonAdoptionQuote
    narr:Obs_QuintonRevisionQuote
    narr:Obs_SupersessionStatement
  }
  ?obs oa:hasSelector ?sel .
  ?sel ?sp ?so .
  FILTER(isBlank(?sel))
} ;

# ── Remove any triples that reference retracted entities as objects ───────────
# (dangling narr:supports / narr:challenges / narr:aboutNode pointers)
DELETE {
  ?s ?p ?retracted .
}
WHERE {
  VALUES ?retracted {
    narr:Narrative_ZypherionAdoption
    narr:Narrative_MeridianAdoption
    narr:Sample_ZypherionDBDecision_20260406
    narr:Actor_QuintonFairweather
  }
  ?s ?p ?retracted .
}