# ── Retraction transaction (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260501T000000Z a prov:Activity ;
    dct:title "RETRACTION: Database decision, Zypherion, Meridian, Quinton Fairweather, analytics pipeline" ;
    prov:generatedAtTime "2026-05-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "test+expert-gh@aswritten.ai" ;
    narr:originPath "(no id field provided — inline message)" ;
    narr:originRef "main" ;
    prov:generated narr:Tx_20260501T000000Z .
} ;

# ── Remove Actor: Quinton Fairweather ────────────────────────────────────────
DELETE WHERE {
  narr:Actor_QuintonFairweather ?p ?o .
} ;

