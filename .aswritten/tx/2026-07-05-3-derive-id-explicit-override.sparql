# ── Update Narrative_PipelineSlugGeneration to include title-not-used constraint ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260705T104852Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. Phase 2 (## heading, no id field): must not crash; must produce a valid slug. Reproduces missing-id failure pattern from prod. Phase 3 (H1 heading present, no id field): the H1 title must NOT be used as the slug source; LLM id-gen or slugify fallback must be used regardless of heading content." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}