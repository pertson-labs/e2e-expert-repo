INSERT DATA {
  GRAPH narr:Tx_20260705T104852Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "E2E test memory: document with YAML frontmatter reviewer and H1 heading whose title must NOT be used as the pipeline slug. Exercises the derive-id path where the heading title should be ignored in favour of LLM id-gen or deterministic slugify fallback." ;
      narr:inputLength "95"^^xsd:integer ;
      dct:created "2025-07-05"^^xsd:string .

    # ── Claim: H1 title must not be used as slug ─────────────────
    narr:Claim_TitleHeadingNotUsedAsSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_SlugFallbackBehavior ;
      dct:source narr:Sample_TitleShouldNotWin ;
      skos:broader narr:CoreWorkflows ;
      skos:note "The H1 heading title ('Some Other Title That Should Not Win') must NOT be used as the slug source. The pipeline must derive the slug via LLM id-gen or deterministic slugify fallback, not from the document heading." .

    # ── Style Observations ───────────────────────────────────────

    # 1. Imperative negation in heading as test assertion
    narr:StyleObs_TitleShouldNotWin_ImperativeNegation a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_TitleShouldNotWin ;
      rdf:value true ;
      skos:note "H1 heading encodes a test assertion via imperative negation ('Should Not Win'), signalling that the title is a deliberate negative constraint, not a descriptive label." ;
      oa:hasTarget [
