        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "52"^^xsd:integer ;
          oa:end "88"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "ena+staging@aswritten.ai\n---\n\n# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Minimalist body — single-word sentence
    narr:StyleObs_TitleShouldNotWin_MinimalistBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TitleShouldNotWin ;
      rdf:value true ;
      skos:note "Body consists of a single word sentence ('Body.') — a placeholder stub typical of E2E fixture documents where content is irrelevant and only structure matters." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "90"^^xsd:integer ;
          oa:end "95"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "ther Title That Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. YAML frontmatter reviewer declaration
    narr:StyleObs_TitleShouldNotWin_FrontmatterReviewer a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_TitleShouldNotWin ;
      rdf:value true ;
      skos:note "YAML frontmatter declares a reviewer via tagged email address (xena+staging@aswritten.ai), a structured metadata convention consistent with staging-environment pipeline review workflows." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "4"^^xsd:integer ;
          oa:end "44"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - xena+staging@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---\n\n# Some Other Title That Sh"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TitleShouldNotWin a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TitleShouldNotWin ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.1"^^xsd:decimal ;
