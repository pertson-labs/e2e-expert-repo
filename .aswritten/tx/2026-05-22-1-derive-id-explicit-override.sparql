PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250721T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-21T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main@unknown" ;
    dct:title "Some Other Title That Should Not Win — Slug Gen Variant Test" ;
    prov:generated
      narr:Sample_SomeOtherTitleSlugTest,
      narr:Claim_SomeOtherTitleSlugTestInstance,
      narr:StyleMetrics_SomeOtherTitleSlugTest,
      narr:StyleObs_SomeOtherTitle_MetaCommentaryTitle,
      narr:StyleObs_SomeOtherTitle_MinimalBody,
      narr:StyleObs_SomeOtherTitle_YAMLFrontmatter .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250721T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleSlugTest a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory submitted without an explicit id field. Contains YAML frontmatter with a reviewer, an H1 heading, and a single-word body. Exercises the pipeline slug-generation fallback path. Reviewer email redacted per PII policy." ;
      narr:inputLength 97 .

    # ── Claim ────────────────────────────────────────────────────
    # New test instance of the existing slug-generation narrative.
    # Actor narr:Actor_TestExpertReviewer already exists in snapshot — not re-inserted.
    narr:Claim_SomeOtherTitleSlugTestInstance a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleSlugTest ;
      skos:note "A third test memory submitted without an explicit id field, this time with the heading 'Some Other Title That Should Not Win'. Reinforces the pipeline slug-generation narrative: the pipeline must derive a slug from content when no id is provided. The heading title is intentionally meta-commentary, asserting it should not be used as the canonical slug." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Style Observations ───────────────────────────────────────

    # 1. Meta-commentary title — informal register, self-referential heading
    narr:StyleObs_SomeOtherTitle_MetaCommentaryTitle a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SomeOtherTitleSlugTest ;
      skos:note "The H1 heading is self-referential meta-commentary ('Should Not Win'), signalling this is a test artifact rather than production content. Informal register." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleSlugTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 82
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Minimal body — extreme sentence brevity, placeholder content
    narr:StyleObs_SomeOtherTitle_MinimalBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleSlugTest ;
      skos:note "Body consists of a single word sentence 'Body.' — a placeholder indicating no substantive content. Extreme brevity; average sentence length is 1 word." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleSlugTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 84 ;
          oa:end 89
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. YAML frontmatter reviewer list — structured metadata convention
    narr:StyleObs_SomeOtherTitle_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SomeOtherTitleSlugTest ;
      skos:note "YAML frontmatter block uses a 'reviewers' list key with an email value. Follows the same frontmatter convention as prior test memories (e.g., Sample_SlugGenTest). Email redacted per PII policy." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleSlugTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 42
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\n# Some Other Title"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleSlugTest a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleSlugTest ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (1 body sentence). Informal/test register. No passive constructions. Minimal jargon beyond YAML frontmatter key 'reviewers'." ;
      narr:AverageSentenceLength "1"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.05"^^xsd:decimal .

  }
}