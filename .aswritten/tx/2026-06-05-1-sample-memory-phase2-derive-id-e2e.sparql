# ── New entities (named graph) ───────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {

    # Sample node
    narr:Sample_SampleMemoryPhase2DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory that reproduces the missing-id failure pattern from prod. Uses a ## level heading with no id field to validate that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 221 .

    # Reviewer actor (PII redacted per policy)
    narr:Actor_TestExpertReviewer
      a narr:Actor ;
      skos:prefLabel "test+expert-gh [redacted]" ;
      skos:note "Reviewer listed in YAML frontmatter of Phase 2 E2E test memory. Email redacted per PII policy." .

    # New claim: Phase 2 specific assertion
    narr:Claim_Phase2MissingIdMustNotCrash
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Phase 2 E2E: a memory with a ## level heading and no id field must not crash the pipeline and must produce a valid slug. This reproduces the missing-id failure pattern observed in production." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # Style Observation 1: Imperative modal obligation
    narr:StyleObservation_Phase2_ImperativeModal
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Double imperative modal: 'Must not crash; must produce a valid slug.' Signals hard requirement framing." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 200
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2: Technical jargon density
    narr:StyleObservation_Phase2_TechnicalJargon
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "High engineering jargon density in a short body: 'missing-id failure pattern', 'prod', '## level heading', 'id field', 'slug'. Assumes reader familiarity with pipeline internals." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 80 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "Derive Id E2E\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # Style Observation 3: Passive/nominalized construction
    narr:StyleObservation_Phase2_PassiveConstruction
      a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Opening verb 'Reproduces' is active but the subject is the document itself acting as agent, creating a nominalized/impersonal register typical of test-spec writing." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 80 ;
          oa:end 110
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern" ;
          oa:prefix "\n\n" ;
          oa:suffix " from prod"
        ]
      ] .

    # Style metrics
    narr:StyleMetrics_SampleMemoryPhase2DeriveIdE2E
      a narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:StyleMetrics ;
      skos:note "Very short body (2 sentences). Active voice dominant but impersonal register. High jargon density for document length. Terse, spec-like cadence." ;
      narr:AverageSentenceLength "18"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.60"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal .

  }
} ;

# ── Update existing Narrative to note Phase 2 coverage ──────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Validated across Phase 1 (## heading, no id) and Phase 2 (## heading, no id, missing-id failure pattern from prod). Both phases assert: must not crash; must produce a valid slug." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}