      dct:source narr:Sample_SlugGenPhase2E2E ;
      skos:note "Phase 2 E2E test asserts two hard requirements: (1) the pipeline must not crash when no id field is present, and (2) it must produce a valid slug. This reproduces a failure pattern observed in production." ;
      narr:aboutNode narr:Process ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_SlugGenerationPipelineRequirement .
  }
} ;

