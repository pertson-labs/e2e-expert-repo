# ── New Claim: crash-safety requirement (not present in snapshot) ────────────
INSERT DATA {
  GRAPH narr:Tx_20250717T120000Z {
    narr:Claim_CrashSafetySlugGeneration
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The pipeline must not crash when processing a memory that has a ## level heading but no explicit id field; it must produce a valid slug. This is the Phase 2 E2E reproduction of the missing-id failure pattern observed in prod." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .
  }
} ;

# ── New Observation: missing-id failure pattern grounded in source ───────────
INSERT DATA {
  GRAPH narr:Tx_20250717T120000Z {
    narr:Observation_MissingIdFailurePattern
      a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:EdgeCaseHandling ;
      skos:note "Reproduces the prod failure: ## heading present, no id field. Pipeline must not crash; must produce a valid slug." ;
      oa:hasSelector
