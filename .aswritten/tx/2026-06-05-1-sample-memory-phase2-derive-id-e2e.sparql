# ── UPDATE: Extend narr:Narrative_PipelineSlugGeneration with Phase 2 context ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250717T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake and file-commit workflow. Phase 2 (E2E) additionally asserts crash-safety: the pipeline must not crash when encountering a ## level heading with no id field, reproducing the missing-id failure pattern observed in prod." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

