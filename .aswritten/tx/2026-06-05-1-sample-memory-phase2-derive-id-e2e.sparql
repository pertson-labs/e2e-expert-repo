# ── UPDATE: Enrich existing Narrative with Phase 2 framing ──────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_SlugGenerationPipelineRequirement skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_SlugGenerationPipelineRequirement
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either through an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E testing additionally asserts the pipeline must not crash on this path, reproducing a missing-id failure pattern observed in production. This tests a critical fallback path in the ingestion workflow." ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided; must not crash on missing-id failure pattern" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_SlugGenerationPipelineRequirement skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}