INSERT {
  GRAPH narr:Tx_20250715T000000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative is validated by two E2E test memories: Phase 1 (Sample_SampleMemoryDistinctiveHeading) and Phase 2 (Sample_SampleMemoryPhase2DeriveIdE2E). Phase 2 additionally asserts crash-prevention: the pipeline must not crash on a ## level heading with no id field." .
  }
}
