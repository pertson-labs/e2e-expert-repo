# ── UPDATE existing Narrative to incorporate Phase 2 specificity ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) reproduces the missing-id failure pattern from production: ## level heading, no id field. The pipeline must not crash and must produce a valid slug. This tests the robustness of the intake process across both LLM and fallback paths." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

