# ── UPDATE: narr:Narrative_PipelineSlugGenFallback — extend with Phase 2 context ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFallback skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGenFallback skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative asserts that the pipeline has a robust fallback path for id-less submissions. Phase 2 (E2E) extends this: the pipeline must also not crash when encountering a ## level heading with no id field, and must produce a valid slug in all cases." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFallback skos:note ?oldNote .
  }
}