# ── UPDATE: Enrich narr:Narrative_PipelineSlugGeneration with Phase 2 context ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E testing (## heading, no id field) adds the explicit requirement that the pipeline must not crash under this condition. This tests both the robustness and the id-resolution path of the ingestion pipeline." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}