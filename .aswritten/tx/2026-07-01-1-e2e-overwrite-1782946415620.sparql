# Update Narrative_FirstVersionPlaceholder to reflect document lifecycle progression to second version
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionPlaceholder skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T225840Z {
    narr:Narrative_FirstVersionPlaceholder skos:note "The document has progressed from a first version stub to a second version, continuing the document lifecycle pattern of minimal placeholder content with structured YAML front matter." ;
      narr:theme "Document lifecycle progression — second version stub" ;
      dct:source narr:Sample_SecondVersion_e2eExpertRepo .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionPlaceholder skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
} ;

# Update StyleObs_ShortBodyText: body text changed from 'First version' to 'Second version'
DELETE {
  GRAPH ?g {
    narr:StyleObs_ShortBodyText dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T225840Z {
    narr:StyleObs_ShortBodyText dct:source narr:Sample_SecondVersion_e2eExpertRepo ;
      skos:note "Body consists of exactly two words: 'Second version'. Maximally compressed cadence, same pattern as first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_e2eExpertRepo ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 58 ; oa:end 72
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleObs_ShortBodyText dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
} ;

