# ── UPDATE: Narrative_PipelineSlugGeneration — add Phase 2 / E2E framing ────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGeneration
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) extends this: the pipeline must also not crash when the memory uses an H2-level heading with no id field, reproducing the production failure pattern." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_SlugFallbackRequired — add crash-safety constraint ─────────
DELETE {
  GRAPH ?g {
    narr:Claim_SlugFallbackRequired skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Claim_SlugFallbackRequired
      skos:note "The pipeline must produce a slug from the memory content when no explicit id is provided, using either the LLM id-gen call or the deterministic slugify fallback. Additionally (Phase 2 requirement): the pipeline must not crash when encountering an H2-level heading with no id field — reproducing the production failure pattern." ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_SlugFallbackRequired skos:note ?oldNote .
  }
}