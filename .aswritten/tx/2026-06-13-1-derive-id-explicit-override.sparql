PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250725T120000Z a prov:Activity ;
    dct:title "Some Other Title That Should Not Win — no-id-field test memory" ;
    prov:generatedAtTime "2025-07-25T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "[no-id-field: slug-derived-from-content]" ;
    narr:originRef "main@unknown" ;
    prov:generated
      narr:Sample_SomeOtherTitleShouldNotWin,
      narr:StyleObs_TitleNormativeFraming,
      narr:StyleObs_MinimalBodyRegister,
      narr:StyleObs_TerseTestArtifactTone,
      narr:StyleMetrics_SomeOtherTitleShouldNotWin .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250725T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory submitted without an explicit id field. Contains YAML frontmatter with a reviewer (email redacted per PII policy), an H1 heading, and a single-word body. Exercises the pipeline slug-generation path." ;
      narr:inputLength 85 .

    # ── Style Observations ──────────────────────────────────────────────────

    # SO-1: Normative/imperative framing embedded in the H1 title
    narr:StyleObs_TitleNormativeFraming a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading embeds a normative judgment ('Should Not Win') directly in the document title, signalling an assertive, evaluative register even in a test artifact." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 85
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # SO-2: Minimal body register — single-word sentence
    narr:StyleObs_MinimalBodyRegister a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The body consists of a single word ('Body.') followed by a period — an extreme instance of short-punchy cadence, functioning as a placeholder in a test-artifact register." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 87 ;
          oa:end 92
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-3: YAML frontmatter reviewer field — institutional/pipeline convention
    narr:StyleObs_TerseTestArtifactTone a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a structured 'reviewers' key with an email value — a pipeline-convention pattern. Email redacted per PII policy. No domain jargon in body; overall register is terse test-artifact prose." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - [REDACTED]"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Extremely short document (1 heading + 1 body word). Fully active voice — no passive constructions. Near-zero jargon density in body; YAML frontmatter adds one pipeline-convention term ('reviewers'). Average sentence length skewed by single-word body sentence." ;
      narr:AverageSentenceLength "5"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.05"^^xsd:decimal .

  }
}