INSERT DATA {
  GRAPH narr:Tx_20260707T032417Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_MultipassWriteModel_20260705 a narr:Sample ;
      dct:title "Multi-pass write model ratified: frozen referent sets, the ambiguity short-circuit, and the first authored reconciliation" ;
      dct:created "2026-07-05"^^xsd:date ;
      narr:inputLength 7534 ;
      dct:description "Architecture session notes from July 5, 2026 (Fable window, task-146). Ratifies the multi-pass write model: frozen extensional referent sets, ambiguity short-circuit with bounce-back, unified write path, footing primitive for authorship provenance. Records the first authored reconciliation in the system's history." .

    # ── Actor ────────────────────────────────────────────────────────────────
    narr:Actor_Scarlet a narr:Actor ;
      skos:prefLabel "Scarlet" ;
      skos:note "Principal architect and decision-maker for the multi-pass extraction pipeline. Email redacted (PII). Endorses Claude-proposed formulations, making endorsement a recordable act distinct from authorship. Affiliated with aswritten.ai." .

    # ── Narratives ───────────────────────────────────────────────────────────

    narr:Narrative_FrozenReferentSets a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "Resolution collapses intensional references into frozen extensional IRI sets at write time" ;
      skos:broader narr:DataModelLifecycle ;
      skos:note "The ratified write model: when a conclusion targets cross-cutting content (e.g. 'everything said about enterprise pricing since March'), the resolution pass collapses that intensional reference into a concrete, frozen set of IRIs or named graphs at write time. Append-only semantics mean a conclusion covers exactly what it saw; later-arriving nodes require a new conclusion. The guardrail: a stored query re-evaluated by the read path is the retired demotion engine returning through the referent side — prohibited. Claude-proposed, Scarlet-ratified." .

    narr:Narrative_InMessageCommentaryFree a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "In-message commentary binds structurally for free — resolution is only needed for graph-reaching references" ;
      skos:broader narr:DataModelLifecycle ;
      skos:note "Commentary about primary source within the same message is structurally bound by the envelope's decomposition: the system already knows which commentary attaches to which source. These bindings cost nothing and can never be ambiguous. Resolution is only ever needed for commentary reaching back into the graph (other messages, other nodes)." .

    narr:Narrative_AmbiguityShortCircuit a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "Ambiguous referent resolution bounces back to the user with candidate sets rather than guessing" ;
      skos:broader narr:EdgeCaseHandling ;
      skos:note "Ratified short-circuit: explicit referents passed into the write skip resolution entirely. Missing referents get a resolution pass. Confident resolutions bind frozen. Ambiguous ones bounce back with candidate sets — the one legitimate prompt in a disambiguate-never-ask-permission system. Source always lands regardless (append-only). The bounce payload is an ordinary commentary-only envelope with referents now explicit, through the same pipeline, no special mode, nothing held server-side." .

    narr:Narrative_UnifiedWritePath a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "The unified write path handles bounce-back follow-ups as ordinary new memories — no special server-side state" ;
      skos:broader narr:CoreWorkflows ;
      skos:note "A follow-up after an ambiguity bounce is just a new memory with everything already committed dropped from it. The held commentary returns as an ordinary commentary-only envelope with referents now explicit, through the same pipeline. The held commentary's witness chain anchors to the source committed in round one — it was said then; only the confirmation is new." .

    narr:Narrative_FootingPrimitive a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "Footing primitive (animator / author / principal) distinguishes model speech from human endorsement" ;
      skos:broader narr:DataModelLifecycle ;
      skos:note "Model speech carries no principal until a human endorses it. Endorsement is a recordable act distinct from authorship. The historical graph contains the failure mode footing is designed against: Claude-authored formulations recorded as Scarlet's words. This memory is its own first test case: the freeze rationale enters as Claude-authored, Scarlet-endorsed. Needed cleanly in v2." .

    narr:Narrative_DogfoodFirstReconciliation a narr:Narrative ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:theme "First authored reconciliation in system history verified live on the real commit seam" ;
      skos:broader narr:Proof ;
      skos:note "July 5, 2026: the first reconciliation ever authored concludes about the multi-pass pipeline's own design. Signed by Scarlet as principal, bound by typed edges to June 24 design nodes it extends. Verified on ephemeral local stack (worktree task-146-multipass). Committed through the production commit path, returned in a live perspective response as leading '⊕ RECONCILED (Scarlet, 2026-07-05)' line. Trajectory-of-conclusions rendering confirmed." .

    # ── Claims ───────────────────────────────────────────────────────────────

    narr:Claim_FreezeRuleRationale a narr:Claim ;
      narr:aboutNode narr:Narrative_FrozenReferentSets ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:supports narr:DataModelLifecycle ;
      skos:note "Two rationale pillars: (1) Append-only semantics — a conclusion covers exactly what it saw; later-arriving nodes are not retroactively covered. (2) Guardrail — a stored query re-evaluated by the read path is machinery deciding what a conclusion covers as the graph moves; this is the retired demotion engine returning through the referent side. Claude-proposed, Scarlet-ratified." .

    narr:Claim_TargetVsReferentSeparation a narr:Claim ;
      narr:aboutNode narr:Narrative_FrozenReferentSets ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:supports narr:DataModelLifecycle ;
      skos:note "A conclusion's target (graph-grain address whose digest should narrate it: a hub, a session's transaction, several of either) is distinct from its referent bindings (precise nodes it concerns, carried as typed relationships: extends / supersedes / contradicts). Folding referents into the target would cause every correction to surface on nodes it never concerned — the read-time bleed the June 24 session warned about, now designed out." .

    narr:Claim_SourceAlwaysLands a narr:Claim ;
      narr:aboutNode narr:Narrative_AmbiguityShortCircuit ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:supports narr:CoreWorkflows ;
      skos:note "Source always lands regardless of referent ambiguity. It is an append-only record of what was said, and there is nothing ambiguous about that. Only the held commentary waits for resolution." .

    narr:Claim_BouncePayloadIsState a narr:Claim ;
      narr:aboutNode narr:Narrative_UnifiedWritePath ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      narr:supports narr:CoreWorkflows ;
      skos:note "The bounce payload itself is the state. No special server-side mode is needed. The held commentary's witness chain anchors to the source committed in round one — it was said then; only the confirmation is new." .

    narr:Claim_FootingHistoricalGap a narr:Claim ;
      narr:aboutNode narr:Narrative_FootingPrimitive ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      skos:note "The historical graph contains Claude-authored formulations recorded as Scarlet's words. This is the failure mode the footing primitive (animator/author/principal) is designed against. Scarlet flagged this directly while reviewing this memory's draft." .

    narr:Claim_DeferredResolveToolSurface a narr:Claim ;
      narr:aboutNode narr:Narrative_AmbiguityShortCircuit ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_MultipassWriteModel_20260705 ;
      skos:note "Deliberately deferred: the resolve tool as a user-facing surface (the pass is the machinery; the tool is a registration away). Numeric ambiguity threshold deferred until gold set provides calibration data. Segmentation grain defaulted to one speech act per expression, logged as tunable. This window: Conviction spine only — ship spines, gate facets." .

