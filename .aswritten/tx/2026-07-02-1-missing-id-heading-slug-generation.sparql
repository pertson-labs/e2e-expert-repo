INSERT {
  GRAPH narr:Tx_20260702T015048Z {
    narr:Narrative_PipelineSlugDerivation skos:note "When a memory is submitted without an explicit id field, the ingestion pipeline must produce a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This is a core resilience requirement for the intake workflow. Phase 2 (e2e-derive-id-1782956687234) reproduces the prod failure pattern and adds crash-prevention as an explicit acceptance criterion." ;
      skos:related narr:Narrative_ProdMissingIdCrashPrevention .
  }
}
