PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250730T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-30T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    dct:title "Second Version — Incremental Document" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionInception,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_Terse,
      narr:StyleObs_SecondVersion_ActiveVoice,
      narr:StyleObs_SecondVersion_VersionIncrement .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250730T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second Version" ;
      dct:description "Minimal incremental document with YAML frontmatter listing the same reviewer as the first version and a single-sentence body declaring a second version." ;
      narr:inputLength 67 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersionInception a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:NarrativeAnchor ;
      narr:theme "Document versioning — second version declaration" ;
      skos:note "The document asserts itself as a second version, advancing the version sequence established by the first version. The same reviewer is retained in the frontmatter, signalling continuity in the review-gated workflow." .

    # ── Style Observations ───────────────────────────────────────

    # SO-1: Extreme terseness / conciseness (body is two words)
    narr:StyleObs_SecondVersion_Terse a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body consists of exactly two words. Maximally terse register, identical cadence to first version." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-2: Active voice (implied declarative statement)
    narr:StyleObs_SecondVersion_ActiveVoice a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The two-word body is an active, declarative noun phrase. No passive constructions present." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-3: Version increment naming convention (ordinal + lowercase noun)
    narr:StyleObs_SecondVersion_VersionIncrement a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version label follows the pattern 'Ordinal + lowercase noun' (\"Second version\"), mirroring \"First version\" from the prior document. Establishes a consistent naming convention for version declarations." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Single two-word sentence. 100% active voice (implied). Zero jargon. Extremely terse register — identical profile to first version document." .

  }
}