    # ── Sample ──────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleThatShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter reviewer and a single-word body. The H1 heading encodes a test assertion: the title must not be used as the slug when a content-derived or deterministic slug is expected." ;
      narr:inputLength 80 .

    # ── Narrative ────────────────────────────────────────────────────
    narr:Narrative_TitlePrioritySlugTest
      a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:broader narr:Process ;
      narr:theme "H1 heading title must not override pipeline slug generation" ;
      skos:note "When a memory lacks an explicit id field, the pipeline must derive a slug from content or via deterministic fallback — the H1 heading title ('Some Other Title That Should Not Win') must not be used as the canonical slug. This test case validates title-vs-slug priority logic in the intake pathway." .

    # ── Claim ────────────────────────────────────────────────────────
    narr:Claim_TitleShouldNotDetermineSlug
      a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      narr:aboutNode narr:Narrative_TitlePrioritySlugTest ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' encodes an explicit test assertion that the title must not win the slug-determination contest. The pipeline must use id-gen or slugify fallback, not the heading text." .

    # ── Observation ──────────────────────────────────────────────────
    narr:Obs_HeadingTitleShouldNotWin
      a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The H1 heading text encodes the test expectation: the title must not be used as the slug. This is the primary semantic signal in the document." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 80
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Some Other Title That Should Not Win" ;
        oa:prefix "# " ;
        oa:suffix "\n\nBody."
      ] .

    # ── Style Observations ───────────────────────────────────────────

    # SO-1: Minimal declarative body — single word sentence
    narr:StyleObs_MinimalBodyDeclarative
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "Body consists of a single word sentence 'Body.' — extreme brevity, placeholder register, no elaboration." ;
      rdf:value false ;
      oa:hasTarget [
