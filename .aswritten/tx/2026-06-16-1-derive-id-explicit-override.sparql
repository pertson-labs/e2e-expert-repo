# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleTestMemory a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal pipeline test memory with YAML frontmatter (reviewer), an H1 heading, and a one-word body. No id field present. Tests that the H1 heading title is NOT used as the derived slug." ;
      narr:inputLength 99 .

    # ── Claim: H1 heading must not win slug derivation ──────────
    narr:Claim_H1HeadingMustNotWinSlug a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' explicitly signals that the heading text must not be used as the derived slug. The pipeline slug-gen logic must suppress or deprioritise the H1 heading when deriving the id, using the LLM id-gen call or deterministic slugify fallback instead." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Observation: H1 heading suppression signal ──────────────
    narr:Obs_H1HeadingSuppressionSignal a narr:Observation ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:broader narr:FailureModesSafety ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a deliberate test signal: the heading title must not win over the pipeline-derived slug. This is a new test variant distinct from the H2 heading pattern in Phase 2." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleTestMemory ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 92
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "# Some Other Title That Should Not Win" ;
          oa:prefix "---\n\n" ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Observations ───────────────────────────────────────
    narr:StyleObs_MinimalBodyStyle a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:note "Single-word body ('Body.') — maximally terse. Signals a test fixture, not a substantive document. Cadence is deliberately minimal." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleTestMemory ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 94 ;
          oa:end 99
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_YAMLFrontmatterReviewerPattern a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:note "YAML frontmatter uses a 'reviewers' list key with a redacted email value. Institutional convention: reviewer attribution embedded in document metadata rather than body text." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleTestMemory ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 47
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    narr:StyleObs_H1HeadingConvention a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:note "H1 heading uses title case with an embedded directive phrase ('Should Not Win'). The heading is self-describing about its own suppression — a meta-commentary style used in pipeline test fixtures." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleTestMemory ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 92
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "# Some Other Title That Should Not Win" ;
          oa:prefix "---\n\n" ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleTestMemory a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleTestMemory ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (1 body sentence, 1 word). Test fixture register. No active/passive distinction meaningful at this length. Zero jargon in body; YAML key 'reviewers' is the only domain term." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.01"^^xsd:decimal .

  }
