      narr:StyleObs_TitleCasing,
      narr:StyleObs_MinimalBody,
      narr:StyleObs_FrontmatterReviewer,
      narr:StyleMetrics_SomeOtherTitle .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250718T000000Z {

    # ── Sample ──────────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleThatShouldNotWin
      a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal markdown document with YAML frontmatter (reviewer) and a single-word body. Submitted without an explicit id field." ;
      narr:inputLength 89 .

    # ── Narrative ───────────────────────────────────────────────────
    narr:Narrative_MinimalBodyDocument
      a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:broader narr:NarrativeAnchor ;
      narr:theme "Minimal document with a heading that asserts it should not win title precedence" ;
      skos:note "The document consists of a YAML frontmatter block with a reviewer field and a body containing only a heading and the word 'Body.' The heading explicitly signals it should not be used as the canonical title, suggesting a pipeline or routing concern about title selection." .

    # ── Observation: heading text ────────────────────────────────────
    narr:Obs_TitleHeading
      a narr:Observation ;
      skos:broader narr:NarrativeAnchor ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The H1 heading explicitly names itself as a title that 'Should Not Win', signalling a test or routing concern about title precedence in the pipeline." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 50 ;
        oa:end 89
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Some Other Title That Should Not Win" ;
        oa:prefix "# " ;
        oa:suffix "\n\nBody."
      ] .

    # ── Style Observation 1: Title-case heading ──────────────────────
    narr:StyleObs_TitleCasing
      a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "Title-case applied to every major word in the H1 heading, consistent with editorial heading conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 89
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Observation 2: Minimal body / extreme brevity ──────────
    narr:StyleObs_MinimalBody
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "Body content is a single word ('Body.') — extreme brevity, likely a placeholder or test fixture rather than substantive prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 91 ;
          oa:end 96
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: YAML frontmatter reviewer field ─────────
    narr:StyleObs_FrontmatterReviewer
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list field with a tagged email address (test+expert-gh@aswritten.ai). Email redacted per PII policy. Structured metadata pattern consistent with CI/pipeline-driven review workflows." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitle
      a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (1 body sentence of 1 word). Active voice ratio not meaningfully computable; defaulted to 1.0. Zero jargon in body. Average sentence length is 1 word. Register: placeholder/test fixture." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "1.00"^^xsd:decimal ;
      narr:JargonDensity "0.00"^^xsd:decimal .

  }
}