PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250718T000000Z a prov:Activity ;
    dct:title "Extraction: Some Other Title That Should Not Win" ;
    prov:generatedAtTime "2025-07-18T00:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(none)" ;
    narr:originRef "main@unknown" ;
    prov:generated
