          oa:start 84 ;
          oa:end 89
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO-2: YAML frontmatter reviewer pattern
    narr:StyleObs_FrontmatterReviewerPattern
      a narr:StyleObservation ;
