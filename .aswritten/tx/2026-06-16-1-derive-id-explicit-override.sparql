          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # SO-3: Title as encoded test assertion
    narr:StyleObs_TitleAsTestAssertion
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "The H1 heading functions as an imperative test assertion embedded in natural language: 'Should Not Win' is a normative claim about pipeline behavior, not a descriptive title. This is a distinctive rhetorical pattern for test fixtures." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleThatShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 80
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
