      dct:source narr:Sample_SomeOtherTitleThatShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list with email-format identifiers. Consistent with pipeline convention for expert reviewer attribution." ;
      rdf:value true ;
      oa:hasTarget [
