# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion and adopt Meridian for the analytics pipeline, citing critical gaps in Zypherion's streaming ingestion. Supersedes the original Zypherion decision. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 520 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian reversal ────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology decision reversal driven by critical capability gap discovery" ;
      skos:note "The organisation reversed its Zypherion adoption decision after discovering critical gaps in its streaming ingestion capability. Meridian was selected as the replacement, handling both batch and streaming natively. The Q3 2026 migration window is retained. Decision attributed to CTO Quinton Fairweather." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

