# ── New entities: Meridian adoption narrative, claims, observation, style ────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Narrative: Meridian adoption
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "The organisation has pivoted from Zypherion to Meridian for its analytics database. The switch is driven by Zypherion's critical streaming ingestion gaps; Meridian handles both batch and streaming natively. The Q3 2026 migration window is retained." ;
      narr:theme "Technology pivot: Meridian replaces Zypherion after streaming ingestion gaps discovered" .

    # New Claim: Meridian is the chosen DB
    narr:Claim_MeridianDBChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian is now the selected analytics database, replacing Zypherion. It handles both batch and streaming ingestion natively." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption .

    # New Claim: Zypherion streaming gap (the reason for the switch)
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the decisive technical failure that triggered the switch to Meridian." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDBChoice .

    # New Claim: Q3 2026 migration for Meridian
    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The Q3 2026 migration window is retained for the Meridian rollout, unchanged from the original Zypherion plan." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDBChoice .

    # Observation: Quinton's direct statement
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:PositioningThesis ;
      skos:note "Quinton Fairweather's direct statement announcing the switch to Meridian and the rationale (streaming ingestion gaps in Zypherion)." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # Style Observation 1: Direct declarative tone
    narr:StyleObs_DirectDeclarative_Meridian a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Authoritative, declarative register: decisions stated as facts with no hedging language." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 342 ;
          oa:end 395
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 2: Technical jargon — domain-specific terms
    narr:StyleObs_TechnicalJargon_Meridian a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Domain jargon used precisely: 'streaming ingestion', 'batch', 'analytics' — no over-explanation, assumes technical audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 220 ;
          oa:end 340
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
          oa:prefix "Zypherion further and " ;
          oa:suffix "\""
        ]
      ] .

    # Style Observation 3: Bullet-list key decisions structure
    narr:StyleObs_BulletStructure_Meridian a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Key decisions formatted as bold-label bullet points (Database / Reason / Timeline), mirroring the prior document's structure — signals deliberate revision rather than new document." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 397 ;
          oa:end 541
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short, punchy sentences in active voice. Technical jargon limited to streaming/batch/analytics domain terms. Register is executive/formal. Bullet structure mirrors prior document deliberately." ;
      narr:AverageSentenceLength 12 ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal .
