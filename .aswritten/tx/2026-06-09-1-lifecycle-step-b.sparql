PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T150000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian — 2026-04-06" ;
    prov:generatedAtTime "2026-04-06T15:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Claim_MeridianStreamingRationale,
      narr:Obs_QuintonMeridianQuote,
      narr:Obs_SupersessionStatement,
      narr:Obs_KeyDecisionsList,
      narr:StyleObs_DirectDeclarativeTone,
      narr:StyleObs_SupersessionRhetoric,
      narr:StyleObs_BoldKeyTerms .
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now Meridian adoption ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology pivot driven by capability gap: streaming ingestion" ;
      skos:note "The organisation has reversed its Zypherion decision and is now adopting Meridian as the analytics database. Zypherion was found to lack streaming ingestion; Meridian handles both batch and streaming natively. Migration remains Q3 2026." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian replaces Zypherion ─────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "Meridian replaces Zypherion as the analytics database. Decision explicitly supersedes the prior Zypherion selection. Stated by CTO Quinton Fairweather on 2026-04-06." ;
      narr:hasConvictionLevel narr:Conviction_Boulder .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3_2026 → now about Meridian ────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionMigrationQ3_2026
      skos:note "Migration to Meridian proceeds on the same Q3 2026 timeline originally set for Zypherion. Timeline preserved despite database switch." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Sample_ZypherionDecision_20260406 → reflect revised content ──────
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_ZypherionDecision_20260406
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for analytics, citing critical streaming ingestion gaps in Zypherion. Migration window remains Q3 2026. Explicitly supersedes the prior Zypherion decision." ;
      narr:inputLength 561 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: StyleMetrics_ZypherionDecision → reflect revised document ────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:StyleMetrics_ZypherionDecision
      skos:note "Revised document maintains terse executive register. Short declarative sentences. High active voice. Jargon density slightly elevated with addition of 'streaming ingestion' and 'batch and streaming natively'." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD .
  }
} ;

# ── DELETE: Claim_ZypherionPerformance15x — explicitly contradicted ──────────
# Zypherion is now rejected; the 15x performance claim supported its adoption.
# The memory states Zypherion has "critical gaps" and is being replaced.
DELETE WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

# ── INSERT: New entities ─────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {

    # New Claim: Zypherion streaming ingestion gap (reason for switch)
    narr:Claim_MeridianStreamingRationale
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion lacks streaming ingestion capability; Meridian handles both batch and streaming natively. This gap is the stated reason for the database switch." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .

    # Observation: Quinton's direct quote on Meridian switch
    narr:Obs_QuintonMeridianQuote
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "CTO direct quote announcing switch from Zypherion to Meridian, citing streaming ingestion gap." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # Observation: Supersession statement
    narr:Obs_SupersessionStatement
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Explicit retraction of prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 342 ;
        oa:end 390
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    # Observation: Key decisions list
    narr:Obs_KeyDecisionsList
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "Structured key decisions: Meridian replaces Zypherion, streaming gap as reason, Q3 2026 timeline preserved." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 392 ;
        oa:end 530
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Database: Meridian replaces Zypherion for analytics" ;
        oa:prefix "Key decisions:\n- **" ;
        oa:suffix "**\n- **Reason**"
      ] .

    # Style Observation 1: Direct declarative tone
    narr:StyleObs_DirectDeclarativeTone
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Terse, authoritative executive register. Declarative sentences with no hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 260
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " We are now switching"
        ]
      ] .

    # Style Observation 2: Supersession rhetoric (explicit retraction pattern)
    narr:StyleObs_SupersessionRhetoric
      a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Explicit supersession statement used as a standalone sentence to formally retract a prior decision. Institutional retraction pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 342 ;
          oa:end 390
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 3: Bold key terms formatting
    narr:StyleObs_BoldKeyTerms
      a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Bold markdown used to highlight decision categories (Database, Reason, Timeline) in the key decisions list. Structured formatting signals executive summary convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 392 ;
          oa:end 561
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "**Database**: Meridian replaces Zypherion for analytics" ;
          oa:prefix "Key decisions:\n- " ;
          oa:suffix "\n- **Reason**"
        ]
      ] .

  }
}