# ── UPDATE: narr:Sample_ZypherionDecision_20260406 ──────────────────────────
# Title and description must reflect the revised decision.
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_ZypherionDecision_20260406
      a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for the analytics pipeline, citing critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Q3 2026 migration window retained. Supersedes prior Zypherion adoption decision." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength "612"^^xsd:integer .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc .
  }
} ;

# ── UPDATE: narr:Obs_QuintonAdoptionStatement ────────────────────────────────
# Quote now references Meridian decision, not Zypherion adoption.
DELETE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionStatement
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Obs_QuintonAdoptionStatement
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "CTO direct statement announcing switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 161 ;
        oa:end 295
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch"
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionStatement
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Obs_ColumnarPerformance → streaming gap rationale ───────────
# Rationale changed from columnar performance to streaming ingestion gap.
DELETE {
  GRAPH ?g {
    narr:Obs_ColumnarPerformance
      skos:note ?oldNote ;
      skos:broader ?oldBroader .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Obs_ColumnarPerformance
      a narr:Observation ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Disqualifying capability gap: Zypherion lacks streaming ingestion. Meridian handles both batch and streaming natively — the stated technical rationale for the switch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 295 ;
        oa:end 345
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead.\n" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_ColumnarPerformance
      skos:note ?oldNote ;
      skos:broader ?oldBroader .
  }
} ;

# ── UPDATE: narr:StyleMetrics_ZypherionDecision ──────────────────────────────
# Jargon density increases with addition of "streaming ingestion" terminology.
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:JargonDensity ?oldJargon .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:StyleMetrics_ZypherionDecision
      a narr:StyleMetrics ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short, declarative sentences in active voice. Jargon slightly elevated with addition of 'streaming ingestion' alongside 'batch', 'analytics pipeline'. Formal decision-record register with supersession framing. Structured bullet summary retained." ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:JargonDensity "0.15"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note ?oldNote ;
      narr:JargonDensity ?oldJargon .
  }
} ;

