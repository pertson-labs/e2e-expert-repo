# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting notes recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian, citing critical streaming ingestion gaps in Zypherion. Supersedes the prior Zypherion adoption decision. Q3 2026 migration timeline retained." ;
      narr:inputLength 541 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → superseded by Meridian adoption ───
# Justified by: memory states "This supersedes the previous Zypherion decision"
# and explicitly names Meridian as the replacement. Functional change on theme.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption: Meridian replaces Zypherion for analytics (batch + streaming ingestion)" ;
      skos:note "The organisation has reversed its Zypherion decision and is now committing to Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDBChoice → now asserts Meridian is chosen DB ─────
# Justified by: "Database: Meridian replaces Zypherion for analytics" — functional
# change on a single-valued database choice claim.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDBChoice skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDBChoice skos:note "Meridian is now the chosen database for the analytics pipeline, replacing Zypherion. Decision made by CTO Quinton Fairweather on 2026-04-06." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:supports narr:Narrative_MeridianAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDBChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
    OPTIONAL { narr:Claim_ZypherionDBChoice narr:aboutNode ?oldAbout . }
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance15x → superseded by streaming gap claim
# Justified by: memory replaces the performance rationale with a new one:
# "Zypherion lacks streaming ingestion" — explicit retraction of the 15x rationale
# as the adoption driver (the adoption itself is reversed).
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x skos:note "SUPERSEDED: The 15x columnar query performance claim was the original rationale for Zypherion adoption. The revised decision found critical streaming ingestion gaps in Zypherion, negating the adoption rationale. This claim no longer supports an active adoption decision." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
