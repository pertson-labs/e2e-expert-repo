PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T140000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_MeridianDecision_20260406,
      narr:Claim_MeridianMigrationQ3_2026,
      narr:Claim_ZypherionStreamingGap,
      narr:Claim_MeridianBatchStreamingNative,
      narr:Observation_QuintonMeridianQuote,
      narr:StyleObs_ToneAuthoritative_Meridian,
      narr:StyleObs_JargonPolicy_Meridian,
      narr:StyleObs_ShortPunchyCadence_Meridian,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── New Sample for the REVISED document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion adoption decision after discovering critical streaming ingestion gaps, and announces Meridian as the replacement for the analytics pipeline. Q3 2026 migration window is retained." ;
      narr:inputLength "620"^^xsd:integer .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now describes Meridian adoption ───
# Justified: memory explicitly states "We are now switching to Meridian instead"
# and "This supersedes the previous Zypherion decision" — functional change on
# narr:theme (single-valued directional claim) and skos:note.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption: Meridian replaces Zypherion for analytics (batch + streaming)" ;
      skos:note "The organisation is switching from Zypherion to Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration remains scheduled for Q3 2026. This supersedes the original Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3_2026 → now about Meridian migration ──
# Justified: memory states Meridian replaces Zypherion; same Q3 2026 window.
# The claim's skos:note and aboutNode description are contradicted (Zypherion → Meridian).
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note "Migration to Meridian (replacing Zypherion) starts Q3 2026, as confirmed in the revised decision session." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance15x → retracted / contradicted ─────────
# Justified: memory states "We evaluated Zypherion further and found critical gaps"
# which explicitly contradicts the prior positive performance claim. The conviction
# level drops from Stake to Notion (claim is now challenged/retracted).
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x skos:note "RETRACTED: The 15x columnar query performance claim for Zypherion is superseded. Subsequent evaluation found critical gaps in Zypherion's streaming ingestion, leading to the decision to switch to Meridian." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:challenges narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionPerformance15x narr:hasConvictionLevel ?oldLevel . }
    OPTIONAL { narr:Claim_ZypherionPerformance15x narr:supports ?oldSupports . }
    OPTIONAL { narr:Claim_ZypherionPerformance15x dct:source ?oldSource . }
  }
} ;

# ── New Claims ───────────────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion, as identified by CTO Quinton Fairweather during further evaluation." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Narrative_ZypherionAdoption .

    narr:Claim_MeridianBatchStreamingNative a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively, making it the preferred replacement for Zypherion in the analytics pipeline." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .

    narr:Claim_MeridianMigrationQ3_2026 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The Q3 2026 migration window is retained for the switch to Meridian, as confirmed in the revised decision." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZypherionAdoption .

  }
} ;

# ── New Observation: Quinton's verbatim quote ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Observation_QuintonMeridianQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Quinton Fairweather's direct statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps and Meridian's native dual-mode capability." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 340
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\""
        ]
      ] .

  }
} ;

