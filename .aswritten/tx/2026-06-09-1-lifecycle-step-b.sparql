PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T140000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "database-decision-zypherion-analytics" ;
    narr:originRef "main" ;
    prov:generated
      narr:Narrative_ZypherionAdoption,
      narr:Claim_ZypherionDatabaseChoice,
      narr:Claim_ZypherionMigrationQ3,
      narr:Claim_ZypherionStreamingGap,
      narr:Sample_ZypherionDecision_20260406,
      narr:Obs_QuintonAdoptionStatement,
      narr:Obs_StreamingIngestionGap,
      narr:Obs_SupersessionStatement,
      narr:Obs_MigrationTimeline,
      narr:StyleObs_DirectDeclarative,
      narr:StyleObs_SupersessionRhetoric,
      narr:StyleObs_TechnicalJargon,
      narr:StyleMetrics_ZypherionDecision .
} ;

# ── UPDATE: narr:Narrative_ZypherionAdoption ────────────────────────────────
# Memory explicitly supersedes Zypherion with Meridian; theme and note must change.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      a narr:Narrative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology re-selection driven by capability gap discovery" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps, switching to Meridian which handles both batch and streaming natively. Migration remains Q3 2026. This supersedes the prior Zypherion adoption decision." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionDatabaseChoice ──────────────────────────────
# "Meridian replaces Zypherion for analytics" — explicit functional change of database choice.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Meridian has been selected as the analytics database, replacing Zypherion. Decision attributed to CTO Quinton Fairweather on 2026-04-06. Supersedes prior Zypherion selection." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionPerformance15x → narr:Claim_ZypherionStreamingGap
# The 15x performance rationale is replaced by the streaming ingestion gap finding.
# Reuse IRI via rename-in-place: update note, aboutNode, and conviction.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the disqualifying reason for switching to Meridian. Contradicts the prior 15x columnar performance rationale as the decision driver." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports .
  }
} ;

