# ── New Sample (REVISED document) ───────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which Quinton Fairweather (CTO) retracts the Zypherion adoption decision and announces Meridian as the analytics database, citing Zypherion's critical gap in streaming ingestion. Q3 2026 migration window retained." ;
      narr:inputLength 487 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now about Meridian adoption ────────
# Justification: memory explicitly states "switching to Meridian instead" and
# "This supersedes the previous Zypherion decision" — temporal supersession.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Superseding Zypherion with Meridian as the analytics database due to streaming ingestion gap" ;
      skos:note "The organisation has reversed its Zypherion adoption decision. Meridian replaces Zypherion for analytics, handling both batch and streaming natively. Zypherion was found to have critical gaps in streaming ingestion. Q3 2026 migration window is retained." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → now contradicted / superseded ────
# Justification: "We are now switching to Meridian instead" directly contradicts
# the claim that Zypherion has been formally adopted.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "SUPERSEDED: Zypherion was formally adopted for the analytics pipeline per CTO directive on 2026-04-06, but this decision was reversed the same day in favour of Meridian due to critical streaming ingestion gaps." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:challenges narr:Claim_MeridianDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote . }
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:aboutNode ?oldAbout . }
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:supports ?oldSupports . }
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance15x → no longer the operative rationale ─
# Justification: The new decision rationale is streaming ingestion gap, not
# columnar performance. The 15x claim is not referenced in the revised memory,
# and the switch away from Zypherion implicitly retracts it as a decision driver.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x skos:note "SUPERSEDED: Zypherion's 15x columnar query performance claim was the original adoption rationale, but the decision was reversed after critical streaming ingestion gaps were identified. Performance advantage no longer operative as a decision driver." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionPerformance15x skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3_2026 → timeline retained but for Meridian
# Justification: Memory states "Same Q3 2026 migration window" — the timeline
# is preserved but now applies to Meridian, not Zypherion.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note "Migration to Meridian (replacing Zypherion) is planned for the same Q3 2026 window originally set for Zypherion." ;
      narr:supports narr:Claim_MeridianDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 narr:supports ?oldSupports . }
  }
} ;

# ── New Claims: Meridian adoption, streaming gap, Q3 timeline ────────────────
INSERT DATA {
