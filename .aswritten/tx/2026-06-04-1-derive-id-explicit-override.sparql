      skos:note "The H1 heading 'Some Other Title That Should Not Win' is an explicit test assertion that the pipeline's title/slug selection logic must not use the H1 heading as the winning source when other sources are available." .

    # ── Observations ─────────────────────────────────────────────────────────
    narr:Obs_ReviewerFrontmatter a narr:Observation ;
