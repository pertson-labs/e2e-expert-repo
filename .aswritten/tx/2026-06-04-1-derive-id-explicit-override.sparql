    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test memory with YAML frontmatter reviewer, an H1 heading asserting it should not be selected as the pipeline slug/title, and a single-word body. Exercises pipeline title-selection and reviewer-attribution paths." ;
      narr:inputLength 97 .

    # ── Narrative ────────────────────────────────────────────────────────────
    narr:Narrative_PipelineTitleSelection a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:Process ;
      narr:theme "Pipeline title/slug selection should prefer sources other than the H1 heading" ;
      skos:note "The heading 'Some Other Title That Should Not Win' encodes a test assertion: when a memory is processed, the pipeline must not blindly adopt the H1 heading as the canonical title or slug. A better source (YAML frontmatter, LLM id-gen, or deterministic fallback) should take precedence." .

    # ── Claim ────────────────────────────────────────────────────────────────
    narr:Claim_H1HeadingShouldNotWin a narr:Claim ;
