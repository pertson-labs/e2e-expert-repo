PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250729T130000Z a prov:Activity ;
    dct:title "Second version — minimal document extraction" ;
    prov:generatedAtTime "2025-07-29T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDocument,
      narr:Observation_SecondVersion_ReviewerFrontmatter,
      narr:StyleObs_SecondVersion_ShortCadence,
      narr:StyleObs_SecondVersion_ActiveVoice,
      narr:StyleObs_SecondVersion_EditorialFrontmatter,
      narr:StyleMetrics_SecondVersion .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250729T130000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document containing YAML frontmatter with a reviewer field and the body text 'Second version'. Structurally identical to the first version; body label incremented." ;
      narr:inputLength "57"^^xsd:integer .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersionDocument
      a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:NarrativeDrivenRoadmap ;
      skos:note "The document declares itself a second version with a single reviewer assigned via YAML frontmatter. No substantive content beyond the version label is present. Structurally mirrors the first version." ;
      narr:theme "Incremental document versioning / second-version declaration" .

    # ── Observation: reviewer frontmatter ───────────────────────
    narr:Observation_SecondVersion_ReviewerFrontmatter
      a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "YAML frontmatter assigns a reviewer role. Reviewer email redacted per PII policy." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "0"^^xsd:integer ;
        oa:end "44"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:" ;
        oa:prefix "---\n" ;
        oa:suffix "\n  - [REDACTED]"
      ] .

    # ── Style Observations ───────────────────────────────────────

    # 1. Short punchy cadence — two-word body sentence
    narr:StyleObs_SecondVersion_ShortCadence
      a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body consists of a single two-word declarative sentence, continuing the ultra-minimal cadence established in the first version." ;
      rdf:value "true"^^xsd:string ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "47"^^xsd:integer ;
          oa:end "57"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. Active voice — declarative label, no passive constructions
    narr:StyleObs_SecondVersion_ActiveVoice
      a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' is a nominal/declarative label with no passive constructions present." ;
      rdf:value "true"^^xsd:string ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "47"^^xsd:integer ;
          oa:end "57"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. Editorial rules — YAML frontmatter reviewer field pattern
    narr:StyleObs_SecondVersion_EditorialFrontmatter
      a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter with a 'reviewers' list field is used as a structural editorial convention, consistent with the first version pattern." ;
      rdf:value "true"^^xsd:string ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "0"^^xsd:integer ;
          oa:end "44"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - [REDACTED]"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion
      a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Single two-word body sentence. No passive constructions. No domain jargon present. Metrics identical to first version." ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}