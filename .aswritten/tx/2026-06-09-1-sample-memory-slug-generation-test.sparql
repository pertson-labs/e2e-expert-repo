# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 295 ;
      dct:description "A pipeline test artifact submitted without an explicit id field to exercise slug-generation fallback logic." .

    # ── Narrative ───────────────────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake workflow." .

    # ── Claim ───────────────────────────────────────────────────────────────
    narr:Claim_SlugFallbackRequired a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id is provided, using either the LLM id-gen call or the deterministic slugify fallback." .

    # ── Observation (body paragraph) ────────────────────────────────────────
    narr:Obs_PipelineSlugBody a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline requirement: slug must be produced and file committed when id is absent." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 91 ;
        oa:end 295
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Submitted without an explicit id field. The pipeline must produce a" ;
        oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
        oa:suffix "\nslug from the memory content"
      ] .

    # ── Style Observation 1: Technical/procedural register ──────────────────
    narr:StyleObs_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Authoritative, procedural register: the document states pipeline requirements as obligations ('must produce', 'must commit') without hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 91 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # ── Style Observation 2: Em-dash as enumerative separator ───────────────
    narr:StyleObs_DashPunctuation a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash used to introduce an inline enumeration of alternatives ('either via the LLM id-gen call or the deterministic slugify fallback'), a typographic choice signalling technical precision." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 255
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the" ;
          oa:prefix "slug from the memory content " ;
          oa:suffix " deterministic slugify fallback"
        ]
      ] .

    # ── Style Observation 3: Imperative/obligation mood ─────────────────────
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Obligation mood throughout: 'must produce', 'commit the file successfully' — no conditional or passive constructions. Signals a test specification rather than a narrative description." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 255 ;
          oa:end 295
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "and commit the file successfully." ;
          oa:prefix "deterministic slugify fallback — " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 22 ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:JargonDensity "0.20"^^xsd:decimal ;
      skos:note "Short document (3 sentences, ~60 words). High active voice ratio; technical jargon limited to pipeline-specific terms (id-gen, slugify, LLM). Formal, specification-style register." .

  }
