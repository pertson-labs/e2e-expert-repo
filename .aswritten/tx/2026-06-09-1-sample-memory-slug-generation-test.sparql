# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      dct:description "A test memory submitted without an explicit id field to exercise the pipeline slug-generation path." ;
      narr:inputLength 296 .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh@aswritten.ai" ;
      skos:note "Reviewer listed in YAML frontmatter of the test memory. Email address used as identifier per PII policy (reviewer role, not personal data)." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative captures the required pipeline resilience pattern." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from memory content (LLM id-gen or deterministic slugify fallback) and commit the file successfully when no id field is present." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_SlugGenMechanism a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Describes the two-path slug generation mechanism: LLM id-gen call or deterministic slugify fallback." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 118 ;
        oa:end 296
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    narr:Observation_ReviewerFrontmatter a narr:Observation ;
      skos:broader narr:QualityReviewGates ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "YAML frontmatter specifies a reviewer email, establishing a review gate for this test memory." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 4 ;
        oa:end 46
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObservation_ImperativeRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Imperative/obligatory register: 'must produce a slug … and commit the file successfully' asserts a hard requirement without hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 118 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    narr:StyleObservation_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Domain-specific technical terms used without definition: 'slug', 'LLM id-gen call', 'deterministic slugify fallback', 'pipeline'. Assumes reader familiarity with the aswritten.ai engineering context." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 144 ;
          oa:end 248
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "slug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "The pipeline must produce a\n" ;
          oa:suffix " — and commit the file"
        ]
      ] .

    narr:StyleObservation_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "'Submitted without an explicit id field' opens with a passive/agentless construction, omitting the actor who submitted the memory. Contrasts with the active-voice imperative that follows." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 78 ;
          oa:end 118
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Submitted without an explicit id field." ;
          oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
          oa:suffix " The pipeline must"
