      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "After slug generation, the pipeline must commit the file successfully — the full write path must complete even when the id was not supplied by the author." .

    # ── Observation (grounded quote) ─────────────────────────────
    narr:Observation_SlugGenRequirement a narr:Observation ;
