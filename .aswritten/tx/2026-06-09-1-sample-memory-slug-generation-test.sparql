# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 367 ;
      dct:description "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exists to exercise and validate that path." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "Expert GH Reviewer" ;
      skos:note "Reviewer listed in YAML frontmatter of this test memory. Email redacted (PII policy)." .

    # ── Observation: slug-gen behavior ──────────────────────────
    narr:Obs_SlugGenBehavior a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id is provided." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 119 ;
        oa:end 299
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Technical register / jargon density
    narr:StyleObs_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Technical pipeline vocabulary: 'LLM id-gen call', 'deterministic slugify fallback', 'commit the file'. Signals an engineering-internal audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 265
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # 2. Imperative / obligation mood
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Use of 'must' signals a normative requirement statement rather than a description, consistent with specification or acceptance-criteria register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 119 ;
          oa:end 161
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # 3. Passive / impersonal construction (frontmatter)
    narr:StyleObs_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "'Submitted without an explicit id field' uses an agentless passive, omitting who submitted the memory. Typical of automated pipeline test fixtures." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 78 ;
          oa:end 118
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Submitted without an explicit id field." ;
          oa:prefix "\n\n" ;
          oa:suffix " The pipeline must produce a"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 28 ;
      narr:ActiveVoiceRatio 0.5 ;
      narr:JargonDensity 0.18 ;
      skos:note "Short two-sentence body. Mixed voice (one passive opener, one active obligation statement). Moderate jargon density driven by pipeline/LLM/slugify terminology. Formal-technical register." .

