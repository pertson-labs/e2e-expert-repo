      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests a critical pipeline resilience path." .

    # ── Claims ───────────────────────────────────────────────────
    narr:Claim_SlugFromContent_LLMOrFallback a narr:Claim ;
