      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength "22"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Body is 2 sentences (~44 words total, avg ~22 words/sentence). Active voice ratio ~0.50 due to opening passive construction. Jargon density ~0.18 reflecting heavy use of pipeline/engineering terms (slug, LLM, id-gen, slugify, pipeline, fallback) in a short passage." .

