# New Sample for second version document
INSERT DATA {
  GRAPH narr:Tx_20260707T131647Z {
    narr:Sample_SecondVersion_E2E a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal stub document with YAML frontmatter (reviewer field) and a single body phrase. Second iteration of the versioned review-gated artifact." ;
      narr:inputLength 64 .
  }
} ;

# Update Narrative_FirstVersionStub to reflect second version
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260707T131647Z {
    narr:Narrative_FirstVersionStub skos:note "Document has progressed to second version; same YAML frontmatter reviewer pattern and stub body register persist. Review workflow remains in place." ;
      narr:theme "Second version stub document marking progression of a review-gated artifact" ;
      dct:source narr:Sample_SecondVersion_E2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub skos:note ?oldNote ;
      narr:theme ?oldTheme ;
      dct:source ?oldSource .
  }
} ;

# Update StyleObs_MinimalBodyText — body text changed from 'First version' to 'Second version'
DELETE {
  GRAPH ?g {
    narr:StyleObs_MinimalBodyText dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
}
INSERT {
  GRAPH narr:Tx_20260707T131647Z {
    narr:StyleObs_MinimalBodyText dct:source narr:Sample_SecondVersion_E2E ;
      skos:note "Body text is a two-word phrase 'Second version', representing extreme brevity — a placeholder or stub register. Version label incremented from first to second." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion_E2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ; oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix " xena+staging@aswritten.ai\n---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleObs_MinimalBodyText dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
} ;

# New StyleMetrics for second version sample
INSERT DATA {
  GRAPH narr:Tx_20260707T131647Z {
    narr:StyleMetrics_SecondVersion_E2E a narr:StyleMetrics ;
