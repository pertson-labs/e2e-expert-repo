PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250714T130000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "Second Version Document Extraction" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDocument,
      narr:Observation_SecondVersionBody,
      narr:StyleObservation_MinimalBody_V2,
      narr:StyleObservation_ReviewerFrontmatter_V2,
      narr:StyleObservation_VersionLabel_V2,
      narr:StyleMetrics_SecondVersion .
} ;

# ── UPDATE: Sample — title and inputLength reflect second version ────────────
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      narr:inputLength ?oldLen ;
      dct:description ?oldDesc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T130000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter listing a reviewer and a single-line body stating 'Second version'. Structurally identical to the first version; body text updated." ;
      narr:inputLength 56 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersion dct:title ?oldTitle ;
      narr:inputLength ?oldLen ;
      dct:description ?oldDesc .
  }
} ;

# ── UPDATE: Narrative — theme and note reflect second version ────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T130000Z {
    narr:Narrative_SecondVersionDocument a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      narr:theme "Iterative document versioning with designated reviewer" ;
      skos:note "The document has advanced from 'First version' to 'Second version', indicating active iteration within a formal review workflow. The body remains minimal, signalling an incremental placeholder update rather than substantive content change." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

# ── UPDATE: Observation — body text now 'Second version' ────────────────────
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T130000Z {
    narr:Observation_SecondVersionBody a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Milestones ;
      skos:note "The body text 'Second version' signals an incremental milestone update, advancing the document from its initial placeholder state." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 48 ;
        oa:end 62
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

# ── INSERT: Style observations (min 3, new extraction) ──────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T130000Z {

    narr:StyleObservation_MinimalBody_V2 a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a two-word noun phrase with no verb, article, or elaboration — extreme conciseness as a placeholder convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 48 ;
          oa:end 62
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObservation_ReviewerFrontmatter_V2 a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter uses a structured 'reviewers' list key, indicating adherence to a machine-readable editorial governance convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 4 ;
          oa:end 43
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    narr:StyleObservation_VersionLabel_V2 a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version label follows an ordinal noun pattern ('Second version') consistent with the prior 'First version' label, establishing a sequential naming convention for document iterations." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 48 ;
          oa:end 62
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2-word body). No jargon detected. Active voice ratio nominal given absence of verbs. Register: stub/placeholder. Metrics unchanged from first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}