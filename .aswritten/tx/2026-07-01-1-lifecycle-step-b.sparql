# ── New entities: Meridian adoption narrative, claims, observations, style ────
INSERT DATA {
  GRAPH narr:Tx_20260701T170902Z {

    # New top-level narrative for the Meridian decision
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology adoption decision revised: Meridian replaces Zypherion for analytics after streaming ingestion gaps discovered" ;
      skos:note "Quinton Fairweather (CTO) announced on 2026-04-06 that Zypherion has been dropped in favour of Meridian due to critical streaming ingestion gaps. Meridian handles both batch and streaming natively. Q3 2026 migration window unchanged." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:supersedes narr:Narrative_ZypherionAdoption .

    # Claim: Meridian migration timeline
    narr:Claim_MeridianMigrationTimeline a narr:Claim ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "Migration to Meridian (replacing Zypherion) is scheduled for Q3 2026, the same window as the original Zypherion migration plan." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:supports narr:Narrative_MeridianAdoption .

    # Claim: Meridian streaming capability
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "Meridian handles both batch and streaming ingestion natively, which was the decisive capability gap that Zypherion could not fill." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:supports narr:Narrative_MeridianAdoption .

    # Claim: Zypherion streaming gap (the reason for the switch)
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, making it unsuitable for the analytics pipeline." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:challenges narr:Narrative_ZypherionAdoption .

    # Observation: Quinton's verbatim Meridian quote
    narr:Observation_MeridianQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      skos:note "Quinton Fairweather's verbatim statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # StyleObservation: supersession declaration language
    narr:StyleObservation_SupersessionDeclaration a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      skos:note "Document opens with 'REVISED' in the title and explicitly states 'This supersedes the previous Zypherion decision' — authoritative retraction framing." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 391 ; oa:end 439
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # StyleObservation: revised bullet format with Reason replacing Performance
    narr:StyleObservation_BulletKeyDecisionsFormat_Revised a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      skos:note "Revised decision bullets swap '**Performance**' for '**Reason**', signalling a qualitative rationale rather than a quantitative one — a register shift from metric-driven to capability-driven justification." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 392 ;
          oa:end 487
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # StyleObservation: declarative switch phrasing
    narr:StyleObservation_DeclarativeSwitch a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      skos:note "'We are now switching to Meridian instead' uses present-progressive with 'now' for immediacy, reinforcing the finality of the reversal." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 291 ; oa:end 332
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix " Meridian handles both"
        ]
      ] .

    # StyleMetrics for the new sample
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:AverageSentenceLength "12"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal ;
      skos:note "Short declarative sentences; predominantly active voice; moderate technical jargon (streaming ingestion, batch, analytics, migration). Supersession register ('REVISED', 'supersedes') elevates formality." .
  }
}