# ── UPDATE: Narrative_ZypherionAdoption → superseded by Meridian adoption ───
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?note ;
      narr:theme ?theme ;
      dct:source ?src .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T170902Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation initially adopted Zypherion for analytics but has now switched to Meridian after discovering critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Migration remains Q3 2026." ;
      narr:theme "Technology adoption decision superseded: Meridian replaces Zypherion for analytics" ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:supersedes narr:Sample_ZypherionDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?theme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?note . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?src . }
  }
} ;

