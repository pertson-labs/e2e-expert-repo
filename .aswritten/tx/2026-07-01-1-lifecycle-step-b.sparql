    narr:Claim_ZypherionColumnarPerformance dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T231303Z {
    narr:Claim_ZypherionColumnarPerformance skos:note "SUPERSEDED (2026-04-06): Although Zypherion handles columnar queries 15x faster, the decision to adopt it was reversed due to critical gaps in streaming ingestion. The columnar performance advantage does not offset the streaming limitation for the analytics use case." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_DatabaseDecisionRevised_Meridian_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionColumnarPerformance narr:hasConvictionLevel ?oldLevel . }
    OPTIONAL { narr:Claim_ZypherionColumnarPerformance dct:source ?oldSource . }
  }
} ;

