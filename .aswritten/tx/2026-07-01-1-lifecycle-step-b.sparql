# ── UPDATE Narrative_ZypherionAdoption → now reflects Meridian adoption ─────
# The narrative theme has fundamentally changed: Zypherion is out, Meridian is in.
# Memory explicitly states "This supersedes the previous Zypherion decision."
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    narr:Narrative_ZypherionAdoption skos:note ?oldNote .
    narr:Narrative_ZypherionAdoption dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T231303Z {
    narr:Narrative_ZypherionAdoption narr:theme "Adopting Meridian as the analytics database, superseding the Zypherion decision due to streaming ingestion gaps" ;
      skos:note "The organization reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps. Meridian was selected as the replacement, handling both batch and streaming natively. Migration remains on the Q3 2026 timeline. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_DatabaseDecisionRevised_Meridian_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── UPDATE Claim_ZypherionColumnarPerformance → superseded/retracted ─────────
# The 15x columnar performance claim was the basis for choosing Zypherion.
# The revised memory explicitly contradicts the prior positive framing by
# identifying critical gaps and switching away. The claim is now superseded.
DELETE {
