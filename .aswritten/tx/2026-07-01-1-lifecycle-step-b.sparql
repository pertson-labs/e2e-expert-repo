# ── UPDATE: Narrative_ZypherionAdoption → superseded by Meridian ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T232330Z {
    narr:Narrative_ZypherionAdoption narr:theme "Zypherion evaluated and rejected for analytics; superseded by Meridian adoption" ;
      skos:note "Originally adopted for 15x columnar query performance; subsequently found to lack streaming ingestion capability. Decision revised 2026-04-06 to adopt Meridian instead. Same Q3 2026 migration window retained." ;
      dct:isReplacedBy narr:Narrative_MeridianAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationTimeline → now targets Meridian ──────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260701T232330Z {
    narr:Claim_ZypherionMigrationTimeline skos:note "Migration timeline (Q3 2026) is retained but now applies to Meridian, not Zypherion. Superseded by Claim_MeridianMigrationTimeline." ;
      dct:isReplacedBy narr:Claim_MeridianMigrationTimeline .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline ?p ?oldNote .
    FILTER(?p = skos:note)
  }
} ;

# ── INSERT: new Sample ───────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260701T232330Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 615 ;
      skos:note "Revised meeting note from CTO Quinton Fairweather superseding the Zypherion adoption decision. Cites streaming ingestion gaps in Zypherion; selects Meridian for native batch and streaming support." .
  }
} ;

# ── INSERT: new Narrative ────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260701T232330Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:theme "Adopting Meridian as the analytics database for native batch and streaming ingestion" ;
      skos:broader narr:StackOverview ;
      skos:note "Meridian replaces Zypherion after critical streaming ingestion gaps were identified in Zypherion. Meridian handles both batch and streaming natively. Migration window remains Q3 2026." ;
      dct:replaces narr:Narrative_ZypherionAdoption .
  }
} ;

# ── INSERT: new Claims ───────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260701T232330Z {

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
