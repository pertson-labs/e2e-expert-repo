PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250127T000001Z a prov:Activity ;
    dct:title "Second version — reviewer-gated document stub, iteration 2" ;
    prov:generatedAtTime "2025-01-27T00:00:01Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id provided in input)" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionIteration,
      narr:Claim_ReviewerGating_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_YAMLFrontmatter,
      narr:StyleObs_SecondVersion_NounPhraseFragment .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250127T000001Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document stub with YAML frontmatter declaring a reviewer and a single-phrase body reading 'Second version'. Structurally identical to first version stub." ;
      narr:inputLength 57 .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SecondVersionIteration a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      narr:theme "Document iteration — second version stub with reviewer gating" ;
      skos:note "The memory marks a second iteration of the same minimal stub pattern seen in the first version. The reviewer assignment is unchanged and the body advances only the version label, confirming a recurring workflow gate before substantive content is authored." .

    # ── Claim ────────────────────────────────────────────────────
    narr:Claim_ReviewerGating_SecondVersion a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      narr:aboutNode narr:Narrative_SecondVersionIteration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_SecondVersionIteration ;
      skos:note "The same reviewer (email redacted) appears in the second version frontmatter, reinforcing the claim that a named reviewer is structurally required before content progresses. Conviction elevated from Notion to Stake because the pattern now recurs across two versions." .

    # ── Style Observations ───────────────────────────────────────

    # 1. Version label as bare noun phrase — ShortPunchyCadence
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a two-word noun phrase with no verb, identical in structure to the first version. Cadence is maximally compressed." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. YAML frontmatter reviewer key — EditorialRules / NamingConventions
    narr:StyleObs_SecondVersion_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter uses a 'reviewers' list key, establishing a machine-readable editorial gate. Consistent with first-version pattern — indicates a stable document template convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # 3. Noun-phrase-only body — VoicePassive / GrammarSyntax (fragment, no verb)
    narr:StyleObs_SecondVersion_NounPhraseFragment a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document body is a verbless noun phrase fragment. No predicate is present, so the text functions as a label rather than a statement. This is a recurring structural pattern in version-stub documents." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "0.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Body is a single two-word noun phrase fragment with no verb. Active/passive voice ratio is undefined — set to 0.0. No domain jargon detected. Metrics are identical to first-version stub, confirming structural template reuse." .

  }
}