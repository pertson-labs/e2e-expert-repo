PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDeclaration,
      narr:Claim_DocumentAtSecondVersion,
      narr:Observation_SecondVersionBody,
      narr:StyleObs_SecondVersion_ShortNounPhrase,
      narr:StyleObs_SecondVersion_AdminRegister,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleMetrics_SecondVersion .
} ;

# ── New Sample for second version ────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML front-matter listing a reviewer and a two-word body declaring second version status. Supersedes Sample_FirstVersion." ;
      narr:inputLength 68 ;
      dct:isVersionOf narr:Sample_FirstVersion ;
      dct:replaces narr:Sample_FirstVersion .

    # ── Narrative: second version declaration ─────────────────────────────
    narr:Narrative_SecondVersionDeclaration a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      narr:theme "Document versioning — second version state declaration" ;
      skos:note "The document asserts it is now at its second version, with the same named reviewer assigned. This supersedes the first-version baseline and advances the revision sequence." .

    # ── Claim: document at second version ────────────────────────────────
    narr:Claim_DocumentAtSecondVersion a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      narr:aboutNode narr:Narrative_SecondVersionDeclaration ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_SecondVersionDeclaration ;
      skos:note "The body text 'Second version' is the sole content assertion. Conviction is Notion — minimal evidence, single declarative phrase. Supersedes Claim_DocumentAtInitialVersion." .

    # ── Observation: body text ────────────────────────────────────────────
    narr:Observation_SecondVersionBody a narr:Observation ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "The entire body of the document is the two-word phrase 'Second version', indicating a revised draft state superseding the first version." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 54 ;
        oa:end 68
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    # ── Style Observation 1: short noun-phrase body ───────────────────────
    narr:StyleObs_SecondVersion_ShortNounPhrase a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a bare two-word noun phrase with no verb, no punctuation — identical cadence pattern to the first version." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 54 ;
          oa:end 68
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: administrative register ──────────────────────
    narr:StyleObs_SecondVersion_AdminRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Register is administrative/version-label: terse, impersonal, no rhetorical elaboration. Consistent with first-version register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 68
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

    # ── Style Observation 3: version label as sole content ────────────────
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "'Second version' uses sentence case (capital S, lowercase v), consistent with the prior 'First version' capitalization pattern — establishing a stable version-label convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 54 ;
          oa:end 68
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Extremely short document. Body is a single 2-word noun phrase. No jargon. No passive constructions. Register is administrative/version-label. Metrics identical to first version." .

  }
}