INSERT {
  GRAPH narr:Tx_20260704T104230Z {
    narr:Narrative_PipelineSlugDerivation skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative is exercised by two E2E test memories: Phase 1 (Sample_SampleMemoryDistinctiveHeading) and Phase 2 (Sample_SampleMemoryPhase2DeriveIdE2E). Phase 2 additionally specifies the must-not-crash constraint and reproduces the prod failure pattern with a ## level heading." .
  }
}
