# ── New Sample for the revised memo ─────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250710T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion database decision and selects Meridian instead, citing critical gaps in Zypherion's streaming ingestion. Q3 2026 migration timeline is retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 592 .
  }
} ;

# ── New Narrative: Meridian adoption ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250710T120000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology decision reversal driven by streaming capability gap" ;
      skos:note "After further evaluation, Zypherion was rejected due to critical gaps in streaming ingestion. Meridian was selected as the replacement because it handles both batch and streaming natively. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption decision." .
  }
} ;

