# ── UPDATE: StyleMetrics → revised document metrics ─────────────────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio ?oldAVR ;
      narr:JargonDensity ?oldJD .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short declarative sentences. Predominantly active voice (first-person plural). Moderate technical jargon (streaming ingestion, batch, analytics pipeline, migration)." ;
      narr:AverageSentenceLength 12 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.10"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision dct:source ?oldSource .
    OPTIONAL { narr:StyleMetrics_ZypherionDecision skos:note ?oldNote . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision narr:AverageSentenceLength ?oldASL . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision narr:ActiveVoiceRatio ?oldAVR . }
    OPTIONAL { narr:StyleMetrics_ZypherionDecision narr:JargonDensity ?oldJD . }
  }
}