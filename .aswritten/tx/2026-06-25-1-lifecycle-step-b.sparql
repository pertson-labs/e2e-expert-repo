PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T120000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-memory-2026-04-06-meridian-decision" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Narrative_MeridianAdoption,
      narr:Claim_MeridianDBChoice,
      narr:Claim_MeridianMigrationQ3,
      narr:Claim_ZypherionStreamingGap,
      narr:Actor_QuintonFairweather,
      narr:Sample_MeridianDecision_20260406,
      narr:Obs_QuintonMeridianQuote,
      narr:StyleObs_AuthoritativeTone_Meridian,
      narr:StyleObs_BoldKeyValue_Meridian,
      narr:StyleObs_SupersedesMarker_Meridian,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── New Sample node for the revised document ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 432 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now Meridian adoption ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "The organization has reversed its Zypherion decision and is now adopting Meridian as its analytics database. Reason: Zypherion lacks streaming ingestion; Meridian handles both batch and streaming natively. Migration remains Q3 2026. This supersedes narr:Narrative_ZypherionAdoption." ;
      narr:theme "Technology adoption decision revised: Meridian replaces Zypherion for analytics pipeline (streaming ingestion gap)" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionDBChoice → Meridian is the chosen DB ─────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDBChoice skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_MeridianDBChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian is the chosen database for the analytics pipeline, replacing Zypherion. Stated by CTO Quinton Fairweather on 2026-04-06." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:StackOverview .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDBChoice skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionDBChoice narr:aboutNode ?oldAbout . }
    OPTIONAL { narr:Claim_ZypherionDBChoice narr:hasConvictionLevel ?oldLevel . }
    OPTIONAL { narr:Claim_ZypherionDBChoice dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same timeline, now for Meridian ────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Migration to Meridian proceeds on the same Q3 2026 window originally planned for Zypherion." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:NarrativeDrivenRoadmap .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3 narr:aboutNode ?oldAbout . }
    OPTIONAL { narr:Claim_ZypherionMigrationQ3 dct:source ?oldSource . }
  }
} ;

# ── DELETE: Claim_ZypherionPerformance15x (superseded, no equivalent) ────────
DELETE WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

# ── UPDATE: Actor_QuintonFairweather note (now announcing switch) ─────────────
DELETE {
  GRAPH ?g {
    narr:Actor_QuintonFairweather skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Actor_QuintonFairweather a narr:Actor ;
      skos:prefLabel "Quinton Fairweather" ;
      skos:note "CTO; originally announced Zypherion adoption, then reversed the decision on 2026-04-06, switching to Meridian due to Zypherion's streaming ingestion gaps." .
  }
}
WHERE {
  narr:Actor_QuintonFairweather skos:note ?oldNote .
} ;

# ── NEW: Claim — Zypherion streaming ingestion gap (new fact, no prior) ──────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, which was the primary reason for switching to Meridian." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Narrative_ZypherionAdoption .
  }
} ;

# ── UPDATE: Obs_QuintonAdoptionQuote → new Meridian quote ───────────────────
DELETE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionQuote ?p ?o .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Obs_QuintonMeridianQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Quinton Fairweather's verbatim announcement of the switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 131 ;
        oa:end 280
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch and streaming natively.\""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionQuote ?p ?o .
  }
} ;

