# ── INSERT: Observations grounded in source text ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Obs_MeridianSwitchQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO direct quote announcing the switch to Meridian." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 198 ;
        oa:end 290
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We are now switching to Meridian instead." ;
        oa:prefix "its streaming ingestion. " ;
        oa:suffix " Meridian handles both batch"
      ] .

    narr:Obs_ZypherionGapQuote a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit statement of Zypherion's critical streaming ingestion gap — the technical rationale for the switch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 155 ;
        oa:end 215
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "found critical gaps in its streaming ingestion" ;
        oa:prefix "evaluated Zypherion further and " ;
        oa:suffix ". We are now switching"
      ] .

    narr:Obs_MeridianCapabilityQuote a narr:Observation ;
      skos:broader narr:StackOverview ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian's native dual-mode ingestion capability stated as the positive selection criterion." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 291 ;
        oa:end 345
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead. " ;
        oa:suffix " This supersedes the previous"
      ] .

  }
} ;

