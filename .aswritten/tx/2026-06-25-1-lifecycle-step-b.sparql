# ── UPDATE: narr:Narrative_ZypherionAdoption — superseded by Meridian decision
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250710T120000Z {
    narr:Narrative_ZypherionAdoption skos:note "SUPERSEDED (2026-04-06): The Zypherion adoption decision was reversed after critical gaps in streaming ingestion were identified. Meridian was selected as the replacement. See narr:Narrative_MeridianAdoption for the current state." ;
      narr:theme "Technology adoption decision reversed due to streaming capability gap" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

