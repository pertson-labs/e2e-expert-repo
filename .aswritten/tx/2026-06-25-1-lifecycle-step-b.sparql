INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:StyleObs_BoldKeyValue_Meridian a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
