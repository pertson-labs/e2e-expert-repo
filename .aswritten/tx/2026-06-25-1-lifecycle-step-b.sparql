# ── UPDATE: narr:Narrative_ZypherionAdoption — superseded ────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption driven by quantified performance gain [SUPERSEDED — see narr:Narrative_MeridianAdoption]" ;
      skos:note "SUPERSEDED 2026-04-06: The Zypherion adoption decision has been reversed. Meridian was selected instead due to critical gaps in Zypherion's streaming ingestion. See narr:Narrative_MeridianAdoption for the current state." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionDatabaseChoice — Zypherion no longer selected ─
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "[SUPERSEDED 2026-04-06] Zypherion was selected as the analytics database. This claim has been retracted: Meridian replaces Zypherion. See narr:Claim_MeridianDatabaseChoice." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionMigrationQ3 — timeline retained but DB changed ─
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionMigrationQ3 skos:note "[UPDATED 2026-04-06] Q3 2026 migration window is retained, but the target database is now Meridian (not Zypherion). The timeline was confirmed in the revised decision document." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:supports narr:Claim_MeridianDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports .
  }
} ;

