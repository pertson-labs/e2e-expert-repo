# ── INSERT new Sample for the revised document ──────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note dated 2026-04-06 with Quinton Fairweather (CTO) announcing that Zypherion has been rejected due to critical streaming ingestion gaps, and that Meridian — which handles both batch and streaming natively — will be adopted instead. Supersedes the prior Zypherion decision. Q3 2026 migration window unchanged." ;
      narr:inputLength 450 .
  }
} ;

# ── UPDATE narr:Narrative_ZypherionAdoption → now Meridian adoption ─────────
# Memory explicitly supersedes the Zypherion adoption narrative.
# Functional change: theme, skos:note, and dct:source all shift.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Strategic pivot from Zypherion to Meridian as the analytics database, driven by streaming ingestion gaps" ;
      skos:note "The organisation evaluated Zypherion further and found critical gaps in its streaming ingestion capability. Meridian — which handles both batch and streaming natively — replaces Zypherion. Q3 2026 migration window is unchanged. This decision explicitly supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

