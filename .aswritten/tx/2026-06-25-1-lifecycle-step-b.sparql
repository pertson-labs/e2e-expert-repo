# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and selects Meridian as the analytics database, citing Zypherion's critical gap in streaming ingestion. Supersedes the prior Zypherion decision. Q3 2026 migration window retained." ;
      narr:inputLength 502 .
  }
} ;

# ── New Narrative: Meridian adoption ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology re-selection driven by streaming ingestion capability gap" ;
      skos:note "The organisation reverses its Zypherion analytics database decision and selects Meridian instead. The pivot is justified by a critical gap in Zypherion's streaming ingestion. Meridian handles both batch and streaming natively. The Q3 2026 migration window is preserved. This narrative supersedes narr:Narrative_ZypherionAdoption." .
  }
} ;

# ── New Claim: Meridian selected as analytics database ──────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption ;
      skos:note "Meridian replaces Zypherion as the analytics database. Decision attributed to CTO Quinton Fairweather on 2026-04-06 in a revised decision document." .
  }
} ;

# ── New Claim: Zypherion streaming ingestion gap ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice ;
      narr:challenges narr:Narrative_ZypherionAdoption ;
      skos:note "Zypherion has critical gaps in streaming ingestion. This is the stated reason for the reversal. Attributed to CTO Quinton Fairweather." .
  }
} ;

# ── Observations ─────────────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {

    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      skos:broader narr:CoreNarratives ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO directly states the reversal and new selection in first-person voice." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 310
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in\nits streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch and streaming natively."
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession statement: this document formally retracts the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 320 ;
        oa:end 368
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    narr:Obs_MeridianBatchStreamingClaim a narr:Observation ;
      skos:broader narr:DataIntegrationFlows ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian's dual capability (batch and streaming) is the stated technical differentiator over Zypherion." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 310 ;
        oa:end 368
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead.\n" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .
  }
} ;

