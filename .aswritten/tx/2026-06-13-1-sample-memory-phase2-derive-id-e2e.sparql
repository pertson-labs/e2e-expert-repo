# ── New Sample node for Phase 2 memory ──────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Tests that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 222 .
  }
} ;

# ── Update Narrative_PipelineSlugGenFallback to incorporate Phase 2 framing ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFallback skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGenFallback skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) extends this: the pipeline must also not crash when the memory uses a ## level heading with no id field, reproducing the missing-id failure pattern from prod. Both phases assert robustness of the intake and file-commit workflow." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGenFallback skos:note ?oldNote .
  }
} ;

# ── New Claim: pipeline must not crash on missing id ────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Claim_PipelineMustNotCrashOnMissingId a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Phase 2 E2E test asserts that the pipeline must not crash when processing a memory with a ## level heading and no id field. It must produce a valid slug. This is a crash-safety / robustness requirement distinct from the slug-generation mechanism claim." ;
      narr:aboutNode narr:IncidentResponse ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGenFallback .
  }
} ;

