PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version document stub extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_PlainLanguage,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_FrontmatterConvention .
} ;

# New Sample entity for the second version document stub
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version document stub" ;
      dct:description "Minimal document stub containing YAML frontmatter with a reviewer assignment and a single version label body, incremented from first version." ;
      narr:inputLength 63 .
  }
} ;

# New StyleMetrics for the second version
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Body is a single two-word fragment ('Second version') with no full sentences, no passive constructions, and no domain jargon. Metrics mirror the stub nature of the document, consistent with the first version." .
  }
} ;

# Style observation 1: Plain language / minimal register
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_PlainLanguage a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text is a bare two-word ordinal phrase with no elaboration, exemplifying maximal plain language economy." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# Style observation 2: YAML frontmatter convention (editorial rules)
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_FrontmatterConvention a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Reviewer assignment is encoded in YAML frontmatter using a list under the 'reviewers' key, consistent with a structured editorial workflow convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 45
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .
  }
} ;

# Style observation 3: Ordinal versioning label as naming convention
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Version state is communicated via a plain ordinal label ('Second version') rather than a semantic version number (e.g., v2.0), indicating an informal or early-stage document lifecycle convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
} ;

# UPDATE: Narrative_FirstVersionDocumentStub — version has incremented to second
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocumentStub narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDocumentStub narr:theme "Document lifecycle: version increment from first to second stub with reviewer assignment" ;
      skos:note "The memory represents the second version of a document lifecycle stub — same reviewer designated via YAML frontmatter, body text incremented from 'First version' to 'Second version'. No substantive content exists beyond the version label." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocumentStub narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocumentStub skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_FirstVersionDocumentStub dct:source ?oldSource . }
  }
} ;

# UPDATE: Claim_FirstVersionInitialState — version label has changed
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionInitialState skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Claim_FirstVersionInitialState skos:note "The document has advanced to its second version state, still a stub with no substantive content. The same reviewer is assigned via YAML frontmatter. Conviction remains Notion given the absence of substantive content." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionInitialState skos:note ?oldNote .
    OPTIONAL { narr:Claim_FirstVersionInitialState dct:source ?oldSource . }
  }
}