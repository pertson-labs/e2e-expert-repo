    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_HeadingNotWinning a narr:Narrative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:NarrativeAnchor ;
      narr:theme "Document heading declared as non-canonical title" ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' signals that the heading text should not be used as the canonical title — likely a test assertion about title-selection logic in the pipeline." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_ReviewerFrontmatter a narr:Observation ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:QualityReviewGates ;
      skos:note "YAML frontmatter declares a single reviewer via the 'reviewers' list field. Email redacted per PII policy." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 4 ;
        oa:end 14
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:" ;
        oa:prefix "---\n" ;
        oa:suffix "\n  - "
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_H1Heading a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "H1 heading uses title case with an embedded meta-assertion ('Should Not Win'), signalling intentional non-canonical framing rather than descriptive titling." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 91
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "# Some Other Title That Should Not Win" ;
          oa:prefix "\n\n" ;
          oa:suffix "\n\nBody."
        ]
      ] .

    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word ('Body.') — an extreme instance of short-punchy cadence, likely a placeholder or test stub rather than substantive prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 93 ;
          oa:end 98
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes for structured metadata (reviewer routing). This is an editorial convention for machine-readable document metadata." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 50
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---" ;
          oa:prefix "" ;
          oa:suffix "\nreviewers:"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SomeOtherTitleShouldNotWin a narr:StyleMetrics ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short body (1 word, 1 sentence). Active/declarative voice. No technical jargon in body text. Specification-like frontmatter; placeholder body register." ;
      narr:AverageSentenceLength 1 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

