# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250717T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal test document with YAML frontmatter (reviewer field) and a single H1 heading followed by a one-word body. Submitted to exercise title-selection and reviewer-routing behaviour." ;
      narr:inputLength 98 .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
