  GRAPH narr:Tx_20250717T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SomeOtherTitleShouldNotWin a narr:Sample ;
      dct:title "Some Other Title That Should Not Win" ;
      dct:description "Minimal pipeline test memory submitted without an explicit id field. Contains YAML frontmatter with a reviewer, an H1 heading asserting the title should not win slug selection, and a one-word body. Tests pipeline resilience and slug-gen behavior." ;
      narr:inputLength 90 .

    # ── Claim: heading must not determine slug ───────────────────
    narr:Claim_HeadingMustNotDetermineSlug a narr:Claim ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading 'Some Other Title That Should Not Win' is a self-referential test assertion: the pipeline must not use this heading as the canonical slug or id when a better mechanism (LLM id-gen or slugify fallback) is available. Supports the existing pipeline slug-generation narrative." ;
