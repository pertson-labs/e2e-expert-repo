      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process .

    # ── Style Observation 1: Minimal body ───────────────────────
    narr:StyleObs_MinimalBody a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "Body consists of a single word 'Body.' — extreme brevity used as a pipeline stress test for minimal content handling." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 82 ;
          oa:end 87
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "# Some Other Title That Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: Self-referential heading ────────────
    narr:StyleObs_HeadingAsAssertion a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "The H1 heading is a self-referential imperative assertion embedded in the document title itself — an unusual rhetorical device that encodes the test expectation directly in the content." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleShouldNotWin ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 43 ;
          oa:end 81
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # ── Style Observation 3: YAML frontmatter reviewer field ─────
    narr:StyleObs_FrontmatterReviewer a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SomeOtherTitleShouldNotWin ;
      skos:note "YAML frontmatter uses a 'reviewers' list field with an email address as identifier — a structured metadata convention for pipeline reviewer attribution." ;
      rdf:value true ;
      oa:hasTarget [
