# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 349 ;
      dct:description "Test pipeline memory submitted without an explicit id field to exercise slug-generation and file-commit behaviour." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh@aswritten.ai" ;
      skos:note "Reviewer listed in YAML frontmatter of the test memory. Redacted to role label; email retained as identifier per allow_pii default." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the resulting file successfully." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id field is present." .

    narr:Claim_SlugSourceLLMOrFallback a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Slug derivation may use either the LLM id-gen call or the deterministic slugify fallback — both paths are valid." .

    narr:Claim_FileCommitSuccess a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "After slug generation the pipeline must commit the file successfully — commit success is a required outcome, not optional." .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_NoExplicitIdField a narr:Observation ;
      skos:broader narr:FrictionFailure ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The memory explicitly states it was submitted without an explicit id field, making slug generation the test condition." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 113 ;
        oa:end 175
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Submitted without an explicit id field." ;
        oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
        oa:suffix " The pipeline must produce a"
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_AuthoritativeImperative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Imperative modal 'must' used twice to assert non-negotiable pipeline requirements; register is authoritative and prescriptive." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 152 ;
          oa:end 215
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    narr:StyleObs_TechnicalJargonDensity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Compact technical shorthand: 'LLM id-gen call' and 'deterministic slugify fallback' pack multiple concepts into noun phrases without definition, assuming reader familiarity." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 232 ;
          oa:end 310
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file"
        ]
      ] .

    narr:StyleObs_EmDashClarification a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dashes used as parenthetical brackets to embed an inline clarification clause mid-sentence, a common technical-writing device for elaborating on mechanism without starting a new sentence." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 220 ;
          oa:end 320
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the\ndeterministic slugify fallback —" ;
          oa:prefix "slug from the memory content " ;
          oa:suffix " and commit the file successfully."
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength "20"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.67"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Short document (~60 words, 3 sentences). Active voice dominates ('The pipeline must produce', 'commit the file successfully'); one passive-adjacent construction ('Submitted without'). Jargon terms: pipeline, slug, LLM, id-gen, slugify, fallback." .

