      skos:note "The pipeline must produce a slug from memory content via LLM id-gen call or deterministic slugify fallback when no explicit id is provided." ;
      narr:supports narr:Process .

    narr:Claim_CommitSuccessRequired a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must commit the file successfully after slug generation — success of the commit is an explicit requirement of this test case." ;
      narr:supports narr:Process .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_SlugGenerationMechanism a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Describes the two-path slug generation mechanism: LLM id-gen call (primary) or deterministic slugify fallback (secondary)." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 95 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observations ──────────────────────────────────────

    # SO-1: Technical register / jargon-heavy vocabulary
    narr:StyleObs_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Technical register: uses pipeline-specific jargon (slug, LLM, id-gen, slugify, fallback) in a single short paragraph, signalling an engineering-internal audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
