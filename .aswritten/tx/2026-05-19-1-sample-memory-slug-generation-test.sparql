        oa:start 4 ;
        oa:end 46
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - [REDACTED]" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_ImperativeProcedural a narr:StyleObservation ;
