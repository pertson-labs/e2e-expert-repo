# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 305 ;
      dct:description "Test memory submitted without an explicit id field to exercise pipeline slug generation." .

    # ── Actor ───────────────────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh" ;
      skos:note "Reviewer listed in YAML frontmatter; email redacted per PII policy (test+expert-gh@aswritten.ai)." .

    # ── Narrative ───────────────────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via LLM id-gen or a deterministic slugify fallback — and commit the file successfully." .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_PipelineMustProduceSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content when no explicit id is provided." ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    narr:Claim_SlugFallbackDeterministic a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Slug generation uses either the LLM id-gen call or the deterministic slugify fallback as a secondary mechanism." ;
      narr:supports narr:Claim_PipelineMustProduceSlug .

    # ── Observation ─────────────────────────────────────────────────────────
    narr:Obs_SubmittedWithoutId a narr:Observation ;
      skos:broader narr:FrictionFailure ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Memory explicitly notes absence of id field as the triggering condition for slug generation." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 91 ;
        oa:end 130
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Submitted without an explicit id field." ;
        oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
        oa:suffix " The pipeline must produce a"
      ] .

    # ── Style Observations ──────────────────────────────────────────────────

    # SO-1: Imperative / authoritative tone — "must produce"
    narr:StyleObs_ImperativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Deontic modal 'must' signals imperative, authoritative register — pipeline behaviour is framed as a requirement, not a suggestion." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 131 ;
          oa:end 168
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # SO-2: Technical jargon density — "LLM id-gen call", "deterministic slugify fallback"
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Compact engineering shorthand ('LLM id-gen call', 'deterministic slugify fallback') assumes a technical audience; jargon density is high relative to document length." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 199 ;
          oa:end 267
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file"
        ]
      ] .

    # SO-3: Alternative construction with em-dash framing
    narr:StyleObs_AlternativeConstruction a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash parenthetical ('— either via … fallback —') is used to enumerate alternatives inline, a compact technical prose pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 186 ;
          oa:end 271
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the\ndeterministic slugify fallback —" ;
          oa:prefix "slug from the memory content " ;
          oa:suffix " and commit the file successfully."
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 22 ;
      narr:ActiveVoiceRatio "0.75"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
