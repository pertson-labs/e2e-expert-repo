# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250717T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 302 ;
      dct:description "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when id field is absent" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative captures the expected system behaviour under that condition." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_PipelineMustSlugFromContent a narr:Claim ;
      narr:aboutNode narr:Process ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "Expert Reviewer (test+expert-gh)" ;
      skos:note "Reviewer listed in YAML frontmatter of the test memory. Email redacted per PII policy." .

    # ── Style Observations ──────────────────────────────────────

    # 1. Technical register / process-oriented diction
    narr:StyleObs_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Technical, process-oriented register: uses pipeline terminology ('LLM id-gen call', 'deterministic slugify fallback', 'commit') consistent with engineering documentation." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 148 ;
          oa:end 248
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "produce a slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # 2. Imperative mood / directive tone
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Directive, imperative framing: 'The pipeline must produce a slug' asserts a behavioural requirement with modal 'must', signalling a specification rather than a description." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 116 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a\nslug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # 3. Em-dash as enumerative separator
    narr:StyleObs_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dashes used as inline enumerative separators to bracket an alternative clause ('— either via … or … —'), a typographic pattern common in technical specifications." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 143 ;
          oa:end 265
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "— either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit" ;
          oa:prefix "slug from the memory content " ;
          oa:suffix " the file successfully."
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength 22 ;
      narr:ActiveVoiceRatio "0.75"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Short document (2 body sentences). Active voice dominates; passive construction present in 'Submitted without an explicit id field'. Moderate jargon density from pipeline/engineering terms." .

  }
}