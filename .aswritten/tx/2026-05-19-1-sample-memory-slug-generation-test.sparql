      narr:theme "Pipeline must derive a slug from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an id field, the pipeline falls back to slug generation — either via LLM id-gen call or deterministic slugify — and must commit the file successfully." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_SlugGenRequirement a narr:Observation ;
