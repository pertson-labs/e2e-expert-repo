          oa:end 195
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "slug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "produce a " ;
          oa:suffix " — and commit"
        ]
      ] .

    # SO-2: Imperative / obligation mood ("must")
    narr:StyleObs_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Obligation mood: 'must' used twice in the body, framing the memory as a requirements specification rather than a narrative description. Signals test-case authorship conventions." ;
      rdf:value true ;
