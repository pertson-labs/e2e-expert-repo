          oa:end 100
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix "\nslug from the memory content"
        ]
      ] .

    # SO-3: Em-dash as rhetorical separator / cadence device
    narr:StyleObs_JargonDensity a narr:StyleObservation ;
      skos:broader narr:CadenceRhythm ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Em-dash used as a mid-sentence pivot ('— either via … or …') to enumerate alternatives inline, a technical-writing cadence pattern that avoids bullet lists in prose." ;
      rdf:value true ;
      oa:hasTarget [
