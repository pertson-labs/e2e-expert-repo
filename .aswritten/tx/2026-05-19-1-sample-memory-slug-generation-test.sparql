  narr:Tx_20250717T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-17T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(no id field — slug generated from content: sample-memory-with-distinctive-heading)" ;
