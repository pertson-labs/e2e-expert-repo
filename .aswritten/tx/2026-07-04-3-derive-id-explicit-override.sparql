        oa:hasSource narr:Sample_SomeOtherTitleStagingDoc ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ; oa:end 88
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Some Other Title That Should Not Win" ;
          oa:prefix "ena+staging@aswritten.ai\n---\n\n# " ;
          oa:suffix "\n\nBody."
        ]
      ] .

    # 2. Placeholder body — extreme terseness
    narr:StyleObs_PlaceholderBodyTerse a narr:StyleObservation ;
      skos:broader narr:Conciseness ;
      dct:source narr:Sample_SomeOtherTitleStagingDoc ;
      rdf:value false ;
      skos:note "Body consists of a single word 'Body.' — a placeholder token, not substantive prose. Signals a test fixture or stub document." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleStagingDoc ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 90 ; oa:end 95
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Body." ;
          oa:prefix "ther Title That Should Not Win\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 3. YAML frontmatter structured metadata
    narr:StyleObs_YAMLFrontmatterStructure a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SomeOtherTitleStagingDoc ;
      rdf:value true ;
      skos:note "Document opens with YAML frontmatter block (--- delimiters) declaring a 'reviewers' list. Structured metadata convention consistent with static-site generators and CI pipeline tooling." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SomeOtherTitleStagingDoc ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 48
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
