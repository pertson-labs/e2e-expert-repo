      skos:broader narr:NarrativeAnchor ;
      skos:note "The heading 'Some Other Title That Should Not Win' is meta-commentary: it names itself as a candidate title while asserting it should not prevail. This is consistent with a test fixture designed to verify that the pipeline does not use the H1 heading as the canonical document id when a proper id is absent." .

    # ── Style Observations ──────────────────────────────────────

    # 1. Meta-commentary heading
    narr:StyleObs_MetaCommentaryHeading a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SomeOtherTitleStagingDoc ;
      rdf:value false ;
      skos:note "Heading is self-negating meta-commentary ('Should Not Win'), signalling a test fixture rather than an authoritative document title." ;
      oa:hasTarget [
