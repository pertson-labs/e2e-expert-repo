          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # 3. Conditional / disjunctive cadence: "either … or …"
    narr:StyleObservation_ConditionalCadence a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Disjunctive 'either … or …' construction presents two parallel resolution paths; reflects engineering decision-tree thinking." ;
      oa:hasTarget [
