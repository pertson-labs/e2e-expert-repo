      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug via either the LLM id-gen call or the deterministic slugify fallback, and commit the file successfully." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenDescription a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core pipeline behavior assertion: slug must be produced and file committed." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 133 ;
        oa:end 299
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Imperative / authoritative tone: "must produce"
    narr:StyleObservation_ImperativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Imperative modal 'must' used to assert pipeline obligation; authoritative, directive register." ;
      oa:hasTarget [
