# ── UPDATE Narrative_PipelineSlugGeneration ──────────────────────────────────
# Memory extends the existing narrative with: Phase 2 scope, prod failure origin,
# ## heading specificity, crash-safety requirement, and valid-slug validity framing.
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20260704T224208Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an id field, the ingestion pipeline must produce a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) reproduces the missing-id failure pattern observed in prod: a ## level heading with no id field. The pipeline must not crash and must produce a valid slug." ;
      narr:theme "Pipeline must derive a valid slug from memory content when no explicit id field is provided, without crashing, including when the heading is a ## level heading" ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveId .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
} ;

