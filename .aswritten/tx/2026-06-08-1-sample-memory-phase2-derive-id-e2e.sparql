    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_MissingIdFailurePattern a narr:Narrative ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      narr:theme "Missing-id failure pattern: pipeline must not crash and must derive a valid slug" ;
      skos:broader narr:FailureModesSafety ;
      skos:note "This memory reproduces a production failure where a memory document has an H2-level heading but no id field. The narrative asserts that the system must handle this gracefully — no crash, valid slug output." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_MustNotCrashOnMissingId a narr:Claim ;
      narr:aboutNode narr:Narrative_MissingIdFailurePattern ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:FailureModesSafety ;
