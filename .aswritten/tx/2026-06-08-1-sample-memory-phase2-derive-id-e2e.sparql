    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_Phase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      narr:inputLength 228 ;
      dct:description "Test memory that reproduces the missing-id failure pattern from production. Validates that the pipeline must not crash and must produce a valid slug when no id field is present." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
