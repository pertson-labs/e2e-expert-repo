# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_Phase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:created "2025-07-14"^^xsd:date ;
      skos:note "Phase 2 pipeline test memory. Reproduces the missing-id failure pattern from prod: ## level heading, no id field. Tests that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 265 .

    # ── Claim: must not crash ────────────────────────────────────────────────
    narr:Claim_MustNotCrash a narr:Claim ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Phase 2 asserts an explicit safety constraint absent from Phase 1: the pipeline must not crash when encountering a ## level heading with no id field. A valid slug must be produced regardless." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Observation: ## heading + no id = failure pattern ───────────────────
    narr:Obs_HeadingNoIdFailurePattern a narr:Observation ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:broader narr:Process ;
      skos:note "Specific failure trigger: ## level heading with no id field. This is the prod failure pattern being reproduced in Phase 2." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 106 ;
        oa:end 175
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "## level heading,\nno id field" ;
        oa:prefix "Reproduces the missing-id failure pattern from prod (" ;
        oa:suffix "). Must not crash; must produce a valid slug."
      ] .

    # ── Style Observations ───────────────────────────────────────────────────
    narr:StyleObs_Phase2_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Technical/engineering register throughout. Imperative constraints ('Must not crash; must produce') signal a test specification rather than narrative prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_Phase2_ImperativeVoice a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Dual imperative clauses ('Must not crash; must produce') establish authoritative test requirements. Short, punchy cadence typical of acceptance criteria." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_Phase2_JargonDensity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "High pipeline-specific jargon density: 'missing-id failure pattern', 'id field', 'slug', '## level heading'. All terms are domain-specific to the aswritten.ai extraction pipeline." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 60 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading,\nno id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_Phase2DeriveIdE2E a narr:StyleMetrics ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:broader narr:StyleMetrics ;
      skos:note "Very short document (2 body sentences). High active/imperative voice ratio. High jargon density due to pipeline-specific terminology (id field, slug, ## heading, failure pattern)." ;
      narr:AverageSentenceLength 22 ;
      narr:ActiveVoiceRatio "0.80"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal .

  }
} ;

# ── UPDATE: Narrative_PipelineSlugGeneration — extend note to cover Phase 2 ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This narrative is validated across two test phases: Phase 1 (missing id field, general) and Phase 2 (## level heading with no id field, must not crash, must produce a valid slug). Both phases confirm the pipeline's resilience to missing-id inputs." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}