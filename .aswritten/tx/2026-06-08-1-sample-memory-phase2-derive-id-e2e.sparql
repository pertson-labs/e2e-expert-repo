    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_Phase2DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      skos:note "Phase 2 test memory submitted without an explicit id field. Uses a ## level heading to reproduce the missing-id failure pattern from production. Exercises crash-safety and valid-slug requirements." ;
      narr:inputLength 243 .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_MustNotCrash
