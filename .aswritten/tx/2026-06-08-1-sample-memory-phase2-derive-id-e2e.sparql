INSERT DATA {
  GRAPH narr:Tx_20250716T120000Z {

    # Sample — Phase 2 artifact
    narr:Sample_Phase2_DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 pipeline test artifact. Reproduces the missing-id failure pattern from prod using a ## level heading with no id field. Validates crash-safety and valid-slug guarantees." ;
      narr:inputLength 215 .

    # Observation — crash-safety requirement
    narr:Observation_Phase2_CrashSafety a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_Phase2_DeriveIdE2E ;
      skos:note "Phase 2 explicitly adds a crash-safety constraint absent from Phase 1: the pipeline must not crash when no id field is present, and must still produce a valid slug." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 120 ;
        oa:end 215
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Must not crash; must produce a valid slug." ;
        oa:prefix "no id field). " ;
        oa:suffix ""
      ] .

    # Style Observation 1 — imperative specification register
    narr:StyleObservation_Phase2_ImperativeRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_Phase2_DeriveIdE2E ;
      skos:note "Imperative modal constructions ('Must not crash; must produce') signal a specification register — requirements stated as hard constraints, not suggestions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 170 ;
          oa:end 215
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — technical jargon density
    narr:StyleObservation_Phase2_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_Phase2_DeriveIdE2E ;
      skos:note "High concentration of pipeline-domain jargon in a short body: 'missing-id failure pattern', 'prod', 'E2E', 'id field', 'slug'. Assumes reader fluency with CI/CD intake vocabulary." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 170
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # Style Observation 3 — semicolon-separated constraint cadence
    narr:StyleObservation_Phase2_SemicolonCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_Phase2_DeriveIdE2E ;
      skos:note "Semicolons used to chain parallel constraints in a single breath ('Must not crash; must produce a valid slug'), creating a terse, checklist-like cadence typical of acceptance criteria." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 170 ;
