        oa:exact "Reproduces the missing-id failure pattern from prod (## level heading, no id field)." ;
        oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
        oa:suffix " Must not crash; must produce a valid slug."
      ] .

    # ── Style Observations ──────────────────────────────────────

