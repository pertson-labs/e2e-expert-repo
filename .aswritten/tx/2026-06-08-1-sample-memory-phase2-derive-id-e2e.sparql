# ── UPDATE: narr:Narrative_PipelineSlugGeneration ────────────────────────────
# Phase 2 memory extends the narrative with a crash-safety dimension and
# confirms the pattern reproduces from prod. Enrich skos:note.
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) confirms this failure pattern reproduces from prod and adds a hard crash-safety constraint: the pipeline must not crash and must always produce a valid slug, even when the heading level is ## and no id field is present." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_SlugFromContent ───────────────────────────────────────
# Phase 2 adds the crash-safety constraint to the existing claim's note.
DELETE {
  GRAPH ?g {
    narr:Claim_SlugFromContent skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Claim_SlugFromContent skos:note "The pipeline must produce a slug from memory content when no explicit id is provided, using either LLM id-gen or deterministic slugify fallback, and must commit the file successfully. Phase 2 (E2E) adds: the pipeline must not crash when encountering a ## level heading with no id field, and must always produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_SlugFromContent skos:note ?oldNote .
  }
}