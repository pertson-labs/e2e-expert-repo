# ── UPDATE: Narrative_PipelineSlugGeneration — add Phase 2 framing ───────────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T140000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must (1) not crash and (2) derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 testing reproduces this pattern from prod using a ## level heading with no id field." ;
      narr:theme "Pipeline crash-safety and slug generation from memory content" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
} ;

