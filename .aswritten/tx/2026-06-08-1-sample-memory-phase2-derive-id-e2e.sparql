# ── UPDATE: narr:Narrative_PipelineSlugGeneration — extend note with Phase 2 / E2E / crash-safety framing ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250716T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests the robustness of the intake process. Phase 2 (E2E): reproduces the missing-id failure pattern from prod (## level heading, no id field). The pipeline must not crash and must produce a valid slug." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

