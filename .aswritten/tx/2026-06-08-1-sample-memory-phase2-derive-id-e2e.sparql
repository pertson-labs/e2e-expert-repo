# ── Update existing Narrative to incorporate Phase 2 crash-safety constraint ─
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250730T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 (E2E) additionally asserts the pipeline must not crash when the missing-id pattern is triggered via a ## level heading, and must produce a valid slug in all cases." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

