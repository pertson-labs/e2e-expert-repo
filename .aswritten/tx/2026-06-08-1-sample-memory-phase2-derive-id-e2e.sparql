      skos:note "The pipeline must not crash when a memory document lacks an id field. This is a hard safety requirement derived from the production failure pattern." .

    narr:Claim_MustProduceValidSlug a narr:Claim ;
      narr:aboutNode narr:Narrative_MissingIdFailurePattern ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:FailureModesSafety ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "When no id field is present, the pipeline must still derive and produce a valid slug. This is the positive output requirement paired with the no-crash constraint." .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_MissingIdFailurePatternQuote a narr:Observation ;
      skos:broader narr:FailureModesSafety ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Core test scenario description: reproduces the missing-id failure pattern from prod with an H2-level heading and no id field." ;
      oa:hasSelector [
