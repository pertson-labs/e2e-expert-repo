# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250720T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory that reproduces the missing-id failure pattern from prod. Exercises the pipeline path where a ## level heading is present but no id field is set. Must not crash; must produce a valid slug." ;
      narr:inputLength 230 .

    # ── Narrative ────────────────────────────────────────────────────────────
    narr:Narrative_Phase2DeriveIdE2E a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:Process ;
      narr:theme "Phase 2 E2E validation: pipeline must not crash and must produce a valid slug when no id field is present" ;
      skos:note "Reproduces the missing-id failure pattern from prod (## level heading, no id field). The pipeline must survive the failure path and emit a valid slug — crash is not an acceptable outcome." .

    # ── Claims ───────────────────────────────────────────────────────────────
    narr:Claim_MustNotCrash a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:aboutNode narr:Narrative_Phase2DeriveIdE2E ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      skos:note "The pipeline must not crash when processing a memory that has a ## level heading but no id field. This is a hard safety requirement derived from a prod failure pattern." .

    narr:Claim_MustProduceValidSlug_Phase2 a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      narr:aboutNode narr:Narrative_Phase2DeriveIdE2E ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Claim_SlugFromContent ;
      skos:note "Even in the Phase 2 missing-id scenario, the pipeline must produce a valid slug — not null, not empty, not an error state." .

    # ── Observations ─────────────────────────────────────────────────────────
    narr:Observation_MissingIdFailurePattern a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:IncidentResponse ;
      skos:note "The Phase 2 test explicitly reproduces a failure pattern observed in production: memory submitted with a ## heading but no id field causes a crash." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 107 ;
        oa:end 194
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Reproduces the missing-id failure pattern from prod (## level heading, no id field)." ;
        oa:prefix "\n\n" ;
        oa:suffix " Must not crash;"
      ] .

    narr:Observation_H2HeadingNoIdField a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:EdgeCaseHandling ;
      skos:note "The specific trigger condition for the Phase 2 test: ## level heading present, no id field in frontmatter. This is the exact prod failure configuration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 143 ;
        oa:end 175
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "## level heading, no id field" ;
        oa:prefix "from prod (" ;
        oa:suffix "). Must not crash"
      ] .

    # ── Style Observations ───────────────────────────────────────────────────
    narr:StyleObs_ImperativeMood_Phase2 a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Imperative mood used for requirements: 'Must not crash; must produce a valid slug.' Signals hard engineering constraints." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 195 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "). " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_TechnicalJargon_Phase2 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Engineering jargon cluster: 'missing-id failure pattern', 'prod', '## level heading', 'id field', 'slug'. Dense technical shorthand consistent with internal engineering spec register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 107 ;
          oa:end 194
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading, no id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    narr:StyleObs_ShortPunchyCadence_Phase2 a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Two short declarative sentences separated by semicolon. Staccato cadence reinforces imperative engineering requirements. No hedging or qualification." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 195 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryPhase2 a narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short engineering spec. Two body sentences; active/imperative voice dominant; jargon terms: slug, id field, prod, E2E, ## level heading, missing-id failure pattern. Register: procedural/engineering constraint spec." ;
      narr:AverageSentenceLength "15"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal .

  }
} ;

# ── Update existing Narrative_PipelineSlugGeneration with Phase 2 evidence ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250720T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E testing (narr:Sample_SampleMemoryPhase2DeriveIdE2E) further requires that the pipeline must not crash when encountering a ## level heading with no id field, reproducing a known prod failure pattern." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}