# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 347 ;
      dct:description "Test memory submitted without an explicit id field to exercise pipeline slug-generation logic." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This tests a specific branch of the intake workflow." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_SlugFromContent a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from memory content when no id is provided, using either LLM id-gen or deterministic slugify fallback, and must commit the file successfully." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_PipelineSlugBehavior a narr:Observation ;
      skos:broader narr:IntakePrioritization ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core behavioral assertion: pipeline slug generation from content when id is absent" ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 107 ;
        oa:end 299
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a\nslug from the memory content — either via the LLM id-gen call or the\ndeterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # SO-1: Passive-voice opening sentence
    narr:StyleObs_PassiveOpening a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value false ;
      skos:note "Opening sentence uses passive construction ('Submitted without an explicit id field'), omitting the grammatical subject entirely — an impersonal, process-documentation register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 107 ;
          oa:end 149
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Submitted without an explicit id field." ;
          oa:prefix "# Sample Memory With Distinctive Heading\n\n" ;
          oa:suffix " The pipeline must produce a"
        ]
      ] .

    # SO-2: Technical jargon density
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "High jargon density for a short document: 'LLM id-gen call', 'deterministic slugify fallback', 'pipeline' — assumes a technical reader familiar with CI/CD and NLP tooling." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 265
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the\ndeterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file successfully."
        ]
      ] .

    # SO-3: Imperative modal 'must' for pipeline obligations
    narr:StyleObs_ImperativeMustCadence a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      rdf:value true ;
      skos:note "Use of deontic modal 'must' twice in two sentences signals authoritative specification register — this is a requirements document, not a description." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 150 ;
          oa:end 299
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a\nslug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength "22"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Two-sentence body. First sentence is passive/agentless; second is active with deontic modal. Jargon terms: pipeline, slug, LLM, id-gen, slugify, fallback (6 of ~40 content tokens ≈ 15%)." .

