# ── UPDATE: Sample — revised title, description, inputLength ─────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title       ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_ZypherionDecision_20260406
      dct:title       "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) in which CTO Quinton Fairweather announces the switch from Zypherion to Meridian for analytics, citing critical streaming ingestion gaps in Zypherion. Migration window remains Q3 2026. Supersedes the original Zypherion adoption decision." ;
      narr:inputLength 541 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title       ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: Observation — Quinton's revised verbatim quote ───────────────────
DELETE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionQuote
      skos:note    ?oldNote ;
      oa:hasSelector ?oldSel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Obs_QuintonAdoptionQuote
      skos:note    "Quinton Fairweather's revised verbatim statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps as the disqualifying factor." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end   340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact  "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Obs_QuintonAdoptionQuote
      skos:note    ?oldNote ;
      oa:hasSelector ?oldSel .
  }
} ;

# ── UPDATE: StyleMetrics — re-assessed for revised document ─────────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note                  ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio      ?oldAVR ;
      narr:JargonDensity         ?oldJD .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:StyleMetrics_ZypherionDecision
      skos:note                  "Short declarative sentences (avg ~11 words); predominantly active voice; low-to-moderate jargon (streaming ingestion, batch, analytics, migration). Register: formal engineering decision memo with explicit supersession marker." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio      "0.92"^^xsd:decimal ;
      narr:JargonDensity         "0.11"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_ZypherionDecision
      skos:note                  ?oldNote ;
      narr:AverageSentenceLength ?oldASL ;
      narr:ActiveVoiceRatio      ?oldAVR ;
      narr:JargonDensity         ?oldJD .
  }
} ;

# ── INSERT: New Claim — Meridian handles batch and streaming natively ─────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_MeridianBatchStreamingCapability
      a narr:Claim ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively — the stated capability advantage over Zypherion that drove the switch." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice .
  }
} ;

# ── INSERT: StyleObservation 1 — Authoritative tone in revised decision ───────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:StyleObs_ToneAuthoritative_Revised
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "CTO speaks in first-person plural declaratives with no hedging: 'We are now switching to Meridian instead.' Authoritative register consistent with prior decision memo." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 248 ;
          oa:end   290
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact  "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix " Meridian handles both"
        ]
      ] .
  }
} ;

