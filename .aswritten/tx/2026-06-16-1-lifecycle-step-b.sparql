PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T140000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Meridian replaces Zypherion — 2026-04-06" ;
    prov:generatedAtTime "2026-04-06T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-input" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Narrative_ZypherionAdoption,
      narr:Claim_ZypherionDatabaseChoice,
      narr:Claim_ZypherionMigrationQ3_2026,
      narr:Claim_ZypherionPerformance15x,
      narr:Claim_MeridianBatchStreamingCapability,
      narr:Sample_ZypherionDecision_20260406,
      narr:Obs_QuintonAdoptionQuote,
      narr:StyleMetrics_ZypherionDecision,
      narr:StyleObs_ToneAuthoritative_Revised,
      narr:StyleObs_SupersessionMarker,
      narr:StyleObs_BulletDecisionFormat .
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now about Meridian adoption ────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology pivot driven by capability gap: streaming ingestion" ;
      skos:note  "The organisation reversed its Zypherion decision after discovering critical streaming ingestion gaps. Meridian now replaces Zypherion for analytics, handling both batch and streaming natively. Migration remains Q3 2026. This supersedes the prior Zypherion adoption narrative." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note  ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the chosen DB ────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note              ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note              "Meridian is the chosen database for the analytics pipeline, replacing Zypherion after critical streaming ingestion gaps were found." ;
      narr:hasConvictionLevel narr:Conviction_Foundation .
  }
}
WHERE {
