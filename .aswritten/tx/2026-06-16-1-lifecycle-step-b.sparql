PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20260406T140000Z a prov:Activity ;
    dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
    prov:generatedAtTime "2026-04-06T14:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-message" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_MeridianDecision_20260406,
      narr:Claim_MeridianDatabase,
      narr:Claim_ZypherionStreamingGap,
      narr:Claim_MeridianMigrationTimeline,
      narr:StyleObs_MeridianDecision_ToneAuthoritative,
      narr:StyleObs_MeridianDecision_Supersession,
      narr:StyleObs_MeridianDecision_BulletStructure,
      narr:StyleMetrics_MeridianDecision .
} ;

# ── New Sample node for the REVISED document ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406
      a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      skos:note "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and selects Meridian, citing critical streaming ingestion gaps in Zypherion. Supersedes the original Zypherion decision note." ;
      narr:inputLength 541 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian supersession ─
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption: Meridian replaces Zypherion for analytics (streaming ingestion gap)" ;
      skos:note "REVISED 2026-04-06: The organisation is switching from Zypherion to Meridian for its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026. This supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabase → superseded; Zypherion no longer selected ─
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabase
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabase
      skos:note "SUPERSEDED 2026-04-06: Zypherion was initially selected for the analytics pipeline but has been replaced by Meridian after critical streaming ingestion gaps were identified. Conviction downgraded from Boulder to Notion." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:challenges narr:Narrative_ZypherionAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabase narr:hasConvictionLevel ?oldConviction .
    OPTIONAL { narr:Claim_ZypherionDatabase skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance → conviction downgraded; gap found ────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance
      skos:note "REVISED 2026-04-06: While Zypherion was asserted to handle columnar queries 15x faster, subsequent evaluation found critical gaps in streaming ingestion, leading to its rejection. The 15x claim is unverified and the decision has been reversed. Conviction downgraded from Stake to Notion." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance narr:hasConvictionLevel ?oldConviction .
    OPTIONAL { narr:Claim_ZypherionPerformance skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationTimeline → now about Meridian ────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline
      skos:note ?oldNote ;
      narr:aboutNode ?oldAbout .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationTimeline
      skos:note "REVISED 2026-04-06: The Q3 2026 migration window is retained, but now applies to Meridian rather than Zypherion. The timeline itself was not changed by the database switch." ;
      narr:aboutNode narr:Claim_MeridianDatabase .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline narr:aboutNode ?oldAbout .
    OPTIONAL { narr:Claim_ZypherionMigrationTimeline skos:note ?oldNote . }
  }
} ;

# ── New Claims for Meridian decision ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Claim_MeridianDatabase
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian has been selected to replace Zypherion as the analytics database. It handles both batch and streaming ingestion natively, addressing the gap that disqualified Zypherion." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .

    narr:Claim_ZypherionStreamingGap
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion after further evaluation. This gap was the stated reason for abandoning Zypherion in favour of Meridian." ;
      narr:aboutNode narr:Claim_ZypherionDatabase ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabase .

    narr:Claim_MeridianMigrationTimeline
      a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Migration to Meridian will proceed in the same Q3 2026 window originally planned for Zypherion. The database switch did not alter the timeline." ;
      narr:aboutNode narr:Claim_MeridianDatabase ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabase .

  }
} ;

# ── Style Observations ───────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:StyleObs_MeridianDecision_ToneAuthoritative
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO speaks in first-person plural declarative ('We evaluated', 'We are now switching'), projecting institutional authority and finality." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 200 ;
          oa:end 310
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\nMeridian handles both"
        ]
      ] .

    narr:StyleObs_MeridianDecision_Supersession
      a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession marker used as a standalone sentence, signalling document authority and intentional overwrite of prior record." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 355 ;
          oa:end 400
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "instead.\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    narr:StyleObs_MeridianDecision_BulletStructure
      a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Key decisions rendered as a three-item bold-label bullet list (Database / Reason / Timeline), mirroring the structure of the original decision note and reinforcing institutional formatting convention." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 402 ;
          oa:end 541
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

  }
} ;

