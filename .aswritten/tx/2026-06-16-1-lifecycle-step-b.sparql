# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ────
# Justified: memory explicitly states "This supersedes the previous Zypherion decision"
# and declares Meridian as the new choice. The theme and note are directly contradicted.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    narr:Narrative_ZypherionAdoption skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T130000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption decision: Meridian selected for analytics pipeline, superseding Zypherion" ;
      skos:note "After further evaluation revealed critical streaming ingestion gaps in Zypherion, the organization is switching to Meridian, which handles both batch and streaming natively. Migration remains Q3 2026. This supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3_2026 → now about Meridian migration ──
# Justified: migration window (Q3 2026) is retained but now applies to Meridian,
# not Zypherion. The aboutNode and note are superseded.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote .
    narr:Claim_ZypherionMigrationQ3_2026 narr:aboutNode ?oldAbout .
    narr:Claim_ZypherionMigrationQ3_2026 narr:supports ?oldSupports .
    narr:Claim_ZypherionMigrationQ3_2026 dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T130000Z {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note "Migration to Meridian proceeds on the same Q3 2026 timeline, replacing the previously planned Zypherion migration." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:supports narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3_2026 skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 narr:aboutNode ?oldAbout . }
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 narr:supports ?oldSupports . }
    OPTIONAL { narr:Claim_ZypherionMigrationQ3_2026 dct:source ?oldSource . }
  }
} ;

# ── DELETE: Claim_ZypherionPerformance15x ────────────────────────────────────
# Justified: new memory explicitly supersedes the Zypherion decision and identifies
# critical gaps in Zypherion. The 15x performance claim supported the now-retracted
# Zypherion adoption; the new memory contradicts Zypherion's suitability entirely.
# This is an explicit retraction ("This supersedes the previous Zypherion decision").
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

