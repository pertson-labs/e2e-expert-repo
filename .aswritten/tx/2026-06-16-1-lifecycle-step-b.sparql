# ── INSERT: new Sample node for this revised extraction ──────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T153000Z {

    narr:Sample_MeridianDBDecision_20260406 a narr:Sample ;
      dct:title       "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created     "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion (critical streaming ingestion gaps found) and adopt Meridian for the analytics pipeline, retaining the Q3 2026 migration window." ;
      narr:inputLength 591 .

    # ── New Claim: Meridian database selection ───────────────────────────────
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Meridian selected as the analytics database, replacing Zypherion, because it handles both batch and streaming natively — stated by CTO Quinton Fairweather." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .

    # ── New Claim: Zypherion streaming ingestion gap ─────────────────────────
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the disqualifying technical finding that triggered the switch to Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # ── New Observation: Quinton's direct quote ──────────────────────────────
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      skos:broader narr:PrimaryActors ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Quinton Fairweather's direct statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 196 ;
        oa:end   372
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact  "We evaluated Zypherion further and found critical gaps in\nits streaming ingestion. We are now switching to Meridian instead.\nMeridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # ── New Observation: supersession statement ──────────────────────────────
    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Explicit statement that this revised decision supersedes the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 374 ;
        oa:end   422
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact  "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    # ── Style Observation 1: Authoritative reversal framing ──────────────────
    narr:StyleObs_AuthoritativeReversal a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "The reversal is framed with the same declarative authority as the original decision — no hedging, no apology. 'We are now switching' mirrors the register of the prior 'We are adopting'." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 228 ;
          oa:end   295
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact  "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles"
        ]
      ] .

    # ── Style Observation 2: Bold key-decision list formatting ───────────────
    narr:StyleObs_BoldKeyDecisions a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Structured bullet list with bold labels (Database, Reason, Timeline) mirrors the original decision note's formatting convention — signals institutional template reuse." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 438 ;
          oa:end   591
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact  "Key decisions:\n- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Zypherion decision.\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Direct quote attribution pattern ────────────────
    narr:StyleObs_DirectQuoteAttribution a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      skos:note "Speaker attribution uses 'Name: \"quote\"' pattern — same idiolect as the original Zypherion note. Establishes a consistent documentary voice for CTO decisions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 186 ;
          oa:end   205
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact  "Quinton: \"We evaluated" ;
          oa:prefix "\n\n" ;
          oa:suffix " Zypherion further"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_MeridianDBDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDBDecision_20260406 ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal ;
      skos:note "Short declarative sentences; very high active voice ('We evaluated', 'We are now switching', 'Meridian handles'); moderate technical jargon (streaming ingestion, batch, analytics). Register: executive/technical briefing, same as prior note."
  }
