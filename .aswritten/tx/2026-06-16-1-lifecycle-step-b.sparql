      skos:note "Revised meeting notes from 2026-04-06. CTO Quinton Fairweather supersedes the Zypherion adoption decision, switching to Meridian Analytics due to critical streaming ingestion gaps. Migration window unchanged at Q3 2026." ;
      narr:inputLength 612 .

    # ── New Narrative: Meridian adoption ──────────────────────────────────────
    narr:Narrative_MeridianAdoption a narr:Narrative ;
