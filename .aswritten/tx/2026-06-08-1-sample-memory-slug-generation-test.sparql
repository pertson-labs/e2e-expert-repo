PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250130T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-30T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "sample-memory-with-distinctive-heading" ;
    narr:originRef "main" ;
    dct:title "Sample Memory With Distinctive Heading — extraction" ;
    prov:generated
      narr:Sample_SampleMemoryDistinctiveHeading,
      narr:Narrative_PipelineSlugGeneration,
      narr:Claim_SlugFromContent,
      narr:Actor_TestExpertReviewer,
      narr:Observation_SlugGenBehavior,
      narr:StyleObservation_TechnicalRegister,
      narr:StyleObservation_AlternativeConstruction,
      narr:StyleObservation_ImperativeMust,
      narr:StyleMetrics_SampleMemoryDistinctiveHeading .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250130T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryDistinctiveHeading a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      dct:created "2025-01-30"^^xsd:date ;
      narr:inputLength 354 ;
      skos:note "Test memory submitted without an explicit id field to exercise the pipeline slug-generation path." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh@aswritten.ai" ;
      skos:note "Reviewer listed in YAML frontmatter of the test memory. Email address used as identifier per PII policy (no real name available)." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug from the memory content — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_SlugFromContent a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenBehavior a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "Core behavioral assertion: pipeline must generate slug and commit when id is absent." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 354
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." ;
        oa:prefix "Submitted without an explicit id field. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Technical/procedural register
    narr:StyleObservation_TechnicalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "technical-procedural; engineering pipeline vocabulary throughout" ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 354
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a slug from the memory content" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " — either via the LLM id-gen call"
        ]
      ] .

    # 2. Alternative/disjunctive construction (either…or)
    narr:StyleObservation_AlternativeConstruction a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "either/or disjunction used to enumerate two fallback strategies; signals engineering optionality" ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 230 ;
          oa:end 320
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the deterministic slugify fallback" ;
          oa:prefix "slug from the memory content — " ;
          oa:suffix " — and commit the file"
        ]
      ] .

    # 3. Imperative modal "must" — obligation framing
    narr:StyleObservation_ImperativeMust a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      skos:note "'must' used twice to assert non-negotiable pipeline obligations; authoritative, specification-like tone" ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryDistinctiveHeading ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 215
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The pipeline must produce a slug" ;
          oa:prefix "Submitted without an explicit id field. " ;
          oa:suffix " from the memory content"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryDistinctiveHeading a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryDistinctiveHeading ;
      narr:AverageSentenceLength "28"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.30"^^xsd:decimal ;
      skos:note "Short document (2 sentences of body text). High active-voice ratio; moderate jargon density driven by technical terms: pipeline, slug, LLM, id-gen, slugify, fallback." .

  }
}