          oa:start 196 ;
          oa:end 280
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "either via the LLM id-gen call or the deterministic slugify fallback" ;
          oa:prefix "produce a slug from the memory content — " ;
          oa:suffix " — and commit the file"
        ]
      ] .

    # Style Obs 2: Passive / impersonal construction
    narr:StyleObs_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:VoicePassive ;
      dct:source narr:Sample_SlugGenTest ;
      skos:note "'Submitted without an explicit id field' opens with a passive/headless construction, omitting the agent — characteristic of technical specification prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SlugGenTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
