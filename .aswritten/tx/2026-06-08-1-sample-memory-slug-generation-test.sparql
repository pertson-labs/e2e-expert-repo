    # 3. Disjunctive fallback pattern (either/or)
    narr:StyleObs_PassiveConstruction a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      dct:source narr:Sample_SlugGenPipelineTest ;
      skos:note "Disjunctive fallback pattern: 'either via the LLM id-gen call or the deterministic slugify fallback' — presents two ordered alternatives, signalling a primary/secondary execution path." ;
      rdf:value true ;
