    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SlugGenTest a narr:Sample ;
      dct:title "Sample Memory With Distinctive Heading" ;
      narr:inputLength 339 ;
      dct:description "Test memory submitted without an explicit id field to exercise pipeline slug generation via LLM id-gen or deterministic slugify fallback." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_PipelineSlugGeneration a narr:Narrative ;
      dct:source narr:Sample_SlugGenTest ;
      narr:theme "Pipeline slug generation from memory content" ;
      skos:broader narr:Process ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exercises that path." .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_SlugFallbackBehavior a narr:Claim ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Process ;
      dct:source narr:Sample_SlugGenTest ;
      skos:note "The pipeline must produce a slug from memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_SlugGenPipelineStatement a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      dct:source narr:Sample_SlugGenTest ;
