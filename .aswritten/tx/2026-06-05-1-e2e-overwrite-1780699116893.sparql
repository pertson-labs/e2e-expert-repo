PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Second version stub document extraction" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:StyleObs_SecondVersion_RegisterFormality,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_ReviewerFrontmatter .
} ;

# ── New Sample entity (INSERT DATA) ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Sample_SecondVersion
      a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal stub document with YAML front-matter reviewer metadata and a single version label body. Successor to First version stub." ;
      narr:inputLength 63 .
  }
} ;

# ── UPDATE: Narrative_FirstVersionStub → now describes Second version pattern ──
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionStub
      dct:source narr:Sample_SecondVersion ;
      skos:note "The document represents a second-version stub: a placeholder with reviewer metadata attached but no substantive content yet. This pattern continues the workflow initiation sequence — the document has been incremented to a second version while remaining a content placeholder awaiting authoring." ;
      narr:theme "Incremental document stub with reviewer assignment" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionStub
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

# ── UPDATE: Observation_VersionLabel — "First version" → "Second version" ──
DELETE {
  GRAPH ?g {
    narr:Observation_VersionLabel
      dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasSelector ?oldSel .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Observation_VersionLabel
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body of the document consists solely of the phrase 'Second version', indicating this is a second-iteration placeholder with no substantive content. Version label has incremented from 'First version'." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_VersionLabel
      dct:source ?oldSource ;
      skos:note ?oldNote .
    OPTIONAL { narr:Observation_VersionLabel oa:hasSelector ?oldSel . }
  }
} ;

# ── UPDATE: Observation_ReviewerMetadata — re-anchor to new sample ──
DELETE {
  GRAPH ?g {
    narr:Observation_ReviewerMetadata
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Observation_ReviewerMetadata
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML front-matter declares a reviewer role assignment in the second version. Email redacted per PII policy. Pattern is consistent with first version — reviewer metadata persists across version increments." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 0 ;
        oa:end 45
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - [REDACTED]" ;
        oa:prefix "---\n" ;
        oa:suffix "\n---"
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_ReviewerMetadata
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: StyleMetrics — re-anchor to new sample ──────────────
DELETE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:StyleMetrics_FirstVersion
      dct:source narr:Sample_SecondVersion ;
      skos:note "Document body remains a single two-word phrase with no sentences, no jargon, and no passive constructions. Metrics unchanged from first version — stub/placeholder state persists." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleMetrics_FirstVersion
      dct:source ?oldSource ;
      skos:note ?oldNote .
  }
} ;

