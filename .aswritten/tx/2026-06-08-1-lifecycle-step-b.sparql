  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_ZypherionDecision_20260406
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note dated 2026-04-06. Quinton Fairweather (CTO) supersedes the prior Zypherion decision, citing critical gaps in Zypherion's streaming ingestion. Meridian is selected as the replacement, handling both batch and streaming natively. Q3 2026 migration window retained." .
  }
}
