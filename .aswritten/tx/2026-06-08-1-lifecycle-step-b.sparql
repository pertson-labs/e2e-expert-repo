        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 310
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\nMeridian handles both batch"
        ]
      ] .

    narr:Obs_ZypherionGapStatement a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Technical disqualifier: Zypherion lacks streaming ingestion capability." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 430 ;
          oa:end 475
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Zypherion lacks streaming ingestion" ;
          oa:prefix "Reason: " ;
          oa:suffix "\n- Timeline:"
        ]
      ] .

    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:ChangeManagement ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession marker: this document formally replaces the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 340 ;
          oa:end 390
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "instead.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .
  }
} ;

