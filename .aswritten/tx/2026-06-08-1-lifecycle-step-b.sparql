# ── INSERT: New Meridian-specific entities ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Sample node for the revised document
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note. CTO Quinton Fairweather supersedes the Zypherion decision, selecting Meridian for batch and streaming analytics. Q3 2026 migration window retained." ;
      narr:inputLength 512 .

    # New Narrative for Meridian adoption (distinct from the updated Zypherion narrative)
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StrategyOverview ;
      narr:theme "Meridian selected as analytics database replacing Zypherion, handling batch and streaming natively" ;
      skos:note "Meridian is chosen because it natively handles both batch and streaming ingestion, directly addressing the gap that disqualified Zypherion. This represents a technology pivot within the same Q3 2026 migration window." .

    # Claim: Meridian database selection
    narr:Claim_MeridianDatabaseSelection a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption ;
      skos:note "Meridian has been selected as the database for the analytics pipeline, replacing Zypherion, as stated by CTO Quinton Fairweather." .

    # Claim: Zypherion streaming ingestion gap (new disqualifying finding)
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseSelection ;
      narr:challenges narr:Claim_ZypherionDatabaseSelection ;
      skos:note "Zypherion has critical gaps in streaming ingestion, which disqualified it from the analytics pipeline role." .

    # Claim: Q3 2026 migration timeline reconfirmed for Meridian
    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseSelection ;
      skos:note "The Q3 2026 migration window is retained for the Meridian rollout, same as originally planned for Zypherion." .

    # Observation: Quinton's revised decision quote
    narr:Obs_QuintonRevisedDecisionQuote a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:PrimaryActors ;
      skos:note "CTO Quinton Fairweather formally announces the reversal and Meridian selection." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 175 ;
        oa:end 320
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "Meridian handles both batch and streaming natively.\""
      ] .

    # Observation: Streaming gap rationale
    narr:Obs_StreamingGapRationale a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Streaming ingestion gap in Zypherion is the stated technical reason for the pivot." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 430 ;
        oa:end 480
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Zypherion lacks streaming ingestion" ;
        oa:prefix "Reason: " ;
        oa:suffix "\n- **Timeline**"
      ] .

    # Observation: Meridian batch+streaming capability
    narr:Obs_MeridianBatchStreamCapability a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DataIntegrationFlows ;
      skos:note "Meridian's native batch and streaming support is the key differentiator cited." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 295 ;
        oa:end 345
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead. " ;
        oa:suffix "\""
      ] .

    # Style Observation 1: Direct authoritative tone
    narr:StyleObs_DirectDeclarativeTone a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO speech uses short declarative sentences with no hedging, projecting authority." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 240
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps" ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " in its streaming ingestion."
        ]
      ] .

    # Style Observation 2: Supersession rhetoric
    narr:StyleObs_SupersessionRhetoric a narr:StyleObservation ;
      skos:broader narr:RhetoricalDevices ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession framing ('This supersedes the previous...') signals formal retraction of prior decision." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 348 ;
          oa:end 395
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 3: Technical jargon — streaming ingestion
    narr:StyleObs_TechnicalJargonStreaming a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "'Streaming ingestion' is domain-specific technical jargon used without definition, assuming an engineering-literate audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 240 ;
          oa:end 295
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in its streaming ingestion" ;
          oa:prefix "found " ;
          oa:suffix ". We are now switching"
        ]
      ] .

    # Style Metrics (new document)
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Revised document: short declarative register, high active voice, moderate-to-elevated jargon density due to streaming/ingestion terminology." ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.88"^^xsd:decimal ;
      narr:JargonDensity "0.14"^^xsd:decimal .
  }
}