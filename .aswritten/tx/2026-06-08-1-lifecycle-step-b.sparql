        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "streaming ingestion. " ;
          oa:suffix " Meridian handles both"
        ]
      ] .

    # Style Observation 2: Technical jargon — streaming ingestion
    narr:StyleObs_JargonStreaming a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Domain-specific term 'streaming ingestion' used without definition, signalling expert audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 195 ;
          oa:end 240
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in its streaming ingestion" ;
          oa:prefix "found " ;
          oa:suffix ". We are now switching"
        ]
      ] .

    # Style Observation 3: Supersession rhetoric — explicit retraction framing
    narr:StyleObs_SupersessionRhetoric a narr:StyleObservation ;
      skos:broader narr:RhetoricalDevices ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Explicit supersession statement used as a rhetorical device to signal authority and finality of the revised decision." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 345 ;
          oa:end 393
        ] ;
        oa:hasSelector [
