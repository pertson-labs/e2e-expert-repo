# ── New entities: Meridian-specific narrative, claims, observations ────────────
INSERT DATA {
  GRAPH narr:Tx_20250710T120000Z {

    # ── Narrative: Meridian Adoption ─────────────────────────────────────────
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Capability-gap-driven database pivot: Meridian over Zypherion" ;
      skos:note "After discovering Zypherion's critical streaming ingestion gaps, the organisation pivoted to Meridian, which handles both batch and streaming natively. This is a reversal of the prior Zypherion adoption decision, retaining the Q3 2026 migration window." .

    # ── Claim: Meridian selected as analytics database ───────────────────────
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian is now the selected analytics database, replacing Zypherion. Decision made by CTO Quinton Fairweather on 2026-04-06." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption .

    # ── Claim: Zypherion lacks streaming ingestion ───────────────────────────
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion — the disqualifying reason for the database switch." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # ── Claim: Meridian handles batch and streaming natively ─────────────────
    narr:Claim_MeridianBatchStreamingCapability a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively — the stated capability advantage over Zypherion." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # ── Claim: Q3 2026 migration window retained for Meridian ────────────────
    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "The Q3 2026 migration window is retained for the Meridian rollout, same as originally planned for Zypherion." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # ── Observation: Quinton's Meridian statement ────────────────────────────
    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "Quinton's direct statement announcing the switch from Zypherion to Meridian." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 189 ;
        oa:end 330
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch and streaming natively.\""
      ] .

    # ── Observation: Zypherion streaming ingestion gap ───────────────────────
    narr:Obs_ZypherionStreamingGap a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:DataIntegrationFlows ;
      skos:note "Specific technical gap identified: Zypherion lacks streaming ingestion capability." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 230 ;
        oa:end 290
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "found critical gaps in its streaming ingestion" ;
        oa:prefix "We evaluated Zypherion further and " ;
        oa:suffix ". We are now switching to Meridian instead."
      ] .

    # ── Observation: Meridian batch+streaming capability ─────────────────────
    narr:Obs_MeridianCapability a narr:Observation ;
