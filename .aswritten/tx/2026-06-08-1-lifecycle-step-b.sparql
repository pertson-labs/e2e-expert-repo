# ── New Sample for the revised document ──────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250710T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather reverses the Zypherion decision, selecting Meridian for analytics due to Zypherion's critical streaming ingestion gaps. Q3 2026 migration window retained." ;
      narr:inputLength 521 ;
      dct:replaces narr:Sample_ZypherionDecision_20260406 .
  }
} ;

# ── UPDATE: narr:Narrative_ZypherionAdoption → superseded by Meridian ────────
# The narrative theme, note, and broader classification all change.
# Temporal supersession: the same decision slot now holds Meridian, not Zypherion.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250710T120000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology pivot driven by capability gap: streaming ingestion" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps. Meridian was selected as the replacement, offering native batch and streaming support. Q3 2026 migration window retained. This narrative supersedes the earlier Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

