INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology supersession driven by capability gap discovery" ;
      skos:note "The organisation is replacing Zypherion with Meridian for analytics after discovering Zypherion lacks streaming ingestion. Meridian handles both batch and streaming natively. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

