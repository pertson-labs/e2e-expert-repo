}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption decision: Meridian replaces Zypherion for analytics" ;
      skos:note "The organisation has reversed its Zypherion decision and is now committing to Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026." ;
