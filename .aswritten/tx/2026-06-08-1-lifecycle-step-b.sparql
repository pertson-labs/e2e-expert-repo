# ── UPDATE: Sample — title and description revised to reflect Meridian ───────
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to abandon Zypherion due to critical streaming ingestion gaps and adopt Meridian instead, retaining the Q3 2026 migration window. Supersedes the prior Zypherion adoption decision." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 612 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

