# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather supersedes the prior Zypherion adoption decision, citing critical streaming ingestion gaps, and formally selects Meridian for the analytics pipeline on the same Q3 2026 timeline." ;
      narr:inputLength 589 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption decision: replacing Zypherion with Meridian for the analytics pipeline" ;
      skos:note "The organisation has reversed its Zypherion adoption decision after discovering critical streaming ingestion gaps. Meridian, which handles both batch and streaming natively, is now the selected analytics database. Migration remains on the Q3 2026 timeline. This supersedes the prior Zypherion decision recorded in Sample_ZypherionDecision_20260406." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the choice ───────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "Meridian has replaced Zypherion as the formally selected database for the analytics pipeline. CTO Quinton Fairweather announced the switch after finding critical streaming ingestion gaps in Zypherion. Stated in revised meeting note 2026-04-06." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldLevel . }
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance15x → conviction downgraded (superseded) 
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x narr:hasConvictionLevel ?oldLevel ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionPerformance15x narr:hasConvictionLevel narr:Conviction_Notion ;
      skos:note "Zypherion's 15x columnar query performance claim is now superseded: the organisation found critical gaps in Zypherion's streaming ingestion and has dropped Zypherion entirely. The performance advantage, while not explicitly retracted, is no longer decision-relevant." ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionPerformance15x skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_MigrationQ3_2026 → now about Meridian, not Zypherion ───────
DELETE {
  GRAPH ?g {
    narr:Claim_MigrationQ3_2026 skos:note ?oldNote ;
      narr:supports ?oldSupports .
  }
}
