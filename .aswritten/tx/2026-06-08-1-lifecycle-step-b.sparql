# ── New Narrative: Meridian adoption ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology reversal: Meridian selected over Zypherion for native batch-and-streaming analytics capability" ;
      skos:note "After further evaluation, Zypherion was found to have critical streaming ingestion gaps. Meridian, which handles both batch and streaming natively, was selected as the replacement. The Q3 2026 migration window is preserved. This narrative supersedes narr:Narrative_ZypherionAdoption." .
  }
} ;

