# ── INSERT: Observations with selectors ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    narr:Obs_QuintonMeridianStatement a narr:Observation ;
      skos:broader narr:PositioningThesis ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO's direct statement announcing the switch from Zypherion to Meridian." ;
      oa:hasSelector [
        a oa:SpecificResource ;
