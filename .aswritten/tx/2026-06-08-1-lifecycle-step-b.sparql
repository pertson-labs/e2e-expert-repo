# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian pivot ───────
# Justified: memory explicitly states "We are now switching to Meridian instead"
# and "This supersedes the previous Zypherion decision" — functional change to
# theme and note of the existing narrative entity.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology reversal: streaming capability gap forces database pivot" ;
      skos:note "The organisation reversed its Zypherion adoption decision after discovering critical gaps in streaming ingestion. Meridian replaces Zypherion for analytics, handling both batch and streaming natively. Migration remains Q3 2026. Supersedes prior Zypherion decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance → now about streaming gap, not speed ─
# Justified: memory contradicts the 15x performance claim with "critical gaps
