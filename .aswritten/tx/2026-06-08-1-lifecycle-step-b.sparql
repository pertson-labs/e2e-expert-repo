# ── INSERT DATA: new entities ────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {

    # New claim: Meridian's streaming capability as decision rationale
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively, which was the decisive capability gap that Zypherion could not fill." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:DataIntegrationFlows .

    # Style Observation 1: Authoritative tone in supersession announcement
    narr:StyleObs_ToneAuthoritative_Revised a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Declarative, first-person plural voice used to announce reversal with no hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 220 ;
