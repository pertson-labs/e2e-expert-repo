# ── UPDATE: Narrative_ZypherionAdoption → now reflects Meridian adoption ────
# Justified by: "We are now switching to Meridian instead" and
# "This supersedes the previous Zypherion decision" — explicit retraction.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T160000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption: Meridian replaces Zypherion for analytics pipeline" ;
      skos:note "The organisation has revised its database decision: Meridian now replaces Zypherion for the analytics pipeline. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026. This supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

