  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, overriding earlier performance claims and triggering the switch to Meridian." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
