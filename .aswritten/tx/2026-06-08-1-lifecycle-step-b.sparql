# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and selects Meridian as the analytics database, citing critical streaming ingestion gaps in Zypherion. Migration timeline remains Q3 2026." ;
      narr:inputLength 612 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now describes Meridian adoption ───
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology reversal: Zypherion rejected for streaming ingestion gaps; Meridian selected as replacement analytics database" ;
      skos:note "The organisation has reversed its Zypherion adoption decision. Quinton Fairweather (CTO) identified critical streaming ingestion gaps in Zypherion and has selected Meridian, which handles both batch and streaming natively, as the replacement. Migration timeline remains Q3 2026. This supersedes the prior Zypherion decision." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

