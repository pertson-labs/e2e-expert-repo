PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250127T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-27T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "First version stub document extraction" ;
    prov:generated
      narr:Sample_FirstVersion,
      narr:Actor_ExpertReviewer_GH,
      narr:Narrative_FirstVersionStub,
      narr:Claim_InitialDraftState,
      narr:StyleObs_MinimalRegister,
      narr:StyleObs_DeclarativeBody,
      narr:StyleObs_YAMLFrontmatterConvention,
      narr:StyleMetrics_FirstVersion .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250127T120000Z {

    # ── Sample ────────────────────────────────────────────────────
    narr:Sample_FirstVersion a narr:Sample ;
      dct:title "First version" ;
      narr:inputLength 52 ;
      dct:description "Minimal stub document with YAML frontmatter listing a reviewer and a two-word body: 'First version'." .

    # ── Actor ─────────────────────────────────────────────────────
    # Email redacted per PII policy (allow_pii not set)
    narr:Actor_ExpertReviewer_GH a narr:Actor ;
      skos:prefLabel "Expert Reviewer (GitHub)" ;
      skos:note "Reviewer listed in YAML frontmatter of the stub document. Email redacted per PII policy." .

    # ── Narrative ─────────────────────────────────────────────────
    narr:Narrative_FirstVersionStub a narr:Narrative ;
      dct:source narr:Sample_FirstVersion ;
      narr:theme "Initial draft / first version stub" ;
      skos:broader narr:Process ;
      skos:note "The document represents an initial stub in a review workflow, asserting only that this is the first version with a named reviewer assigned." .

    # ── Claim ─────────────────────────────────────────────────────
    narr:Claim_InitialDraftState a narr:Claim ;
      narr:aboutNode narr:Narrative_FirstVersionStub ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_FirstVersionStub ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "The document body 'First version' asserts an initial draft state with minimal content. Conviction is Notion — the claim is a placeholder pending substantive content." .

    # ── Style Observations ────────────────────────────────────────

    # 1. Minimal register / plain language body
    narr:StyleObs_MinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Body text is a two-word declarative phrase with no elaboration, indicating a minimal/placeholder register." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 38 ;
          oa:end 51
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. YAML frontmatter convention
    narr:StyleObs_YAMLFrontmatterConvention a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes to declare structured metadata (reviewers list), a common editorial/documentation convention." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 36
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert" ;
          oa:prefix "" ;
          oa:suffix "-gh@aswritten.ai\n---"
        ]
      ] .

    # 3. Declarative sentence mood in body
    narr:StyleObs_DeclarativeBody a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_FirstVersion ;
      skos:note "The sole body sentence is declarative and nominal ('First version'), with no verb, reflecting a stub/placeholder authoring pattern." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 38 ;
          oa:end 51
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ─────────────────────────────────────────────
    narr:StyleMetrics_FirstVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Minimal stub document. Body is two words ('First version'). No jargon. No passive constructions. Average sentence length is 2 words." .

  }
}