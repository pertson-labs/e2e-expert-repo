# New Sample for second version document
INSERT DATA {
  GRAPH narr:Tx_20260703T172610Z {
    narr:Sample_SecondVersionStagingDoc a narr:Sample ;
      dct:title "Second version — reviewer staging doc" ;
      narr:inputLength 64 ;
      dct:description "Second version of the staging document with YAML front-matter listing a reviewer and a two-word body." ;
      dct:replaces narr:Sample_FirstVersionStagingDoc .
  }
} ;

# Update Claim_FirstVersionStatus: body text has changed from 'First version' to 'Second version'
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T172610Z {
    narr:Claim_FirstVersionStatus skos:note "The body of the document now contains only the text 'Second version', indicating this is the second iteration of the draft with no additional substantive content." ;
      dct:source narr:Sample_SecondVersionStagingDoc .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# Update StyleObs_MinimalBody: exact quote changed from 'First version' to 'Second version'
DELETE {
  GRAPH ?g {
    narr:StyleObs_MinimalBody dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T172610Z {
    narr:StyleObs_MinimalBody dct:source narr:Sample_SecondVersionStagingDoc ;
      skos:note "The entire document body is a single two-word phrase, representing extreme brevity." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStagingDoc ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ; oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix " xena+staging@aswritten.ai\n---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleObs_MinimalBody dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
} ;

# Update StyleObs_InformalVersionLabel: label changed from 'First version' to 'Second version'
DELETE {
  GRAPH ?g {
    narr:StyleObs_InformalVersionLabel dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
}
INSERT {
  GRAPH narr:Tx_20260703T172610Z {
    narr:StyleObs_InformalVersionLabel dct:source narr:Sample_SecondVersionStagingDoc ;
      skos:note "'Second version' is an informal, lowercase version label rather than a semantic version string (e.g. v2.0.0), continuing the low-formality internal draft register established in the first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStagingDoc ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ; oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix " xena+staging@aswritten.ai\n---\n\n" ;
          oa:suffix ""
        ]
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:StyleObs_InformalVersionLabel dct:source ?oldSource ;
      skos:note ?oldNote ;
      oa:hasTarget ?oldTarget .
  }
} ;

