    # Style Obs 3: Structured bullet-point decision format
    narr:StyleObs_BulletDecisionFormat a narr:StyleObservation ;
      skos:broader narr:GrammarSyntax ;
      skos:note "Key decisions are presented as bold-labelled bullet points (Database, Reason, Timeline), a structured format that mirrors an ADR or decision log. Parallelism enforced by consistent label-colon-value pattern." ;
      rdf:value true ;
