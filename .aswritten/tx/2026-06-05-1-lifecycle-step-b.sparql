# ── New Sample node ──────────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120100Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion and adopt Meridian for the analytics pipeline, citing critical streaming ingestion gaps in Zypherion. Supersedes the original Zypherion decision." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength "612"^^xsd:integer .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → superseded by Meridian ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120100Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology reversal: Zypherion rejected; Meridian adopted as analytics database for batch and streaming ingestion" ;
      skos:note "SUPERSEDED: The organisation initially adopted Zypherion but found critical streaming ingestion gaps. Decision reversed in favour of Meridian, which handles both batch and streaming natively. Same Q3 2026 migration window retained." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionForAnalytics → now contradicted ──────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionForAnalytics skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120100Z {
    narr:Claim_ZypherionForAnalytics skos:note "RETRACTED: Zypherion was formally selected but has since been rejected due to critical streaming ingestion gaps. Meridian is now the chosen analytics database." ;
      narr:hasConvictionLevel narr:Conviction_Notion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionForAnalytics narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionForAnalytics skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_MigrationQ3_2026 → now points to Meridian ─────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_MigrationQ3_2026 skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120100Z {
    narr:Claim_MigrationQ3_2026 skos:note "Migration to Meridian (replacing Zypherion) is scheduled for the same Q3 2026 window." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:supports narr:Claim_MeridianReplacesZypherion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_MigrationQ3_2026 narr:aboutNode ?oldAbout .
    OPTIONAL { narr:Claim_MigrationQ3_2026 skos:note ?oldNote . }
    OPTIONAL { narr:Claim_MigrationQ3_2026 narr:supports ?oldSupports . }
  }
} ;

