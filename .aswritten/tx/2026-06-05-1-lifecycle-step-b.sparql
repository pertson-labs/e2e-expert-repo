          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short revised decision note (~520 chars). High active voice ratio reflecting direct executive register. Moderate jargon density from technical terms (streaming ingestion, batch, analytics, migration). Slightly higher jargon than original due to explicit technical contrast." ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
