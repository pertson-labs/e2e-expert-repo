# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note superseding the Zypherion adoption decision. CTO Quinton Fairweather announces switch to Meridian after critical streaming ingestion gaps found in Zypherion. Migration window unchanged at Q3 2026." ;
      narr:inputLength 541 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → Narrative_MeridianAdoption ────────
# The core narrative has reversed: Meridian replaces Zypherion.
# We mint a new IRI because the narrative direction has fundamentally changed
# (adoption of Zypherion → rejection of Zypherion, adoption of Meridian).
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      skos:note "The organisation is switching from Zypherion to Meridian for analytics after discovering critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. This supersedes the prior Zypherion adoption decision. The narrative pattern: technology re-evaluation when a critical capability gap is discovered mid-process, with course correction before migration begins." ;
      narr:theme "Technology course-correction driven by discovered capability gap" .
  }
} ;

# ── UPDATE: Actor skos:note (role context updated to Meridian decision) ──────
DELETE {
  GRAPH ?g {
    narr:Actor_QuintonFairweather skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Actor_QuintonFairweather skos:note "CTO; original decision-maker for Zypherion adoption (2026-04-06); subsequently reversed that decision and selected Meridian after discovering critical streaming ingestion gaps in Zypherion." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Actor_QuintonFairweather skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationTimeline → now about Meridian ────────────
# Timeline is same (Q3 2026) but the target database has changed to Meridian.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline skos:note ?oldNote ;
      narr:aboutNode ?oldAbout ;
      narr:supports ?oldSupports ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationTimeline skos:note "Migration to Meridian (replacing Zypherion) starts Q3 2026 — same window as originally planned for Zypherion. The timeline is preserved despite the database switch." ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:supports narr:Narrative_MeridianAdoption ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationTimeline skos:note ?oldNote ;
      narr:aboutNode ?oldAbout .
  }
  OPTIONAL { GRAPH ?g { narr:Claim_ZypherionMigrationTimeline narr:supports ?oldSupports . } }
  OPTIONAL { GRAPH ?g { narr:Claim_ZypherionMigrationTimeline dct:source ?oldSource . } }
} ;

