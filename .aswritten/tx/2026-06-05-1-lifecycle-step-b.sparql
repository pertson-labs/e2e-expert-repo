# ── UPDATE: Observation_QuintonAdoptionQuote → new verbatim quote ────────────
DELETE {
  GRAPH ?g {
    narr:Observation_QuintonAdoptionQuote
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Observation_QuintonAdoptionQuote
      skos:note "Quinton Fairweather's verbatim statement announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps and Meridian's native batch+streaming capability." ;
      dct:source narr:Sample_MeridianDecisionRevised_20260406 ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 176 ;
        oa:end 340
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_QuintonAdoptionQuote
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

