# ── Style Metrics for new sample ─────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StyleMetrics ;
      skos:note "Short revised decision record (~487 chars). Register is direct executive/technical: declarative active voice, explicit supersession language, two product names (Zypherion, Meridian), one technical term (streaming ingestion). Bullet list reinforces scannable decision-record format. Slightly higher jargon density than original due to streaming ingestion terminology." ;
      narr:AverageSentenceLength "13"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal .
  }
}