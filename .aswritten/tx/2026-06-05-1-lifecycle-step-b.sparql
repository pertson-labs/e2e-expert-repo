        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix "\nMeridian handles both batch"
        ]
      ] .

    # StyleObservation 2: Technical jargon — streaming ingestion
    narr:StyleObs_TechnicalJargon_Revised
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "'Streaming ingestion' is used as an unglossed technical term, consistent with an internal engineering audience. Jargon density slightly elevated from original." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 148 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in\nits streaming ingestion" ;
          oa:prefix "and found " ;
          oa:suffix ". We are now switching"
        ]
      ] .

    # StyleObservation 3: Supersession rhetoric — explicit overwrite signal
    narr:StyleObs_SupersessionRhetoric
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDecision_20260406 ;
      skos:note "The phrase 'This supersedes the previous Zypherion decision' is a rare explicit retraction marker — institutional voice asserting version authority over prior records." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 280 ;
          oa:end 330
        ] ;
        oa:hasSelector [
