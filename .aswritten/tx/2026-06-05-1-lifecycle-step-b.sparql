    OPTIONAL { narr:Claim_ZypherionDatabaseChoice narr:hasConvictionLevel ?oldConv . }
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice dct:source ?oldSrc . }
  }
} ;

