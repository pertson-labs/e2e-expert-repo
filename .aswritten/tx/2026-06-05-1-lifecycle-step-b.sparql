  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports ;
      narr:aboutNode ?oldAbout .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionColumnarPerformance
      skos:note "Zypherion was found to have critical gaps in streaming ingestion, invalidating its suitability for the analytics pipeline. This supersedes the prior columnar performance rationale." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Narrative_ZypherionAdoption ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      dct:source narr:Sample_MeridianDecisionRevised_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports ;
      narr:aboutNode ?oldAbout .
  }
} ;

