# ── New Sample for revised document ─────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion due to critical streaming ingestion gaps and adopt Meridian instead, retaining the Q3 2026 migration window." ;
      narr:inputLength 487 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → Meridian supersession ──────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption: Zypherion rejected for streaming ingestion gaps; Meridian adopted as analytics database for batch and streaming workloads" ;
      skos:note "The organisation has reversed its Zypherion decision after discovering critical streaming ingestion gaps. Meridian now replaces Zypherion as the analytics database, handling both batch and streaming natively. Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian replaces Zypherion ──────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConviction ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "Meridian has replaced Zypherion as the selected database for the analytics pipeline. Zypherion was rejected due to critical streaming ingestion gaps discovered during further evaluation. Stated directly by CTO." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      narr:hasConvictionLevel ?oldConviction .
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote . }
    OPTIONAL { narr:Claim_ZypherionDatabaseChoice dct:source ?oldSource . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same window, now for Meridian ───────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionMigrationQ3
      skos:note "Migration to Meridian (replacing Zypherion) is scheduled for the same Q3 2026 window. Timeline unchanged despite database switch." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      narr:aboutNode narr:Narrative_ZypherionAdoption .
    OPTIONAL { narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote . }
    OPTIONAL { narr:Claim_ZypherionMigrationQ3 dct:source ?oldSource . }
  }
} ;

# ── New Claim: Zypherion streaming ingestion gap (reason for switch) ──────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion lacks streaming ingestion capability. This critical gap was discovered during further evaluation and is the stated reason for abandoning Zypherion in favour of Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice ;
      narr:supports narr:DataIntegrationFlows .
  }
} ;

# ── New Claim: Meridian batch+streaming capability ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian handles both batch and streaming ingestion natively, making it the preferred replacement for Zypherion in the analytics pipeline." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:StackOverview .
  }
} ;

