# ── New Sample for the REVISED document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather retracts the Zypherion decision and selects Meridian, citing critical gaps in Zypherion's streaming ingestion. Migration window remains Q3 2026." ;
      narr:inputLength 512 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now describes Meridian adoption ───
# Memory explicitly supersedes the Zypherion decision; the narrative theme
# and note must be updated to reflect the new technology choice.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption: switching from Zypherion to Meridian for analytics pipeline due to streaming ingestion gaps" ;
      skos:note "The organisation has reversed its Zypherion decision and is now adopting Meridian, which handles both batch and streaming ingestion natively. The Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption narrative." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the choice ──────
# Functional property change: the selected database is now Meridian, not Zypherion.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "Meridian replaces Zypherion as the selected analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively." ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
} ;

# ── UPDATE: Claim_ZypherionPerformance15x → retracted; gap claim replaces it ─
# The 15x performance rationale is superseded: Zypherion now has a known
# critical deficiency (streaming ingestion). The claim is reframed.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      narr:supports ?oldSupports .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x skos:note "RETRACTED: The 15x columnar query advantage was the original rationale for Zypherion. Subsequent evaluation found critical gaps in streaming ingestion, leading to the decision reversal. This claim is superseded by Claim_ZypherionStreamingGap." ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
    OPTIONAL { narr:Claim_ZypherionPerformance15x narr:supports ?oldSupports . }
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → timeline retained, database changed ─
# The Q3 2026 window is explicitly preserved; only the database name changes.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3 skos:note "Migration to Meridian (replacing Zypherion) is scheduled for the same Q3 2026 window. Timeline unchanged despite the database switch." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3 skos:note ?oldNote .
  }
} ;

