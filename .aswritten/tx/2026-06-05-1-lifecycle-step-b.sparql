# ── New Sample node for the revised document ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecisionRevised_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      skos:note "Revised meeting note recording CTO Quinton Fairweather's decision to abandon Zypherion (critical streaming ingestion gaps) and adopt Meridian for the analytics pipeline, retaining the Q3 2026 migration window. Explicitly supersedes the prior Zypherion decision." ;
      narr:inputLength "612"^^xsd:integer .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now Meridian adoption ─────────────
# Temporal supersession: the prior adoption decision is replaced by Meridian.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption
      skos:note "The organisation has reversed its Zypherion adoption decision and is now adopting Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration window remains Q3 2026. This supersedes the prior Zypherion decision." ;
      narr:theme "Technology adoption decision: Meridian replaces Zypherion for analytics (streaming ingestion gap)" ;
      dct:source narr:Sample_MeridianDecisionRevised_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      skos:note ?oldNote ;
      narr:theme ?oldTheme .
  }
} ;

# ── UPDATE: Claim_ZypherionColumnarPerformance → now streaming gap claim ─────
# Functional change: the rationale for the database choice has inverted.
# The columnar performance claim is superseded by a streaming deficiency finding.
