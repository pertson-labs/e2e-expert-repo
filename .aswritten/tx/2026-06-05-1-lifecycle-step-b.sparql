# ── UPDATE: Sample node — title and description revised ─────────────────────
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406 dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for analytics, citing Zypherion's critical streaming ingestion gaps and Meridian's native batch+streaming support. Supersedes the original Zypherion adoption decision." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 541 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDecision_20260406 dct:title ?oldTitle .
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 dct:description ?oldDesc . }
    OPTIONAL { narr:Sample_ZypherionDecision_20260406 narr:inputLength ?oldLen . }
  }
} ;

# ── UPDATE: Narrative — Zypherion adoption → Meridian adoption ──────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption decision: Meridian replaces Zypherion as analytics database" ;
      skos:note "The organisation has reversed its Zypherion database decision and is now adopting Meridian instead, after discovering critical streaming ingestion gaps in Zypherion. Meridian handles both batch and streaming natively. Migration remains on the Q3 2026 timeline." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice — now Meridian is chosen ───────────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldConv ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T143000Z {
    narr:Claim_ZypherionDatabaseChoice skos:note "Meridian has been formally selected as the analytics database, replacing Zypherion. Decision attributed to CTO Quinton Fairweather. Zypherion was rejected due to critical streaming ingestion gaps." ;
