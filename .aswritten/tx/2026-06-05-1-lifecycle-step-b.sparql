# ── UPDATE: Narrative_ZypherionAdoption — superseded by Meridian ─────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Strategic adoption of Zypherion as the analytics database [SUPERSEDED — see narr:Narrative_MeridianAdoption]" ;
      skos:note "SUPERSEDED 2026-04-06: Zypherion adoption reversed due to critical streaming ingestion gaps. Meridian selected as replacement. See narr:Narrative_MeridianAdoption." ;
      skos:related narr:Narrative_MeridianAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

