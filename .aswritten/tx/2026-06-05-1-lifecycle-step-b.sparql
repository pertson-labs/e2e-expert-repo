# ── UPDATE: Narrative_ZypherionAdoption → now about Meridian adoption ────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Technology adoption decision: abandoning Zypherion (streaming ingestion gaps) and replacing with Meridian for analytics; same Q3 2026 migration window" ;
      skos:note "The organisation has reversed its Zypherion commitment after discovering critical streaming ingestion gaps. Meridian, which handles both batch and streaming natively, is now the chosen analytics database. The Q3 2026 migration window is retained." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

