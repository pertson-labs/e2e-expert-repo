# ── New Sample for the revised document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note (2026-04-06) in which CTO Quinton Fairweather reverses the Zypherion decision, citing critical streaming ingestion gaps, and selects Meridian for the analytics pipeline with the same Q3 2026 migration window." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 541 .
  }
} ;

# ── New Narrative: Meridian adoption (supersedes Zypherion) ─────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120000Z {
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Strategic pivot from Zypherion to Meridian as the analytics database" ;
      skos:note "The organisation reverses its Zypherion decision after discovering critical streaming ingestion gaps. Meridian is selected as the replacement, supporting both batch and streaming natively, within the same Q3 2026 migration window." .
  }
} ;

# ── New Claims ───────────────────────────────────────────────────────────────
