  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption narr:theme "Strategic pivot from Zypherion to Meridian as the analytics database" ;
      skos:note "The organisation has reversed its Zypherion adoption decision after discovering critical streaming ingestion gaps. Meridian replaces Zypherion for analytics, handling both batch and streaming natively. Migration remains on the Q3 2026 schedule." .
  }
}
