# streaming ingestion" and the decision is reversed. The 15x performance claim
# that justified adoption is superseded by the rejection.
DELETE WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionColumnarPerformance ?p ?o .
  }
} ;

# ── DELETE: Obs_PerformanceClaim ─────────────────────────────────────────────
