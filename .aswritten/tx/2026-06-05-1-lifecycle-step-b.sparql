# ── INSERT: New entities ─────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T143000Z {

    # New Claim: Meridian chosen as replacement
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian is the new analytics database selection, replacing Zypherion. It handles both batch and streaming natively." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_ZypherionAdoption .

    # New Claim: Zypherion streaming ingestion gap (the explicit reason for reversal)
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion. Meridian handles both batch and streaming natively — stated as the primary technical rationale for the switch." ;
      narr:aboutNode narr:Claim_MeridianDatabaseChoice ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # New Claim: Q3 2026 timeline confirmed for Meridian
    narr:Claim_MeridianMigrationQ3_2026 a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Migration to Meridian proceeds on the same Q3 2026 window originally planned for Zypherion." ;
      narr:aboutNode narr:Claim_MeridianDatabaseChoice ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianDatabaseChoice .

    # Style Observation 1: Explicit supersession statement — ToneAuthoritative
    narr:StyleObs_DirectSupersessionStatement a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Blunt declarative supersession: 'This supersedes the previous Zypherion decision.' No hedging, no qualification." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 248 ;
          oa:end 294
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "Meridian handles both batch and streaming natively.\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 2: Technical jargon — streaming ingestion terminology
    narr:StyleObs_TechnicalJargonStreaming a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Precise technical vocabulary: 'streaming ingestion', 'batch and streaming natively' — domain-specific without explanation, assumes technical audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 152 ;
          oa:end 246
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "critical gaps in\nits streaming ingestion. We are now switching to Meridian instead.\nMeridian handles both batch and streaming natively." ;
          oa:prefix "We evaluated Zypherion further and found " ;
          oa:suffix "\n\nThis supersedes"
        ]
      ] .

    # Style Observation 3: Bullet-point decision format — GrammarSyntax / ShortPunchyCadence
    narr:StyleObs_BulletDecisionFormat a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Key decisions rendered as three tight bullets with bold labels (Database, Reason, Timeline) — maximises scanability, minimises prose." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 308 ;
          oa:end 470
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "- **Database**: Meridian replaces Zypherion for analytics\n- **Reason**: Zypherion lacks streaming ingestion\n- **Timeline**: Same Q3 2026 migration window" ;
          oa:prefix "Key decisions:\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Metrics (new sample)
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Short declarative sentences (avg ~11 words). Strongly active voice. Moderate jargon density driven by 'streaming ingestion', 'batch', 'analytics'." ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.13"^^xsd:decimal .
  }
}