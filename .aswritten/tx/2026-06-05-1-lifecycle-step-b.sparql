  GRAPH narr:Tx_20260406T150000Z {

    # Style Obs 1: Direct first-person executive quote register
    narr:StyleObs_DirectQuoteRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      skos:note "CTO speaks in unhedged first-person plural declaratives: 'We evaluated', 'We are now switching'. Authoritative register with no qualifiers." ;
      rdf:value true ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 280
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in\nits streaming ingestion. We are now switching to Meridian instead." ;
