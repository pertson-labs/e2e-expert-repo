# ── INSERT: New entities ──────────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # Sample node for the revised document
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note: CTO Quinton Fairweather announces switch from Zypherion to Meridian due to streaming ingestion gaps. Supersedes prior decision." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 480 .

    # New Claim: Meridian is the new database choice
    narr:Claim_MeridianDatabaseChoice a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Meridian has been selected to replace Zypherion for analytics; it handles both batch and streaming natively." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Foundation ;
      narr:supports narr:Narrative_ZypherionAdoption .

    # New Claim: Zypherion streaming ingestion gap (reason for reversal)
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Zypherion has critical gaps in streaming ingestion, which was the decisive factor in reversing the adoption decision." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice .

    # Observation: Quinton's revision statement
    narr:Obs_QuintonRevisionStatement a narr:Observation ;
      skos:broader narr:PrimaryActors ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO Quinton Fairweather's verbatim statement announcing the switch to Meridian." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 133 ;
        oa:end 282
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\nMeridian handles both batch"
      ] .

    # Observation: Streaming gap technical detail
    narr:Obs_StreamingGapStatement a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Technical rationale: Meridian handles both batch and streaming natively, addressing the gap." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 256 ;
        oa:end 310
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Meridian handles both batch and streaming natively." ;
        oa:prefix "switching to Meridian instead.\n" ;
        oa:suffix "\"\n\nThis supersedes"
      ] .

    # Observation: Supersession statement
    narr:Obs_SupersessionStatement a narr:Observation ;
      skos:broader narr:DesignTradeoffs ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession: this revised decision replaces the prior Zypherion adoption." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 314 ;
        oa:end 358
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "This supersedes the previous Zypherion decision." ;
        oa:prefix "natively.\"\n\n" ;
        oa:suffix "\n\nKey decisions:"
      ] .

    # Style Observation 1: Direct declarative tone
    narr:StyleObs_DirectDeclarative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Short, unhedged declarative sentences assert the reversal with executive authority." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 256 ;
          oa:end 310
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Meridian handles both batch and streaming natively." ;
          oa:prefix "switching to Meridian instead.\n" ;
          oa:suffix "\"\n\nThis supersedes"
        ]
      ] .

    # Style Observation 2: Technical jargon — streaming ingestion
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Domain-specific term 'streaming ingestion' used without definition, assuming technical audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 195 ;
          oa:end 255
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "found critical gaps in\nits streaming ingestion." ;
          oa:prefix "evaluated Zypherion further and " ;
          oa:suffix " We are now switching"
        ]
      ] .

    # Style Observation 3: Supersession rhetoric — explicit retraction
    narr:StyleObs_SupersessionRhetoric a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession phrase used as a standalone sentence to formally retire the prior decision — a deliberate rhetorical move signalling institutional authority." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 314 ;
          oa:end 358
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Metrics for revised document
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
