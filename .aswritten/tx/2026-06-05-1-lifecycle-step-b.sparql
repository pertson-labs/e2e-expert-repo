  }
} ;

# ── New entities: Meridian narrative, claims, observation, style ──────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T120100Z {

    # Narrative
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology reversal: Meridian replaces Zypherion as analytics database due to streaming ingestion capability" ;
      skos:note "Quinton Fairweather reversed the Zypherion decision after finding critical streaming ingestion gaps. Meridian was selected because it handles both batch and streaming natively. The Q3 2026 migration window is retained." .

    # Claims
    narr:Claim_MeridianReplacesZypherion a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption ;
      skos:note "Meridian formally replaces Zypherion for analytics. Decision attributed to CTO Quinton Fairweather." .

    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_MeridianReplacesZypherion ;
      skos:note "Zypherion has critical gaps in streaming ingestion — the stated reason for rejection." .

    narr:Claim_MeridianBatchAndStreaming a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianReplacesZypherion ;
      skos:note "Meridian handles both batch and streaming natively — stated by CTO, no independent benchmark cited." .

    narr:Claim_MigrationQ3_2026_Meridian a narr:Claim ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Claim_MeridianReplacesZypherion ;
      skos:note "Migration to Meridian will proceed in the same Q3 2026 window originally planned for Zypherion." .

    # Observation: verbatim CTO quote
    narr:Obs_QuintonMeridianQuote a narr:Observation ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "CTO direct statement announcing Meridian adoption, Zypherion rejection rationale, and capability comparison." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "232"^^xsd:integer ;
        oa:end "399"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
        oa:prefix "Quinton: \"" ;
        oa:suffix "\""
      ] .

    # Style Observation 1: Direct declarative tone
    narr:StyleObs_DirectDeclarative_Meridian a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "CTO uses unhedged first-person plural declarations ('We evaluated', 'We are now switching') — authoritative, no qualifiers." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "232"^^xsd:integer ;
          oa:end "310"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix " We are now switching"
        ]
      ] .

    # Style Observation 2: Supersession rhetoric
    narr:StyleObs_SupersessionRhetoric_Meridian a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Explicit supersession framing ('This supersedes the previous Zypherion decision') signals institutional authority and clean break rhetoric." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "400"^^xsd:integer ;
          oa:end "447"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # Style Observation 3: Technical jargon density
    narr:StyleObs_TechnicalJargon_Meridian a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Moderate technical jargon: 'streaming ingestion', 'batch and streaming natively', 'analytics' — domain-specific but not over-dense." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_MeridianDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "280"^^xsd:integer ;
          oa:end "399"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
          oa:prefix "streaming ingestion. " ;
          oa:suffix "\""
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_MeridianDecision a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_MeridianDecision_20260406 ;
      skos:note "Short declarative register. Very high active-voice ratio from first-person plural CTO statements. Moderate jargon density from streaming/batch terminology." ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.92"^^xsd:decimal ;
      narr:JargonDensity "0.13"^^xsd:decimal .
  }
}