# ── New Sample for the REVISED document ─────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:created "2026-04-06"^^xsd:date ;
      dct:description "Revised meeting note from 2026-04-06. CTO Quinton Fairweather retracts the Zypherion decision, citing critical streaming ingestion gaps, and formally selects Meridian for analytics. Supersedes the original Zypherion decision from the same date. Q3 2026 migration window retained." ;
      narr:inputLength 541 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now Meridian adoption ──────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption: replacing Zypherion with Meridian for analytics due to streaming ingestion gaps" ;
      skos:note "The organisation reversed its Zypherion analytics database decision after discovering critical streaming ingestion gaps. Meridian was selected as the replacement because it handles both batch and streaming natively. The Q3 2026 migration window is retained. This supersedes the original Zypherion adoption decision recorded on 2026-04-06." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian is now the choice ───────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "Meridian has been formally selected as the analytics database, replacing Zypherion. CTO Quinton Fairweather announced the reversal on 2026-04-06, citing critical streaming ingestion gaps in Zypherion." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → same timeline, now for Meridian ─────
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T153000Z {
    narr:Claim_ZypherionMigrationQ3
      skos:note "Migration to Meridian (replacing Zypherion) starts Q3 2026. The timeline is unchanged from the original decision; only the target database has changed." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── DELETE: Claim_ZypherionPerformance15x — contradicted by Zypherion rejection
# The memory explicitly states Zypherion has "critical gaps" and is being replaced.
# The 15x performance claim was the primary rationale for adopting Zypherion;
# that rationale is now superseded and the claim is contradicted by the reversal.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionPerformance15x ?p ?o .
  }
} ;

