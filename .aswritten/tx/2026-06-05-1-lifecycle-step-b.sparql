# ── New Sample for the revised decision document ─────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note in which CTO Quinton Fairweather supersedes the prior Zypherion decision, selecting Meridian for its native batch and streaming ingestion support. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 520 .
  }
} ;

# ── UPDATE: Narrative_ZypherionAdoption → now describes Meridian adoption ────
# Justified by: memory explicitly states "We are now switching to Meridian instead"
# and "This supersedes the previous Zypherion decision."
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology platform switch driven by streaming ingestion capability gap" ;
      skos:note "The organisation is replacing Zypherion with Meridian for analytics. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Q3 2026 migration window is retained. This supersedes the prior Zypherion adoption decision." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: Claim_ZypherionDatabaseChoice → Meridian replaces Zypherion ──────
# Justified by: "Database: Meridian replaces Zypherion for analytics" — direct
# functional contradiction of the prior claim that Zypherion was selected.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionDatabaseChoice
      skos:note "Meridian has replaced Zypherion as the selected analytics database. The prior Zypherion selection is explicitly superseded per CTO Quinton Fairweather on 2026-04-06." ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionDatabaseChoice
      skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel ;
      dct:source ?oldSource .
  }
} ;

# ── UPDATE: Claim_ZypherionMigrationQ3 → timeline retained but now for Meridian
# Justified by: "Timeline: Same Q3 2026 migration window" — same date, different
# target system. The claim's aboutNode and note must reflect Meridian.
DELETE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionMigrationQ3
      skos:note "Migration to Meridian (replacing Zypherion) retains the same Q3 2026 window. Confirmed by CTO in the revised decision note." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── NEW: Claim — Zypherion has critical streaming ingestion gaps ──────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      skos:note "Zypherion was found to have critical gaps in streaming ingestion. This is the stated technical reason for abandoning it in favour of Meridian." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:challenges narr:Claim_ZypherionDatabaseChoice ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
} ;

# ── NEW: Claim — Meridian handles batch and streaming natively ───────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T150000Z {
    narr:Claim_MeridianStreamingCapability a narr:Claim ;
      skos:note "Meridian handles both batch and streaming ingestion natively. This capability is the primary justification for selecting it over Zypherion." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZypherionDatabaseChoice ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
} ;

# ── Style Observations (minimum 3) ───────────────────────────────────────────
