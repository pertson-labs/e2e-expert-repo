# ── Update existing Narrative_PipelineSlugGeneration to reference Phase 2 ─────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This validates the robustness of the intake and file-naming process. Phase 2 (E2E) extends this with an explicit crash-safety requirement: the pipeline must not crash when the heading is at ## level and no id field is present." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}