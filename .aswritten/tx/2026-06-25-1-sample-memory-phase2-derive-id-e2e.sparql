# ── UPDATE: extend Narrative_PipelineSlugGeneration with Phase 2 evidence ────
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T140000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E test (Derive Id E2E) further validates this by reproducing the missing-id failure pattern observed in production (## level heading, no id field), asserting the pipeline must not crash and must produce a valid slug under those conditions." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}