# ── New Sample (named graph) ─────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T140000Z {

    narr:Sample_SampleMemoryPhase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 pipeline test memory submitted without an explicit id field, reproducing the missing-id failure pattern from production. Validates that the pipeline must not crash and must produce a valid slug." ;
      narr:inputLength 222 .

    # ── Claims ───────────────────────────────────────────────────────────────

    narr:Claim_ReproducesMissingIdFailure a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "This memory reproduces the missing-id failure pattern observed in production: a ## level heading with no id field in the frontmatter." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    narr:Claim_MustNotCrash a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The pipeline must not crash when processing a memory that has no explicit id field — this is a hard requirement validated by this E2E test." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    narr:Claim_MustProduceValidSlug a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "The pipeline must produce a valid slug even when no explicit id is provided — the slug-generation fallback path must succeed." ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_PipelineSlugGeneration .

    # ── Observation ──────────────────────────────────────────────────────────

    narr:Observation_MissingIdFailurePattern a narr:Observation ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:broader narr:FailureModesSafety ;
      skos:note "Verbatim assertion of the prod failure pattern being reproduced: ## level heading, no id field." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 96 ;
        oa:end 177
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Reproduces the missing-id failure pattern from prod (## level heading,\nno id field)." ;
        oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
        oa:suffix " Must not crash; must produce a valid slug."
      ] .

    # ── Style Observations ───────────────────────────────────────────────────

    narr:StyleObservation_ImperativeMood_Phase2 a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Imperative mood used for pipeline requirements: 'Must not crash; must produce a valid slug.' Signals hard engineering constraints." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 178 ;
          oa:end 222
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObservation_JargonDensity_Phase2 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Engineering jargon concentrated in a short body: 'missing-id failure pattern', 'prod', '## level heading', 'no id field', 'slug'. High jargon density for document length." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 96 ;
          oa:end 165
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod (## level heading," ;
          oa:prefix "\n\n" ;
          oa:suffix "\nno id field)."
        ]
      ] .

    narr:StyleObservation_ToneAuthoritative_Phase2 a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
      skos:note "Authoritative, specification-style tone throughout. No hedging language; requirements stated as absolutes ('Must not crash')." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
