# ── UPDATE: narr:Narrative_PipelineSlugGeneration — add Phase 2 / must-not-crash framing ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
}
INSERT {
  GRAPH narr:Tx_20250727T120000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Phase 2 E2E testing additionally asserts the pipeline must not crash under this condition. This tests a specific resilience path in the ingestion pipeline." ;
      narr:theme "Pipeline slug generation from memory content when no explicit id is provided; pipeline must not crash and must produce a valid slug" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
    narr:Narrative_PipelineSlugGeneration narr:theme ?oldTheme .
  }
} ;

# ── UPDATE: narr:Claim_NoExplicitIdSlugRequired — add must-not-crash constraint ──
DELETE {
  GRAPH ?g {
    narr:Claim_NoExplicitIdSlugRequired skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250727T120000Z {
    narr:Claim_NoExplicitIdSlugRequired skos:note "The pipeline must produce a slug from memory content when no id field is present, using either LLM id-gen or deterministic slugify fallback, and must commit the file successfully. Phase 2 E2E adds the explicit constraint: must not crash under the missing-id condition (## level heading, no id field)." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_NoExplicitIdSlugRequired skos:note ?oldNote .
  }
}