      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Imperative/prescriptive register: back-to-back 'must' clauses assert hard system requirements." ;
      rdf:value true ;
      oa:hasTarget [
