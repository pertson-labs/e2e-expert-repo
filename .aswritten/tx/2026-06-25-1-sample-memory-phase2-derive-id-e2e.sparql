          oa:end 234
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — Prod reference as authority signal
    narr:StyleObs_Phase2_ProdReferencePattern a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Citing 'prod' (production environment) as the origin of the failure pattern lends authority and urgency to the test case framing." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 96 ;
          oa:end 148
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod" ;
          oa:prefix "Reproduces the " ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # Style Observation 3 — Phase numbering convention in heading
    narr:StyleObs_Phase2_HeadingPhaseConvention a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "'Phase 2' in the H2 heading signals an iterative test series convention, implying a Phase 1 precursor and possible Phase N continuation." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 91
