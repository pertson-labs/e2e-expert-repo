INSERT DATA {
  GRAPH narr:Tx_20250727T120000Z {

    # Sample node for this document
    narr:Sample_SampleMemoryPhase2_DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod to verify the pipeline does not crash and produces a valid slug." ;
      narr:inputLength "249"^^xsd:integer .

    # Reviewer actor
    narr:Actor_TestExpertReviewer a narr:Actor ;
      skos:prefLabel "test+expert-gh@aswritten.ai" ;
