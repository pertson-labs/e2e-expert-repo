    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SampleMemoryPhase2_DeriveIdE2E
      a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:created "2025-07-17"^^xsd:date ;
      narr:inputLength 194 ;
      skos:note "Phase 2 E2E test memory submitted without an explicit id field. Validates that the pipeline does not crash and produces a valid slug when the id field is absent. Reviewer assigned in frontmatter (email redacted per PII policy)." .

    # ── Claim: Must Not Crash ────────────────────────────────────
    narr:Claim_MustNotCrash
      a narr:Claim ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      narr:aboutNode narr:Narrative_PipelineSlugGeneration ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_PipelineSlugGeneration ;
      skos:note "The pipeline must not crash when processing a memory that has no explicit id field and uses only a ## level heading. This is a safety/resilience requirement distinct from the slug-production outcome." .

    # ── Style Observation 1: Jargon / Technical Terminology ──────
    narr:StyleObs_Phase2_JargonDensity
      a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Pipeline-specific jargon ('missing-id failure pattern', 'slug', '## level heading') concentrated in a two-sentence body, yielding high jargon density relative to document length." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 60 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading," ;
          oa:prefix "Reproduces the " ;
          oa:suffix "\nno id field)."
        ]
      ] .

    # ── Style Observation 2: Imperative / Modal Mood ─────────────
    narr:StyleObs_Phase2_ImperativeMood
      a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Requirements stated as modal imperatives ('Must not crash; must produce a valid slug') — terse, directive register typical of acceptance-criteria style." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 145 ;
          oa:end 194
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 3: Authoritative / Technical Register ──
    narr:StyleObs_Phase2_TechnicalRegister
      a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
      skos:note "Opening sentence uses declarative active voice ('Reproduces the missing-id failure pattern from prod') establishing authoritative, engineering-report register with no hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 100
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "## Sample Memory Phase 2 — Derive Id E2E\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_SampleMemoryPhase2
      a narr:StyleMetrics ;
      dct:source narr:Sample_SampleMemoryPhase2_DeriveIdE2E ;
