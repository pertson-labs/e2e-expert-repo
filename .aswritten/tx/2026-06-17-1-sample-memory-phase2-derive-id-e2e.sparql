      narr:AverageSentenceLength "15"^^xsd:integer ;
      narr:ActiveVoiceRatio "0.50"^^xsd:decimal ;
      narr:JargonDensity "0.20"^^xsd:decimal ;
      skos:note "Very short document (2 body sentences). Mixed active/modal-imperative voice. High jargon density relative to length due to pipeline-specific terminology (slug, id field, ## level heading, prod)." .

