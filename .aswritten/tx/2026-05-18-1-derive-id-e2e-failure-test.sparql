# ── UPDATE: narr:Narrative_PipelineSlugGeneration ────────────────────────────
# Memory adds Phase 2 E2E framing and 'must not crash' safety requirement
# to the existing narrative. Existing IRI preserved.
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T000000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. This memory exists to exercise that code path. Phase 2 (E2E) extends this: the pipeline must not crash under the missing-id condition and must produce a valid slug in all cases." ;
      dct:source narr:Sample_Phase2DeriveIdE2E .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

