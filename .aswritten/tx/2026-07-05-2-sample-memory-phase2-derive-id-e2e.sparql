  GRAPH narr:Tx_20260705T104457Z {
    narr:Narrative_PipelineSlugGeneration skos:note "When a memory is submitted without an explicit id field, the pipeline must produce a slug from the memory content — either via the LLM id-gen call or the deterministic slugify fallback — and commit the file successfully. Phase 2 (## heading, no id field): must not crash; must produce a valid slug. Reproduces missing-id failure pattern from prod." .
  }
}
