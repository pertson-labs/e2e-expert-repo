# ── UPDATE: narr:Sample_ZypherionDBDecision_20260406 ────────────────────────
# Memory explicitly revises the document: title, description, and inputLength change.
DELETE {
  GRAPH ?g {
    narr:Sample_ZypherionDBDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Sample_ZypherionDBDecision_20260406
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised meeting note recording CTO Quinton Fairweather's decision to switch from Zypherion to Meridian for the analytics pipeline, citing Zypherion's critical gap in streaming ingestion. Supersedes the original Zypherion adoption decision. Q3 2026 migration window retained." ;
      narr:inputLength 521 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_ZypherionDBDecision_20260406
      dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: narr:Narrative_ZypherionAdoption ────────────────────────────────
# Memory explicitly supersedes the Zypherion adoption narrative with Meridian.
# Temporal supersession + explicit retraction: "This supersedes the previous Zypherion decision."
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Narrative_ZypherionAdoption
      narr:theme "Technology adoption decision: Meridian replaces Zypherion as analytics database" ;
      skos:note "REVISED: The organisation is switching from Zypherion to Meridian as its analytics database. Zypherion was found to have critical gaps in streaming ingestion; Meridian handles both batch and streaming natively. Migration remains scheduled for Q3 2026. Supersedes the original Zypherion adoption decision." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption
      narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
} ;

# ── UPDATE: narr:Claim_ZypherionMigrationQ3 ─────────────────────────────────
# Migration target changes from Zypherion to Meridian; timeline retained.
DELETE {
  GRAPH ?g {
