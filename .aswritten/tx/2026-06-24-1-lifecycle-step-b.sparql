} ;

# ── INSERT: New entities from revised memory ────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260406T140000Z {

    # New Narrative: Meridian adoption (the positive replacement decision)
    narr:Narrative_MeridianAdoption a narr:Narrative ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:broader narr:StackOverview ;
      narr:theme "Technology selection: Meridian chosen for native batch and streaming analytics" ;
      skos:note "Meridian is selected as the analytics database because it handles both batch and streaming ingestion natively, addressing the critical gap found in Zypherion. Decision made by CTO Quinton Fairweather, 2026-04-06." .

    # New Claim: Meridian migration Q3
    narr:Claim_MeridianMigrationQ3 a narr:Claim ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_MeridianAdoption ;
      skos:note "Migration to Meridian proceeds in the same Q3 2026 window originally planned for Zypherion." .

    # New Claim: Zypherion streaming ingestion gap
    narr:Claim_ZypherionStreamingGap a narr:Claim ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      narr:aboutNode narr:Narrative_MeridianAdoption ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_MeridianAdoption ;
      narr:challenges narr:Narrative_ZypherionAdoption ;
      skos:note "Zypherion has critical gaps in streaming ingestion, making it unsuitable for the analytics pipeline. This finding drove the switch to Meridian." .

    # Observation: Quinton's direct quote announcing the revision
    narr:Obs_QuintonRevisionQuote a narr:Observation ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:broader narr:Quotes ;
      skos:note "Direct quote from Quinton Fairweather announcing the switch from Zypherion to Meridian, citing streaming ingestion gaps." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 175 ;
          oa:end 340
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We evaluated Zypherion further and found critical gaps in its streaming ingestion. We are now switching to Meridian instead. Meridian handles both batch and streaming natively." ;
          oa:prefix "Quinton: \"" ;
          oa:suffix "\""
        ]
      ] .

    # Observation: Supersession statement
    narr:Obs_SupersessionStatement a narr:Observation ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:broader narr:DesignTradeoffs ;
      skos:note "Explicit statement that the revised decision supersedes the prior Zypherion decision." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 342 ;
          oa:end 390
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # StyleObservation 1: Direct declarative tone in revision announcement
    narr:StyleObs_DirectDeclarative_Revised a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Authoritative, declarative register: short imperative-adjacent sentences announce the switch without hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 210 ;
          oa:end 262
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We are now switching to Meridian instead." ;
          oa:prefix "its streaming ingestion. " ;
          oa:suffix " Meridian handles both"
        ]
      ] .

    # StyleObservation 2: Technical jargon — streaming ingestion
    narr:StyleObs_TechnicalJargon_Revised a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Technical jargon: 'streaming ingestion' and 'batch' used without definition, assuming engineering-literate audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 263 ;
          oa:end 315
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Meridian handles both batch and streaming natively." ;
          oa:prefix "switching to Meridian instead. " ;
          oa:suffix "\""
        ]
      ] .

    # StyleObservation 3: Supersession rhetoric — explicit prior-decision retraction
    narr:StyleObs_SupersessionRhetoric a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_ZypherionDBDecision_20260406 ;
      skos:note "Explicit supersession framing: a single declarative sentence formally retracts the prior decision. Institutional voice pattern for decision revision." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ZypherionDBDecision_20260406 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 342 ;
          oa:end 390
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "This supersedes the previous Zypherion decision." ;
          oa:prefix "natively.\"\n\n" ;
          oa:suffix "\n\nKey decisions:"
        ]
      ] .

    # StyleMetrics for the revised document
    narr:StyleMetrics_MeridianRevision a narr:StyleMetrics ;
