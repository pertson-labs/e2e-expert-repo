  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionPerformance15x
      skos:note "SUPERSEDED: Original 15x columnar query performance claim for Zypherion. Revised decision found critical gaps in Zypherion streaming ingestion, overriding the performance rationale. Meridian now selected instead." ;
