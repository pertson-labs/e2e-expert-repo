      narr:aboutNode ?oldAbout .
  }
}
INSERT {
  GRAPH narr:Tx_20260406T140000Z {
    narr:Claim_ZypherionMigrationQ3
      skos:note "Migration to Meridian (replacing Zypherion) starts Q3 2026. Timeline unchanged from original decision." ;
      narr:aboutNode narr:Narrative_ZypherionAdoption .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_ZypherionMigrationQ3
      skos:note ?oldNote ;
      narr:aboutNode ?oldAbout .
  }
} ;

