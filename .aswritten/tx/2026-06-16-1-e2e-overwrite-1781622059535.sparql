PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    dct:title "Second version document extraction" ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Narrative_SecondVersionDocument,
      narr:Claim_SecondVersionState,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_NominalPhrase,
      narr:StyleObs_SecondVersion_MinimalBody,
      narr:StyleObs_SecondVersion_ReviewerFrontMatter .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML front-matter declaring a reviewer and a single-line body asserting second version status." ;
      narr:inputLength 63 .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_SecondVersionDocument a narr:Narrative ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:Process ;
      skos:note "The document declares itself as a second version and assigns the same named reviewer via YAML front-matter, indicating an iterated review-gated authoring process." ;
      narr:theme "Iterated document version with designated reviewer" .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_SecondVersionState a narr:Claim ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The body text 'Second version' asserts this is a revised draft state. Conviction is Notion — minimal content, no corroborating evidence beyond the version label." ;
      narr:aboutNode narr:Narrative_SecondVersionDocument ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process .

    # ── Style Observations ──────────────────────────────────────

    # Style Obs 1: Nominal phrase body — same ultra-minimal register as first version
    narr:StyleObs_SecondVersion_NominalPhrase a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a bare two-word nominal phrase with no verb, mirroring the first version's register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 58
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Obs 2: YAML front-matter reviewer declaration
    narr:StyleObs_SecondVersion_ReviewerFrontMatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML front-matter used to declare a named reviewer, establishing a structured editorial governance pattern consistent with the first version." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 42
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    # Style Obs 3: Minimal body length — microcopy register
    narr:StyleObs_SecondVersion_MinimalBody a narr:StyleObservation ;
      skos:broader narr:MicrocopyGuidelines ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Entire body content is two words. Consistent with a label or status marker rather than prose, signalling a microcopy or placeholder register." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 44 ;
          oa:end 58
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Body is a single two-word nominal phrase. No sentences in the traditional sense; no jargon; active voice assumed by default for declarative labels. Identical register to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .

  }
}