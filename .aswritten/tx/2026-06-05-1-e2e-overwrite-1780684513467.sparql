PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250715T120000Z a prov:Activity ;
    dct:title "Extraction: Second version document with reviewer frontmatter" ;
    prov:generatedAtTime "2025-07-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Observation_SecondVersionPhrase,
      narr:StyleObs_SecondVersion_PlainRegister,
      narr:StyleObs_SecondVersion_YAMLFrontmatter,
      narr:StyleObs_SecondVersion_NounPhraseCadence,
      narr:StyleMetrics_SecondVersion .
} ;

# ── Update Narrative: First → Second version ────────────────────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Second draft submission with designated reviewer" ;
      skos:note "Document asserts it is a second version and designates a reviewer via YAML frontmatter. No substantive content beyond the version declaration. Supersedes the first version." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── Update Observation: phrase changed from 'First version' to 'Second version' ──
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionPhrase skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Observation_SecondVersionPhrase a narr:Observation ;
      skos:broader narr:CoreWorkflows ;
      skos:note "The body of the document consists solely of the phrase 'Second version', indicating a revised draft state superseding the first version." ;
      dct:source narr:Sample_SecondVersion ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 47 ;
        oa:end 61
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionPhrase skos:note ?oldNote ;
      dct:source ?oldSource .
  }
} ;

# ── New Sample node for second version ──────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version document with reviewer frontmatter" ;
      dct:description "Minimal document: YAML frontmatter listing a reviewer email, body text 'Second version'. Supersedes first version." ;
      narr:inputLength 68 .

    # ── Style Observations ───────────────────────────────────────────────────

    narr:StyleObs_SecondVersion_PlainRegister a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      skos:note "Entire body is a two-word declarative noun phrase. Maximally plain register; no verbs, no punctuation, no elaboration." ;
      rdf:value true ;
      dct:source narr:Sample_SecondVersion ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      skos:note "YAML frontmatter used to encode reviewer attribution metadata, consistent with structured editorial workflow conventions." ;
      rdf:value true ;
      dct:source narr:Sample_SecondVersion ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 46
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:\n  - test+expert-gh@aswritten.ai" ;
          oa:prefix "---\n" ;
          oa:suffix "\n---"
        ]
      ] .

    narr:StyleObs_SecondVersion_NounPhraseCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      skos:note "Body text is a bare noun phrase ('Second version') with no sentence structure. Cadence is minimal and declarative, consistent with version-label convention rather than prose." ;
      rdf:value true ;
      dct:source narr:Sample_SecondVersion ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 47 ;
          oa:end 61
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────

    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Extremely short document. Body is a single 2-word noun phrase. No jargon. Active voice implied by declarative noun phrase. Metrics computed on body text only (frontmatter excluded)." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
}