PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250116T120000Z a prov:Activity ;
    dct:title "Second version document with reviewer metadata" ;
    prov:generatedAtTime "2025-01-16T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Observation_SecondVersionBody,
      narr:StyleMetrics_SecondVersion,
      narr:StyleObs_SecondVersion_ShortPunchy,
      narr:StyleObs_SecondVersion_FragmentaryRegister,
      narr:StyleObs_SecondVersion_YAMLFrontMatter .
} ;

# ── New Sample node ──────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250116T120000Z {
    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Short document with YAML front-matter declaring a reviewer and a two-word body stating 'Second version'. Identical structure to first version; body text incremented." ;
      narr:inputLength 67 .
  }
} ;

# ── New Observation: body text ───────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250116T120000Z {
    narr:Observation_SecondVersionBody a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body text asserts document is at its second iteration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 54 ;
        oa:end 68
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
} ;

# ── Style Observations ───────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250116T120000Z {

    narr:StyleObs_SecondVersion_ShortPunchy a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Body is a two-word noun phrase with no verb — maximally compressed, stub-like cadence." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 54 ;
          oa:end 68
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_FragmentaryRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Register is fragmentary / stub: no full sentences, no verbs, no punctuation in body. Consistent with a draft label or placeholder document." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 54 ;
          oa:end 68
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_YAMLFrontMatter a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML front-matter block used for structured metadata (reviewer assignment). Consistent with the first version's front-matter pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 52
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@aswritten.ai\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .

  }
} ;

# ── Style Metrics ────────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250116T120000Z {
    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (2 words of body text). No verbs present, active voice ratio is 0. No domain jargon detected. Register: fragmentary label / stub. Identical profile to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "0.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── UPDATE: Narrative — version theme superseded ─────────────────
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250116T120000Z {
    narr:Narrative_FirstVersionDocument narr:theme "Document versioning — second iteration" ;
      skos:note "The document has been incremented to its second version, with the same named reviewer assigned via YAML front-matter. This signals an active early-stage review workflow progressing beyond initial draft." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDocument narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_FirstVersionDocument skos:note ?oldNote . }
  }
} ;

# ── UPDATE: Claim — version assertion superseded ─────────────────
DELETE {
  GRAPH ?g {
    narr:Claim_DocumentAtFirstVersion skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250116T120000Z {
    narr:Claim_DocumentAtFirstVersion skos:note "The body text 'Second version' asserts the document is at its second iteration. Conviction remains Notion — minimal content, no corroborating evidence beyond the label itself." ;
      dct:source narr:Sample_SecondVersion .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_DocumentAtFirstVersion skos:note ?oldNote .
    OPTIONAL { narr:Claim_DocumentAtFirstVersion dct:source ?oldSource . }
  }
}