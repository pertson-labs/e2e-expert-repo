# ── New Sample (REVISED document) ───────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20260704T101829Z {
    narr:Sample_MeridianDecision_20260406 a narr:Sample ;
      dct:title "Database Decision REVISED: Switching from Zypherion to Meridian" ;
      dct:description "Revised decision record from Quinton Fairweather (CTO) superseding the Zypherion adoption. Meridian selected for native batch and streaming ingestion support. Q3 2026 migration window retained." ;
      dct:created "2026-04-06"^^xsd:date ;
      narr:inputLength 590 .
  }
} ;

# ── UPDATE Narrative_ZypherionAdoption → Meridian adoption ──────────────────
# The Zypherion adoption narrative is explicitly superseded by this memory.
# The same IRI is retained; theme and note are updated.
DELETE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20260704T101829Z {
    narr:Narrative_ZypherionAdoption narr:theme "Adopting Meridian as the analytics database, superseding Zypherion, for native batch and streaming ingestion" ;
      skos:note "The organisation reversed its Zypherion decision after discovering critical streaming ingestion gaps. Meridian was selected as the replacement, handling both batch and streaming natively. The Q3 2026 migration window is retained." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_ZypherionAdoption narr:theme ?oldTheme .
    OPTIONAL { narr:Narrative_ZypherionAdoption skos:note ?oldNote . }
    OPTIONAL { narr:Narrative_ZypherionAdoption dct:source ?oldSource . }
  }
} ;

# ── DELETE Claim_ZypherionColumnarPerformance ────────────────────────────────
# The new memory explicitly supersedes the Zypherion decision. The 15x columnar
# performance claim was the rationale for adopting Zypherion; that adoption is
# now reversed. The new memory contradicts the premise (Zypherion is rejected,
# not adopted), constituting explicit retraction of this claim.
DELETE {
