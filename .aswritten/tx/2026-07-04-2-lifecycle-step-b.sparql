  }
}
INSERT {
  GRAPH narr:Tx_20260704T232046Z {
    narr:Narrative_ZypherionAdoption narr:theme "Adopting Meridian as the analytics database, superseding Zypherion" ;
      skos:note "The organisation reversed its Zypherion adoption decision after discovering critical streaming ingestion gaps. Meridian was selected as the replacement, handling both batch and streaming natively. Migration remains Q3 2026. This narrative supersedes the prior Zypherion adoption narrative from 2026-04-06." ;
      dct:source narr:Sample_MeridianDecision_20260406 .
  }
}
