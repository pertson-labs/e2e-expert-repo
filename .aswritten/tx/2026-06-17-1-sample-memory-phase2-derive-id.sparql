} ;

# New sample node
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Sample_Phase2DeriveIdE2E a narr:Sample ;
      dct:title "Sample Memory Phase 2 — Derive Id E2E" ;
      dct:description "Phase 2 E2E test memory submitted without an explicit id field. Reproduces the missing-id failure pattern from prod (## level heading, no id field). Must not crash; must produce a valid slug." ;
      narr:inputLength 248 .
  }
} ;

# Style metrics for new sample
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {
    narr:StyleMetrics_Phase2DeriveIdE2E a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Very short document (2 body sentences). Active, imperative register. Moderate jargon density from pipeline/slug/prod/E2E terminology. Short average sentence length." ;
      narr:AverageSentenceLength 16 ;
      narr:ActiveVoiceRatio "0.90"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal .
  }
} ;

# Style observations for new sample
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {

    narr:StyleObs_Phase2_ImperativeRegister a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Imperative, prescriptive register: behavioral requirements stated as obligations ('Must not crash; must produce a valid slug')." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a valid slug." ;
          oa:prefix "no id field). " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_Phase2_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Dense use of pipeline/engineering jargon: 'missing-id failure pattern', 'prod', 'slug', 'E2E', '## level heading', 'no id field' — assumes reader familiarity with the system." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 97 ;
          oa:end 175
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "missing-id failure pattern from prod (## level heading, no id field)" ;
          oa:prefix "Reproduces the " ;
          oa:suffix ". Must not crash"
        ]
      ] .

    narr:StyleObs_Phase2_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "Two short, declarative sentences in the body. Staccato rhythm reinforces test-spec register: assertion followed by pass criteria." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_Phase2DeriveIdE2E ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 97 ;
          oa:end 230
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Reproduces the missing-id failure pattern from prod" ;
          oa:prefix "\n\n" ;
          oa:suffix " (## level heading,"
        ]
      ] .
  }
} ;

# Update existing Narrative to reference new sample as additional source
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250715T120000Z {
    narr:Narrative_PipelineSlugGeneration dct:source narr:Sample_SlugGenPipelineTest ;
      dct:source narr:Sample_Phase2DeriveIdE2E ;
      skos:note "When a memory is submitted without an explicit id field, the pipeline must derive a slug — either via an LLM id-gen call or a deterministic slugify fallback — and commit the file successfully. Confirmed across two E2E test runs (Phase 1 and Phase 2)." ;
      narr:theme "Pipeline slug generation from memory content" .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration dct:source ?oldSource .
  }
}