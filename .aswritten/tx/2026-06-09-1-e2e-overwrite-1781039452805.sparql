PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T130000Z a prov:Activity ;
    dct:title "Extraction: Second version document" ;
    prov:generatedAtTime "2025-01-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "" ;
    prov:generated
      narr:Sample_SecondVersion,
      narr:Actor_Reviewer_ExpertGH,
      narr:Observation_SecondVersionBody,
      narr:StyleObs_SecondVersion_MinimalDeclarative,
      narr:StyleObs_SecondVersion_ReviewerFrontmatter,
      narr:StyleObs_SecondVersion_VersionCadence,
      narr:StyleMetrics_SecondVersion .
} ;

# New entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T130000Z {

    narr:Sample_SecondVersion a narr:Sample ;
      dct:title "Second version" ;
      dct:description "Minimal document with YAML frontmatter (reviewer metadata) and a single body sentence declaring second version status. Supersedes the First version document." ;
      narr:inputLength 68 .

    narr:Actor_Reviewer_ExpertGH a narr:Actor ;
      skos:prefLabel "Expert Reviewer (GH)" ;
      skos:note "Reviewer listed in YAML frontmatter of the Second version document. Email redacted per PII policy." .

    narr:Observation_SecondVersionBody a narr:Observation ;
      skos:broader narr:QualityReviewGates ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "The sole body content declares second version status, signalling progression in the document review lifecycle." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 52 ;
        oa:end 66
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    narr:StyleObs_SecondVersion_MinimalDeclarative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Bare declarative noun phrase with no verb; authoritative minimal register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_ReviewerFrontmatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "YAML frontmatter used to encode reviewer metadata structurally, consistent with editorial workflow conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 48
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - "
        ]
      ] .

    narr:StyleObs_SecondVersion_VersionCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_SecondVersion ;
      skos:note "Two-word body phrase mirrors the cadence of the prior 'First version' document, establishing a versioning idiom." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersion ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 66
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleMetrics_SecondVersion a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersion ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Extremely short document (one body phrase, two tokens). Active voice ratio maximal; zero jargon density. Register: minimal declarative, identical profile to First version." .

  }
} ;

# UPDATE: narr:Narrative_FirstVersionDeclaration — temporal supersession
# The narrative theme 'Document version declaration' persists as a pattern,
# but the note must be updated to reflect that a second version now exists.
DELETE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Narrative_FirstVersionDeclaration skos:note "The document series asserts version status declarations ('First version', 'Second version'), signalling progression through a review or publication lifecycle. The Second version document supersedes the First version." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_FirstVersionDeclaration skos:note ?oldNote .
  }
} ;

# UPDATE: narr:Claim_FirstVersionStatus — temporal supersession by 'Second version'
# The claim that the document is at its first version is now superseded.
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}
INSERT {
  GRAPH narr:Tx_20250115T130000Z {
    narr:Claim_FirstVersionStatus skos:note "Originally asserted first-version status; now superseded by the Second version document. The version lifecycle has progressed beyond the initial state." ;
      narr:hasConvictionLevel narr:Conviction_Stake .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      narr:hasConvictionLevel ?oldLevel .
  }
}