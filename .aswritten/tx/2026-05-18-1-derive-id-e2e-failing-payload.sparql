# ── New entities (named graph) ───────────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250117T130000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_BoxFreeDesignContinuation2 a narr:Sample ;
      dct:title "Box-Free Design Continuation 2 — Derive Id E2E" ;
      dct:description "Second E2E test reproducing Mike Sackton's failing payload pattern: ## level heading with no id field. Pipeline must not crash and must produce a topical slug." ;
