          oa:exact "Must not crash; must produce a topical slug." ;
          oa:prefix "no id). " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Observation 2: Engineering jargon density ─────────────────────
    narr:StyleObs_BoxFree_JargonEngineering a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_BoxFreeDesignContinuation2 ;
      skos:note "Concentrated pipeline/engineering terminology: 'payload pattern', 'id', 'slug'. Assumes reader familiarity with the extraction pipeline domain." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_BoxFreeDesignContinuation2 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 82 ;
          oa:end 154
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
