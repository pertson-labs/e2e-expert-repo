          oa:prefix "Derive Id E2E\n\n" ;
          oa:suffix " Must not crash"
        ]
      ] .

    # ── Style Observation 3: Sentence-level parallelism / anaphora ──────────
    narr:StyleObs_BoxFree_ImperativeMood a narr:StyleObservation ;
      skos:broader narr:Parallelism ;
      dct:source narr:Sample_BoxFreeDesignContinuation2 ;
      skos:note "Parallel 'must' constructions ('Must not crash; must produce') create a two-part acceptance criterion with balanced syntactic weight." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_BoxFreeDesignContinuation2 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 207
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Must not crash; must produce a topical slug." ;
          oa:prefix "no id). " ;
          oa:suffix ""
        ]
