# ── UPDATE: extend Narrative_PipelineSlugGeneration with new sample source ──
DELETE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250117T130000Z {
    narr:Narrative_PipelineSlugGeneration skos:note "The pipeline must generate a slug when no id field is provided — either via LLM id-gen call or deterministic slugify fallback — and commit the file successfully. Evidenced by two E2E test cases: (1) Zypherion Analytics Migration Decision; (2) Box-Free Design Continuation 2 reproducing Mike Sackton's failing ## heading / no-id payload pattern." ;
      dct:source narr:Sample_BoxFreeDesignContinuation2 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_PipelineSlugGeneration skos:note ?oldNote .
  }
} ;

# ── UPDATE: extend Claim_NoIdFieldRequiresSlug with no-crash requirement ────
DELETE {
  GRAPH ?g {
    narr:Claim_NoIdFieldRequiresSlug skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250117T130000Z {
    narr:Claim_NoIdFieldRequiresSlug skos:note "The pipeline must (a) not crash and (b) produce a topical slug from memory content — via LLM id-gen or deterministic slugify fallback — when no id is present. Confirmed by two test cases including Mike Sackton's failing ## heading / no-id payload pattern." ;
      dct:source narr:Sample_BoxFreeDesignContinuation2 .
  }
}
WHERE {
