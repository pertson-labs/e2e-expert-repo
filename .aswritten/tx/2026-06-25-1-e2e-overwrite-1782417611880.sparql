      narr:StyleObs_VersioningIdiom,
      narr:StyleMetrics_FirstVersionStub .
} ;

# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_FirstVersionStub a narr:Sample ;
      dct:title "First version stub document" ;
      narr:inputLength "52"^^xsd:integer ;
      dct:description "Minimal document containing YAML frontmatter with a reviewer assignment and a two-word body 'First version'." .

    # ── Actor ───────────────────────────────────────────────────
    # PII redacted: reviewer email address withheld per verbatim policy (allow_pii not set)
    narr:Actor_ExpertReviewer_GH a narr:Actor ;
      skos:prefLabel "Expert Reviewer (GitHub)" ;
      skos:note "Reviewer listed in YAML frontmatter under 'reviewers'. Email address redacted (PII policy)." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_DocumentVersioning a narr:Narrative ;
      dct:source narr:Sample_FirstVersionStub ;
      narr:theme "Document versioning and initial draft status" ;
      skos:broader narr:Process ;
      skos:note "The document body 'First version' signals an initial draft state, establishing a versioning baseline for the artifact." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_FirstVersionStatus a narr:Claim ;
      narr:aboutNode narr:Narrative_DocumentVersioning ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_DocumentVersioning ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "The phrase 'First version' asserts this is an initial draft. Conviction is Notion — minimal content, no corroborating context." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_ReviewerFrontmatter a narr:Observation ;
      skos:broader narr:QualityReviewGates ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "YAML frontmatter assigns a reviewer role, indicating a review-gated workflow." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "4"^^xsd:integer ;
        oa:end "43"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "reviewers:\n  - test+expert-gh@" ;
        oa:prefix "---\n" ;
        oa:suffix "aswritten.ai"
      ] .

    narr:Observation_FirstVersionBody a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "The body of the document consists solely of the phrase 'First version', marking initial draft status." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "42"^^xsd:integer ;
        oa:end "55"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "First version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_MinimalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "Extremely terse register: the entire document body is two words. No prose, no sentences, no elaboration." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "42"^^xsd:integer ;
          oa:end "55"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_YAMLFrontmatterConvention a narr:StyleObservation ;
      skos:broader narr:CitationConventions ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "Document uses YAML frontmatter delimited by triple-dashes (---) to encode structured metadata before prose content. This is a common convention in static-site generators and documentation pipelines." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "0"^^xsd:integer ;
          oa:end "41"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - test+expert-gh@" ;
          oa:prefix "" ;
          oa:suffix "aswritten.ai\n---"
        ]
      ] .

    narr:StyleObs_VersioningIdiom a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_FirstVersionStub ;
      skos:note "'First version' is a plain-language versioning idiom — direct, unadorned, no semantic versioning notation (e.g., v1.0.0). Signals informal or early-stage documentation practice." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_FirstVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "42"^^xsd:integer ;
          oa:end "55"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "First version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_FirstVersionStub a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_FirstVersionStub ;
      narr:AverageSentenceLength "2"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal ;
      skos:note "Metrics computed on a 2-word body. AverageSentenceLength=2 (single nominal phrase). ActiveVoiceRatio=1.0 (no passive constructions). JargonDensity=0.0 (no technical terms in body)." .

  }
}