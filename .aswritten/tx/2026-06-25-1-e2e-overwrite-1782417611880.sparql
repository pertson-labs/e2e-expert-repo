PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    dct:title "Extraction: second version stub document with reviewer frontmatter" ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersionStub,
      narr:Narrative_DocumentVersioning,
      narr:Claim_SecondVersionStatus,
      narr:Observation_SecondVersionBody,
      narr:StyleMetrics_SecondVersionStub,
      narr:StyleObs_PlainLanguage_SecondVersion,
      narr:StyleObs_NominalPhraseCadence_SecondVersion,
      narr:StyleObs_YAMLFrontmatterConvention_SecondVersion .
} ;

# ── UPDATE: Sample — title, description, inputLength reflect second version ──
DELETE {
  GRAPH ?g {
    narr:Sample_FirstVersionStub dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Sample_SecondVersionStub a narr:Sample ;
      dct:title "Second version stub document" ;
      dct:description "Minimal document containing YAML frontmatter with a reviewer assignment and a two-word body 'Second version'." ;
      narr:inputLength "67"^^xsd:integer .
  }
}
WHERE {
  GRAPH ?g {
    narr:Sample_FirstVersionStub dct:title ?oldTitle ;
      dct:description ?oldDesc ;
      narr:inputLength ?oldLen .
  }
} ;

# ── UPDATE: Narrative — theme advances from initial draft to second version ──
DELETE {
  GRAPH ?g {
    narr:Narrative_DocumentVersioning narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Narrative_DocumentVersioning narr:theme "Document versioning and iterative draft progression" ;
      skos:note "The document body 'Second version' advances the versioning baseline established by the first version, signalling iterative draft progression." ;
      dct:source narr:Sample_SecondVersionStub .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_DocumentVersioning narr:theme ?oldTheme ;
      skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

# ── UPDATE: Claim — first version status superseded by second version ────────
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Claim_SecondVersionStatus a narr:Claim ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The phrase 'Second version' asserts this document has been revised at least once. Conviction is Notion — minimal content, no corroborating context beyond the version label." ;
      narr:aboutNode narr:Narrative_DocumentVersioning ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_DocumentVersioning .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionStatus skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

# ── UPDATE: Observation body — quote changes from 'First version' to 'Second version' ──
DELETE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120000Z {
    narr:Observation_SecondVersionBody a narr:Observation ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:broader narr:Process ;
      skos:note "The body of the document consists solely of the phrase 'Second version', marking an iterative revision beyond the initial draft." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 53 ;
        oa:end 67
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Second version" ;
        oa:prefix "---\n\n" ;
        oa:suffix ""
      ] .
  }
}
WHERE {
  GRAPH ?g {
    narr:Observation_FirstVersionBody skos:note ?oldNote ;
      dct:source ?oldSrc .
  }
} ;

