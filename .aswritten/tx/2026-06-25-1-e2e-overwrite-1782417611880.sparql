      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Entire document body is a two-word nominal phrase — no verb, no sentence structure. Extreme brevity as cadence marker." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 67
        ] ;
        oa:hasSelector [
