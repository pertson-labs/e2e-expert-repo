PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250124T130000Z a prov:Activity ;
    dct:title "Second version stub extraction" ;
    prov:generatedAtTime "2025-01-24T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    prov:generated
      narr:Sample_SecondVersionStub,
      narr:StyleMetrics_SecondVersionStub,
      narr:StyleObs_SecondVersion_PlainLanguage,
      narr:StyleObs_SecondVersion_VersionLabel,
      narr:StyleObs_SecondVersion_FrontMatter .
} ;

# ── New Sample node for second version stub ──────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250124T130000Z {
    narr:Sample_SecondVersionStub a narr:Sample ;
      dct:title "Second version stub" ;
      dct:description "Minimal placeholder document with YAML front-matter reviewer assignment and version label 'Second version'." ;
      narr:inputLength 71 .
  }
} ;

# ── Update Narrative_DocumentInitialization to reference second version ──
DELETE {
  GRAPH ?g {
    narr:Narrative_DocumentInitialization
      dct:source narr:Sample_FirstVersionStub ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250124T130000Z {
    narr:Narrative_DocumentInitialization
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The document represents a second stub iteration: a second version with a reviewer assigned but still no substantive content authored. Supersedes the first version stub." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Narrative_DocumentInitialization
      dct:source narr:Sample_FirstVersionStub ;
      skos:note ?oldNote .
  }
} ;

# ── Update Claim_FirstVersionLabel to reflect second version (temporal supersession) ──
DELETE {
  GRAPH ?g {
    narr:Claim_FirstVersionLabel
      dct:source narr:Sample_FirstVersionStub ;
      skos:note ?oldNote .
  }
}
INSERT {
  GRAPH narr:Tx_20250124T130000Z {
    narr:Claim_FirstVersionLabel
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "The body text 'Second version' signals this is a second placeholder iteration, still at stub stage. Supersedes the 'First version' label claim." .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_FirstVersionLabel
      dct:source narr:Sample_FirstVersionStub ;
      skos:note ?oldNote .
  }
} ;

# ── Style Metrics for second version stub ───────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250124T130000Z {
    narr:StyleMetrics_SecondVersionStub a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Extremely minimal document: one two-word body phrase. No full sentences, no jargon, no passive constructions. Metrics reflect placeholder state identical in character to first version." ;
      narr:AverageSentenceLength 2 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.0"^^xsd:decimal .
  }
} ;

# ── Style Observations (minimum 3) ──────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250124T130000Z {

    narr:StyleObs_SecondVersion_PlainLanguage a narr:StyleObservation ;
      skos:broader narr:PlainLanguage ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Body text is maximally plain: two words, no punctuation, no elaboration. Consistent with placeholder register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_VersionLabel a narr:StyleObservation ;
      skos:broader narr:CapitalizationCase ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "Version label uses title-case noun phrase ('Second version') with capital S, lowercase v — consistent with the prior 'First version' capitalization pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Second version" ;
          oa:prefix "---\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_SecondVersion_FrontMatter a narr:StyleObservation ;
      skos:broader narr:EditorialRules ;
      dct:source narr:Sample_SecondVersionStub ;
      skos:note "YAML front-matter block used for reviewer assignment, following the same editorial convention as the first version stub. Reviewer email is PII-redacted." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_SecondVersionStub ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 48
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "---\nreviewers:\n  - [REDACTED]\n---" ;
          oa:prefix "" ;
          oa:suffix "\n\nSecond version"
        ]
      ] .
  }
}