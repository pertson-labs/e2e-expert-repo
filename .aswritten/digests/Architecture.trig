@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Architecture> {
  <https://aswritten.ai/narrative#Digest_Architecture> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Architecture> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "9950ccef197f155c84b1db579a9908ad5f682f36" ;
    narr:narration """The architecture governing Meridian deployments has shifted toward a [verified release model](narr:Narrative_VerifiedReleaseGate), mandating that every deployment now requires a signed release manifest. This [formal gate](narr:Expr_1ProtectedFallbackProbe_1) is framed by Quinton Fairweather as a direct response to [past security lapses](narr:Expr_1ProtectedFallbackProbe_2), specifically the discovery of unsigned artifacts in staging. While the [core requirement](narr:Expr_1ProtectedFallbackProbe_3) is established as a technical constraint, subsequent documentation [extends the scope](narr:Expr_1ProtectedFallbackProbe_4) to cover both staging and production environments. Ownership of this protocol is [formally attributed](narr:Expr_1ProtectedFallbackProbe_5) to Fairweather, solidifying the transition from implicit trust to a verified, manifest-based deployment pipeline.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_VerifiedReleaseGate> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ] ;
    narr:variation [ narr:text "The scope of the mandate is explicitly expanded to production environments by secondary documentation." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}