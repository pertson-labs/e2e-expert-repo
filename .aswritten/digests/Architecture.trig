    narr:keyPhrase [ narr:text "We are adopting Zypherion for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_1> ] ;
    narr:keyPhrase [ narr:text "It handles columnar queries 15x faster than our current setup." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_2> ] ;
    narr:keyPhrase [ narr:text "The migration starts next quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_3> ] ;
    narr:keyPhrase [ narr:text "**Timeline**: Migration starts Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_6> ] ;
    narr:keyPhrase [ narr:text "**Database**: Zypherion for analytics" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
