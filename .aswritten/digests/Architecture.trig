    narr:variation [ narr:text "The Q3 2026 pin in the restatement is an addition not present in the source claim, which says only 'next quarter' — a small but traceable specificity gap between the two layers." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_3> ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_6> ] ;
