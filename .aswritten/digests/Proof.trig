    narr:generatedFrom "9d474f6218edf0fd49edb8507d94f3bdf6f201f0" ;
    narr:narration """The discourse centers on the operationalization of Atlas rollback capabilities, moving from abstract design to [mandated rehearsal cadences](narr:Expr_1DirectAfterUnprotectProbe_1). Quinton Fairweather establishes a [formalized ownership structure](narr:Expr_1DirectAfterUnprotectProbe_4) to ensure accountability, framing the transition as a shift from theoretical readiness to [verified recovery](narr:Expr_1DirectAfterUnprotectProbe_3). The underlying logic, articulated as a [broader principle of recovery](narr:Narrative_RehearsedRecoveryIsRealRecovery), posits that a capability is functionally non-existent until it is repeatedly tested. This [philosophical stance on readiness](narr:Expr_1DirectAfterUnprotectProbe_2) serves as the primary justification for the move toward a recurring, high-frequency maintenance schedule.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_RehearsedRecoveryIsRealRecovery> ;
    narr:keyPhrase [ narr:text "Atlas rollback rehearsals run monthly from now on." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_1> ] ;
    narr:keyPhrase [ narr:text "A rollback\nwe have not rehearsed is a rollback we do not actually have." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Cadence**: monthly Atlas rollback rehearsals" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_4> ] ;
    narr:variation [ narr:text "The tension between the abstract definition of 'real' recovery and the concrete, administrative burden of monthly rehearsals." ; narr:over <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_2> ; narr:over <https://aswritten.ai/narrative#Expr_1DirectAfterUnprotectProbe_1> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
