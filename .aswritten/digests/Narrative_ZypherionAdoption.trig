@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Narrative_ZypherionAdoption> {
  <https://aswritten.ai/narrative#Digest_Narrative_ZypherionAdoption> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "60c5e370b9346881cc2b3f8e218d2270139d481e" ;
    narr:narration """This hub traces the arc of a technology decision that reversed itself: Zypherion was initially selected for the analytics pipeline, then [formally reversed on 2026-04-06](narr:https://aswritten.ai/narrative#Claim_ZypherionAdoptionDecision) when [critical streaming ingestion gaps disqualified it](narr:https://aswritten.ai/narrative#Claim_ZypherionStreamingGap). Quinton Fairweather (CTO) announced [Meridian as the replacement](narr:https://aswritten.ai/narrative#Claim_MeridianAdoptionDecision), selected specifically because it [handles both batch and streaming ingestion natively](narr:https://aswritten.ai/narrative#Claim_MeridianBatchStreamingCapability) — the capability Zypherion lacked. The Q3 2026 migration window, originally planned for Zypherion, [was retained unchanged for Meridian](narr:https://aswritten.ai/narrative#Claim_ZypherionMigrationTimeline). Two REVISED nodes restate the Zypherion-centric framing of the adoption and timeline decisions, reflecting the correction in place as of 2026-07-05. The hub covers: the original Zypherion selection, the streaming gap that undid it, the Meridian substitution, and the preserved migration schedule.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianAdoptionDecision> ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianBatchStreamingCapability> ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianMigrationTimeline> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionAdoptionDecision> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionMigrationTimeline> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ;
    narr:keyPhrase [ narr:text "reversed the Zypherion adoption on 2026-04-06 after discovering critical streaming ingestion gaps" ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionAdoptionDecision> ] ;
    narr:keyPhrase [ narr:text "Zypherion was found to have critical gaps in streaming ingestion, which disqualified it from the analytics pipeline role." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ] ;
    narr:keyPhrase [ narr:text "Meridian handles both batch and streaming ingestion natively, addressing the gap that disqualified Zypherion." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_MeridianBatchStreamingCapability> ] ;
    narr:keyPhrase [ narr:text "The Q3 2026 migration window is retained unchanged." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionMigrationTimeline> ] ;
    narr:keyPhrase [ narr:text "Migration to Meridian is scheduled for Q3 2026, the same window originally planned for Zypherion." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_MeridianMigrationTimeline> ] ;
    narr:variation [ narr:text "The hub is named for Zypherion adoption, but every child documents its undoing — a reader querying for Zypherion's adoption as a live decision will find only its reversal here." ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionAdoptionDecision> ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ] ;
    narr:variation [ narr:text "Two REVISED nodes restate the same reversal from a Zypherion-centric frame, while three Meridian-framed nodes cover the same facts from the replacement's perspective — parallel accounts of one event, not independent claims." ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionAdoptionDecision> ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionMigrationTimeline> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianAdoptionDecision> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianMigrationTimeline> ] ;
    narr:variation [ narr:text "The streaming gap is the sole stated disqualifier for Zypherion; no children address cost, vendor, performance on batch, or other evaluation criteria — the decision rationale is narrow." ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianBatchStreamingCapability> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}