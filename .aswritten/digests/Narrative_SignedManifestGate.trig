GRAPH <https://aswritten.ai/narrative#Digest_Narrative_SignedManifestGate> {
  <https://aswritten.ai/narrative#Digest_Narrative_SignedManifestGate> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_SignedManifestGate> ;
