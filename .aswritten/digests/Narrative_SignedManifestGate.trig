    narr:generatedFrom "808905fc06fb25ea765659d1425c23e29830364a" ;
    narr:narration """This hub covers the signed release manifest gate for Meridian deployments, established 20260718. Quinton Fairweather declared the rule directly: [every Meridian deployment now requires a signed release manifest](narr:Expr_1ProtectedFallbackProbe_1) before it ships. The motivating incident grounds the policy: [two unsigned artifacts reached staging last quarter](narr:Expr_1ProtectedFallbackProbe_2), and that incident is cited as the whole reason the gate exists. The session then crystallized three settled conclusions — [the gate itself](narr:Expr_1ProtectedFallbackProbe_3) (signed manifest required), [its scope](narr:Expr_1ProtectedFallbackProbe_4) (staging and production both covered), and [its owner](narr:Expr_1ProtectedFallbackProbe_5) (Quinton Fairweather). The register throughout is matter-of-fact and authority-ranking; no dissent or qualification appears in the children. Queries about the gate's rationale, its coverage boundaries, or its named owner route here; queries about enforcement mechanics, exception handling, or downstream pipeline steps do not.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ] ;
    narr:keyPhrase [ narr:text "Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ] ;
    narr:keyPhrase [ narr:text "Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:keyPhrase [ narr:text "Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ] ;
    narr:variation [ narr:text "The gate's rationale is incident-driven (two unsigned artifacts last quarter), not policy-first — a reader could read the rule as contingent on that specific failure mode rather than a standing architectural principle." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ] ;
    narr:variation [ narr:text "Scope is declared as staging and production, leaving open whether development or preview environments are excluded by design or simply unaddressed." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
