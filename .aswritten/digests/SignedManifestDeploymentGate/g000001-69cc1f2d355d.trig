    narr:voiceTrait [ narr:dim "style" ; narr:reading "The voice utilizes antithesis to contrast the current mandate against the specific failure that necessitated it." ; narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate.\"" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
