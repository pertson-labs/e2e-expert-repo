    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_7> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "Key decisions:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_6> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_7> ] ;
