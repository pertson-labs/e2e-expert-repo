@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Narrative_DeploymentGateAsSecurityControl> {
  <https://aswritten.ai/narrative#Digest_Narrative_DeploymentGateAsSecurityControl> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_DeploymentGateAsSecurityControl> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "eba35758c1030f5c2e733eb7a1ae58adddf603a5" ;
    narr:narration """The deployment gate for Meridian, established in August 2026, functions as a [mandatory security control](narr:Expr_1ProtectedBaseProbe_1) requiring a signed release manifest for all shipments. This directive emerged as a direct response to [past operational failures](narr:Expr_1ProtectedBaseProbe_2), specifically the unauthorized arrival of unsigned artifacts in staging. The requirement is framed both as a [formal policy directive](narr:Expr_1ProtectedBaseProbe_3) and a [scoped technical constraint](narr:Expr_1ProtectedBaseProbe_4) that explicitly encompasses both staging and production environments. While the gate's technical implementation is clear, the broader governance structure—specifically the [designation of an accountable owner](narr:Narrative_GateOwnershipAccountability)—remains an open dimension of the control's lifecycle, leaving the question of persistent versus transferable accountability to be resolved as the gate matures.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_GateOwnershipAccountability> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The gate is justified by a specific past failure, contrasting with its abstract, forward-looking policy language." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:variation [ narr:text "Accountability for the gate is treated as a separate, evolving governance concern rather than an inherent part of the technical requirement." ; narr:over <https://aswritten.ai/narrative#Narrative_GateOwnershipAccountability> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}