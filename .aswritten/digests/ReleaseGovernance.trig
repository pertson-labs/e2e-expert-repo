@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_ReleaseGovernance> {
  <https://aswritten.ai/narrative#Digest_ReleaseGovernance> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ReleaseGovernance> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "ca5b4f5212f8bb9f23c036aa061713dced050c89" ;
    narr:narration """This hub records the governance decision, as of 20260718, that Meridian deployments must clear a signed-manifest gate before shipping. [Quinton's policy statement](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1) frames the rule in present-tense authority: every deployment, no exceptions. [The incident rationale](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2) grounds it in a concrete past event — two unsigned artifacts reaching staging last quarter — making the gate reactive rather than precautionary in origin. The session then crystallised two settled conclusions: [the gate rule itself](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3) (signed manifest required) and [its scope](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4) (staging and production both covered). The [broader narrative node](narr:https://aswritten.ai/narrative#Narrative_SignedManifestGate) situates these within the Meridian release train as a whole. The region covers: what the gate is, why it was introduced, and where it applies — not rollback procedures, signing authority, or enforcement tooling.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedManifestGate> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ] ;
    narr:keyPhrase [ narr:text "Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ] ;
    narr:keyPhrase [ narr:text "Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:variation [ narr:text "The gate's origin is reactive (incident-driven, past-tense) rather than proactive policy design — a framing tension between the rule-as-standing-authority and the rule-as-patch." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ] ;
    narr:variation [ narr:text "Scope is declared as staging-and-production, but development environments are unaddressed — whether the gate is absent there or simply unstated is open." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:variation [ narr:text "The session conclusions carry no single named owner (principal: Session), while the supporting rationale is attributed to QuintonFairweather — leaving accountability for the rule's authority ambiguous." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}