@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Organization> {
  <https://aswritten.ai/narrative#Digest_Organization> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Organization> ;
    narr:childCount "7"^^xsd:integer ;
    narr:generatedFrom "c1e4afe567b5f1bd95ccfdcc9d4f584db3be7886" ;
    narr:narration """The organizational approach to Meridian deployment governance has shifted toward a formal, gate-based model, anchored by a new [mandatory release manifest requirement](narr:Expr_1ProtectedBaseProbe_1). This policy, which [applies to both staging and production](narr:Expr_1ProtectedBaseProbe_4), is framed as a direct response to [past operational failures](narr:Expr_1ProtectedBaseProbe_2) involving unauthorized artifacts. The initiative is currently [centralized under Quinton Fairweather](narr:Expr_1ProtectedBaseProbe_5), who has codified the mandate into [short, punchy summary directives](narr:Expr_1ProtectedBaseProbe_3). While the policy is presented as a necessary conservation measure to ensure system integrity, the underlying [incident-driven justification](narr:Narrative_IncidentDrivenControlTightening) suggests that the control's legitimacy is tethered to the memory of those specific past lapses. The [broader policy framework](narr:Narrative_MeridianDeploymentGatePolicy) remains focused on this transition from open shipping to signed gating, establishing a clear, albeit rigid, accountability structure for future releases.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_IncidentDrivenControlTightening> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_MeridianDeploymentGatePolicy> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:variation [ narr:text "The policy is framed as a reactive correction to specific past incidents rather than a proactive architectural evolution." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ; narr:over <https://aswritten.ai/narrative#Narrative_IncidentDrivenControlTightening> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}