    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "4508ac1596d2e79de2a93b06808baf96bdd6c8de" ;
    narr:narration """This hub tracks the formalization of operational readiness, specifically centering on the [mandatory cadence for Atlas rollback rehearsals](narr:Expr_1UnprotectedBaseProbe_1). The organization defines this practice through a lens of [demonstrated capability](narr:Narrative_RehearsalIsProofOfCapability), where the existence of a recovery mechanism is contingent upon active, periodic testing. Quinton Fairweather has established this [monthly rehearsal schedule](narr:Expr_1UnprotectedBaseProbe_3) as a directive, positioning himself as the [primary owner](narr:Expr_1UnprotectedBaseProbe_4) of the initiative. The rationale relies on a strict [antithetical framing](narr:Expr_1UnprotectedBaseProbe_2) of readiness: a capability that remains untested is functionally non-existent.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_RehearsalIsProofOfCapability> ;
    narr:keyPhrase [ narr:text "Atlas rollback rehearsals run monthly from now on." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "A rollback\nwe have not rehearsed is a rollback we do not actually have." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Cadence**: monthly Atlas rollback rehearsals" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The tension between the administrative record of ownership and the philosophical claim that rehearsal is the only proof of capability." ; narr:over <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ; narr:over <https://aswritten.ai/narrative#Narrative_RehearsalIsProofOfCapability> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}