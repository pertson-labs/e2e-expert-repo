GRAPH <https://aswritten.ai/narrative#Digest_Organization> {
  <https://aswritten.ai/narrative#Digest_Organization> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Organization> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "db21c19c4c804d57cbba8ceb84f18b70d90ff324" ;
    narr:narration """The organization has formalized a [mandatory release gate](narr:Expr_1ProtectedBaseProbe_1) for all Meridian deployments, requiring a signed manifest prior to shipping. This [governance shift](narr:Narrative_SignedReleaseGateGovernance) moves the deployment model from a trust-based system to one of verified signing. The decision is framed as a [direct response](narr:Expr_1ProtectedBaseProbe_2) to past failures, specifically citing two unsigned artifacts that reached staging last quarter. The requirement is [formally recorded](narr:Expr_1ProtectedBaseProbe_3) as a settled decision, with its [operational scope](narr:Expr_1ProtectedBaseProbe_4) explicitly covering both staging and production environments. Quinton Fairweather is [designated as the owner](narr:Expr_1ProtectedBaseProbe_5) responsible for this enforcement mechanism.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedReleaseGateGovernance> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:variation [ narr:text "The rationale relies on past failure as a justification for current restrictive policy." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}