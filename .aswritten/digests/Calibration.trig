    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_1> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
