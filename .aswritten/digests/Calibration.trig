    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InstrumentCalibrationVerifiedAgainstReference> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_1> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
    narr:keyPhrase [ narr:text "**Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_4> ] ;
    narr:variation [ narr:text "The reliance on fixed prior reference plates may limit flexibility if the instrument's operating environment shifts outside the June baseline." ; narr:over <https://aswritten.ai/narrative#Narrative_InstrumentCalibrationVerifiedAgainstReference> ] ;
