    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InstrumentCalibrationVerification> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_1> ] ;
    narr:keyPhrase [ narr:text "verified the calibration against the June reference plates and it\nholds across the full observing band" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_4> ] ;
    narr:keyPhrase [ narr:text "**Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ] ;
    narr:variation [ narr:text "Two children are session-level consolidated bullets rather than direct actor quotes — their epistemic standing differs from QuillAshgrove's first-person claims, which may matter for provenance queries." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_4> ] ;
