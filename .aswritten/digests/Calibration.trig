    narr:generatedFrom "0fd9b2ff63f012a7626a749880eb69bae578cb12" ;
    narr:narration """The operational status of the [Kestrelwood spectrograph](narr:Expr_1ForgetLifecycleTargetReturn_3) has been finalized as of July 17, 2026. Technical efforts led by Quill Ashgrove have established a [specific frequency calibration](narr:Expr_1ForgetLifecycleTargetReturn_1) of 88.4 MHz. This setting has been [validated against established reference standards](narr:Expr_1ForgetLifecycleTargetReturn_2), specifically the June reference plates, ensuring observational fidelity across the full band. The [formal record of this calibration](narr:Expr_1ForgetLifecycleTargetReturn_4) serves as the current baseline for the instrument, consolidating the technical verification into a unified [calibration and verification framework](narr:Narrative_InstrumentCalibrationVerification).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InstrumentCalibrationVerification> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "**Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ] ;
