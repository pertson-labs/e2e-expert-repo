    narr:generatedFrom "c894b1fad2c116c69a336e4f5775872f1dcd7197" ;
    narr:narration """This hub gathers the calibration record for the Kestrelwood spectrograph, dated 20260719. The core claim is a specific frequency setting: [88.4 MHz calibration statement](narr:https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1) asserted by QuillAshgrove in technical register. That figure is then grounded by [verification against June reference plates](narr:https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2), with the added claim that it holds across the full observing band — a broader scope assertion than the point value alone. Two editorial bullets from XenaExpertgh restate the same facts in parallel list form: [instrument identification bullet](narr:https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4) names the Kestrelwood spectrograph, and [calibration summary bullet](narr:https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5) pairs the 88.4 MHz value with the reference-plate verification. A broader narrative node [spectrograph calibration confirmed](narr:https://aswritten.ai/narrative#Narrative_SpectrographCalibrationVerified) frames the whole as an established, verified state. The region covers: a specific instrument, a specific frequency, a verification method, and a scope claim (full observing band).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SpectrographCalibrationVerified> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "**Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:variation [ narr:text "The point-value claim (88.4 MHz) and the scope claim (holds across the full observing band) are asserted by different children and could be read as independent — the frequency could hold without the band-wide claim also holding." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:variation [ narr:text "Two actors contribute: QuillAshgrove authors the primary technical assertions; XenaExpertgh authors editorial restatements — the same facts carry different authorship and framing weight." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
