    narr:covers <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_5> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_2> ] ;
    narr:keyPhrase [ narr:text "- **Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_3> ] ;
    narr:keyPhrase [ narr:text "- **Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_4> ] ;
    narr:keyPhrase [ narr:text "- **Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_5> ] ;
    narr:variation [ narr:text "Quinton's own, informal account of the incident behind the gate stands apart from the terse decision-register entry that states the requirement without the backstory." ; narr:over <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_2> ; narr:over <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_3> ] ;
    narr:variation [ narr:text "The recorded scope extends to both staging and production, though the incident cited as the gate's reason occurred in staging alone." ; narr:over <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_2> ; narr:over <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_4> ] ;
