@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Narrative_MeridianAdoption> {
  <https://aswritten.ai/narrative#Digest_Narrative_MeridianAdoption> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_MeridianAdoption> ;
    narr:childCount "3"^^xsd:integer ;
    narr:generatedFrom "a10d80d24c4d993da7fa524620af472d264b0980" ;
    narr:narration """The hub traces a database substitution in the analytics pipeline: [Zypherion's disqualifying streaming gap](narr:https://aswritten.ai/narrative#Claim_ZypherionStreamingGap) — its inability to support both batch and streaming ingestion — prompted CTO Quinton Fairweather to [select Meridian as the replacement](narr:https://aswritten.ai/narrative#Claim_MeridianDBChoice) on 2026-04-06. The [Q3 2026 migration window](narr:https://aswritten.ai/narrative#Claim_MeridianMigrationQ3) was carried over from the original Zypherion plan rather than reset. As of the single witness date (2026-07-04), the record covers the decision rationale and the inherited schedule, but does not address Meridian's own capability profile or any re-scoping of the timeline for the new system.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianDBChoice> ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianMigrationQ3> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ;
    narr:keyPhrase [ narr:text "Meridian is the chosen database for the analytics pipeline, replacing Zypherion. Decision made by CTO Quinton Fairweather on 2026-04-06." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_MeridianDBChoice> ] ;
    narr:keyPhrase [ narr:text "Migration to Meridian is scheduled for the same Q3 2026 window originally planned for Zypherion." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_MeridianMigrationQ3> ] ;
    narr:keyPhrase [ narr:text "Zypherion has critical gaps in streaming ingestion, making it unsuitable for the analytics pipeline which requires both batch and streaming support." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ] ;
    narr:variation [ narr:text "The Q3 timeline was inherited from the Zypherion plan without documented re-evaluation for Meridian — no child establishes whether the window is still realistic under the new system." ; narr:over <https://aswritten.ai/narrative#Claim_MeridianMigrationQ3> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianDBChoice> ] ;
    narr:variation [ narr:text "The rationale names Zypherion's streaming gap as the disqualifier but no child asserts that Meridian affirmatively satisfies both batch and streaming requirements — the case against is present; the case for is absent." ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianDBChoice> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}