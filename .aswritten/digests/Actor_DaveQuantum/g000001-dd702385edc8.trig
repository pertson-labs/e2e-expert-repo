    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_5> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_2> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_3> ] ;
    narr:keyPhrase [ narr:text "**Performance gain**: 10x analytical queries" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_4> ] ;
    narr:keyPhrase [ narr:text "**Timeline**: Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_5> ] ;
    narr:variation [ narr:text "The migration is presented both as a direct, authoritative decision and as a set of abstracted, future-facing project milestones." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787304049763_3> ] ;
