    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1786785433921_5> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786785433921_1> ] ;
