@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_PositioningThesis> {
  <https://aswritten.ai/narrative#Digest_PositioningThesis> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#PositioningThesis> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "fda36cada6535e03185d060b936eea86b00a34b7" ;
    narr:narration """All five children, dated 20260711, converge on a single positioning thesis: [the owned-vs-rented intelligence distinction](narr:https://aswritten.ai/narrative#Narrative_OwnedVsRentedIntelligence) as the core frame. The thesis holds that [owned intelligence is categorically distinct from rented](narr:https://aswritten.ai/narrative#Position_OwnedIntelligenceNotRented) — perspective, judgment, and accumulated knowledge are proprietary assets, while AI substrate is interchangeable commodity. Two aphoristic formulations — [the owned-not-rented aphorism](narr:https://aswritten.ai/narrative#Obs_OwnedNotRented) and [the substrate-as-commodity aphorism](narr:https://aswritten.ai/narrative#Obs_SubstrateCommodity) — compress the thesis into portable, quotable form. The positional claim [framing AI infrastructure as undifferentiated](narr:https://aswritten.ai/narrative#Position_SubstrateommodityPerspectiveAsset) extends this: the durable moat is individual perspective, not access to any particular model or platform. The hub covers the owned/rented distinction, the commodity-substrate claim, and the perspective-as-asset framing; it does not cover implementation, pricing, or audience segmentation.""" ;
    narr:covers <https://aswritten.ai/narrative#Narrative_OwnedVsRentedIntelligence> ;
    narr:covers <https://aswritten.ai/narrative#Obs_OwnedNotRented> ;
    narr:covers <https://aswritten.ai/narrative#Obs_SubstrateCommodity> ;
    narr:covers <https://aswritten.ai/narrative#Position_OwnedIntelligenceNotRented> ;
    narr:covers <https://aswritten.ai/narrative#Position_SubstrateommodityPerspectiveAsset> ;
    narr:keyPhrase [ narr:text "individually-owned intelligence (perspective, judgment, accumulated knowledge) is categorically distinct from rented intelligence (commodity AI substrate)" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_OwnedVsRentedIntelligence> ] ;
    narr:keyPhrase [ narr:text "The perspective is the asset you keep; the substrate is interchangeable." ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_OwnedVsRentedIntelligence> ] ;
    narr:keyPhrase [ narr:text "frames AI infrastructure as undifferentiated while individual perspective is the durable moat." ; narr:phraseSource <https://aswritten.ai/narrative#Position_SubstrateommodityPerspectiveAsset> ] ;
    narr:keyPhrase [ narr:text "Owned intelligence is not the same as rented intelligence — a categorical distinction between proprietary perspective and commodity AI access." ; narr:phraseSource <https://aswritten.ai/narrative#Position_OwnedIntelligenceNotRented> ] ;
    narr:variation [ narr:text "The thesis asserts substrate will remain commodity and perspective will remain durable — but no child surfaces a challenge to either assumption (e.g., substrate differentiation, or perspective erosion); the thesis is stated, not stress-tested." ; narr:over <https://aswritten.ai/narrative#Position_SubstrateommodityPerspectiveAsset> ; narr:over <https://aswritten.ai/narrative#Narrative_OwnedVsRentedIntelligence> ] ;
    narr:variation [ narr:text "The hub carries two distinct registers — aphoristic compression ([Obs_OwnedNotRented](narr:https://aswritten.ai/narrative#Obs_OwnedNotRented), [Obs_SubstrateCommodity](narr:https://aswritten.ai/narrative#Obs_SubstrateCommodity)) and positional argument ([Position_OwnedIntelligenceNotRented](narr:https://aswritten.ai/narrative#Position_OwnedIntelligenceNotRented)) — which may function differently in deployment even though they assert the same claim." ; narr:over <https://aswritten.ai/narrative#Obs_OwnedNotRented> ; narr:over <https://aswritten.ai/narrative#Obs_SubstrateCommodity> ; narr:over <https://aswritten.ai/narrative#Position_OwnedIntelligenceNotRented> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}