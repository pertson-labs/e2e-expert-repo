    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:variation [ narr:text "A tension exists between the formal, conservation-focused mandates and a more critical, past-tense evaluation of market-pricing implications." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:variation [ narr:text "The shift from conservation-oriented stability to self-enhancement goals suggests a divergence in how the gate's value is perceived in practice." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
