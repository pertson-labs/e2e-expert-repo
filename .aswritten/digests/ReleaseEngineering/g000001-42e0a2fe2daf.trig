@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_ReleaseEngineering> {
  <https://aswritten.ai/narrative#Digest_ReleaseEngineering> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ReleaseEngineering> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "42e0a2fe2dafdb428b1bf4884f0513ab0369f9d9" ;
    narr:narration """Operational gates across the release pipeline center on [signed release manifests](narr:https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1) instituted in response to past security gaps where [unsigned artifacts reached staging](narr:https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2). Formal standards specify that [signed release manifest required for Meridian deploys](narr:https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3) and that this mandate [applies to staging and production](narr:https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4). Governance ownership is established under [Quinton Fairweather](narr:https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5), aligning verification controls across [Meridian deployments require signed manifests to prevent unverified artifacts from shipping](narr:https://aswritten.ai/narrative#Narrative_SignedReleaseManifestRequirement).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedReleaseManifestRequirement> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:writer "google/gemini-3.5-flash-lite" .
}