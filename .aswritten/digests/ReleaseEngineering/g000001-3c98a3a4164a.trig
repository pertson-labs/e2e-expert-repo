@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_ReleaseEngineering> {
  <https://aswritten.ai/narrative#Digest_ReleaseEngineering> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ReleaseEngineering> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "3c98a3a4164aca34b95bf293cd090372a60c7029" ;
    narr:narration """The release engineering posture for Meridian deployments underwent a formal transition in August 2026, shifting from a reliance on informal trust to a [cryptographically verified gating mechanism](narr:Narrative_SignedManifestDeploymentGate). This new control requires a [signed release manifest](narr:Expr_1ProtectedBaseProbe_1) for all software reaching staging and production environments. The mandate is framed as a [direct response to past security lapses](narr:Expr_1ProtectedBaseProbe_2), specifically the unauthorized movement of unsigned artifacts. Quinton Fairweather has established [clear ownership](narr:Expr_1ProtectedBaseProbe_5) over this enforcement, formalizing the [gate criteria](narr:Expr_1ProtectedBaseProbe_3) and [defined scope](narr:Expr_1ProtectedBaseProbe_4) as a standard operational requirement. The current trajectory focuses on the implementation of these controls, though the underlying narrative remains open to future testing through potential incidents or exceptions.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedManifestDeploymentGate> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:variation [ narr:text "The shift is justified by past failure (competence-based) rather than purely abstract policy adherence." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:variation [ narr:text "The policy is framed as a transition from informal trust to cryptographic verification." ; narr:over <https://aswritten.ai/narrative#Narrative_SignedManifestDeploymentGate> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}