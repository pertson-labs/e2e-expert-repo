    narr:variation [ narr:text "The gate is framed as a historical artifact of rational persuasion rather than a current technical necessity." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:variation [ narr:text "The gate is treated as a purely formal, abstract requirement decoupled from concrete deployment realities." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
