    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786267378045_2> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786267378045_3> ] ;
