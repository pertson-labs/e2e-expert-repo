GRAPH <https://aswritten.ai/narrative#Digest_Architecture> {
  <https://aswritten.ai/narrative#Digest_Architecture> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Architecture> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "940612e45daea4f69021c82a442a37e720a8a507" ;
    narr:narration """The architecture of Meridian deployments is undergoing a transition from trust-based release cycles to a model of cryptographically verified provenance. This shift is centered on a [new mandatory requirement](narr:Expr_1ProtectedBaseProbe_1) for signed release manifests, a gate established in response to [past security lapses](narr:Expr_1ProtectedBaseProbe_2) where unsigned artifacts reached staging. The scope of this control [encompasses both staging and production](narr:Expr_1ProtectedBaseProbe_4), with Quinton Fairweather identified as the [primary owner](narr:Expr_1ProtectedBaseProbe_5) of the policy. The documentation reflects a move toward formalizing this [provenance gating](narr:Narrative_SignedManifestDeployGate) as a standard engineering safeguard, with editorial summaries [codifying the decision](narr:Expr_1ProtectedBaseProbe_3) to ensure consistent application across the deployment pipeline.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedManifestDeployGate> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The policy is framed as a reactive correction to specific past failures rather than a proactive architectural evolution." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}