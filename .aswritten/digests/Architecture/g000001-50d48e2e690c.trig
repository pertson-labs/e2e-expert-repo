    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1785148094404_6> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InfrastructureMigrationAsserted> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_QuantifiedCostBenefitJustification> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785148094404_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785148094404_1> ] ;
    narr:keyPhrase [ narr:text "Infrastructure migration performed as settled" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_InfrastructureMigrationAsserted> ] ;
    narr:keyPhrase [ narr:text "Quantified performance and cost as decision basis" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_QuantifiedCostBenefitJustification> ] ;
    narr:variation [ narr:text "The migration is presented as a fait accompli, potentially obscuring the underlying trade-offs or alternative database strategies." ; narr:over <https://aswritten.ai/narrative#Narrative_InfrastructureMigrationAsserted> ] ;
