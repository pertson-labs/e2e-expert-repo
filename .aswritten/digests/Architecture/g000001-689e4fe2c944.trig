    narr:generatedFrom "689e4fe2c944aa3e23eb6027dada1b8215bf5f57" ;
    narr:narration """On 2026-08-19, Dave announced a database migration as settled fact: [PostgreSQL to QuantumDB for the analytics pipeline](narr:Expr_1E2EQuantum1787131137794_1), backed by a [quantified performance-and-cost rationale](narr:Expr_1E2EQuantum1787131137794_2) claiming 10x query speed and lower licensing. The decision was [restated as a three-facet composite](narr:Expr_1E2EQuantum1787131137794_3) — what changes, the gain, and a Q3 2026 timeline — though the composite child notes this is one recorded decision, not three separate acts. Two broader narratives frame the pattern: [infrastructure migrations announced as settled fact by engineering leadership](narr:Narrative_InfrastructureMigrationDecisions) raises the question of who decides and whether the matter was ever debated, while [migrations justified through quantified performance-and-cost gains](narr:Narrative_MigrationBenefitJustification) asks whether the spoken claim and any written restatement hold consistently. The hub's thematic span is narrow: a single migration decision, its justification, and the rhetorical pattern of unilateral announcement.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_3> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InfrastructureMigrationDecisions> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_MigrationBenefitJustification> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_2> ] ;
    narr:keyPhrase [ narr:text "10x analytical queries" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_3> ] ;
    narr:keyPhrase [ narr:text "Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_3> ] ;
    narr:variation [ narr:text "The decision is announced as already settled — no proposal, no debate — raising whether the framing forecloses dissent by presentation." ; narr:over <https://aswritten.ai/narrative#Narrative_InfrastructureMigrationDecisions> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_1> ] ;
    narr:variation [ narr:text "The composite child insists the three bullets are one decision restated, not three acts — a structural reading that resists treating each facet as independent evidence." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_3> ] ;
    narr:variation [ narr:text "The justification narrative asks whether the spoken claim (10x query performance) and the written restatement (10x analytical queries) are the same promise or a quietly narrowed one." ; narr:over <https://aswritten.ai/narrative#Narrative_MigrationBenefitJustification> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787131137794_3> ] ;
