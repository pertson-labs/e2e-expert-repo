    narr:covers <https://aswritten.ai/narrative#Narrative_PerformanceCostRationale> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787217576351_1> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787217576351_3> ] ;
    narr:keyPhrase [ narr:text "**Timeline**: Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1787217576351_5> ] ;
    narr:variation [ narr:text "No challenge or dissent child exists — the migration is presented as unanimous and settled, with no record of alternatives weighed or rejected." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787217576351_1> ; narr:over <https://aswritten.ai/narrative#Narrative_DatabaseMigrationDecision> ] ;
