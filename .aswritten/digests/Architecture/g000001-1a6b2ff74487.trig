    narr:covers <https://aswritten.ai/narrative#Narrative_QuantifiedBenefitCase> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_2> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_3> ] ;
    narr:keyPhrase [ narr:text "**Performance gain**: 10x analytical queries" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_4> ] ;
