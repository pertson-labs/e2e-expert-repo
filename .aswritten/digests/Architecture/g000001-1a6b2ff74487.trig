    narr:variation [ narr:text "The decision is framed as settled and declarative, yet the Q3 2026 timeline is irrealis/future — decided but not yet executed, leaving the migration's completion unproven." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1785319384310_5> ] ;
