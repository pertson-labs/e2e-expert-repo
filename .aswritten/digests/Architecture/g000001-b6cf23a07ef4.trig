@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Architecture> {
  <https://aswritten.ai/narrative#Digest_Architecture> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Architecture> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "b6cf23a07ef4ba41625ca9ea24cc3a52d1bf43fa" ;
    narr:narration """The organization has [ratified an asynchronous job contract](narr:Expr_1ContractImmediateReturn_1) for the `remember` operation, establishing a pattern of immediate receipt and non-blocking dispatch. This architecture ensures that clients receive a handle in seconds, while the actual extraction is managed through [cursor-based polling](narr:Expr_1ContractImmediateReturn_1). The [operational logic](narr:Expr_1ContractImmediateReturn_4) emphasizes resilience, specifically noting that work is preserved even if a client drops their receipt. While the primary mechanism is polling, [alternative retrieval patterns](narr:Expr_1ContractImmediateReturn_3) allow for reactions to be piggybacked on subsequent calls, suggesting a flexible approach to state synchronization beyond the initial dispatch contract.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_AsyncRememberContract> ;
    narr:keyPhrase [ narr:text "ratified the async job contract" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_1> ] ;
    narr:keyPhrase [ narr:text "No blocking call, and no lost work if the client drops the receipt." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_2> ] ;
    narr:keyPhrase [ narr:text "remember dispatches, then the agent either polls the run or gets the reaction piggybacked on a later call." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_3> ] ;
    narr:variation [ narr:text "The contract mandates cursor polling, but secondary retrieval allows piggybacking reactions on later calls." ; narr:over <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ContractImmediateReturn_3> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}