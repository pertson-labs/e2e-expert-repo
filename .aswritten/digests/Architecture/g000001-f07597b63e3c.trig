    narr:covers <https://aswritten.ai/narrative#Narrative_AnalyticsPlatformAdoption> ;
    narr:keyPhrase [ narr:text "We are adopting Zypherion for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_1> ] ;
    narr:keyPhrase [ narr:text "It handles columnar queries 15x faster than our current setup." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_2> ] ;
    narr:keyPhrase [ narr:text "The migration starts next quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_3> ] ;
    narr:keyPhrase [ narr:text "Key decisions:\n- **Database**: Zypherion for analytics\n- **Performance**: 15x improvement on columnar queries\n- **Timeline**: Migration starts Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
    narr:variation [ narr:text "The focus remains exclusively on performance-based justification, leaving the long-term maintenance or integration costs of the new stack unaddressed." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_2> ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
