    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_AnalyticsInfrastructureModernization> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_2> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_3> ] ;
    narr:keyPhrase [ narr:text "**Timeline**: Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_5> ] ;
    narr:variation [ narr:text "The decision is voiced as present-tense fact ('we're switching') yet scheduled for Q3 2026 future irrealis — the announcement and the execution sit in different temporal registers." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_5> ] ;
    narr:variation [ narr:text "DaveQuantum frames the switch with reward and rational-persuasion power; XenaExpertgh's timeline bullet carries pressure — the ratification adds urgency the original announcement did not." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786095060988_5> ] ;
    narr:variation [ narr:text "The broader narrative generalizes to a class of migrations from general-purpose to specialized engines, but no child here discusses migration risk, data integrity, or operational cost — the tradeoff space is performance-and-cost only." ; narr:over <https://aswritten.ai/narrative#Narrative_AnalyticsInfrastructureModernization> ] ;
