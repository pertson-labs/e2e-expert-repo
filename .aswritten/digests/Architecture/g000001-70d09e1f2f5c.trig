    narr:covers <https://aswritten.ai/narrative#Expr_1LifecycleStepA_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1LifecycleStepA_8> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_QuantifiedPerformanceJustification> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SettledTechnologyAdoption> ;
    narr:keyPhrase [ narr:text "We are adopting Zypherion for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_2> ] ;
    narr:keyPhrase [ narr:text "It handles columnar queries 15x faster than our current setup." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_3> ] ;
    narr:keyPhrase [ narr:text "The migration starts next quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
    narr:keyPhrase [ narr:text "- **Database**: Zypherion for analytics" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_6> ] ;
    narr:keyPhrase [ narr:text "- **Performance**: 15x improvement on columnar queries" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_7> ] ;
    narr:keyPhrase [ narr:text "- **Timeline**: Migration starts Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_8> ] ;
    narr:variation [ narr:text "The tension between the CTO's direct declaration and the editorial summary's role as a secondary, ratification-free record." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_2> ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_6> ] ;
    narr:variation [ narr:text "The shift from the CTO's active, present-tense decision to the editorial framing of the migration as a future-dated, abstract commitment." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_8> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
