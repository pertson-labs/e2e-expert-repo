    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ] ;
    narr:keyPhrase [ narr:text "verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:keyPhrase [ narr:text "**Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ] ;
    narr:variation [ narr:text "QuillAshgrove's direct technical report (expert/informational) vs. XenaExpertgh's editorial summary bullets (composed-but-not-endorsed): same facts, different epistemic standing — the former is a first-person witness claim, the latter is framed prose that does not carry endorsement." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
