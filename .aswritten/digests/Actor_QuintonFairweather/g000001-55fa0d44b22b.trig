    narr:voiceTrait [ narr:dim "value" ; narr:reading "Primarily focused on conservation of system integrity, with a secondary pivot to personal accountability." ; narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
