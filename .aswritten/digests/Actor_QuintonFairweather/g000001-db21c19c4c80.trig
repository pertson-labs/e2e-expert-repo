    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The rationale relies on a specific past failure, contrasting with the forward-looking, abstract nature of the final decision record." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_2> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "He utilizes a short, punchy cadence to signal the finality of a decision." ; narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "His tone remains consistently formal, reinforcing the weight of the authority being exercised." ; narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
