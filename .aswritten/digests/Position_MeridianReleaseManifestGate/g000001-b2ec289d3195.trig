    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "b2ec289d3195075bfc545f4425d71863e7c5d7be" ;
    narr:narration """This position holds that [every Meridian deployment now requires a signed release manifest before it ships](narr:Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_1), grounded in [two unsigned artifacts that reached staging last quarter](narr:Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_2). The decision register records [the gate requirement](narr:Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_3), [its scope covering staging and production](narr:Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_4), and [ownership assigned to Quinton Fairweather](narr:Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_5).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261008_1_ProtectedBaseProbe_hfaec2f6da2c2_2> ;
