@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_ToneAuthoritative> {
  <https://aswritten.ai/narrative#Digest_ToneAuthoritative> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ToneAuthoritative> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "3f4354dda1838b734c3f832a22a22166e2668b4b" ;
    narr:narration """This hub gathers stylistic observations about the markers that constitute an authoritative institutional register, all dated 2026-07-05. The dominant pattern is first-person plural declarative construction: [collective ownership via 'We are adopting'](narr:https://aswritten.ai/narrative#StyleObservation_FirstPersonDeclarative) and [active-voice framing via 'We evaluated' / 'We are now switching'](narr:https://aswritten.ai/narrative#StyleObservation_MeridianDirectQuote) both signal institutional commitment without hedging. A distinct but related mechanism is [direct quotation from a named authority figure — the CTO — to convey a reversal decision](narr:https://aswritten.ai/narrative#StyleObservation_DirectQuoteStyle), grounding authority in an individual rather than the collective voice. Precision numerics appear as a third lever: [a specific multiplier ('15x faster') lends empirical weight to an adoption rationale](narr:https://aswritten.ai/narrative#StyleObservation_QuantifiedClaim). Finally, [an explicit supersession statement — a standalone declarative with no qualification — frames the document as formally overriding a prior decision](narr:https://aswritten.ai/narrative#StyleObservation_SupersessionStatement). Together the children map a toolkit of authority signals: voice, attribution, quantification, and explicit institutional override.""" ;
    narr:covers <https://aswritten.ai/narrative#StyleObservation_DirectQuoteStyle> ;
    narr:covers <https://aswritten.ai/narrative#StyleObservation_FirstPersonDeclarative> ;
    narr:covers <https://aswritten.ai/narrative#StyleObservation_MeridianDirectQuote> ;
    narr:covers <https://aswritten.ai/narrative#StyleObservation_QuantifiedClaim> ;
    narr:covers <https://aswritten.ai/narrative#StyleObservation_SupersessionStatement> ;
    narr:keyPhrase [ narr:text "We are now switching to Meridian instead." ; narr:phraseSource <https://aswritten.ai/narrative#StyleObservation_DirectQuoteStyle> ] ;
    narr:keyPhrase [ narr:text "We are adopting the Velociraptor retro format." ; narr:phraseSource <https://aswritten.ai/narrative#StyleObservation_FirstPersonDeclarative> ] ;
    narr:keyPhrase [ narr:text "We evaluated Zypherion further and found critical gaps in
its streaming ingestion." ; narr:phraseSource <https://aswritten.ai/narrative#StyleObservation_MeridianDirectQuote> ] ;
    narr:keyPhrase [ narr:text "It handles columnar queries 15x faster than our current setup." ; narr:phraseSource <https://aswritten.ai/narrative#StyleObservation_QuantifiedClaim> ] ;
    narr:keyPhrase [ narr:text "This supersedes the previous Zypherion decision." ; narr:phraseSource <https://aswritten.ai/narrative#StyleObservation_SupersessionStatement> ] ;
    narr:variation [ narr:text "Collective institutional voice ('We evaluated', 'We are adopting') vs. named individual authority (CTO direct quote) — two distinct sources of authorization that the children treat as equivalent but which carry different rhetorical weight and traceability." ; narr:over <https://aswritten.ai/narrative#StyleObservation_FirstPersonDeclarative> ; narr:over <https://aswritten.ai/narrative#StyleObservation_MeridianDirectQuote> ; narr:over <https://aswritten.ai/narrative#StyleObservation_DirectQuoteStyle> ] ;
    narr:variation [ narr:text "Quantified precision ('15x faster') is a mechanistically distinct authority signal — empirical rather than grammatical or attributive — and sits apart from the voice/attribution cluster that dominates the other four children." ; narr:over <https://aswritten.ai/narrative#StyleObservation_QuantifiedClaim> ] ;
    narr:variation [ narr:text "The supersession statement operates at document-structure level (framing the whole as an override) rather than sentence level — a different register move from the in-sentence declaratives, and the one most dependent on institutional context to carry force." ; narr:over <https://aswritten.ai/narrative#StyleObservation_SupersessionStatement> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}