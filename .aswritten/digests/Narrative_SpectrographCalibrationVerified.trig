    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "**Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:keyPhrase [ narr:text "Key decisions:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ] ;
    narr:variation [ narr:text "QuillAshgrove's first-person witness claim (realis, present-tense) vs. XenaExpertgh's editorial restatements (informational, no in-text ratification) — the same facts appear under two different epistemic authorities, leaving open whether the editorial layer adds or merely echoes." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:variation [ narr:text "The verification is framed as past-completed in Quill's account but restated in present-tense parallel form by the editorial layer — a temporal register shift that could matter for readers assessing currency." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
