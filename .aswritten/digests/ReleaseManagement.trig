GRAPH <https://aswritten.ai/narrative#Digest_ReleaseManagement> {
  <https://aswritten.ai/narrative#Digest_ReleaseManagement> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ReleaseManagement> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "325fa4012c689ede68409e3d38e9831ceb6c5b30" ;
    narr:narration """This hub covers the release-management gate established for Meridian deployments as of 20260718. The triggering rationale is concrete: [two unsigned artifacts reached staging last quarter](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2), and that incident is cited as the direct cause of the new control. The settled rule, restated as a decision bullet, is that [a signed release manifest is required for Meridian deploys](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3), with [scope covering staging and production](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4) and [ownership assigned to Quinton Fairweather](narr:https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5). The hub-level narrative confirms this as the current operative state: [signed manifests mandatory for Meridian deploys, staging and production in scope](narr:https://aswritten.ai/narrative#Narrative_SignedManifestGate). The posture throughout is formal and authority-ranking; no dissent or qualifying voice appears in the children.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedManifestGate> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_1> ] ;
    narr:keyPhrase [ narr:text "We saw two unsigned artifacts reach staging\nlast quarter and that is the whole reason for the gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_2> ] ;
    narr:keyPhrase [ narr:text "Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_3> ] ;
    narr:keyPhrase [ narr:text "Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:keyPhrase [ narr:text "Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ] ;
    narr:variation [ narr:text "No child raises whether the gate should extend beyond staging/production (e.g., dev or preview environments) — that boundary is asserted, not argued." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_4> ] ;
    narr:variation [ narr:text "Ownership is assigned to a single named individual rather than a team or role, leaving succession and delegation unaddressed in this graph." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedFallbackProbe_5> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}