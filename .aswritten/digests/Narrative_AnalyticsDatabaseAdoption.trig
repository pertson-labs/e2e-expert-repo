    narr:covers <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1LifecycleStepA_5> ;
    narr:keyPhrase [ narr:text "We are adopting Zypherion for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_1> ] ;
    narr:keyPhrase [ narr:text "It handles columnar queries 15x faster than our current setup." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_3> ] ;
    narr:keyPhrase [ narr:text "The migration starts next quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
    narr:keyPhrase [ narr:text "Migration starts Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1LifecycleStepA_5> ] ;
    narr:variation [ narr:text "The timeline commitment is tagged future-irrealis with a 'pressure' power dimension — distinct from the calm-legitimate register of the adoption announcement — leaving open whether 'next quarter' is a firm plan or a pushed deadline." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_4> ] ;
    narr:variation [ narr:text "The session summary re-renders Quinton's assertions without attribution, framing them as conversation-level conclusions rather than a single speaker's commitments — a subtle shift in who owns the decision." ; narr:over <https://aswritten.ai/narrative#Expr_1LifecycleStepA_5> ] ;
