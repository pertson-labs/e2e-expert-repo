GRAPH <https://aswritten.ai/narrative#Digest_ReleaseGovernance> {
  <https://aswritten.ai/narrative#Digest_ReleaseGovernance> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#ReleaseGovernance> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "b512c547e58eaca8f00b287c0805d7d662912a24" ;
    narr:narration """This hub gathers the governance mechanisms imposed on the Meridian release pipeline, all dated 20260722. The central decision is a [signed-manifest gate requirement](narr:Expr_1ProtectedBaseProbe_1), attributed to Quinton Fairweather as reported speech, justified by a concrete incident: two unsigned artifacts reached staging the prior quarter. An [editorial restatement](narr:Expr_1ProtectedBaseProbe_3) consolidates the gate decision without re-attributing Quinton's words, while a [scope specification](narr:Expr_1ProtectedBaseProbe_4) extends the gate to both staging and production, and an [ownership line](narr:Expr_1ProtectedBaseProbe_5) names Quinton as the responsible principal. The [broader narrative](narr:Narrative_DeploymentGateFromIncident) frames the entire arc as a past operational failure hardening into a binding, settled deployment gate. The justification is incident-reactive rather than proactive — the gate exists because something already went wrong, and is presented as already in force rather than under proposal.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_DeploymentGateFromIncident> ;
    narr:keyPhrase [ narr:text "that is the whole reason for the gate" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:variation [ narr:text "The gate is justified retrospectively by a specific breach (unsigned artifacts reaching staging) rather than by forward-looking risk assessment — governance here is reactive, framed as already settled." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ; narr:over <https://aswritten.ai/narrative#Narrative_DeploymentGateFromIncident> ] ;
    narr:variation [ narr:text "Scope extends the gate to staging as well as production, meaning the control is not limited to customer-facing environments but governs the pre-release pipeline too." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:writer "z-ai/glm-5.2" .
