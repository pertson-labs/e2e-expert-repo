    narr:covers <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SignedManifestRequirement> ;
    narr:keyPhrase [ narr:text "signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_2> ] ;
    narr:keyPhrase [ narr:text "applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_3> ] ;
    narr:keyPhrase [ narr:text "Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_4> ] ;
    narr:keyPhrase [ narr:text "Signed Manifests Gate Deployment Across Staging and Production" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_SignedManifestRequirement> ] ;
    narr:variation [ narr:text "The gate was instituted reactively to address past staging contamination rather than established as a baseline design constraint" ; narr:over <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_1> ] ;
