    narr:generatedFrom "d06bb91089513fef21262054a839697a8eb11310" ;
    narr:narration """The framework establishes [a mandatory verification protocol gating releases](https://aswritten.ai/narrative#Narrative_SignedManifestRequirement). This control follows [an operational decision prompted by unsigned artifacts reaching lower environments](https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_1), establishing [a formal requirement for signed release manifests](https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_2) that enforces [verification across both staging and production tiers](https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_3) under [designated ownership](https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_4).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1DeploymentGateDecisionMeridianReleaseTrain_1> ;
