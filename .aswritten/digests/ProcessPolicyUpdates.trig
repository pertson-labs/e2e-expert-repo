    narr:generatedFrom "592d7ffe36e11e06558d5c721d4a0a7c482f8530" ;
    narr:narration """As of 2026-07-06, this hub records a single process change: the team [shifted its retrospective practice from the start-stop-continue format to the Velociraptor format](narr:https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption), announced by Engineering Manager Sage Brightwell and [took effect last sprint](narr:https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption). The new format is [structured around three nautical-metaphor sections: Sailed, Stalled, and Capsized](narr:https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption). The adoption is corroborated by a [direct statement of format adoption by Sage Brightwell](narr:https://aswritten.ai/narrative#Obs_VelociraptorAdoptionQuote), a [confirmation that the Velociraptor format superseded start-stop-continue last sprint](narr:https://aswritten.ai/narrative#Obs_ReplacedFormatQuote), and a node [defining the three-section structure](narr:https://aswritten.ai/narrative#Obs_ThreeSectionsQuote). All children share the same date; no prior history or subsequent revision is recorded here. The hub label suggests a broader process-and-policy scope, but current coverage is limited to this one retrospective format change.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ;
    narr:covers <https://aswritten.ai/narrative#Obs_ReplacedFormatQuote> ;
    narr:covers <https://aswritten.ai/narrative#Obs_ThreeSectionsQuote> ;
    narr:covers <https://aswritten.ai/narrative#Obs_VelociraptorAdoptionQuote> ;
    narr:keyPhrase [ narr:text "shifted its retrospective practice from the start-stop-continue format to the Velociraptor format" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ] ;
    narr:keyPhrase [ narr:text "structured around three nautical-metaphor sections: Sailed, Stalled, and Capsized" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ] ;
    narr:keyPhrase [ narr:text "took effect last sprint" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ] ;
    narr:keyPhrase [ narr:text "Adopting the Velociraptor retro format (Sailed / Stalled / Capsized) to replace the start-stop-continue format" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ] ;
    narr:variation [ narr:text "The hub is scoped as 'ProcessPolicyUpdates' (plural, general), but all current children address only this one retrospective format change — other process or policy updates are not represented here, so queries about non-retro process changes should not expect coverage." ; narr:over <https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted> ; narr:over <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ] ;
    narr:variation [ narr:text "No rationale for the format switch is recorded — why start-stop-continue was dropped and what motivated the nautical-metaphor framing is absent from all children, leaving the 'why' open." ; narr:over <https://aswritten.ai/narrative#Narrative_VelociraptorRetroAdoption> ; narr:over <https://aswritten.ai/narrative#Obs_ReplacedFormatQuote> ] ;
