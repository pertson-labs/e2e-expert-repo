    narr:covers <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_5> ;
    narr:keyPhrase [ narr:text "We're switching from PostgreSQL to QuantumDB for the analytics pipeline." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_1> ] ;
    narr:keyPhrase [ narr:text "10x query performance, lower licensing cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_2> ] ;
    narr:keyPhrase [ narr:text "**Database migration**: PostgreSQL → QuantumDB" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_3> ] ;
    narr:keyPhrase [ narr:text "**Performance gain**: 10x analytical queries" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_4> ] ;
    narr:keyPhrase [ narr:text "**Timeline**: Q3 2026" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_5> ] ;
    narr:variation [ narr:text "The lower-licensing-cost justification is voiced by DaveQuantum but dropped from XenaExpertgh's editorial summary, leaving cost advantage asserted once and never restated." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_4> ] ;
    narr:variation [ narr:text "No child carries risk, counter-argument, or scope qualification — the graph holds only the decision and its positive rationale, with no dissent present." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1786440665269_5> ] ;
