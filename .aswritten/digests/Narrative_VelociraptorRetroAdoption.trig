    narr:generatedFrom "592d7ffe36e11e06558d5c721d4a0a7c482f8530" ;
    narr:narration """As of 20260706, [Sage Brightwell's adoption announcement](narr:https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted) marks the team's move to the Velociraptor retro format. [The replacement of start-stop-continue](narr:https://aswritten.ai/narrative#Claim_VelociraptorReplacedStartStopContinue) is placed at last sprint, framing this as an already-executed switch rather than a pending one. [The format's three-section structure](narr:https://aswritten.ai/narrative#Claim_VelociraptorRetroThreeSections) — Sailed, Stalled, and Capsized — is the only structural detail recorded here. The graph covers the *what* and *when* of the format change and its named sections; it does not cover rationale, facilitation guidance, or outcomes from any retro run under the new format.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_VelociraptorReplacedStartStopContinue> ;
    narr:covers <https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted> ;
    narr:covers <https://aswritten.ai/narrative#Claim_VelociraptorRetroThreeSections> ;
    narr:keyPhrase [ narr:text "The Velociraptor format replaced the old start-stop-continue format as of last sprint." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_VelociraptorReplacedStartStopContinue> ] ;
    narr:keyPhrase [ narr:text "Sage Brightwell states the team is adopting the Velociraptor retro format." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted> ] ;
    narr:keyPhrase [ narr:text "The Velociraptor retro format has exactly three sections: Sailed, Stalled, and Capsized." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_VelociraptorRetroThreeSections> ] ;
    narr:variation [ narr:text "Timing/status ambiguity: one child frames adoption as a present-tense statement of intent ('is adopting'), while another frames it as already completed ('replaced… as of last sprint') — the two are consistent but not identical in certainty." ; narr:over <https://aswritten.ai/narrative#Claim_VelociraptorRetroFormatAdopted> ; narr:over <https://aswritten.ai/narrative#Claim_VelociraptorReplacedStartStopContinue> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
