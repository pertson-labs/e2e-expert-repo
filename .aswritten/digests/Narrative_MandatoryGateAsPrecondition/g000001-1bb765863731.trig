    narr:covers <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_6> ;
    narr:keyPhrase [ narr:text "Every Meridian deployment now requires a signed release\nmanifest before it ships." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "**Gate**: signed release manifest required for Meridian deploys" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
    narr:keyPhrase [ narr:text "**Scope**: applies to staging and production" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_5> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_6> ] ;
    narr:variation [ narr:text "The tension lies in the shift from Quinton's direct, declarative speech to the editorialized, bulleted structure used to enforce the policy." ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_1> ; narr:over <https://aswritten.ai/narrative#Expr_1ProtectedBaseProbe_4> ] ;
