    narr:generatedFrom "63b828637201793f289e38032f07078371bfb8b0" ;
    narr:narration """As of 20260708, this hub covers a fixture-repository consolidation decision with three interlocking parts. The mainline commitment is to [consolidate all non-empty fixtures into e2e-expert-repo by end of Q3](narr:https://aswritten.ai/narrative#Claim_ConsolidateNonEmptyFixtures), establishing a single canonical home for the bulk of test fixtures. Running alongside that is a deliberate carve-out: [the empty-repo case stays as a dedicated repo and is excluded from the consolidation](narr:https://aswritten.ai/narrative#Claim_EmptyRepoDedicatedFixture), a boundary that survived negotiation. Rounding out the picture is a maintenance commitment: [weekly fixture drift checks each Monday](narr:https://aswritten.ai/narrative#Claim_WeeklyFixtureDriftChecks) as an ongoing cadence to keep the consolidated state from decaying. All three nodes share the same date, so this reads as a single decision moment rather than an evolving arc.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_ConsolidateNonEmptyFixtures> ;
    narr:covers <https://aswritten.ai/narrative#Claim_EmptyRepoDedicatedFixture> ;
    narr:covers <https://aswritten.ai/narrative#Claim_WeeklyFixtureDriftChecks> ;
    narr:keyPhrase [ narr:text "Consolidate all non-empty fixtures into e2e-expert-repo by end of Q3." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ConsolidateNonEmptyFixtures> ] ;
    narr:keyPhrase [ narr:text "The empty-repo case stays as a dedicated repo and is excluded from the consolidation. Tanya's pushback was accepted on this point." ; narr:phraseSource <https://aswritten.ai/narrative#Claim_EmptyRepoDedicatedFixture> ] ;
    narr:keyPhrase [ narr:text "weekly fixture drift checks each Monday as an ongoing maintenance cadence" ; narr:phraseSource <https://aswritten.ai/narrative#Claim_WeeklyFixtureDriftChecks> ] ;
    narr:variation [ narr:text "The empty-repo case is explicitly excluded from consolidation — Tanya's pushback was accepted, making this a negotiated exception rather than an oversight, and it may be a locus of future revisitation." ; narr:over <https://aswritten.ai/narrative#Claim_EmptyRepoDedicatedFixture> ; narr:over <https://aswritten.ai/narrative#Claim_ConsolidateNonEmptyFixtures> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
}