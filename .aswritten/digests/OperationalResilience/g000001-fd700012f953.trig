GRAPH <https://aswritten.ai/narrative#Digest_OperationalResilience> {
  <https://aswritten.ai/narrative#Digest_OperationalResilience> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#OperationalResilience> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "fd700012f953a86966ac23fb76ecd7f726878a87" ;
    narr:narration """The discourse surrounding operational resilience centers on the transition from theoretical capability to verified practice, specifically through the lens of [rehearsal as the primary validation mechanism](narr:Narrative_RehearsalAsRealCapability). As of August 2026, this has crystallized into a [formal directive](narr:Expr_1UnprotectedBaseProbe_1) mandating monthly Atlas rollback rehearsals. The framing rejects the assumption that design or documentation equates to possession, positing instead that [unrehearsed capabilities are effectively non-existent](narr:Expr_1UnprotectedBaseProbe_2). This shift is supported by [administrative codification](narr:Expr_1UnprotectedBaseProbe_3) and [individual ownership](narr:Expr_1UnprotectedBaseProbe_4), moving the conversation from abstract intent to a concrete, recurring operational cadence.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_RehearsalAsRealCapability> ;
    narr:keyPhrase [ narr:text "Atlas rollback rehearsals run monthly from now on." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "A rollback\nwe have not rehearsed is a rollback we do not actually have." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "**Cadence**: monthly Atlas rollback rehearsals" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "**Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The tension lies between the pragmatic, matter-of-fact administrative scheduling and the underlying principle that challenges the legitimacy of unverified systems." ; narr:over <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ; narr:over <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}