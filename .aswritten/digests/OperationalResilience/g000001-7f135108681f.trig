GRAPH <https://aswritten.ai/narrative#Digest_OperationalResilience> {
  <https://aswritten.ai/narrative#Digest_OperationalResilience> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#OperationalResilience> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "7f135108681fb6f421d38979be3011b513d59d2b" ;
    narr:narration """Operational resilience is currently defined by the formalization of [Atlas rollback rehearsals](narr:Expr_1UnprotectedBaseProbe_1) as a mandatory monthly cadence. This directive, issued by Quinton Fairweather on August 27, 2026, moves beyond mere scheduling by anchoring the practice in a [foundational principle](narr:Expr_1UnprotectedBaseProbe_2) that equates the absence of rehearsal with the absence of capability. The organizational record [codifies this authority](narr:Narrative_DirectiveRatifiedAsRecord) by explicitly linking the [rehearsal cadence](narr:Expr_1UnprotectedBaseProbe_3) to a [designated owner](narr:Expr_1UnprotectedBaseProbe_4). The discourse centers on the transition from abstract readiness to concrete, recurring action, framing the rehearsal not as a periodic check, but as the [constitutive condition](narr:Narrative_UnrehearsedCapabilityIsNoCapability) for the existence of the capability itself.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_DirectiveRatifiedAsRecord> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_UnrehearsedCapabilityIsNoCapability> ;
    narr:keyPhrase [ narr:text "Atlas rollback rehearsals run monthly from now on." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ] ;
    narr:keyPhrase [ narr:text "A rollback\nwe have not rehearsed is a rollback we do not actually have." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ] ;
    narr:keyPhrase [ narr:text "Cadence**: monthly Atlas rollback rehearsals" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_3> ] ;
    narr:keyPhrase [ narr:text "Owner**: Quinton Fairweather" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_4> ] ;
    narr:variation [ narr:text "The tension between the directive's matter-of-fact administrative tone and the existential weight of the underlying principle." ; narr:over <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_1> ; narr:over <https://aswritten.ai/narrative#Expr_1UnprotectedBaseProbe_2> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
