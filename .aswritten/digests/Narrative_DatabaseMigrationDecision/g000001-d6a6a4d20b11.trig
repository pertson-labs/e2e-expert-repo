    narr:variation [ narr:text "The shift from technical justification to authority-based scheduling introduces a tension between 'what is being done' and 'when it must be done'." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787834607681_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2EQuantum1787834607681_5> ] ;
