    narr:generatedFrom "f625f89af7bd5bef7ca8f7d288b140f34db732cf" ;
    narr:narration """This hub covers the analytics database technology decision and its revision. The [broader adoption narrative](narr:https://aswritten.ai/narrative#Narrative_ZypherionAdoption) records that Zypherion was originally selected, then superseded: on 2026-04-06, CTO Quinton Fairweather announced the switch to Meridian, with the Q3 2026 migration window left unchanged. The [streaming gap claim](narr:https://aswritten.ai/narrative#Claim_ZypherionStreamingGap) supplies the stated rationale — Zypherion's unsuitability for streaming ingestion — while the [Meridian capability claim](narr:https://aswritten.ai/narrative#Claim_MeridianStreamingCapability) frames the positive case: native handling of both batch and streaming as the key differentiator. The [database choice claim](narr:https://aswritten.ai/narrative#Claim_ZypherionDatabaseChoice) records the formal revision, and the [CTO announcement observation](narr:https://aswritten.ai/narrative#Obs_AdoptionStatement) anchors the decision to its source. The trajectory runs from original Zypherion adoption through the April 2026 reversal; migration execution detail is not present here.""" ;
    narr:covers <https://aswritten.ai/narrative#Claim_MeridianStreamingCapability> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionDatabaseChoice> ;
    narr:covers <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ;
    narr:covers <https://aswritten.ai/narrative#Obs_AdoptionStatement> ;
    narr:keyPhrase [ narr:text "handles both batch and streaming ingestion natively" ; narr:phraseSource <https://aswritten.ai/narrative#Claim_MeridianStreamingCapability> ] ;
    narr:keyPhrase [ narr:text "critical gaps in streaming ingestion" ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ] ;
    narr:keyPhrase [ narr:text "Decision revised by CTO Quinton Fairweather on 2026-04-06" ; narr:phraseSource <https://aswritten.ai/narrative#Claim_ZypherionDatabaseChoice> ] ;
    narr:keyPhrase [ narr:text "Q3 2026 migration window unchanged" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ] ;
    narr:keyPhrase [ narr:text "Supersedes the original Zypherion adoption decision" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ] ;
    narr:variation [ narr:text "The original Zypherion adoption decision is superseded but not erased — agents querying for the prior database choice or the rationale behind it may still need to expand the earlier framing captured in the broader narrative." ; narr:over <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionDatabaseChoice> ] ;
    narr:variation [ narr:text "Streaming capability is the sole documented reason for the switch; no cost, vendor-relationship, or performance-at-scale rationale appears under this hub — queries on those dimensions will not find support here." ; narr:over <https://aswritten.ai/narrative#Claim_ZypherionStreamingGap> ; narr:over <https://aswritten.ai/narrative#Claim_MeridianStreamingCapability> ] ;
    narr:variation [ narr:text "Migration execution detail (steps, owners, risk) is absent — the Q3 2026 window is noted as unchanged but nothing beneath this hub covers how the migration proceeds." ; narr:over <https://aswritten.ai/narrative#Narrative_ZypherionAdoption> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
