    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "b8b15252d967a4d80496d3a28d7deeb5fda73b8e" ;
    narr:narration """On 2026-08-26 this hub records a single calibration event treated as load-bearing: the Kestrelwood spectrograph set to 88.4 MHz and verified against June reference plates. [Quill's unified-voice assertion](narr:Expr_1ForgetLifecycleTargetReturn_2) states the calibration is done and holds across the full observing band, voiced in his own words with calm-positive conviction and technical register. That result is then ratified as an organizational decision: [an editorial label](narr:Expr_1ForgetLifecycleTargetReturn_3) introduces a key-decisions block, and two decision-line items record the [instrument](narr:Expr_1ForgetLifecycleTargetReturn_4) and the [calibration value with its verification provenance](narr:Expr_1ForgetLifecycleTargetReturn_5). Two broader narratives frame what makes this load-bearing rather than merely noted: [settled calibration decisions](narr:Narrative_SettledCalibrationDecisions) asks what transforms a calibration result into a ratified decision, and [verification authority invocation](narr:Narrative_VerificationAuthorityInvocation) asks how naming a principal lends epistemic weight to instrument verification claims. The hub's thematic span is thus: a specific instrument, a specific frequency, a specific reference standard, and the organizational machinery that converts a verified measurement into a signed decision.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SettledCalibrationDecisions> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_VerificationAuthorityInvocation> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ] ;
    narr:keyPhrase [ narr:text "Key decisions:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_3> ] ;
    narr:keyPhrase [ narr:text "- **Instrument**: Kestrelwood spectrograph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_4> ] ;
    narr:keyPhrase [ narr:text "- **Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:variation [ narr:text "The calibration claim appears twice — once as Quill's voiced assertion with full-band verification, once as a terse decision-line item; the decision record omits the 'holds across the full observing band' scope claim." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_2> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTargetReturn_5> ] ;
    narr:variation [ narr:text "Verification authority is invoked but not yet narrated: the broader frame asks how a principal's name lends epistemic weight, yet no child here names who signed off." ; narr:over <https://aswritten.ai/narrative#Narrative_VerificationAuthorityInvocation> ] ;
    narr:writer "z-ai/glm-5.2" .
