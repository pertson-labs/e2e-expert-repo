    narr:generatedFrom "89c94ad9fc6df7f26cc9e2b65b05f9bfc377a8fe" ;
    narr:narration """The organization’s calibration framework centers on the formal verification of instrument performance against established reference standards. Current activity, documented as of July 2026, focuses on the [Kestrelwood spectrograph](narr:Expr_1ForgetLifecycleTarget_2), which has been calibrated to 88.4 MHz. This status is maintained through [verification against June reference plates](narr:CalibrationVerification), ensuring stability across the full observing band. The documentation of these outcomes follows a dual-track approach: [direct technical assertion](narr:Expr_1ForgetLifecycleTarget_2) by the primary actor, Quill Ashgrove, and [formalized summary reporting](narr:Expr_1ForgetLifecycleTarget_3) that categorizes the result as a settled decision. These records serve as [principal authority relays](narr:PrincipalAuthorityRelay), where technical precision is coupled with administrative finality to mark outcomes as [settled decisions](narr:SettledDecisionRecording) rather than ongoing proposals.""" ;
    narr:covers <https://aswritten.ai/narrative#CalibrationVerification> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ;
    narr:covers <https://aswritten.ai/narrative#PrincipalAuthorityRelay> ;
    narr:covers <https://aswritten.ai/narrative#SettledDecisionRecording> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
    narr:keyPhrase [ narr:text "verified the calibration against the June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
    narr:keyPhrase [ narr:text "Key decisions:\n- **Instrument**: Kestrelwood spectrograph\n- **Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ] ;
    narr:variation [ narr:text "Tension exists between the performative, expert-led assertion of calibration and the administrative, matter-of-fact recording of the same data." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}