    narr:covers <https://aswritten.ai/narrative#Narrative_CalibrationDecisionRatification> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_InstrumentReadinessVerified> ;
    narr:keyPhrase [ narr:text "The Kestrelwood spectrograph is now calibrated at 88.4 MHz." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_2> ] ;
    narr:keyPhrase [ narr:text "We verified the calibration against the June reference plates and it\nholds across the full observing band." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ] ;
    narr:keyPhrase [ narr:text "- **Calibration**: 88.4 MHz, verified against June reference plates" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_6> ] ;
    narr:variation [ narr:text "The ratification frame (claims → decisions) and the readiness frame (untested → confirmed) read the same calibration facts as different stories — one about institutional process, one about technical authority." ; narr:over <https://aswritten.ai/narrative#Narrative_CalibrationDecisionRatification> ; narr:over <https://aswritten.ai/narrative#Narrative_InstrumentReadinessVerified> ] ;
    narr:variation [ narr:text "QuillAshgrove voices the calibration as a communal-sharing technical claim; XenaExpertgh restates it as an authority-ranking decision — same facts, different conviction register." ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_3> ; narr:over <https://aswritten.ai/narrative#Expr_1ForgetLifecycleTarget_6> ] ;
